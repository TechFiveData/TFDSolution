<script>

    $(document).ready(function () {


        /* ========================================================
           OPEN UPDATE HUB
        ======================================================== */

        $("#checkUpdatesBtn").on("click", function () {

            openUpdateHub();

        });


        $("#updateHeaderBtn").on("click", function () {

            openUpdateHub();

        });


        $("#updateMainBtn").on("click", function () {

            openUpdateHub();

        });


        function openUpdateHub() {

            $("#syncScreen").show();

            $("#updateFound").hide();

            $("#continueUpdateBtn").hide();

            $("#hubModal").css("display", "flex");

            startHubSync();

        }


        /* ========================================================
           ERP HUB SYNCHRONIZATION
        ======================================================== */

        function startHubSync() {

            $(".sync-status-row")
                .removeClass("active done");

            $(".sync-loader")
                .remove();

            $("#syncStep1")
                .addClass("active");

            $("#syncStep1").append(
                '<span class="sync-loader"></span>'
            );


            setTimeout(function () {

                completeSyncStep(
                    "#syncStep1",
                    "#syncStep2"
                );

            }, 900);


            setTimeout(function () {

                completeSyncStep(
                    "#syncStep2",
                    "#syncStep3"
                );

            }, 1800);


            setTimeout(function () {

                completeSyncStep(
                    "#syncStep3",
                    "#syncStep4"
                );

            }, 2700);


            setTimeout(function () {

                completeSyncStep(
                    "#syncStep4",
                    "#syncStep5"
                );

            }, 3600);


            setTimeout(function () {

                $("#syncStep5")
                    .removeClass("active")
                    .addClass("done");

                $("#syncStep5 i")
                    .removeClass()
                    .addClass("fa fa-circle-check");


                setTimeout(function () {

                    showUpdateFound();

                }, 500);


            }, 4500);

        }


        function completeSyncStep(
            current,
            next
        ) {

            $(current)
                .removeClass("active")
                .addClass("done");

            $(current)
                .find(".sync-loader")
                .remove();

            $(current)
                .find("i")
                .removeClass()
                .addClass("fa fa-circle-check");


            $(next)
                .addClass("active");

            $(next).append(
                '<span class="sync-loader"></span>'
            );

        }


        /* ========================================================
           SHOW UPDATE FOUND
        ======================================================== */

        function showUpdateFound() {

            $("#syncScreen").fadeOut(150);

            setTimeout(function () {

                $("#updateFound")
                    .fadeIn(200);

                $("#continueUpdateBtn")
                    .fadeIn(200);

            }, 180);

        }


        /* ========================================================
           UPDATE NOW
        ======================================================== */

        $("#continueUpdateBtn").on("click", function () {

            $("#hubModal").hide();

            openOtpModal();

        });


        /* ========================================================
           OTP
        ======================================================== */

        function openOtpModal() {

            $(".otp-box").val("");

            $("#otpModal")
                .css("display", "flex");

            startOtpTimer();

            setTimeout(function () {

                $(".otp-box")
                    .first()
                    .focus();

            }, 200);


            /*
             * ACTUAL API:
             *
             * $.ajax({
             *
             *     url: '/ERPUpdate/SendUpdatePasscode',
             *     type: 'POST'
             *
             * });
             */

            console.log(
                "OTP sent to registered email and mobile."
            );

        }


        /* ========================================================
           OTP INPUT
        ======================================================== */

        $(".otp-box").on("input", function () {

            this.value =
                this.value.replace(/[^0-9]/g, "");


            if (this.value.length === 1) {

                $(this)
                    .next(".otp-box")
                    .focus();

            }

        });


        $(".otp-box").on("keydown", function (e) {

            if (
                e.key === "Backspace" &&
                this.value === ""
            ) {

                $(this)
                    .prev(".otp-box")
                    .focus();

            }

        });


        /* ========================================================
           OTP TIMER
        ======================================================== */

        let otpSeconds = 300;

        let otpInterval;


        function startOtpTimer() {

            clearInterval(otpInterval);

            otpSeconds = 300;

            updateOtpTimer();


            otpInterval = setInterval(function () {

                otpSeconds--;

                updateOtpTimer();


                if (otpSeconds <= 0) {

                    clearInterval(otpInterval);

                    $("#otpTimer")
                        .text("Expired");

                }

            }, 1000);

        }


        function updateOtpTimer() {

            let minutes =
                Math.floor(otpSeconds / 60);

            let seconds =
                otpSeconds % 60;


            $("#otpTimer").text(

                String(minutes).padStart(2, "0")
                + ":"
                +
                String(seconds).padStart(2, "0")

            );

        }


        /* ========================================================
           RESEND OTP
        ======================================================== */

        $("#resendOtp").on("click", function () {

            $(".otp-box").val("");

            startOtpTimer();

            $(".otp-box")
                .first()
                .focus();


            /*
             * Actual API call:
             *
             * /ERPUpdate/SendUpdatePasscode
             */

            console.log(
                "New OTP sent."
            );

        });


        /* ========================================================
           VERIFY OTP
        ======================================================== */

        $("#verifyOtp").on("click", function () {

            let otp = "";


            $(".otp-box").each(function () {

                otp += $(this).val();

            });


            if (otp.length !== 6) {

                alert(
                    "Please enter the complete 6-digit passcode."
                );

                return;

            }


            /*
             * DEMO ONLY
             *
             * Replace with server-side validation.
             */

            if (otp === "123456") {

                clearInterval(otpInterval);

                $("#otpModal").hide();

                $("#confirmModal")
                    .css("display", "flex");

            }
            else {

                alert(
                    "Invalid or expired passcode."
                );

                $(".otp-box")
                    .val("");

                $(".otp-box")
                    .first()
                    .focus();

            }

        });


        /* ========================================================
           CONFIRMATION CHECKBOXES
        ======================================================== */

        $(
            "#logoutConfirm, #backupConfirm, #downtimeConfirm"
        ).on("change", function () {


            let valid =

                $("#logoutConfirm")
                    .is(":checked")

                &&

                $("#backupConfirm")
                    .is(":checked")

                &&

                $("#downtimeConfirm")
                    .is(":checked");


            $("#startUpdate")
                .prop("disabled", !valid);

        });


        /* ========================================================
           START UPDATE
        ======================================================== */

        $("#startUpdate").on("click", function () {

            $("#confirmModal").hide();

            $("#progressModal")
                .css("display", "flex");

            startERPUpdate();

        });


        /* ========================================================
           ERP UPDATE
        ======================================================== */

        function startERPUpdate() {

            let progress = 0;

            let step = 0;


            let steps = [

                "Checking active ERP users...",

                "Verifying update authorization...",

                "Creating database backup...",

                "Preparing ERP update package...",

                "Updating ERP application...",

                "Updating database structure...",

                "Applying configuration changes...",

                "Running database validation...",

                "Restarting ERP services...",

                "Validating ERP system..."

            ];


            let interval = setInterval(function () {


                progress += 10;


                if (progress > 100)
                    progress = 100;


                $("#progressFill")
                    .css(
                        "width",
                        progress + "%"
                    );


                $("#progressPercent")
                    .text(
                        progress + "%"
                    );


                $("#progressMessage")
                    .text(
                        steps[step]
                        ||
                        "Finalizing update..."
                    );


                step++;


                if (progress >= 100) {

                    clearInterval(interval);


                    $("#progressMessage")
                        .text(
                            "ERP update completed successfully."
                        );


                    setTimeout(function () {

                        $("#progressModal").hide();

                        alert(
                            "ERP has been successfully updated to v5.9.0."
                        );

                        location.reload();

                    }, 1200);

                }


            }, 900);

        }


        /* ========================================================
           CLOSE MODALS
        ======================================================== */

        $("[data-close]").on("click", function () {

            let modalId =
                $(this).attr("data-close");

            $("#" + modalId).hide();

        });


        /* ========================================================
           CLICK OUTSIDE MODAL
        ======================================================== */

        $(".modal-overlay").on("click", function (e) {

            if (e.target === this) {

                $(this).hide();

            }

        });


        /* ========================================================
           ESCAPE
        ======================================================== */

        $(document).on("keydown", function (e) {

            if (e.key === "Escape") {

                $(".modal-overlay").hide();

            }

        });

    });

</script>
