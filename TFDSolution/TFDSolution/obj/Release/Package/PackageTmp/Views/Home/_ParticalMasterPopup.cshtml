                    </label>
                </div>
                <button type="button" id="btnCanceldet" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnSave" class="btn btn-primary" onclick="SavePageData(true);">Submit</button>
            }
        </div>
