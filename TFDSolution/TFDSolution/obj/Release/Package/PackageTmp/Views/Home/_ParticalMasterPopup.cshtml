</div>
<script type="text/javascript">
    function loadPageDropdown(_fieldId, dropdownId, fieldcap) {
        $.ajax({
            url: '@Url.Action("getFieldSelection", "Common")',
            type: 'GET',
            data: { fieldId: _fieldId },
            success: function (data) {
                /*$('#' + dropdownId + '_select-loader').hide();*/
                var dropdown = $('#' + dropdownId);
                var fieldvalue = $('#' + dropdownId).attr("data-interval");
                dropdown.empty().append('<option value="">Select ' + fieldcap + '</option>');
                var isData = false;
                $.each(data, function (i, item) {
                    isData = true;
                    if (fieldvalue != null && fieldvalue != "" && fieldvalue == item.Value) {
                        dropdown.append($('<option selected></option>').val(item.Value).text(item.Text));
                    }
                    else {
                        dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                    }
                });
                /*$('#' + dropdownId + '_select-loader').hide();*/
                /*$("#pageLoader").hide();*/
            },
            error: function () {
                //$('#' + dropdownId + '_select-loader').hide();
                //$("#pageLoader").hide();
                console.log("Error loading dropdown: " + fieldcap);
            }
        });
    }
    $(document).ready(function () {
        try {
            var action = $("#hdnPageAction").val();
            $("#DataTabPopup").find("select, input, textarea").each(function () {
                    var $ctrl = $(this);
                    var ctrlId = $ctrl.attr("id");
                    if (!ctrlId) return;
                    // ===== Enable / Disable Logic =====
                    if (action === "V") {
                        $ctrl.prop("disabled", true);
                    }
                    else if (action === "E" || action === "A") {
                        if ($ctrl.is("select") && $ctrl.attr("data-disabled") === "True") {
                            $ctrl.prop("disabled", true);
                        } else {
                            $ctrl.prop("disabled", false);
                        }
                    } else {
                        $ctrl.prop("disabled", true);
                    }
                    // ===== Dropdown Load Logic =====
                    if ($ctrl.is("select")) {
                        var sourceType = $ctrl.data("sourcetype");
                        if (sourceType === "StoredProcedure") {
                            loadDropdown($ctrl.data("container"),ctrlId,$ctrl.data("html"));
                        }
                    }
            });
            $('#DataTabPopup .select2').each(function () {
                let selectId = $(this).attr('id');
                if (selectId) {
                    try {
                        let parentWrapper = $(this).parent();
                        var sourceType = $("#DataTabPopup #" + selectId).attr("data-sourcetype");
                        var _fieldId = $("#DataTabPopup #" + selectId).attr("data-container");
                        let selectedValues = $("#DataTabPopup #" + selectId).attr("data-interval");
                        let selectedText = $("#DataTabPopup #" + selectId).attr("data-display");
                        let caption = $("#DataTabPopup #" + selectId).attr("data-html");
                        let firstFive = selectedText ? selectedText.substring(0, 40) : "";
                        let isDependency = $("#DataTabPopup #" + selectId).attr("data-dependency");
                        if (sourceType == "StoredProcedure" && isDependency != "True") {
                            const pageFieldData = getPageFieldData();
                            const $selectElement = $('#DataTabPopup #' + selectId);
                            $selectElement.select2({
                                dropdownParent: parentWrapper,
                                placeholder: `Select ${caption}`,
                                allowClear: true,
                                skipLoading: true, // Custom flag
                                delay: 250,
                                minimumInputLength: 0, // Set to 0 to allow dropdown without typing
                                ajax: {
                                    url: '@Url.Action("FillSelctionPagingSP", "Common")',
                                    type: 'POST', // <-- Use POST instead of GET
                                    contentType: 'application/json', // <-- Send JSON body
                                    dataType: 'json',
                                    skipLoading: true, // Custom flag
                                    delay: 250,
                                    cache: true,cache: true,
                                    data: function (params) {
                                        return JSON.stringify({
                                            FieldId: _fieldId,
                                            searchTerm: params.term || '',
                                            page: params.page || 1,
                                            fieldValue: '',
                                            pageFieldData: pageFieldData
                                        });
                                    },
                                    processResults: function (data) {
                                        return {
                                            results: data.results,
                                            pagination: {
                                                more: data.pagination?.more || false
                                            }
                                        };
                                    },
                                    error: function (xhr, status, error) {
                                        console.error("Select2 AJAX Error:", {
                                            error,
                                            status,
                                            response: xhr.responseText
                                        });
                                    }
                                }
                            });

                            if (selectedValues.length) {
                                $.ajax({
                                    url: '@Url.Action("FillSelctionPagingSP", "Common")',
                                    skipLoading: true, // <-- Custom flag
                                    type: 'POST', // <-- Use POST instead of GET
                                    contentType: 'application/json', // <-- Send JSON body
                                    data: JSON.stringify({ FieldId: _fieldId, searchTerm: '', page: 1, fieldValue: '', pageFieldData: pageFieldData }),
                                    success: function (data) {
                                        var isMultiSelection = $selectElement.attr("data-multiselection");
                                        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                            const multiVal = selectedValues.split(',');
                                            $selectElement.val([]).trigger('change');
                                            multiVal.forEach(function (val) {
                                                let item = data.results.find(x => x.id.trim().toLowerCase() == val.trim().toLowerCase());
                                                if (item) {
                                                    let option = new Option(item.text, item.id, true, true);
                                                    $selectElement.append(option);
                                                    $selectElement.trigger('change');
                                                }
                                            });
                                        }
                                        else {
                                            if (data != null && data.results != null) {
                                                let item = data.results.find(x => x.id.trim().toLowerCase() == selectedValues.trim().toLowerCase());
                                                if (item) {
                                                    let option = new Option(item.text, item.id, true, true);
                                                    $selectElement.append(option).trigger('change');
                                                }
                                            }
                                        }
                                    }
                                });
                            }
                        }
                        else if (isDependency != "True") {
                            $('#DataTabPopup #' + selectId).select2({
                                dropdownParent: parentWrapper,
                                placeholder: 'Select ' + caption,
                                allowClear: true,
                                skipLoading: true, // <-- Custom flag
                                delay: 250,
                                minimumInputLength: 0, // change to 0 if you want scrolling without typing
                                ajax: {
                                    url: '@Url.Action("FillSelctionPaging", "Common")',
                                    dataType: 'json',
                                    skipLoading: true, // <-- Custom flag
                                    delay: 250,
                                    data: function (params) {
                                        return {
                                            FieldId: _fieldId,
                                            searchTerm: params.term || '', // search term
                                            page: params.page || 1,
                                            fieldValue: ''
                                        };
                                    },
                                    processResults: function (data) {
                                        return {
                                            results: data.results,
                                            pagination: {
                                                more: data.pagination.more
                                            }
                                        };
                                    },
                                    error: function (xhr, status, error) {
                                        console.error("Select2 AJAX Error:", error);
                                        console.error("Status:", status);
                                        console.error("Response:", xhr.responseText);
                                    },
                                    cache: true
                                }
                            });

                            /// Pre-load selected values (important when editing)
                            if (selectedValues.length) {
                                $.ajax({
                                    url: '@Url.Action("FillSelctionPaging", "Common")',
                                    type: 'GET',
                                    skipLoading: true, // <-- Custom flag
                                    data: { FieldId: _fieldId, searchTerm: firstFive, page: 1, fieldValue: '' },
                                    success: function (data) {
                                        var isMultiSelection = $(this).attr("data-multiselection");
                                        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                            selectedValues.forEach(function (val) {
                                                let item = data.results.find(x => x.id.trim().toLowerCase() == val.trim().toLowerCase());
                                                if (item) {
                                                    let option = new Option(item.text, item.id, true, true);
                                                    $('#DataTabPopup #' + selectId).append(option);
                                                    $('#DataTabPopup #' + selectId).trigger('change');
                                                }
                                            });
                                        }
                                        else {
                                            if (data != null && data.results != null) {
                                                let item = data.results.find(x => x.id.trim().toLowerCase() == selectedValues.trim().toLowerCase());
                                                if (item) {
                                                    let option = new Option(item.text, item.id, true, true);
                                                    $('#DataTabPopup #' + selectId).append(option).trigger('change');
                                                    //$('#DataTabPopup #' + selectId).trigger('change');
                                                }
                                            }
                                        }
                                    }
                                });
                            }
                        }
                    } catch (e) {
                        console.error("Select2 AJAX Error:", e);
                    }
                    //$('#' + selectId).select2()
                    //console.log("Selected : " + $('#DataTabPopup #' + selectId).val());
                }
            });
        } catch (e) {
            console.error(e);
        }

    });
    function selectChange(ctrl) {
        let selectId = $(ctrl).attr('id');
        BindHeaderDependencyData(selectId + "_Id", false);
    }
    function BindHeaderDependencyData(_fromFieldName, Isloaded) {
        var PageFieldData = [];
        var loadname = _fromFieldName.replace('_Id', '');
        try {
            var isMultiSelection = $("#" + loadname).attr("data-multiselection");
            if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                console.log("Multiple Selection");
            }
            else {
                $("#DataTabPopup input").each(function () {
                    if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                        var ctrlId = $(this).attr("id");
                        var fieldId = $(this).attr("data-bind");
                        var fieldtype = $(this).attr("data-content");
                        var fieldcap = $(this).attr("data-html");

                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $(this).val()
                            });
                        }
                    }
                });
                $("#DataTabPopup textarea").each(function () {
                    if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                        var ctrlId = $(this).attr("id");
                        var fieldId = $(this).attr("data-bind");
                        var fieldtype = $(this).attr("data-content");
                        var fieldcap = $(this).attr("data-html");
                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $(this).val()
                            });
                        }
                    }
                });
                $("#DataTabPopup select").each(function () {
                    if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                        var ctrlId = $(this).attr("id");
                        var fieldId = $(this).attr("data-bind");
                        var fieldcap = $(this).attr("data-html");
                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $("#DataTabPopup #" + $(this).attr("id") + "  option:selected").text()
                            });
                            PageFieldData.push({
                                FieldName: fieldId + "_Id",
                                FieldValue: $(this).val()
                            });
                        }
                    }
                });
                var tablename = $("#hdnTableName").val();
                var model = {
                    PageTablename: tablename,
                    FieldData: PageFieldData,
                    FromFieldName: _fromFieldName,
                    Id: parseInt($("#hdnRecordId").val()),
                    PageType: "Header",
                    FormId: '@Model.Design.FormId',
                    FieldId: (Isloaded == true ? $("#" + loadname).attr("data-container") : "")
                }
                $.ajax({
                    type: "POST", url: '@Url.Action("getHeaderDependencyData", "Home")',
                    contentType: "application/json;",
                    data: JSON.stringify(model),
                    skipLoading: true, // <-- Custom flag
                    beforeSend: function () {
                        $('#ajaxLoader').hide();  // Show loader before the call
                    },
                    complete: function () {
                        $('#ajaxLoader').hide();  // Hide loader after call finishes (success or fail)
                    },
                    async: false,
                    success: function (response) {
                        if (response != null && response != undefined && response.length > 0) {
                            $.each(response, function (index, item) {
                                var element = $('#' + item.FieldName);
                                var dataset = item.FieldValue;
                                if (element != undefined && element.length > 0) {
                                    if (element[0].localName == "label") {
                                        $('#' + item.FieldName).removeClass("text-success");
                                        $('#' + item.FieldName).addClass("text-danger");
                                        if (dataset != null && dataset != undefined && dataset.length > 0) {
                                            $.each(dataset, function (index, Dataitem) {
                                                if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                    $('#' + item.FieldName).addClass("text-success");
                                                    $('#' + item.FieldName).removeClass("text-danger");
                                                    element.text(Dataitem.FieldValue);
                                                }
                                                else {
                                                    element.text('N/A');
                                                }
                                            });
                                        }
                                        else {
                                            element.text('N/A');
                                        }
                                    }
                                    else if (element[0].localName == "input") {
                                        if (dataset != null && dataset != undefined && dataset.length > 0) {
                                            //if (element[0].type == "text") {
                                            //    element.val('');
                                            //}
                                            //else if (element[0].type == "number") {
                                            //    element.val('');
                                            //}
                                            $.each(dataset, function (index, Dataitem) {
                                                if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                    if (element[0].type == "text") {
                                                        var exVal = element.attr("value");
                                                        if ('@Model.PageAction' == 'V' && exVal != undefined && exVal != null && exVal.length > 0) {
                                                            element.val(exVal);
                                                        }
                                                        else {
                                                            element.val(Dataitem.FieldValue);
                                                        }
                                                    }
                                                    else if (element[0].type == "number") {
                                                        var exVal = element.attr("value");
                                                        if ('@Model.PageAction' == 'V' && exVal != undefined && exVal != null && exVal.length > 0) {
                                                            element.val(exVal);
                                                        }
                                                        else {
                                                            element.val(Dataitem.FieldValue);
                                                        }
                                                    }
                                                }
                                            });
                                        }
                                    }
                                    else if (element[0].localName == "textarea") {
                                        if (dataset != null && dataset != undefined && dataset.length > 0) {
                                            element.val('');
                                            $.each(dataset, function (index, Dataitem) {
                                                if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                    element.val(Dataitem.FieldValue);
                                                }
                                            });
                                        }
                                    }
                                    else if (element[0].localName == "select") {
                                        if (dataset != null && dataset != undefined && dataset.length > 0) {
                                            var dropdown = $('#DataTabPopup #' + item.FieldName);
                                            var fieldvalue = $('#DataTabPopup #' + item.FieldName).attr("data-interval");
                                            var DDLTextField = $('#DataTabPopup #' + item.FieldName).attr("data-wrap");
                                            var DDLValueField = $('#DataTabPopup #' + item.FieldName).attr("data-spy");
                                            var fieldTitle = $('#DataTabPopup #' + item.FieldName).attr("data-html");
                                            dropdown.empty();
                                            dropdown.append('<option value="">Select ' + fieldTitle + '</option>');
                                            var optionItem = "";
                                            var optionItemValue = "";
                                            var selectedVal = false;
                                            for (var irow = 0; irow < dataset.length; irow++) {
                                                if (dataset[irow].FieldName == DDLTextField) {
                                                    optionItem = dataset[irow].FieldValue;
                                                }
                                                else if (dataset[irow].FieldName == DDLValueField) {
                                                    optionItemValue = dataset[irow].FieldValue;
                                                }
                                                if (irow % 2) {
                                                    if (DDLTextField == DDLValueField) {
                                                        var fieldvalue = $('#DataTabPopup #' + item.FieldName).attr("data-interval");
                                                        if (fieldvalue != null && fieldvalue != "" && fieldvalue == optionItem) {
                                                            selectedVal = true;
                                                            dropdown.append($('<option selected></option>').val(optionItem).text(optionItem));
                                                        }
                                                        else {
                                                            dropdown.append($('<option></option>').val(optionItem).text(optionItem));
                                                        }
                                                    }
                                                    else {
                                                        var fieldvalue = $('#DataTabPopup #' + item.FieldName).attr("data-interval");
                                                        if (fieldvalue != null && fieldvalue != "" && fieldvalue == optionItemValue) {
                                                            selectedVal = true;
                                                            dropdown.append($('<option selected></option>').val(optionItemValue).text(optionItem));
                                                        }
                                                        else {
                                                            dropdown.append($('<option></option>').val(optionItemValue).text(optionItem));
                                                        }
                                                    }
                                                }
                                            }
                                            $('#DataTabPopup #' + item.FieldName).select2({
                                                width: '100%'
                                            });
                                            if (selectedVal) {
                                                if ($('#DataTabPopup #' + item.FieldName).attr("data-dependency") != "True"){
                                                    dropdown.trigger('select');
                                                }
                                                else {
                                                    BindHeaderDependencyData(item.FieldName + "_Id", false);
                                                }
                                            }

                                            //if (selectedVal == false && dataset.length > 0) {
                                            //    $('#DataTabPopup #' + item.FieldName).prop('selectedIndex', 1);
                                            //}
                                        }
                                        else {
                                            dropdown.empty();
                                        }
                                    }
                                }
                            });
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            }
        } catch (e) {
        }
    }
    function loadDropdown(_fieldId, dropdownId, fieldcap) {
        try {
            var sourceType = $("#" + dropdownId).attr("data-sourcetype");
            if (sourceType == "StoredProcedure") {
                var fieldname = $("#" + dropdownId).attr('id') + "_Id";
                /*console.log("Load Stored Procedure Bind for " + fieldname);*/
                BindHeaderDependencyData(fieldname, true);
            }
            else {
                $.ajax({
                    url: '@Url.Action("getFieldSelection", "Common")',
                    type: 'GET',
                    data: { fieldId: _fieldId },
                    cache: true,
                    success: function (data) {
                        var dropdown = $('#' + dropdownId);
                        var fieldvalue = $('#' + dropdownId).attr("data-interval");
                        dropdown.empty().append('<option value="">Select ' + fieldcap + '</option>');
                        $.each(data, function (i, item) {
                            if (fieldvalue != null && fieldvalue != "" && fieldvalue == item.Value) {
                                var isMultiSelection = $('#' + dropdownId).attr("data-multiselection");
                                if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                    var values = fieldvalue.split(",");
                                    dropdown.append($('<option selected></option>').val(values).text(item.Text));
                                }
                                else {
                                    dropdown.append($('<option selected></option>').val(item.Value).text(item.Text));
                                }
                            }
                            else {
                                dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                            }
                        });
                        var isMultiSelection = $('#' + dropdownId).attr("data-multiselection");
                        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                            var values = fieldvalue.split(",");
                            $('#' + dropdownId).val(values);
                        }
                        BindHeaderDependencyData(dropdownId + "_Id", true);
                        $("#pageLoader").hide();
                    },
                    error: function () {
                        $("#pageLoader").hide();
                        console.log("Error loading dropdown: " + fieldcap);
                    }
                });
            }
        } catch (e) {
            console.error("Select2 AJAX Error:", e);

        }
    }
    function CleanRecord() {
        $("#DataTabPopup input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                if ($(this).attr("id") != "hdnTabSQLTableName" && $(this).attr("id") != "BOMProcessId") {
                    $(this).val('');
                }
            }
        });
        $("#DataTabPopup select").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                $(this).val('');
                $(this).val([]).trigger('change');
            }
        });
        $("#DataTabPopup textarea").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                $(this).val('');
            }
        });
        $("#DataTabPopup label").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                $(this).removeClass("text-success");
                $(this).addClass("text-danger");
                $(this).text('N/A');
            }
        });
        $("#DataTabPopup input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                if ($(this).attr("id") != "hdnTabSQLTableName" && $(this).attr("id") != "BOMProcessId") {
                    $(this).val('');
                }
            }
        });
        $("#hdnDetailId").val(0);
        $("#hdnChargesId").val(0);
        $('#DataTabPopup .select2').val([]).trigger('change');
    }
    function SavePageData(isSubmited) {
        var isFormValid = true, isAllowMultipleDoc = false;
        var multipleDocFieldName = "";
        var PageFieldData = [];
        PageFieldData.push({
            FieldName: "ParentId",
            FieldValue: $("#hdnParentRecordId").val()
        });
        $("#DataTabPopup input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var ctrlId = $(this).attr("id");
                var fieldId = $(this).attr("data-bind");
                var fieldtype = $(this).attr("data-content");
                var fieldcap = $(this).attr("data-html");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    if ($(this).attr("type") == "checkbox") {
                        var checkVal = ($(this).is(":checked") == true? "true": "false");
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: checkVal,
                            FieldType: $(this).attr("type"),
                        });
                    }
                    else if ($(this).attr("type") == "radio") {
                        var checkVal = ($(this).is(":checked") == true ? "true" : "false");
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: checkVal,
                            FieldType: $(this).attr("type"),
                        });
                    }
                    else if ($(this).attr("type") != "file") {
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: $(this).val(),
                            FieldType: $(this).attr("type"),
                        });
                    }
                }
                $(this).next(".validation").remove();
                if ($(this).prop('required') && $(this).attr("type") != "file" && $.trim($(this).val()).length == 0) {
                    $(this).addClass("input-validation-error");
                    $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap +"</div>");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                } else {
                    $(this).removeClass("input-validation-error");
                }
            }
        });
        $("#DivTotal input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val(),
                        FieldType: $(this).attr("type"),
                    });
                }
            }
        });
        $("#DataTabPopup select").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var ctrlId = $(this).attr("id");
                var fieldId = $(this).attr("data-bind");
                var fieldcap = $(this).attr("data-html");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    var isMultiSelection = $(this).attr("data-multiselection");
                    if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                        var multiText = $(this).find('option:selected').map(function () {
                            return $(this).text(); // Use .val() if you want IDs
                        }).get().join(',');
                        isAllowMultipleDoc = $(this).data("multidocument") === true || $(this).data("multidocument") === "True";
                        multipleDocFieldName = fieldId;
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: multiText,
                            FieldType: $(this).attr("type"),
                        });
                        PageFieldData.push({
                            FieldName: fieldId + "_Id",
                            FieldValue: $(this).val().join(','),
                            FieldType: $(this).attr("type"),
                        });
                    }
                    else {
                        if ($(this).val() != null && $(this).val() != undefined && $(this).val().length > 0 && $(this).val() != "0" && $(this).val() != "") {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $('#' + $(this).attr("Id") + ' option:selected').text(),
                                FieldType: $(this).attr("type"),
                            });
                        }
                        PageFieldData.push({
                            FieldName: fieldId + "_Id",
                            FieldValue: $(this).val(),
                            FieldType: $(this).attr("type"),
                        });
                    }
                }
                $(this).next(".validation").remove();
                if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                    $(this).addClass("input-validation-error");
                    $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please select " + fieldcap +"</div>");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                } else {
                    $(this).removeClass("input-validation-error");
                }
            }
        });
        //textarea
        $("#DataTabPopup textarea").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var ctrlId = $(this).attr("id");
                var fieldId = $(this).attr("data-bind");
                var fieldtype = $(this).attr("data-content");
                var fieldcap = $(this).attr("data-html");

                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val(),
                        FieldType: $(this).attr("type"),
                    });
                }
                $(this).next(".validation").remove();
                if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                    $(this).addClass("input-validation-error");
                    $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                } else {
                    $(this).removeClass("input-validation-error");
                }
            }
        });
        $("#DataTabPopup label").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).text()
                    });
                }
            }
        });
        if (!isFormValid) {
            ShowToastNotification("error","Please fill in all the required fields (indicated by *)");
            return;
        }
        else {
            try {
                var tablename = $("#hdnTableName").val();
                var recordId = $("#hdnRecordId").val(); // Get the hidden ID field
                var model = {
                    PageTablename: tablename,
                    FieldData: PageFieldData,
                    Id: recordId,  // Pass record ID for update
                    PageType: "Header",
                    FormId: '@Model.Design.FormId',
                    DocId: $("#hdnDocId").val(),
                    AllowMultipleDocument: isAllowMultipleDoc,
                    MultipleDocFieldName: multipleDocFieldName
                }

                 $.ajax({
                     type: "POST", url: '@Url.Action("SavePageData", "Home")',
                     contentType: "application/json;",
                     data: JSON.stringify(model),
                     async: false,
                     success: function (response) {
                         if (response.IsSuccess) {
                             CleanRecord();
                             ShowToastNotification("success", response.Response)
                             setTimeout(function () {
                                 BindGridPagination();
                             }, 1000);
                         }
                         else {
                             ShowToastNotification("error",response.Response);
                         }
                     },
                     failure: function (response) { },
                     error: function (response) { }
                 });
            } catch (e) {

            }
        }
    }
</script>