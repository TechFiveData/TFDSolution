@model TFDSolution.Models.PageModel

@{
    ViewBag.Title = Model.Design.FormTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    string AllowOtherCharges = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "AllowOtherCharges");
    string AllowBillOfMaterial = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "BillOfMaterial");
    string AllowInlineForm = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "InlineForm");
    string AllowDetailPopupStyle = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "DetailPopupStyle");
    string EnablePhotoUpload = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "EnablePhotoUpload");
    string AllowSubDetailsView = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "AllowSubDetailsView");
    string AllowBackdateDays = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "AllowBackdateDays");
    string EnableEWayBill = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "EnableEWayBill");
    string EnableEInvoiceBill = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "EnableEInvoiceBill");
    bool isInlineForm = false, IsCenterStyle = false;
    string popStyle = "";
    if (!string.IsNullOrEmpty(AllowInlineForm) && AllowInlineForm == "y")
    {
        isInlineForm = true;
    }
    if (!string.IsNullOrEmpty(AllowDetailPopupStyle) && AllowDetailPopupStyle == "y")
    {
        IsCenterStyle = true;
        popStyle = "modal-dialog-centered float-none model-center-style";
    }
    var ImagesBase = Url.Content("~/");
    var today = DateTime.Today;
    int backDays = 0;
    int.TryParse(AllowBackdateDays, out backDays);
    DateTime startDate;
    DateTime endDate;
    if (TFDSolution.Common.SessionPersister.LoginedUser != null && TFDSolution.Common.SessionPersister.LoginedUser.CompanyInfo != null)
    {
        startDate = TFDSolution.Common.SessionPersister.LoginedUser.CompanyInfo.FinancialStartDate;
        endDate = TFDSolution.Common.SessionPersister.LoginedUser.CompanyInfo.FinancialEndDate;
    }
    else
    {
        if (today.Month >= 4)
        {
            // Current FY: Apr this year → Mar next year
            startDate = new DateTime(today.Year, 4, 1);
            endDate = new DateTime(today.Year + 1, 3, 31);
        }
        else
        {
            // Current FY: Apr last year → Mar this year
            startDate = new DateTime(today.Year - 1, 4, 1);
            endDate = new DateTime(today.Year, 3, 31);
        }
    }
    if (Model.PageAction == "A") { startDate = DateTime.Now; }
    // If today is exactly 1-April
    if (startDate.Month == 4 && startDate.Day == 1)
    {
        backDays = 0;
    }
    int fyYear = DateTime.Now.Year;
    DateTime financialYearStart = new DateTime(fyYear, 4, 1);
    DateTime calculatedDate = startDate.AddDays(-backDays);
    // Don't allow date before 1-April
    if (calculatedDate < financialYearStart)
    {
        startDate = financialYearStart;
    }
    else
    {
        startDate = calculatedDate;
    }
}
