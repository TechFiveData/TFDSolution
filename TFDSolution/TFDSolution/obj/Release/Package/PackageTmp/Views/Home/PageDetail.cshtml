    function DownloadEInvoice(downloadType) {
        var $btn;
        var $spinner;
        var originalText;
        if (downloadType === "eInvoicePDF") {
            $btn = $("#btnDownloadEInvoice");
            $spinner = $("#downloadInvoiceSpinner");
            originalText = "Download PDF";
        }
        else if (downloadType === "QRCode") {
            $btn = $("#btnDownloadQRCode");
            $spinner = $("#downloadQRCodeSpinner");
            originalText = "QR Code";
        }

        $btn.prop("disabled", true);
        $spinner.removeClass("d-none").css("visibility", "visible");
        $btn.find(".btn-text").text("Downloading...");
        var Irn = "@eInvoiceIRN";
        $.ajax({
            url: "@Url.Action("DownloadEInvoiceBill", "EWayBill")",
            type: "GET",
            data: {Irn: Irn,URNno: $("#txtURNNo").val(),downloadType: downloadType},
            dataType: "json",
            skipLoading: true,
            success: function (response) {
                if (response.success) {
                    ShowToastNotification("success", response.message);
                    ShowEInvoiceMessage(response.message, "success");
                    window.open(response.filePath, "_blank");
                }
                else {
                    ShowEInvoiceMessage("e-Invoice Bill not downloaded. Please try again.", "error");
                    ShowToastNotification("error", "File is not downloaded. Please try again.");
                }
            },
            error: function(xhr, status, error) {
                ShowToastNotification("error", error);
                ShowEInvoiceMessage("e-Invoice Bill not downloaded. Please try again.", "error");
            },
            complete: function () {
                $btn.prop("disabled", false);
                $spinner.addClass("d-none").css("visibility", "hidden");
                $btn.find(".btn-text").text(originalText);
            }
        });
    }
