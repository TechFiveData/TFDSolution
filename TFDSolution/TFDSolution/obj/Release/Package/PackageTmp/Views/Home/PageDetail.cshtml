        $("#fileAttachment").on("change", function () {
            try {
                $("#btnAttachUpload").attr("disabled", true);
                if (this.files && this.files.length > 0) {
                    let file = this.files[0];
                    let fileSize = file.size;
                    // 1. File size limit (e.g. 25 MB)
                    let maxSize = 50 * 1024 * 1024;
                    if (fileSize > maxSize) {
                        e.preventDefault();
                        ShowToastNotification("error","File size must be less than 25 MB.");
                        return false;
                    }
                    var fileSizeInKB = (fileSize / 1024).toFixed(2);
                    var fileSizeInMB = (fileSize / (1024 * 1024)).toFixed(2);
                    // original file name with extension
                    let fileName = file.name;
                    // remove the extension (everything after the last ".")
                    let cleanName = fileName.replace(/\.[^/.]+$/, "");
                    // set values
                    var extension = fileName.split('.').pop().toLowerCase();
                    $("#hdnAttachFileSize").val(fileSizeInMB +" MB");   // e.g., "image/jpeg"
                    $("#hdnAttachFileType").val(extension);   // e.g., "image/jpeg"
                    $("#txtAttachedFile").val(cleanName);     // e.g., "photo" instead of "photo.jpg"
                    $("#btnAttachUpload").attr("disabled", false);
                } else {
                    $("#txtAttachedFile").val(""); // clear if no file selected
               }
            } catch (e) {
                ShowToastNotification("error", "Upload is failed. Please try again.");
            }
        });
    });

