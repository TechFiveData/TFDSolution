    function CopySelectedOption(ctrl) {
        var $select = $('#' + ctrl);
        $('#' + ctrl).prev('span.my-label').remove();
        // Make sure Select2 is initialized
        if (!$select.hasClass('select2-hidden-accessible')) {
            alert('Select2 not initialized!');
            return;
        }
        var selectedValues = "";
        var isMultiSelection = $select.attr("data-multiselection");
        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
            var multiText = $select.find('option:selected').map(function () {
                return $(this).text(); // Use .val() if you want IDs
            }).get().join(',');
            selectedValues = multiText;
        }
        else {
            selectedValues = $('#' + ctrl + ' option:selected').text();
        }

        if (selectedValues.length === 0) {
            selectedValues = $('#' + ctrl + ' option:selected').text();
            return;
        }
        var textToCopy = selectedValues;
        // Use a fallback method if navigator.clipboard is not supported
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(textToCopy).then(function () {
                console.log('Copied: ' + textToCopy);
                $('#' + ctrl).before('<span class="my-label">Copied</span>');
                // Remove the span after 5 seconds (5000 milliseconds)
                setTimeout(function () {
                    $('#' + ctrl).prev('span.my-label').fadeOut(1000, function () {
                        $(this).remove(); // Remove after fade out
                    });
                }, 5000);
            }).catch(function (err) {
                console.error('Clipboard failed:', err);
            });
        } else {
            // Fallback for insecure context
            var textArea = document.createElement("textarea");
            textArea.value = textToCopy;
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                console.log('Copied: ' + textToCopy);
                $('#' + ctrl).before('<span class="my-label">Copied</span>');
                // Remove the span after 5 seconds (5000 milliseconds)
                setTimeout(function () {
                    $('#' + ctrl).prev('span.my-label').fadeOut(1000, function () {
                        $(this).remove(); // Remove after fade out
                    });
                }, 5000);
            } catch (err) {
                console.error('Fallback: Unable to copy', err);
            }
            document.body.removeChild(textArea);
            // Fallback using temporary input element
            //alert('Copied: ' + textToCopy);
        }
    }
    $(document).on('paste', 'input[type="date"]', function (e) {
        e.preventDefault(); // stop default paste

        // Get pasted text
        let pastedData = (e.originalEvent || e).clipboardData.getData('text').trim();

        // Normalize delimiters (accept -, /, .)
        let clean = pastedData.replace(/[.\-]/g, '/');
        let parts = clean.split('/');
        let formatted = "";

        // Case: yyyy-MM-dd or yyyy/MM/dd (ISO format)
        if (parts.length === 3 && parts[0].length === 4) {
            let yyyy = parts[0];
            let mm = parts[1].padStart(2, '0');
            let dd = parts[2].padStart(2, '0');
            formatted = `${yyyy}-${mm}-${dd}`;
        }
        // Case: dd/MM/yyyy (European/India format)
        else if (parts.length === 3 && parts[0].length <= 2 && parts[1].length <= 2) {
            let dd = parts[0].padStart(2, '0');
            let mm = parts[1].padStart(2, '0');
            let yyyy = parts[2];
            formatted = `${yyyy}-${mm}-${dd}`;
        }
        // Case: MM/dd/yyyy (US format)
        else if (parts.length === 3 && parts[0].length <= 2 && parts[1].length <= 2 && parts[2].length === 4 && parts[0] <= 12) {
            let mm = parts[0].padStart(2, '0');
            let dd = parts[1].padStart(2, '0');
            let yyyy = parts[2];
            formatted = `${yyyy}-${mm}-${dd}`;
        }

        if (formatted) {
            $(this).val(formatted);
        } else {
            console.log("⚠️ Invalid date format! Use dd/MM/yyyy, MM-dd-yyyy, or yyyy-MM-dd.");
        }
    });
