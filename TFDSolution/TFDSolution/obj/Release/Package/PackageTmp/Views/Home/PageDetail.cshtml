    // Open file dialog when clicked
    dropZone.addEventListener('click', () => fileInput.click());

    // Highlight on drag
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
        document.getElementById('uploadStatus').innerHTML = "";
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
        document.getElementById('uploadStatus').innerHTML = "";
    });

    // Handle dropped files
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        $("#dropZone").removeClass("input-validation-error");
        dropZone.classList.remove('dragover');
        uploadFiles(e.dataTransfer.files);
    });

    // Handle normal file selection
    fileInput.addEventListener('change', () => {
        $("#dropZone").removeClass("input-validation-error");
        document.getElementById('uploadStatus').innerHTML = "";
        uploadFiles(fileInput.files);
    });

    function uploadFiles(files) {
        const formData = new FormData();
        for (let i = 0; i < files.length; i++) {
            formData.append('files', files[i]);
        }
        $("#dropZone").removeClass("input-validation-error");
        fetch('@Url.Action("UploadImportFiles", "Transaction")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
            .then(data => {
                if (data.IsSuccess) {
                    //data.NewFileName
                    $("#hdnImportedFileName").val(data.NewFileName);
                    document.getElementById('uploadStatus').innerHTML =
                        `<p style="color:green;">${data.message}</p>`;
                    $("#btnStep1Next").click();
                }
                else {
                    document.getElementById('uploadStatus').innerHTML = `<p style="color:red;">Upload failed.</p>`;
                }
        })
        .catch(err => {
            document.getElementById('uploadStatus').innerHTML = `<p style="color:red;">Upload failed.</p>`;
        });
    }
