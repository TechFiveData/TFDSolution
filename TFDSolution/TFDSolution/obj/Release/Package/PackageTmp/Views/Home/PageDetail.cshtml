                                    @if (EnablePhotoUpload == "y")
                                    {
                                        string FileName = "NoImage", FilePath = ImagesBase + "Images/NoImage.png";
                                        <div class="row">
                                            <div class="container mt-4">
                                                @*<h2 class="mb-3">📷 Photo Gallery</h2>*@
                                                <!-- Upload Form -->
                                                <form id="uploadForm" enctype="multipart/form-data">
                                                    <div class="input-group mb-3 d-none">
                                                        <input type="file" id="fileInput" name="photo" class="form-control" accept="image/*" required />
                                                        <button id="uploadBtn" class="btn btn-primary" type="button">Upload</button>
                                                    </div>
                                                </form>
                                                <div id="imageModal" class="modal">
                                                    <span class="close">&times;</span>
                                                    <img class="modal-content" id="modalImage" style="margin-top: 0; max-width: 90%; max-height: 90%; border-radius: 8px;">
                                                </div>
                                                <div class="row">
                                                    @if (!string.IsNullOrEmpty(FileName))
                                                    {
                                                        <div class="image-container text-center mb-4" style="height:155px;">
                                                            <img id="mainImage" data-bind="@FileName" src="@FilePath" class="main-image shadow" />
                                                            <button class="btn-delete d-none" onclick="deleteImage()">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </div>

                                                        <!-- Thumbnails -->
                                                        <div class="thumbnail-strip">
                                                            <div id="fileList" class="thumbnail-strip"></div>
                                                        </div>
                                                        <div id="uploadResult"></div>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted">No photos uploaded yet.</p>
                                                    }
                                                </div>
                                                <script>
                                                            $(document).ready(function () {
                                                                BindPhotos();
                                                                $('#imageModal').click(function (e) {
                                                                    if (e.target.id == 'imageModal') {
                                                                        $(this).fadeOut();
                                                                    }
                                                                });
                                                                $("#mainImage").click(function () {
                                                                    var src = $(this).attr('src');
                                                                    var cacheBuster = new Date().getTime()
                                                                    $('#modalImage').attr('src', src + '?v=' + cacheBuster);
                                                                    $('#imageModal').fadeIn();
                                                                });

                                                                $("#fileInput").on("change", function () {
                                                                    if (this.files.length > 0) {
                                                                        // Trigger upload button click
                                                                        $("#uploadBtn").click();
                                                                    }
                                                                });
                                                                $('#imageModal .close').click(function () {
                                                                    $('#imageModal').fadeOut();
                                                                });
                                                                $("#uploadBtn").click(function () {
                                                                    try {
                                                                        var isValided = true;
                                                                        let fileInput = $("#fileInput")[0];
                                                                        let fileError = $("#fileError");
                                                                        fileError.text(""); // reset error

                                                                        // 1. Check file selected
                                                                        if (fileInput.files.length === 0) {
                                                                            e.preventDefault();
                                                                            $("#uploadResult").html("<p style='color:red;'>Please select a file.</p>");
                                                                            return false;
                                                                        }

                                                                        let file = fileInput.files[0];
                                                                        let fileName = file.name.toLowerCase();
                                                                        let fileSize = file.size;

                                                                        // 2. Allowed extensions
                                                                        let allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif)$/i;
                                                                        if (!allowedExtensions.exec(fileName)) {
                                                                            e.preventDefault();
                                                                            $("#uploadResult").html("<p style='color:red;'>Only JPG, JPEG, PNG, GIF files are allowed.</p>");
                                                                            return false;
                                                                        }

                                                                        // 3. File size limit (e.g. 2 MB)
                                                                        let maxSize = 5 * 1024 * 1024;
                                                                        if (fileSize > maxSize) {
                                                                            e.preventDefault();
                                                                            $("#uploadResult").html("<p style='color:red;'>File size must be less than 5 MB.</p>");
                                                                            return false;
                                                                        }

                                                                        var formData = new FormData();
                                                                        // append file
                                                                        /*var file = $("#fileInput")[0].files[0];*/
                                                                        if (file) {
                                                                            formData.append("file", file);
                                                                        }
                                                                        if (isValided)
                                                                        {
                                                                            // extra parameters
                                                                            formData.append("URNNo", $("#LabelURN").text());       // example userId
                                                                            formData.append("FormName", $("#hdnFormName").val());        // example categoryId
                                                                            formData.append("ParentFormName", '@Model.Design.ParentFormName');
                                                                            $.ajax({
                                                                                url: '@Url.Action("UploadPhoto", "Home")',
                                                                                type: 'POST',
                                                                                data: formData,
                                                                                processData: false, // Don't process the files
                                                                                contentType: false, // Set content type to false
                                                                                success: function (response) {
                                                                                    if (response.success) {
                                                                                        ShowToastNotification("success", "Photo uploaded successfully.");
                                                                                        BindPhotos();
                                                                                    } else {
                                                                                        ShowToastNotification("error", response.message);
                                                                                    }
                                                                                },
                                                                                error: function (xhr, status, error) {
                                                                                    ShowToastNotification("error", "Upload failed: " + error + "");
                                                                                }
                                                                            });
                                                                        }
                                                                    } catch (e) {

                                                                    }
                                                                });
                                                            })
                                                            function AddNewPhotoClick() {
                                                                $("#fileInput").click();
                                                            }
                                                            function deleteImage() {
                                                                if (confirm("Do you want to delete this image?")) {
                                                                    try {
                                                                        var prefix = $('#mainImage').attr('data-bind');
                                                                        $.ajax({
                                                                            url: '@Url.Action("DeletePhoto", "Home")',
                                                                            type: 'POST',
                                                                            data: { fileName: prefix, formName: $("#hdnFormName").val(), parentFormName: '@Model.Design.ParentFormName' },
                                                                            success: function (response) {
                                                                                if (response.success) {
                                                                                    ShowToastNotification("success", "Photo deleted successfully.");
                                                                                    BindPhotos();

                                                                                } else {
                                                                                    ShowToastNotification("error", response.message);
                                                                                }
                                                                            },
                                                                            error: function (xhr, status, error) {
                                                                                ShowToastNotification("error", "Delete failed: " + error + "");
                                                                            }
                                                                        });
                                                                    } catch (e) {

                                                                    }

                                                                }
                                                            }
                                                            function showImage(src, imgName) {
                                                                var cacheBuster = new Date().getTime()
                                                                $("#mainImage").attr("data-bind", imgName);
                                                                $("#mainImage").attr("src", src + '?v=' + cacheBuster);
                                                            }
                                                            function BindPhotos() {
                                                                try {
                                                                    var prefix = $("#LabelURN").text();
                                                                    var FormName = $("#hdnFormName").val();
                                                                    var ParentFormName = '@Model.Design.ParentFormName';
                                                                    $.ajax({
                                                                        url: '@Url.Action("GetFilesByPrefix", "Home")',
                                                                        type: 'GET',
                                                                        data: { prefix: prefix, formName: FormName, parentFormName: ParentFormName },
                                                                        success: function (files) {
                                                                            var $list = $("#fileList");
                                                                            $list.empty();
                                                                            if (files.length === 0) {
                                                                                if ('@Model.PageAction' != 'V')
                                                                                {
                                                                                    $("button.btn-delete").addClass("d-none");
                                                                                    $list.append(`<div class="file-item">
                                                                                            <a id="aAddNewPhoto" onclick="AddNewPhotoClick();" class="btn btn-primary" href="javascript:void(0)" title="Upload New Photo">
                                                                                                <i class="fa fa-plus-square"></i>
                                                                                            </a>
                                                                                        </div>`);
                                                                                }
                                                                                $("#mainImage").attr("src", '@ImagesBase' + "Images/NoImage.png");
                                                                            } else {
                                                                                $.each(files, function (index, fileName) {
                                                                                    // Assuming 'fileName' is the URL or relative path of the image
                                                                                    var fullPath = '@ImagesBase' + 'FileManager/' + ParentFormName + '/' + FormName + '/' + fileName ;
                                                                                    $list.append(`
                                                                                        <div class="file-item">
                                                                                            <img src="${fullPath}" data-bind="${fileName}" class="thumbnail" onclick="showImage('${fullPath}','${fileName}')" />
                                                                                        </div>
                                                                                    `);
                                                                                });
                                                                                $('#fileList .file-item img:first').click();
                                                                                if ('@Model.PageAction' != 'V')
                                                                                {
                                                                                    $("button.btn-delete").removeClass("d-none");
                                                                                    $list.append(`<div class="file-item">
                                                                                            <a id="aAddNewPhoto" onclick="AddNewPhotoClick();" class="btn btn-primary" href="javascript:void(0)" title="Upload New Photo">
                                                                                                <i class="fa fa-plus-square"></i>
                                                                                            </a>
                                                                                        </div>`);
                                                                                }
                                                                            }
                                                                        },
                                                                        error: function () {
                                                                            alert("Error fetching files.");
                                                                        }
                                                                    });
                                                                } catch (e) {

                                                                }
                                                            }
                                                </script>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            if (section.SectionName != "Header" && AllowBillOfMaterial == "y")
                            {
                                var tabId = "_tab";
                                detailtabCSS = "det-grid-right";
                                var Id = "_frm";
                                <div class="det-grid-left">
