    function ShowEInvoiceMessage(message, type) {
        if (!message || $.trim(message) === "") {
            $("#eInvoiceBillMessage")
                .addClass("d-none")
                .removeClass("alert-danger alert-success alert-warning")
                .html("");
            return;
        }
        var cssClass = "alert-warning";
        var icon = "fa-exclamation-triangle";
        var title = "Important";
        switch (type) {
            case "success":
                cssClass = "alert-success";
                icon = "fa-check-circle";
                title = "Success";
                break;

            case "error":
                cssClass = "alert-danger";
                icon = "fa-times-circle";
                title = "Error";
                break;

            case "warning":
                cssClass = "alert-warning";
                icon = "fa-exclamation-triangle";
                title = "Important";
                break;
        }
        $("#eInvoiceBillMessage")
            .removeClass("d-none alert-success alert-danger alert-warning")
            .addClass(cssClass)
            .html('<i class="fa ' + icon + ' mr-2"></i><strong>' + title + ':</strong> ' + message);
    }
