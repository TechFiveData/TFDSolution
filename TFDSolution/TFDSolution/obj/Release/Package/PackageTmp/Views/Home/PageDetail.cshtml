    function SaveBOMProcess() {
        try {
            var isFormValid = true;
            if ($.trim($("#ddlBOMProcess").val()).length == 0) {
                $("#ddlBOMProcess").addClass("input-validation-error");
                $("#ddlBOMProcess").after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please select Process</div>");
                if (isFormValid == true) {
                    $("#ddlBOMProcess").focus();
                }
                isFormValid = false;
            } else {
                $("#ddlBOMProcess").removeClass("input-validation-error");
            }
            if ($.trim($("#ddlBOMLocation").val()).length == 0) {
                $("#ddlBOMLocation").addClass("input-validation-error");
                $("#ddlBOMLocation").after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please select Location</div>");
                if (isFormValid == true) {
                    $("#ddlBOMLocation").focus();
                }
                isFormValid = false;
            } else {
                $("#ddlBOMLocation").removeClass("input-validation-error");
            }
            if (isFormValid) {
                var model = {
                    Id: $("#hdnBOMProcessId").val(),
                    ParentId: $("#hdnRecordId").val(),
                    QCEnable: $("#chkIsQCForm").prop('checked'),  // Pass record ID for update
                    ProcessId: $("#ddlBOMProcess").val(),
                    FormId: '@Model.Design.FormId',
                    LocationId: $("#ddlBOMLocation").val()
                }
                $.ajax({
                    type: "POST", url: '@Url.Action("SaveBOMProcess", "Home")',
                    contentType: "application/json;",
                    data: JSON.stringify(model),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            ShowToastNotification("success", response.Response)
                            $('#processModal').modal('hide');
                            $("#ddlBOMLocation").val('');
                            $("#ddlBOMProcess").val('');
                            $("#chkIsQCForm").prop('checked', false);
                            $("#btnCancelProcess").click();
                            BindBOMProcess(response.Id);
                        }
                        else {
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            }
        } catch (e) {

        }
    }
