<script type="text/javascript">
    function loadPageDropdown(_fieldId, dropdownId, fieldcap) {
        $.ajax({
            url: '@Url.Action("getFieldSelection", "Common")',
            type: 'GET',
            data: { fieldId: _fieldId },
            success: function (data) {
                /*$('#' + dropdownId + '_select-loader').hide();*/
                var dropdown = $('#' + dropdownId);
                var fieldvalue = $('#' + dropdownId).attr("data-interval");
                dropdown.empty().append('<option value="">Select ' + fieldcap + '</option>');
                var isData = false;
                $.each(data, function (i, item) {
                    isData = true;
                    if (fieldvalue != null && fieldvalue != "" && fieldvalue == item.Value) {
                        dropdown.append($('<option selected></option>').val(item.Value).text(item.Text));
                    }
                    else {
                        dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                    }
                });
                /*$('#' + dropdownId + '_select-loader').hide();*/
                /*$("#pageLoader").hide();*/
            },
            error: function () {
                //$('#' + dropdownId + '_select-loader').hide();
                //$("#pageLoader").hide();
                console.log("Error loading dropdown: " + fieldcap);
            }
        });
    }
    function BindGrid(tableName, tbId, sectionname, detailParentId)
    {
        if (sectionname != "Header") {
            var processId = 0;
            var isValid = true;
            var AllowBom = '@(!string.IsNullOrEmpty(AllowBillOfMaterial) ? AllowBillOfMaterial.ToString() : "n")';
            if (AllowBom == 'y') {
                processId = parseInt($("#hdnProcessId").val());
                //if (processId == 0) {
                //    isValid = false;
                //    /*ShowToastNotification("error", "Please select Process");*/
                //}
            }

            if (isValid) {
                $("#" + tableName).empty();
                $("#hdnSelectedTabId").val(tbId);
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("getPageTabData", "Home")",
                    contentType: "application/json; charset=utf-8",
                    skipLoading: true,
                    data: {
                        tabId: tbId,
                        ParentId: parseInt($("#hdnRecordId").val()),
                        ProcessId: processId,
                        DetailParentId: detailParentId
                    },
                    dataType: "json",
                    success: function (response) {
                        if (response != null) {
                            if (response.IsSuccess == false) {
                                ShowToastNotification("error", response.Response);
                            }
                            // Add Sp next Button value to the response //Neelima
                            //if (response.IsNextButtonStoreProcedure != "") {
                            //    $("#hdnNextProcedureValue").val(response.IsNextButtonStoreProcedure);
                            //    $("#nextProcedureBtn").show();
                            //} else {
                            //    $("#hdnNextProcedureValue").val("");
                            //    $("#nextProcedureBtn").hide();
                            //}
                            bindDataTable(response, tableName, tbId);
                        }
                    },
                    error: function (response) {
                        ShowToastNotification("error", "Error fetching data!");
                    }
                });
                setTimeout(() => {
                    const header = document.querySelector('th[aria-controls="' +tableName+'"]');
                    if (header) {
                        header.click();
                    }
                }, 300);
            }
        }
    }
    function BindInlinGrid(tableName, tbId, sectionname)
    {
        if (sectionname != "Header") {
            try {
                $("#hdnSelectedTabId").val(tbId);
                var processId = 0;
                var isValid = true;
                var AllowBom = '@(!string.IsNullOrEmpty(AllowBillOfMaterial) ? AllowBillOfMaterial.ToString() : "n")';
                if (AllowBom == 'y') {
                    processId = parseInt($("#hdnProcessId").val());
                }
                if (isValid) {
                    $("#hdnSelectedTabId").val(tbId);
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("getPageInlineTabData", "Home")",
                        contentType: "application/json; charset=utf-8",
                        data: {
                            tabId: tbId,
                            ParentId: parseInt($("#hdnRecordId").val(), 0),
                            ProcessId: processId,
                            FormId: $("#hdnFormId").val(),
                            SectionId: "2629A112-68DF-4660-A528-6B5D9041B5EB",
                            PageAction: '@Model.PageAction'  // ✅ Fix: use colon, not equals
                        },
                        success: function (response) {
                            if (response != null) {
                                $("#" + tableName).html(response);
                            }
                        },
                        error: function (response) {
                            console.log(response);
                            ShowToastNotification("error", "Error fetching data!");
                        }
                    });
                }
            } catch (e) {

            }
        }
    }
</script>
