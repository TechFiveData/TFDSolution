    function eWayBillGenerationSubmit() {
        try {
            ShowEWayBillMessage("","success");
            $.get('@Url.Action("eWayBillAuthentication", "EWayBill")')
                .done(function (response) {
                    if (!response) {
                        ShowEWayBillMessage("e-Way configuration not valid. Please train again.", "error");
                        ShowToastNotification("error", "Please try again.");
                        return;
                    }
                    if (!response.success) {
                        ShowEWayBillMessage(response.message, "error");
                        ShowToastNotification("error", response.message);
                        return;
                    }
                    var model = {
                        FormId: '@Model.Design.FormId',
                        ParentId: parseInt($("#hdnRecordId").val()) || 0,
                        sqlTableName: $("#hdnTableName").val()
                    };
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GenerateeWayBill", "EWayBill")",
                        data: JSON.stringify(model),
                        contentType: "application/json; charset=utf-8",
                        skipLoading: true,
                        success: function(result) {
                            if (!result) {
                                ShowEWayBillMessage("e-Way Bill not generated successfully. Please train again.", "error");
                                ShowToastNotification("error", "Please try again.");
                                return;
                            }

                            if (result.success) {
                                ShowEWayBillMessage("e-Way Bill has been generated. e-Way Bill#: " + result.data.EWayBillNumber + ", Valid Up To: " + result.data.ValidUpto, "success");
                                ShowToastNotification("success", "e-Way Bill has been successfully generated. e-Way Bill#:" + result.data.EWayBillNumber);
                                setTimeout(function() {
                                    ShowToastNotification("info", "The page will refresh in 3 seconds.");
                                    setTimeout(function() {
                                        location.reload();
                                    }, 3000);
                                }, 2000);
                                return;
                            }

                            if (result.data && result.data.error) {
                                var errorCode = result.data.error.error_cd || "";
                                var errorMessage = result.data.error.message || "Unknown error.";
                                ShowEWayBillMessage("(" + errorCode + "): " + errorMessage, "error");
                                ShowToastNotification("error", "Validation (" + errorCode + "): " + errorMessage);
                                return;
                            }
                            ShowEWayBillMessage("e-Way Bill not generated successfully. Please train again.", "error");
                            ShowToastNotification("error", "e-Way Bill was not generated. Please try again.");
                        },
                        error: function() {
                            ShowToastNotification("error", "Please try again.");
                            ShowEWayBillMessage("e-Way Bill not generated successfully. Please train again.", "error");
                        }
                    });
                })
            .fail(function () {
                ShowToastNotification("error", "Authentication request failed.");
            });
        }
        catch (e) {
            console.error(e);
            ShowToastNotification("error", "Please try again.");
        }
    }
