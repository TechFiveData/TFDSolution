@{
    string status = ViewBag.Status, statusName = "";
    string EWayBillNumber = "", EWayBillDate = "", EWayValidUpto = "", EWayBillCancelledDate = "";
    string eInvoiceAckNo = "", eInvoiceAckDate = "", eInvoiceIRN = "", eInvoiceStatus = "", eInvoiceCancelDate = "";
    string docNo = ViewBag.DocNo, docNoDB = ViewBag.DocNo;
    string currencyid = ViewBag.currenctyId;
    bool isStatusField = false;
    string urnNo = ViewBag.URNNo, CancelReason = "";
    string exchangeRate = "";
    DateTime docDate = DateTime.Today.Date;
    if (Model.Design.Data != null && Model.Design.Data.Count() > 0)
    {
        foreach (var item in Model.Design.Data.ToList())
        {
            if (item.ContainsKey("DocNo"))
            {
                docNo = Convert.ToString(item["DocNo"]);
                docNoDB = Convert.ToString(item["DocNo"]);
                if (item.ContainsKey("RevisionCount") && Convert.ToString(item["RevisionCount"]) != "0" && Convert.ToString(item["RevisionCount"]) != "")
                {
                    docNo = docNo + "(R" + Convert.ToString(item["RevisionCount"]) + ")";
                }
            }
            if (item.ContainsKey("eInvoiceIRN"))
            {
                eInvoiceIRN = Convert.ToString(item["eInvoiceIRN"]);
            }
            if (item.ContainsKey("eInvoiceCancelledDate"))
            {
                eInvoiceCancelDate = Convert.ToString(item["eInvoiceCancelledDate"]);
            }
            if (item.ContainsKey("eInvoiceStatus"))
            {
                eInvoiceStatus = Convert.ToString(item["eInvoiceStatus"]);
            }
            if (item.ContainsKey("eInvoiceAckNo"))
            {
                eInvoiceAckNo = Convert.ToString(item["eInvoiceAckNo"]);
            }
            if (item.ContainsKey("eInvoiceAckDate"))
            {
                eInvoiceAckDate = Convert.ToString(item["eInvoiceAckDate"]);
            }
            if (item.ContainsKey("EWayBillCancelledDate"))
            {
                EWayBillCancelledDate = Convert.ToString(item["EWayBillCancelledDate"]);
            }
            if (item.ContainsKey("EWayBillNumber"))
            {
                EWayBillNumber = Convert.ToString(item["EWayBillNumber"]);
            }
            if (item.ContainsKey("EWayBillDate"))
            {
                EWayBillDate = Convert.ToString(item["EWayBillDate"]);
            }
            if (item.ContainsKey("EWayValidUpto"))
            {
                EWayValidUpto = Convert.ToString(item["EWayValidUpto"]);
            }
            if (item.ContainsKey("StatusName"))
            {
                statusName = Convert.ToString(item["StatusName"]);
            }
            if (item.ContainsKey("URNNo"))
            {
                urnNo = Convert.ToString(item["URNNo"]);
            }
            if (item.ContainsKey("CancelReason"))
            {
                CancelReason = Convert.ToString(item["CancelReason"]);
            }
            if (item.ContainsKey("CurrencyId") && !string.IsNullOrEmpty(Convert.ToString(item["CurrencyId"])))
            {
                currencyid = Convert.ToString(item["CurrencyId"]);
            }
            if (item.ContainsKey("Status"))
            {
                isStatusField = true;
                status = Convert.ToString(item["Status"]);
            }
            if (item.ContainsKey("DocDate"))
            {
                docDate = Convert.ToDateTime(item["DocDate"]);
            }
            if (item.ContainsKey("ExchangeRate"))
            {
                exchangeRate = "₹" + Convert.ToString(item["ExchangeRate"]);
            }
        }
    }
}
<div id="divpageDetail" class="page-main animated fadeIn mypage">
    <div class="page-main-header">
        <div class="page-main-title">
            <span>
                @Model.Design.FormTitle
            </span>
        </div>
        <nav>
            <ol class="breadcrumb page-breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
                <li class="breadcrumb-item">@Model.Design.ParentFormTitle</li>
                <li class="breadcrumb-item"><a href="@Url.Action("MyPage","Home", new { @pagename = Model.Design.FormName})">@Model.Design.FormTitle</a></li>
                @if (Model.PageAction == "A")
                {
                    <li class="breadcrumb-item active">New @Model.Design.FormTitle</li>
                }
                else if (Model.PageAction == "E")
                {
                    <li class="breadcrumb-item active">Edit @Model.Design.FormTitle</li>
                }
                else
                {
                    <li class="breadcrumb-item active">View @Model.Design.FormTitle</li>
                }
            </ol>
        </nav>
    </div>
    <div class="page-main-container">
        <div class="page-main-card">
            <div class="page-main-card-header">
                <div class="page-main-card-title">
                    <!-- Previous / Current / Next -->
                    <div class="record-navigation d-flex align-items-center">
                        <button type="button" class="btn btn-sm" id="btnMainPrevious" title="Previous Record">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                        <span id="lblDocumentNo" class="fw-bold">1/10</span>
                        <button type="button" class="btn btn-sm" id="btnMainNext" title="Next Record">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                    </div>
                    <!-- Attachments -->
                    <button class="btn btn-sm" data-toggle="modal" data-target="#attachModal" onclick="OpenHeaderAttachments()"
                            title="Attachments" type="button">
                        <i class="fa fa-paperclip font16"></i>
                    </button>
                    <!-- Comments -->
                    <button class="btn btn-sm"
                            data-toggle="modal"
                            data-target="#showCommentsModel"
                            onclick="ShowComments()"
                            title="Comments"
                            type="button">
                        <i class="fa fa-comment-o font16"></i>
                    </button>
                </div>
                <div class="page-main-card-actions">
                    @if (status == "2" && (!string.IsNullOrEmpty(EnableEWayBill) && EnableEWayBill != "n"))
                    {
                        if (!string.IsNullOrEmpty(EWayBillNumber))
                        {
                            <a class="btn btn-sm" data-target="#eWayBillModal"
                               title="View e-Way Bill" data-toggle="modal"
                               href="javascript:void(0);"
                               onclick="eWayBillGeneration()">
                                <i class="fa fa-check-circle text-success mr-1"></i>
                                e-Way Bill
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm" data-toggle="modal"
                               title="Generate e-Way Bill" data-target="#eWayBillModal"
                               href="javascript:void(0);" onclick="eWayBillGeneration()">
                                <i class="fa fa-times-circle text-danger mr-1"></i>e-Way Bill
                            </a>
                        }
                    }
                    @if (status == "2" && (!string.IsNullOrEmpty(EnableEInvoiceBill) && EnableEInvoiceBill != "n"))
                    {
                        if (!string.IsNullOrEmpty(eInvoiceAckNo))
                        {
                            <a class="btn btn-sm" data-target="#eInvoicelModal"
                               title="View e-Invoice" data-toggle="modal"
                               href="javascript:void(0);"
                               onclick="eInvoiceBillGeneration()">
                                <i class="fa fa-check-circle text-success mr-1"></i>
                                e-Invoice
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm" data-toggle="modal"
                               title="Generate e-Invoice" data-target="#eInvoicelModal"
                               href="javascript:void(0);" onclick="eInvoiceBillGeneration()">
                                <i class="fa fa-times-circle text-danger mr-1"></i>e-Invoice
                            </a>
                        }
                    }
                    @if ((status == "6" || status == "2") && (Model.Design.SqlTemplateId == 2 || ((!string.IsNullOrEmpty(AllowBillOfMaterial) ? AllowBillOfMaterial.ToString() : "n") == "y")))
                    {
                        <button class="btn btn-sm" title="Amendment" onclick="CreateAmmendment()" type="button">
                            <i class="fa fa-code-fork font16"></i>
                        </button>
                    }
                    @if (Model.PageAction == "V")
                    {
                        <button class="btn btn-sm" title="Replicate" onclick="CreateReplica()" type="button">
                            <i class="fa fa-clone font16"></i>
                        </button>
                    }
                    @if (Model.PageAction == "V" && Model.Design.CanAdd == true)
                    {
                        <button class="btn btn-sm" title="New" onclick="AddNewRecord()" type="button"><i class="fa fa-plus font16"></i></button>
                    }
                    @if (((Model.PageAction == "E" || Model.PageAction == "A") || status == "2") && Model.Design.CanEdit == true)
                    {
                        @*<button class="btn btn-sm" disabled type="button"><i class="fa fa-pencil"></i>&nbsp; Edit</button>*@
                    }
                    else if ((status == "1" || (status == "7" && (statusName == "ApprovedNA" || statusName == "Not Approved"))) && Model.Design.CanEdit == true)
                    {
                        <button class="btn btn-sm" title="Edit" onclick="EditPageData()" type="button"><i class="fa fa-pencil font16"></i></button>
                    }
                    @if (Model.PageAction != "V" || status == "2")
                    {
                        @*<button class="btn btn-sm" disabled type="button"><i class="fa fa-trash"></i>&nbsp; Delete</button>*@
                    }
                    else if (status == "1" && Model.Design.CanDelete == true)
                    {
                        <button class="btn btn-sm" title="Delete" onclick="DeletePageData()" type="button"><i class="fa fa-trash font16"></i></button>
                    }
                    @if ((Model.PageAction == "V" || status == "2") && (Model.Design.CanEdit == true || Model.Design.CanAdd == true))
                    {
                        @*<button class="btn btn-sm" disabled type="button"><i class="fa fa-save"></i>&nbsp; Save</button>*@
                    }
                    else
                    {
                        if (Model.Design.CanEdit == true || Model.Design.CanAdd == true)
                        {
                            <button class="btn btn-sm" onclick="SavePageData()" type="button" title="Save Record"><i class="fa fa-save font16"></i></button>
                        }
                    }
                    @if ((Model.PageAction == "E" || Model.PageAction == "V") && Model.Design.CanEdit == true)
                    {
                        <a class="btn btn-sm" data-toggle='modal' title="Create Follow-Up" data-target='#followUpModal' href="*" onclick="LoadFollowUpModel()"><i class="fa fa-user-plus"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.PrimaryId) && ViewBag.PrimaryId != "0")
                    {
                        <a class="btn btn-sm" title="Click here to send email" onclick="openEmailModal();" href="javascript:void(0);">
                            <i class="fa fa-envelope-o font16"></i>
                        </a>
                    }
                    @if (Model.PageAction == "V" && Model.Design.CanPrint == true)
                    {
                        if (Model.Reports != null && Model.Reports.Count > 0)
                        {
                            <div class="dropdown report-print" style="display: inline-block;">
