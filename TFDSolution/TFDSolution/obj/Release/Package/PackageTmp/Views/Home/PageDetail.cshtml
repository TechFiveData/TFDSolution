                        <div class="col-sm-10">
                            <input type="email" class="form-control" id="emailTo" placeholder="Enter recipient email" required>
                        </div>
                    </div>
                    <div class="mb-1 row">
                        <label for="emailCc" class="col-sm-2 col-form-label">CC:</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control" id="emailCc" placeholder="Enter CC email">
                        </div>
                    </div>
                    <div class="mb-1 row">
                        <label for="emailCc" class="col-sm-2 col-form-label">BCC:</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control" id="emailBcc" placeholder="Enter BCC email">
                        </div>
                    </div>
                    <div class="mb-1 row">
                        <label for="emailSubject" class="col-sm-2 col-form-label">Subject:<span class="text-danger p-1">(*)</span></label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="emailSubject" placeholder="Enter subject" required>
                        </div>
                    </div>
                    <div class="mb-1">
                        <label for="emailMessage" class="form-label">Message:<span class="text-danger p-1">(*)</span></label>
                        <textarea class="form-control" id="emailMessage" rows="4" placeholder="Enter your message" required></textarea>
                    </div>
                    @if (Model.Reports != null && Model.Reports.Count > 0)
                    {
                        <div class="mb-1 row">
                            <label for="emailReport" class="col-sm-2 col-form-label">Report</label>
                            <div class="col-sm-10">
                                <select id="emailReport" class="form-select">
                                    @foreach (var item in Model.Reports)
                                    {
                                        <option value="@item.ReportId">@item.ReportTitle</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </form>
            </div>
            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" id="btnEmailCancel" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" form="emailForm" onclick="SendEmail();" class="btn btn-primary">Send Email</button>
            </div>
        </div>
    </div>
</div>
