                    selector: '.rowReorder',
                    dataSrc: 'RowIndex'
                },
                /*scrollY: '200'*/
                // 🚀 SUMMARY FOOTER
                footerCallback: function (row, data, start, end, display) {
                    if (hasSummary) {
                        let api = this.api();
                        // ✅ Safe numeric conversion
                        let num = function (val) {
                            if (val === null || val === undefined) return 0;
                            if (typeof val === 'string') {
                                val = 0;
                            }
                            val = parseFloat(val);
                            return isNaN(val) ? 0 : val;
                        };
                        // TOTAL label
                        $(api.column(0).footer()).html('<b>Summary</b>');
                        api.columns().every(function (idx) {
                            /* 🔹 1. Always skip fixed columns */
                            if (idx === 0 || idx === 1) return;

                            /* 🔹 2. Skip action/subview columns */
                            let offset = 1;

                            if (allowSubView === 'y') {
                                if ($("#hdnPageAction").val() !== "V" && $("#hdnCanEdit").val() === "True") {
                                    if (idx === 2 || idx === 3) return;
                                    offset = 3;
                                } else {
                                    if (idx === 2) return;
                                    offset = 2;
                                }
                            }
                            /* 🔹 3. Validate summary config safely */
                            let configIndex = idx - offset;
                            if (!columnNames[configIndex] || columnNames[configIndex].IsSummary !== true) {
                                return;
                            }
                            else {
                                // console.log("Count column index: " + configIndex);
                                // console.log("Count column : " + columnNames[configIndex].ColumnTitle);
                            }
                            /* 🔹 4. Calculate total */
                            try {
                                var decimalval = parseInt(columnNames[configIndex].FieldDecimal ?? "", 10);
                                c = isNaN(decimalval) ? 2 : decimalval;
                                if (columnNames[configIndex].ColumnTitle == "Amount"
                                    || columnNames[configIndex].ColumnName == "Amount") {
                                    let colData = api.rows().data().pluck('Amount').toArray();
                                    let total = colData.reduce((sum, v) => sum + num(v), 0);
                                    $(this.footer()).html(total.toFixed(decimalval));
                                }
                                else {
                                    let colData = this.data().toArray();
                                    if (!colData.length) return;
                                    try {
                                        //colData = JSON.parse(colData.replace(/'/g, '"'));
                                        let total = colData.reduce((sum, v) => {
                                            return sum + parseFloat(String(v).replace(/,/g, '')) || sum;
                                        }, 0);
                                        $(this.footer()).html(total ? total.toFixed(decimalval) : '0');
                                    } catch (e) {
                                        $(this.footer()).html('0');
                                    }
                                }
                            } catch (e) {
                                $(this.footer()).html('0');
                            }
                        });
                    }
