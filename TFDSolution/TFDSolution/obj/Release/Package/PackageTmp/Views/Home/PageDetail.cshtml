    //Populate Followup date & time seperatly
    function populateFollowUpDateTimeControls(fullDateTimeStr, controlPrefix) {
        if (!fullDateTimeStr || !controlPrefix) return;
        // Expected format: dd/MM/yyyy hh:mm AM/PM
        const match = fullDateTimeStr.match(/^(\d{2})\/(\d{2})\/(\d{4}) (\d{1,2}):(\d{2}) (AM|PM)$/i);
        if (match) {
            let [_, dd, MM, yyyy, hh, mm, period] = match;
            hh = parseInt(hh, 10);
            if (period.toUpperCase() === 'PM' && hh < 12) hh += 12;
            if (period.toUpperCase() === 'AM' && hh === 12) hh = 0;

            const datePart = `${yyyy}-${MM}-${dd}`; // "yyyy-MM-dd"
            const timePart = `${hh.toString().padStart(2, '0')}:${mm}`; // "HH:mm"

            $(`#${controlPrefix}_Date`).val(datePart);
            $(`#${controlPrefix}_Time`).val(timePart);
        } else {
            console.warn('Invalid date format:', fullDateTimeStr);
            ShowToastNotification("error", "Invalid date format:" + fullDateTimeStr);
        }
    }
