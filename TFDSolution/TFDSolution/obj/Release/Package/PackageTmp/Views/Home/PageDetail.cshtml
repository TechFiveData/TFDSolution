    function getMasterFieldData() {
        const PageFieldData = [];
        // helper function to push data
        function pushData($el, value, suffix = "") {
            const fieldId = $el.data("bind");
            if (fieldId) {
                PageFieldData.push({
                    FieldName: fieldId + suffix,
                    FieldValue: value
                });
            }
        }

        // inputs in HeaderTabs
        $("#HeaderTabs input").each(function () {
            const $el = $(this);
            const type = $el.attr("type");
            if (!$el.attr("id")) return;
            if (type === "checkbox" || type === "radio") {
                pushData($el, $el.is(":checked") ? "true" : "false");
            } else if (type !== "file") {
                pushData($el, $el.val());
            }
        });

        // inputs in DivTotal
        $("#DivTotal input").each(function () {
            const $el = $(this);
            if ($el.attr("id")) {
                pushData($el, $el.val());
            }
        });

        // selects in HeaderTabs
        $("#HeaderTabs select").each(function () {
            const $el = $(this);
            if (!$el.attr("id")) return;
            const isMultiSelection = $el.data("multiselection") === true || $el.data("multiselection") === "True";
            if (isMultiSelection) {
                const texts = $el.find("option:selected").map(function () {
                    return $(this).text();   // use .val() if IDs are needed instead
                }).get().join(",");

                pushData($el, texts);
                pushData($el, $el.val() ? $el.val().join(",") : "", "_Id");
            } else {
                if ($el.val() && $el.val() !== "0") {
                    pushData($el, $el.find("option:selected").text());
                }
                pushData($el, $el.val(), "_Id");
            }
        });

        // textareas in HeaderTabs
        $("#HeaderTabs textarea").each(function () {
            const $el = $(this);
            if ($el.attr("id")) {
                pushData($el, $el.val());
            }
        });

        // labels in HeaderTabs
        $("#HeaderTabs label").each(function () {
            const $el = $(this);
            if ($el.attr("id")) {
                pushData($el, $el.text());
            }
        });

        return PageFieldData;
    }
