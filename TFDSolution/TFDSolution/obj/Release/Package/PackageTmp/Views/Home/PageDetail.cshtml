                    && columnNames[i].ColumnName != "UpdatedOn" && columnNames[i].ColumnType != "Button"
                    /*&& columnNames[i].ColumnName.indexOf("Date") < 0*/
                ) {
                    if (columnNames[i].ColumnName.toLowerCase() == "amount") {
