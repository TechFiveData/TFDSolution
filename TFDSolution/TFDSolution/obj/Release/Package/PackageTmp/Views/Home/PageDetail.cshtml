        try {
            // Decode and convert to object
            const objData = JSON.parse(decodeURIComponent(rowData));
            const PageFieldData = Object.entries(objData).map(([key, value]) => ({
                FieldName: key,
                FieldValue: value
            }));

            $("#FieldButtonModelLabel").html(fieldcaption);

            var model = {
