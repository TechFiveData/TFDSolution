    // Save Inline Form row
    function InlineSaveRecord(rowData, tablename, detailId) {
        var isFormValid = true;
        try {
            var PageFieldData = [];
            var rownumber = "1";
            rowData.find("input").each(function () {
                var $input = $(this);
                var ctrlId = $input.attr("id");
                if (!ctrlId) return;
                var fieldId = $input.attr("data-bind");
                var fieldcap = $input.attr("data-html");
                var fieldValue = $input.val();
                var type = $input.prop("type");

                if (ctrlId == "ItemSrNo") {
                    rownumber = fieldValue;
                }

                // ✅ Fix datetime-local
                if (type === "datetime-local" && fieldValue && fieldValue.length === 16) {
                    fieldValue += ":00";
                }
                if (fieldId) { PageFieldData.push({FieldName: fieldId,FieldValue: fieldValue,FieldType: type}); }

                $input.next(".validation").remove();

                if ($input.prop('required') && $.trim(fieldValue).length == 0) {
                    $input.addClass("input-validation-error");
                    $input.after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");

                    if (isFormValid) {
                        $input.focus();
                    }
                    isFormValid = false;
                } else {
                    $input.removeClass("input-validation-error");
                }
            });
            rowData.find("textarea").each(function () {
                if ($(this).attr("id")) {
                    var fieldId = $(this).attr("data-bind");
                    var fieldcap = $(this).attr("data-html");
                    if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: $(this).val()
                        });
                    }
                    $(this).next(".validation").remove();
                    if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                        $(this).addClass("input-validation-error");
                        $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");
                        if (isFormValid == true) {
                            $(this).focus();
                        }
                        isFormValid = false;
                    } else {
                        $(this).removeClass("input-validation-error");
                    }
                }
            });
            rowData.find("select").each(function () {
                if ($(this).attr("id")) {
                    const fieldId = $(this).attr("data-bind");
