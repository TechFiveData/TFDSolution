                PageAction: '@Model.PageAction',  // ✅ Fix: use colon, not equals
                TemplateId: _templateId,
                ItemSrNo: objData.SrNo
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("PartialDetailButton", "Home")',
                contentType: "application/json;",
                data: JSON.stringify(model),
                skipLoading: true, // <-- Custom flag
