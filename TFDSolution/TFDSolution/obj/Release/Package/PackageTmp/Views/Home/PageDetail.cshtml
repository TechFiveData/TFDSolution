                    var $checkbox = $row.find('input[type="checkbox"]');
                    var IsValid = true;
                    if ($checkbox.length > 0) {
                        IsValid = $row.find('input[type="checkbox"]').is(':checked');
                    }
                    if (IsValid) {
                        var ReadingItem = [];
                        var _SrNo = 1;
                        var _RequireDim = "", _LowerLimit = "", _UpperLimit = "", _Parameter = "", _Reading = "";
                        var rownumber = "1";
                        $row.find("input").each(function () {
                            if ($(this).attr("id")) {
                                var ctrlId = $(this).attr("id");
                                var fieldId = $(this).attr("data-bind");
                                var fieldValue = "";
                                if ($(this).attr("type") === "checkbox") {
                                    fieldValue = $(this).prop("checked") ? 1 : 0;
                                }
                                else {
                                    fieldValue = $(this).val();
                                }
                                if (fieldId != undefined && fieldId != "" && fieldId.length > 0 && fieldId != "Select") {
                                    RowItem.push({ FieldName: fieldId, FieldValue: fieldValue });
                                    if (ctrlId == "ItemSrNo") {
                                        rownumber = $(this).val();
                                        _SrNo = rownumber;
                                    }
                                    if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                                        if (fieldId == "Reading") {
                                            _Reading = $(this).val();
                                        }
                                    }
                                }
                            }
                        });
                        $row.find("select").each(function () {
                            if ($(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                                //var ctrlId = $(this).attr("id");
                                //var fieldId = $(this).attr("data-bind");
                                //var fieldValue = $(this).val();
                                //if (fieldId != undefined && fieldId != "" && fieldId.length > 0) {
                                //    RowItem.push({ FieldName: fieldId, FieldValue: fieldValue });
                                //}
                                if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                                    var fieldId = $(this).attr("data-bind");
                                    if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                                        RowItem.push({
                                            FieldName: fieldId,
                                            FieldValue: $row.find("#" + $(this).attr("id") + "  option:selected").text()
                                        });
                                        var selectval = $(this).val();
                                        if ($(this).val() == null) {
                                            selectval = $row.find("#" + $(this).attr("id")).attr("data-interval");
                                        }
                                        RowItem.push({FieldName: fieldId + "_Id",FieldValue: selectval});
                                    }
                                }
                            }
                        });
                        $row.find("label").each(function () {
                            var fieldId = $(this).attr("data-bind");
                            if (fieldId != undefined && fieldId != "" && fieldId.length > 0) {
                                RowItem.push({ FieldName: fieldId, FieldValue: $(this).text() });
                                if (fieldId == "RequireDim") {
                                    _RequireDim = $(this).text();
                                }
                                else if (fieldId == "LowerLimit") {
                                    _LowerLimit = $(this).text();
                                }
                                else if (fieldId == "Parameter") {
                                    _Parameter = $(this).text();
                                }
                                else if (fieldId == "UpperLimit") {
                                    _UpperLimit = $(this).text();
                                }
                            }
