<script>

    $(document).ready(function () {

        /*
         * Action filter
         */

        $(".action-filter").on("click", function () {

            var filter = $(this).data("filter");

            $(".action-filter").removeClass("active");

            $(this).addClass("active");


            if (filter === "all") {

                $(".timeline-item").show();

            }
            else {

                $(".timeline-item").each(function () {

                    var action = $(this).data("action");

                    if (action === filter) {

                        $(this).show();

                    }
                    else {

                        $(this).hide();

                    }

                });

            }

        });

    });

</script>