                                                                                @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", @type = "datetime-local", data_content = field.FieldType, data_html = field.FieldCaption, data_bind = field.FieldName, @readonly = "readonly" })
                                                                            }
                                                                            else
