                        ShowToastNotification(
                            "error",
                            "Failed to save new sort order."
                        );
                    }
                });

            });
        } catch (e) {

        }
    }
    function openBOMProcess(event, ctrl, Id) {
        try {
            $("#btnProcessDelete").hide();
            $("#btnProcessEdit").hide();
            // Determine edit/delete permissions
            var isAllowEdit = ($("#txtStatus").val() === "1");
            // Show edit button if user can edit and not in view mode
            if ($("#hdnPageAction").val() !== "V" && $("#hdnCanEdit").val() === "True") {
                $("#btnProcessEdit")
                    .off("click") // remove any previous click bindings
                    .on("click", function () { EditBOMProcess(Id); })
                    .show();
            }
            // Show delete button if status allows and user can delete
            if (isAllowEdit && $("#hdnCanDelete").val() === "True") {
                $("#btnProcessDelete")
                    .off("click")
                    .on("click", function () { DeleteBOMProcess(Id); })
                    .show();
            }
            let processAction = document.querySelector('#ProcessAction');
            if (processAction) {
                // Show the div
                processAction.style.display = 'block';
                processAction.style.position = 'fixed';
                // Position near click
                processAction.style.left = event.pageX + 'px';
                processAction.style.top = event.pageY + 'px';
                // Optionally append to body (so it’s not clipped)
                document.body.appendChild(processAction);
            }
        } catch (e) {
            console.error(e);
        }
    }
