                var fieldtype = $(this).attr("data-content");
                var fieldcap = $(this).attr("data-html");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    if ($(this).attr("type") == "checkbox") {
                        var checkVal = ($(this).is(":checked") == true? "true": "false");
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: checkVal,
                            FieldType: $(this).attr("type"),
                        });
                    }
                    else if ($(this).attr("type") == "radio") {
                        var checkVal = ($(this).is(":checked") == true ? "true" : "false");
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: checkVal,
                            FieldType: $(this).attr("type"),
                        });
                    }
                    else if ($(this).attr("type") != "file") {
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: $(this).val(),
                            FieldType: $(this).attr("type"),
                        });
                    }
                }
                $(this).next(".validation").remove();
                if ($(this).prop('required') && $(this).attr("type") != "file" && $.trim($(this).val()).length == 0) {
                    $(this).addClass("input-validation-error");
                    $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap +"</div>");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
