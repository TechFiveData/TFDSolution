    function SavePageData() {
        var isFormValid = true, isAllowMultipleDoc = false;
        var multipleDocFieldName = "";
        var PageFieldData = [];
        $("#HeaderTabs input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var ctrlId = $(this).attr("id");
