                    type: "POST", url: '@Url.Action("SavePageData", "Home")',
                    contentType: "application/json;",
                    data: JSON.stringify(model),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            ShowToastNotification("success", "Row Number " + rownumber + " record has been saved successfully!");
