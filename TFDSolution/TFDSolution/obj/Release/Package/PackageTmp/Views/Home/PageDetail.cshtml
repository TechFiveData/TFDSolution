                                                            @if (totalDetailTabs > 1)
                                                            {
                                                                <a class="btn btn-sm btn-primary btnDefault @tabNextdis" onclick="PrevButton()" title="Click Here to Previous Tab" href="#"><i class="fa fa-chevron-left"></i></a>
                                                                <a class="btn btn-sm btn-primary btnDefault @tabLastdis" onclick="NextButton('@tab.NextTabDataScript')" style="margin: 0 3px;" title="Click Here to Next Tab" href="#"><i class="fa fa-chevron-right"></i></a>
                                                            }
                                                            <a class="btn btn-sm btn-primary btn-add" href="javascript:void(0);" onclick="OpenImportModal('@tab.TabTitle','@tab.FormTabId','@tabName')" data-target='#importModal' data-toggle='modal' title="Import @tab.TabTitle Data"><i class="fa fa-upload"></i></a>
                                                            <a class="btn btn-sm btn-primary btn-add" href="javascript:void(0);" onclick="ExportTabData('@tab.TabTitle','@tab.FormTabId','@tabName','excel')" title="Export @tab.TabTitle Data"><i class="fa fa-download"></i></a>
                                                            @if (isInlineForm == false)
                                                            {
                                                                <a onclick="ActionTabData(0,'A','@tab.FormTabId',0);" class="btn btn-sm btn-primary btn-add" title="Add New @tab.TabTitle" style="font-size:9px;" data-toggle='modal' data-target='#tabModal' href="javacript:void(0);"><i class="fa fa-plus"></i></a>
                                                            }
                                                            else
                                                            {
                                                                <a onclick="InlinTabData(0,'A','@tab.FormTabId','@tabGrid');" class="btn btn-sm btn-primary btnDefault" title="Add New @tab.TabTitle" style="font-size:9px;" href="javacript:void(0);"><i class="fa fa-plus"></i></a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else if (Model.PageAction == "V")
                                                {
                                                    <div class="row">
                                                        <div class="col col-md-12 text-right form-group">
                                                            <!--  RIGHT SIDE → DOWNLOAD -->
                                                            <div>
                                                                <a class="btn btn-sm btn-primary btn-add"
                                                                   href="javascript:void(0);"
                                                                   onclick="ExportTabData('@tab.TabTitle','@tab.FormTabId','@tabName','excel')"
                                                                   title="Export @tab.TabTitle Data">
                                                                    <i class="fa fa-download"></i>
                                                                </a>
                                                            </div>

                                                        </div>
                                                    </div>
                                                }
                                                else if (totalDetailTabs > 1)
                                                {
                                                    <div class="row">
                                                        <div class="col col-md-12 text-right form-group">
                                                            <a class="btn btn-sm btn-primary btn-add btn-danger btn-multidelete error"
                                                               href="javascript:void(0);"
                                                               title="Delete @tab.TabTitle Data">
                                                                <i class="fa fa-trash"></i>
                                                            </a>
                                                            <a class="btn btn-sm btn-primary btn-add @tabNextdis" onclick="PrevButton()" title="Click Here to Previous Tab" href="#"><i class="fa fa-chevron-left"></i></a>
                                                            <a class="btn btn-sm btn-primary btn-add @tabLastdis" onclick="NextButton('@tab.NextTabDataScript')" style="margin: 0 3px;" title="Click Here to Next Tab" href="#"><i class="fa fa-chevron-right"></i></a>
                                                        </div>
                                                    </div>
                                                }
                                                <input id="@hdntab" type="hidden" value="@tab.TabSQLTableName" />
                                                <div class="row form-group">
                                                    <div class="col col-md-12" style="overflow-x:auto;">
                                                        @if (tab.Fields != null && tab.Fields.Count > 0)
                                                        {
                                                            if (isInlineForm)
                                                            {
                                                                <div class="InlineTable" data-bind="@tab.FormTabId" id="@tabInlineGrid">

                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                if (!string.IsNullOrEmpty(ViewBag.PrimaryId))
                                                                {
                                                                    <table id="@tabGrid" data-bind="@tab.FormTabId" class="display cell-border nowrap" cellspacing="0" width="100%"></table>
                                                                }
                                                                else
                                                                {
                                                                    <table id="@tabGrid" data-bind="@tab.FormTabId" class="display cell-border nowrap" cellspacing="0" width="100%">
                                                                        <thead>
                                                                            <tr>
                                                                                @foreach (var field in tab.Fields.OrderBy(x => x.SortOrder).ToList())
                                                                                {
                                                                                    <th>@field.FieldCaption</th>
                                                                                }
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                        </tbody>
                                                                    </table>
                                                                    <script type="text/javascript">
                                                                                new DataTable('#@tabGrid', { searching: false, paging: false, info: false });
                                                                    </script>
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p>No fields available.</p>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        firstRow = firstRow + 1;
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p>No tabs available in this section.</p>
                        }
                    </div>
                }
            }
            else
            {
                <p>No sections available.</p>
            }
            @if (Model.Design.SqlTemplateId == 2 && AllowOtherCharges == "y")
            {
                <div id="DivTotal" style="padding-top: 10px !important;"></div>
            }
        </div>
    </div>
</div>

