    function loadDropdown(_fieldId, dropdownId, fieldcap) {
        try {
            var sourceType = $("#" + dropdownId).attr("data-sourcetype");
            if (sourceType == "StoredProcedure") {
                var fieldname = $("#" + dropdownId).attr('id') + "_Id";
                /*console.log("Load Stored Procedure Bind for " + fieldname);*/
                BindHeaderDependencyData(fieldname, true);
            }
            else {
                $.ajax({
                    url: '@Url.Action("getFieldSelection", "Common")',
                    type: 'GET',
                    data: { fieldId: _fieldId },
                    cache: true,
                    success: function (data) {
                        var dropdown = $('#' + dropdownId);
                        var fieldvalue = $('#' + dropdownId).attr("data-interval");
                        dropdown.empty().append('<option value="">Select ' + fieldcap + '</option>');
                        $.each(data, function (i, item) {
                            if (fieldvalue != null && fieldvalue != "" && fieldvalue == item.Value) {
                                var isMultiSelection = $('#' + dropdownId).attr("data-multiselection");
                                if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                    var values = fieldvalue.split(",");
                                    dropdown.append($('<option selected></option>').val(values).text(item.Text));
                                }
                                else {
                                    dropdown.append($('<option selected></option>').val(item.Value).text(item.Text));
                                }
                            }
                            else {
                                dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                            }
                        });
                        var isMultiSelection = $('#' + dropdownId).attr("data-multiselection");
                        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                            var values = fieldvalue.split(",");
                            $('#' + dropdownId).val(values);
                        }
                        BindHeaderDependencyData(dropdownId + "_Id", true);
                        $("#pageLoader").hide();
                    },
                    error: function () {
                        $("#pageLoader").hide();
                        console.log("Error loading dropdown: " + fieldcap);
                    }
                });
            }
        } catch (e) {
            console.error("Select2 AJAX Error:", e);

        }
    }
