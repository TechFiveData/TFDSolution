    function DeleteOtherCharges(chargesId) {
        customConfirm({
            message: "Are you sure you want to delete this record?",
            type: "delete", // success | warning | delete
            title: "delete Confirmation"
        }, function (result) {
            if (result) {
                    $.get('@Url.Action("DeleteOtherCharges", "Configuration")', { chargesId: chargesId }, function (data) {
                        if (data != null && data.IsSuccess) {
                            ShowToastNotification("success", "Record has been deleted successfully!");
                            $('#tblOtherCharges').DataTable().destroy();
                            $('#tblOtherCharges tbody').empty();
                            BindCharges();
                        }
                    }).fail(function () {
                        // Error callback if the request fails

                    });
                }
            });
    }
    function EditOtherCharges(chargesId) {
        CleanDetailPopup();
        CleanPopup();
        $.get('@Url.Action("GetOtherChargeDetails", "Configuration")', { chargesId: chargesId }, function (data) {
            if (data != null) {
                $("#txtDescription").val(data.Description);
                $("#txtShortName").val(data.ShortName);
                $("#ddlChargesType").val(data.ChargesTypeId);
                $("#ddlTaxSlab").val(data.TaxSlabId);
                $("#ddlLedger").val(data.LedgerId);
                $("#ddlForms").val(data.FormId);
                /*$("#ddlLedger").val(data.LedgerId).trigger('change');*/
                if (data.LedgerId > 0) {
                    var items = $('#ddlLedger option').map(function () {
                        return { value: this.value, text: $(this).text() };
                    }).get();

                    let item = items.find(x => x.value == data.LedgerId);
                    if (item) {
                        let option = new Option(item.text, item.value, true, true);
                        $('#ddlLedger').append(option);
                    }
                }
                if (data.MultipleFormId != null && data.MultipleFormId != "") {
                    var ddl = $('#ddlMultiForms');
                    // clear all old options
                    ddl.empty();
                    // clone original dropdown options
                    var addedText = [];
                    $('#ddlForms option').each(function () {
                        var text = $(this).text().trim();
                        // skip duplicate text
                        if (!addedText.includes(text)) {
                            addedText.push(text);
                            ddl.append(
                                $('<option>', {
                                    value: $(this).val(),
                                    text: text
                                })
                            );
                        }
                    });
                    // set selected values
                    if (data.MultipleFormId != null && data.MultipleFormId != "") {
                        // remove duplicate selected values
                        var arr = [...new Set(
                            data.MultipleFormId
                                .split(',')
                                .map(v => v.trim())
                        )];

                        ddl.val(arr);
                    }

                    // refresh select2
                    ddl.trigger('change');
                }
                $("#hgnChargesId").val(data.ChargesId);
                BindDetailGrid();
                $("#tblDetails tbody tr").remove();
                if (data.Details != null && data.Details.length > 0) {
                    var table = document.getElementById("tblDetails"); //get the table
                    data.Details.forEach((item) => {
                        var rowcount = table.rows.length; //get no. of rows in the table
                        var tblRow = '<tr id="row' + item.SrNo + '" data-bind=' + item.OtherChargesDetailId +'>' +
                            '<td><a href="#" data-toggle="modal" data-target="#DetailModal" onclick="EditDetailRow(' + item.SrNo + ');" title="Edit Record">Edit</a>&nbsp;|&nbsp;<a href="#" onclick="DeleteDetailRow(' + item.SrNo + ');" title="Delete Record">Delete</a></td>' +
                            '<td data-bind="rownumber" data-content=' + item.SrNo + '>' + item.SrNo + '</td>' +
                            '<td data-bind="txtAlias" data-content="' + htmlEncode(item.Alias) + '">' + item.Alias + '</td>' +
                            '<td data-bind="txtTaxChargeName" data-content="' + htmlEncode(item.TaxChargeName) + '">' + displayBlank(item.TaxChargeName) + '</td>' +
                        //'<td data-bind="ddlLedgerDet" data-content=' + item.LedgerId + '>' + $("#ddlLedgerDet option:selected").text() + '</td>' +
                            '<td data-bind="ddlLedgerDet" data-content=' + item.LedgerId + '>' + displayBlank(item.LedgerIdName) + '</td>' +
                            '<td data-bind="ddlPerAmount" data-content=' + item.PerAmount + '>' + item.PerAmount + '</td>' +
                            '<td data-bind="ddlBasedOn" data-content=' + item.BasedOn + '>' + item.BasedOn + '</td>' +
                            '<td data-bind="txtValue" data-content=' + item.ChargesValue + '>' + item.ChargesValue + '</td>' +
                            '<td data-bind="txtFormula" data-content=' + item.Formula + '>' + item.Formula + '</td>' +//ddlEffect
                            '<td data-bind="txtDecimalPoint" data-content=' + item.DecimalPoint + '>' + item.DecimalPoint + '</td>' +//DecimalPoint
                            '<td data-bind="ddlEffect" data-content=' + item.Effect + '>' + item.Effect + '</td>' +
                            '<td data-bind="chkChangeValue" data-content=' + item.ChangeValue + '>' + (item.ChangeValue == true ? '<span class="fa fa-check text-success"></span>' : '<span class="fa fa-remove text-danger"></span>') + '</td>' +
                            '<td data-bind="chkAddInCost" data-content=' + item.AddInCost + '>' + (item.AddInCost == true ? '<span class="fa fa-check text-success"></span>' : '<span class="fa fa-remove text-danger"></span>') + '</td>' +
                            '<td data-bind="chkIsDisplayOnItemsPopup" data-content=' + item.IsDisplayOnItemsPopup + '>' + (item.IsDisplayOnItemsPopup == true ? '<span class="fa fa-check text-success"></span>' : '<span class="fa fa-remove text-danger"></span>') + '</td>' +
                            '</tr>'
                        $("#tblDetails").append(tblRow);
                    });

                }
                var myModal = new bootstrap.Modal(document.getElementById('editModal'));
                myModal.show();
            }
        }).fail(function () {
            // Error callback if the request fails

        });
    }
    function displayBlank(val) {
        return (val === null || val === undefined || val === '' || val === 'null')
            ? ''
            : val;
    }
    function SuccessBindGrid(dataset) {
        dataset = Array.isArray(dataset) ? dataset : [];
        // Initialize DataTable
        let formTable = new DataTable("#tblOtherCharges", {
            "destroy": true,
            searching: true,
            paging: true,
            scrollCollapse: true,
            scrollX: true,
            scrollY: true,
            info: true,
            // scrollY: '500px',
            data: dataset,
            select: true,
            lengthMenu: [10, 25, 50, 100, 200],
            pageLength: 25,
            columns: [
                {
                    title: '',
                    /*className: "grid-action-item",*/
                    render: function (data, type, row, meta) {
                        return "<a title='Edit Record' data-toggle='modal' data-target='#reportModal' onclick='EditOtherCharges(\"" + row.ChargesId + "\")' href='javascript:void(0)'><i class='fa fa-pencil'></i></a> &nbsp;|&nbsp; <a title='Delete Record' onclick='DeleteOtherCharges(\"" + row.ChargesId + "\")' href='javascript:void(0)';><i class='fa fa-trash text-danger'></i></a>";
                    },
                },
                {
                    orderable: false, // disable sorting for all columns
                    title: "Status",
                    className: 'dt-center actions',
                    defaultContent: '<button class="dropdown">Action</button>',
                    orderable: true,
                    render: function (data, type, row, meta) {
                        return '<button class="dropdown" data-bind=' + row["Status"] + ' data-interval=' + row["ChargesId"] + ' data-content=' + row["ChargesId"] + ' >' + DisplayStatus(row["Status"]) + '</button>';
                    },
                },
                { title: "Description", data: "Description" },
                { title: "Short Name", data: "ShortName" },
                { title: "Tax Slab", data: "TaxSlab" },
                { title: "Charges Type", data: "ChargesType" },
            ],
            language: {
                emptyTable: "No records found", // Message when no data is available
                zeroRecords: "No matching records found"
            }
        });
        let actions = document.querySelector('#actions');
        formTable.on('click', 'button.dropdown', function (e) {
            e.stopPropagation();
            $("#actions").hide();
            // Display and position the dropdown
            var currectStatus = $(this).attr("data-bind");
            var recordId = $(this).attr("data-content");
            var ParentId = $(this).attr("data-interval");
            $("#btnApproved").attr("data-content", recordId);
            $("#btnNotApproved").attr("data-content", recordId);
            $("#btnCancelled").attr("data-content", recordId);
            if (currectStatus == "1") {
                $("#btnNotApproved").hide();
                $("#btnApproved").show();
                $("#btnCancelled").show();
            }
            else if (currectStatus == "2") {
                $("#btnNotApproved").show();
                $("#btnApproved").hide();
                $("#btnCancelled").show();
            }
            else if (currectStatus == "3") {
                $("#btnNotApproved").show();
                $("#btnApproved").show();
                $("#btnCancelled").hide();
            }
            // $("#btnCancelledDet").show();
            // $("#btnCancelledDet").attr("data-container", $('#' + tblId).attr("data-content"));
            // $("#btnCancelledDet").attr("data-bind", currectStatus);
            // $("#btnCancelledDet").attr("data-content", recordId);
            // $("#btnCancelledDet").attr("data-interval", ParentId);
            const currentOffsetLeft = e.pageX;
            const currentOffsetTop = e.pageX;// + e.offsetHeight - 5;
            if (actions != null) {
                this.parentNode.append(actions);
                if (actions.style != null) {
                    actions.style.display = 'block';
                    //actions.style.right = this.offsetLeft + 'px';
                }
            }
            // Remove with the next click on the document
            document.addEventListener('click', function () {
                if (actions != null) {
                    actions.remove();
                }
            });
        });
    }
    function SaveOtherCharges() {
        try {
            var isFormValid = true;
            if ($.trim($("#txtDescription").val()).length == 0) {
                $("#txtDescription").addClass("input-validation-error");
                $("#txtDescription").focus();
                isFormValid = false;
            }
            if ($.trim($("#txtShortName").val()).length == 0) {
                $("#txtShortName").addClass("input-validation-error");
                isFormValid = false;
            }
            //if ($.trim($("#ddlForms").val()).length == 0) {
            //    $("#ddlForms").addClass("input-validation-error");
            //    isFormValid = false;
            //}
            //var multiText = $("#ddlMultiForms").val().join(',');
            if ($.trim($("#ddlMultiForms").val()).length == 0) {
                $("#ddlMultiForms").addClass("input-validation-error");
                isFormValid = false;
            }
            if ($.trim($("#ddlLedger").val()).length == 0) {
                $("#ddlLedger").addClass("input-validation-error");
                if (isFormValid) {
                    $("#ddlLedger").focus();
                }
                isFormValid = false;
            }
            if (isFormValid) {
                var _detail = [];
                $('#tblDetails tbody>tr').each(function () {
                    if ($(this) != null && $(this).attr("id") != null && $(this).attr("id").length > 0) {
                        var _SrNo = 0, _LedgerId = 0;
                        var _OtherChargesDetailId = parseInt($(this).attr("data-bind"));
                        var _Alias = "", _TaxChargeName = "", _Formula = "", _ChargesValue = "", _PerAmount = "", _BasedOn = "", _Effect = "", _DecimalPoint = 0;
                        var _ChangeValue = "", _AddInCost = "", _IsDisplayOnItemsPopup = "";
                        $('td', this).each(function () {
                            if ($(this).attr("data-bind") != null && $(this).attr("data-bind").length > 0) {
                                if ($(this) != null && $(this).attr("data-bind").indexOf("chk") != -1) {
                                    if ($(this).attr("data-bind") == "chkChangeValue") {
                                        _ChangeValue = $(this).attr("data-content");
                                    }
                                    if ($(this).attr("data-bind") == "chkAddInCost") {
                                        _AddInCost = $(this).attr("data-content");
                                    }
                                    if ($(this).attr("data-bind") == "chkIsDisplayOnItemsPopup") {
                                        _IsDisplayOnItemsPopup = $(this).attr("data-content");
                                    }                                    
                                }
                                else if ($(this).attr("data-bind").indexOf("ddl") != -1) {
                                    if ($(this).attr("data-bind") == "ddlLedgerDet") {
                                        _LedgerId = parseInt($(this).attr("data-content"));
                                    }
                                    else if ($(this).attr("data-bind") == "ddlPerAmount") {
                                        _PerAmount = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "ddlBasedOn") {
                                        _BasedOn = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "ddlEffect") {
                                        _Effect = $(this).attr("data-content");
                                    }
                                }
                                else {
                                    if ($(this).attr("data-bind") == "txtAlias") {
                                        _Alias = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "txtTaxChargeName") {
                                        _TaxChargeName = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "rownumber") {
                                        _SrNo = parseInt($(this).attr("data-content"));
                                    }
                                    else if ($(this).attr("data-bind") == "txtFormula") {
                                        _Formula = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "txtDecimalPoint") {
                                        _DecimalPoint = $(this).attr("data-content");
                                    }
                                    else if ($(this).attr("data-bind") == "txtValue") {
                                        _ChargesValue = $(this).attr("data-content");
                                    }
                                }
                            }
                        });
                        _detail.push({
                            ChargesId: $("#hgnChargesId").val(),
                            OtherChargesDetailId: _OtherChargesDetailId,
                            SrNo: _SrNo,
                            Alias: _Alias,
                            TaxChargeName: _TaxChargeName,
                            LedgerId: _LedgerId,
                            PerAmount: _PerAmount,
                            BasedOn: _BasedOn,
                            ChargesValue: _ChargesValue,
                            Formula: _Formula,
                            DecimalPoint: _DecimalPoint,
                            Effect: _Effect,
                            ChangeValue: (_ChangeValue == "true" ? true : false),
                            AddInCost: (_AddInCost == "true" ? true : false),
                            IsDisplayOnItemsPopup: (_IsDisplayOnItemsPopup == "true" ? true : false),
                        });
                    }
                });

                if (_detail != null && _detail.length > 0) {
                    var _model = {
                        TaxSlabId: $("#ddlTaxSlab").val(),
                        ChargesTypeId: $("#ddlChargesType").val(),
                        ChargesId: $("#hgnChargesId").val(),
                        FormId: $("#ddlForms").val(),
                        ShortName: $("#txtShortName").val(),
                        Description: $("#txtDescription").val(),
                        LedgerId: $("#ddlLedger").val(),
                        Details: _detail,
                        MultipleFormId: $("#ddlMultiForms").val().join(',')
                    };

                    $.ajax({
                        type: "POST", url: '@Url.Action("SaveOtherCharges", "Configuration")',
                        contentType: "application/json;",
                        data: JSON.stringify(_model),
                        async: false,
                        success: function (response) {
                            if (response.IsSuccess) {
                                $("#hgnChargesId").val(0);
                                ShowToastNotification("success", "Record saved successfully.")
                                $("#btnCancel").click();
                                $('#tblOtherCharges').DataTable().destroy();
                                $('#tblOtherCharges tbody').empty();
                                BindCharges();
                            }
                            else {
                                ShowToastNotification("error", response.Response);
                            }
                        },
                        failure: function (response) { },
                        error: function (response) { }
                    });
                }
                else {
                    ShowToastNotification("error", "Please enter at least item.");
                }
            }
            else {
                ShowToastNotification("error", "Please select/enter required field.");
            }
        } catch (e) {
            alert(e);
        }
    }
</script>
