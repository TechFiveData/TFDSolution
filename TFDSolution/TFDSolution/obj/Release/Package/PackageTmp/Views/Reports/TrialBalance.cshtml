
@{
    ViewBag.Title = "Trial Balance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .dropdown-menu-right {
        right: 0 !important;
        left: auto !important;
        min-width: 250px;
        margin-top: 34px !important;
        transform: none !important;
    }

    .dropdown-item {
        width: 100%;
        white-space: normal;
        overflow-wrap: break-word;
    }
</style>
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Trial Balance</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li>Statutary Reports</li>
                    <li>Accounts</li>
                    <li class="active">Trial Balance</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    <div class="row m-0">
        <div class="col-md-12 p-0">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-12 text-right">
                        <label id="lblExportNotification" style="padding-top: 6px;color: crimson;display:none;float:left;">Report export in progress. Please wait...</label>
                        <a class="btn btn-sm" id="btnExportCsv" href="javascript:void(0);"><i class="fa fa-file-excel-o"></i>&nbsp; Excel</a>
                        @*<a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-file-pdf-o"></i>&nbsp; PDF</a>*@
                        @if (ViewBag.ReportSelection != null)
                        {
                            List<TFDSolution.Transport.Master.ReportMast> reports = ViewBag.ReportSelection as List<TFDSolution.Transport.Master.ReportMast>;
                            if (reports != null && reports.Count > 0)
                            {
                                <div class="dropdown" style="float:right; position:relative;">
                                    <button class="btn btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-print font16"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuButton">
                                        @foreach (var item in reports)
                                        {
                                            <a class="dropdown-item" onclick="openSystemReport(@item.ReportId);" href="#">@item.ReportTitle</a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 form-group reportfilter">
                            <div class="d-inline-block pr-3 pb-2">
                                <label class="form-control-label mr-2">From Date</label>
                                <input id="dtFromDate" type="date" class="form-control d-inline-block w-auto myDate" />
                            </div>
                            <div class="d-inline-block pr-3 pb-2">
                                <label class="form-control-label mr-2">To Date</label>
                                <input id="dtToDate" type="date" class="form-control d-inline-block w-auto myDate" />
                            </div>
                            <!-- Dropdown -->
                            <div class="d-inline-block pr-3 pb-2">
                                <label class="form-control-label mr-2">Report Type</label>
                                <select id="ddlReportType" class="form-select d-inline-block w-auto" style="min-width:120px;">
                                    <option value="ALL">ALL</option>
                                    <option value="GROUP">Group</option>
                                    <option value="LEDGER">Ledger</option>
                                </select>
                            </div>
                            <button id="btnGenerate" class="btn btn-primary btn-Generate">Generate</button>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <table id="tblDataReportView" class="display cell-border nowrap dataTable-white-rows" cellspacing="0" width="100%"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function openSystemReport(_ReportId) {
        try {
            var SpecificationField = [];
            SpecificationField.push({ FieldName: "RequestAccountId",FieldValue: $("#ddlLedger").val() });
            SpecificationField.push({ FieldName: "RequestFromDate",FieldValue: $("#dtFromDate").val() });
            SpecificationField.push({ FieldName: "RequestToDate", FieldValue: $("#dtToDate").val() });
            $.ajax({
                url: '@Url.Action("OpenSystemReportView", "Reports")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    ReportId: _ReportId,
                    TableName: "t_TrialBalance_Hist",
                    reportParameters: SpecificationField
                }),
                success: function (response) {
                    if (response != null && response.IsSuccess) {
                        var basepath = '@Url.Content("~/ExportReport/")';
                        basepath = basepath + response.Response;
                        window.open(basepath, "_blank");
                        ShowToastNotification("success", "Report has been exported successfully.");
                    }
                    else {
                        ShowToastNotification("error", response.Response);
                    }
                },
                error: function () {

                    ShowToastNotification("error", "Error occurred.");
                }
            });
        } catch (e) {
            console.log(e);
            ShowToastNotification("error", "An error occurred while exporting the report. Please try again.");
        }
    }
    $(document).ready(function () {
        let today = new Date();
        // First day of current month
        let year = today.getFullYear();
        let month = today.getMonth();

        let firstDay = (month >= 3) ? new Date(year, 3, 1) : new Date(year - 1, 3, 1);
        firstDay.setMinutes(firstDay.getMinutes() - firstDay.getTimezoneOffset());
        let formatted = firstDay.toISOString().split('T')[0];
        // Format yyyy-MM-dd (required for type="date")
        let formatDate = (d) => d.toISOString().split('T')[0];
        $("#dtFromDate").val(formatDate(firstDay));
        $("#dtToDate").val(formatDate(today));
        $("#btnExportCsv").addClass("disabled");
        ReportLoadPagination();
        $("#btnGenerate").click(function () {
          ReportLoadPagination();
        })
        $('#btnExportCsv').on('click', function () {
            try {
                 var requestModel = {
                     FromDate: $("#dtFromDate").val(),
                     ToDate: $("#dtToDate").val(),
                 };
                $("#btnExportCsv").addClass("disabled");
                $("#lblExportNotification").show();
                $("#btnExportCsv").attr("title", "Report is exporting. Please wait..")
                ShowToastNotification("info", "Report is downloading... Please wait.");
                $.ajax({
                    url: "@Url.Action("ExportTrialBalanceReport", "Reports")",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(requestModel),
                    skipLoading: true,
                    beforeSend: function () {
                        $('#btnDownloadCsv').text('Preparing...').prop('disabled', true);
                    },
                    success: function (response) {
                        if (response != null && response != null && response.IsSuccess) {
                            //ShowToastNotification("success", response.Response);
                            // Poll every 5 seconds to check export completion
                            let pollInterval = setInterval(function () {
                                $.ajax({
                                    url: '@Url.Action("CheckExportStatus", "Reports")',
                                    type: 'GET',
                                    async: true,
                                    skipLoading: true,
                                    data: { fileName: response.Action },
                                    success: function (res) {
                                        if (res.IsReady) {
                                            $("#lblExportNotification").hide();
                                            $("#btnExportCsv").removeClass("disabled");
                                            $("#btnExportCsv").attr("title", "Export");
                                            clearInterval(pollInterval);
                                            const downloadBaseUrl = '@Url.Content("~/TempDownload/")';
                                            const url = downloadBaseUrl + encodeURIComponent(res.FileName);
                                            // Construct download URL
                                            //const downloadUrl = '@Url.Content("~/TempDownload/")' + res.FileName;

                                            ShowToastNotification("success", "Report is ready. Downloading...");
                                            window.open(url, '_blank');
                                        }
                                    }
                                });
                            }, 5000);
                        }
                        else {
                            $("#btnExportCsv").removeClass("disabled");
                            $("#lblExportNotification").hide();
                            $("#btnExportCsv").attr("title", "Export");
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    complete: function () {
                        /*$('#btnDownloadCsv').text('Preparing...').prop('disabled', true);*/
                        //ShowToastNotification("success", "Report downloaded success.");
                    },
                    error: function () {
                        $("#btnExportCsv").removeClass("disabled");
                        $("#lblExportNotification").hide();
                        $("#btnExportCsv").attr("title", "Export");
                        ShowToastNotification("error", "Report downloaded failed. Please try again..");
                    }
                });
            } catch (e) {
                $("#btnExportCsv").attr("title", "Export");
                $("#lblExportNotification").hide();
                $("#btnExportCsv").removeClass("disabled");
                ShowToastNotification("error", "Report downloaded failed. Please try again..");
            }
        });
    });
    function OpenLedger(ledgerId, ledgerName) {
        var model = {
            AccountId: ledgerId,
            AccountLedger: ledgerName,
            FromDate: $("#dtFromDate").val(),
            ToDate: $("#dtToDate").val()
        };
        $.ajax({
            url: "@Url.Action("RedirectToLedger", "Reports")",
            type: 'POST',
            data: model,
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    ShowToastNotification("success", "Successfully redirected to ledger.");
                    window.open(response.redirectUrl, '_blank');
                }
                else {
                    ShowToastNotification("error", response.message);
                }
            },
            error: function (xhr, status, error) {
                ShowToastNotification("error", "An error occurred: " + error);
            }
        });
    }
    function ReportLoadPagination() {
    try {
        var dynamicColumns = [];
        //dynamicColumns.push({
        //    title: "#",
        //    class: "text-center",
        //    render: function (data, type, row, meta) {
        //        return "<span></span>";
        //    },
        //});
        dynamicColumns.push({
            title: "Particular",
            render: function (data, type, row, meta) {
                var level = row["Level"] || 0;

                // 🔹 Create spaces based on level
                let spaces = '&nbsp;'.repeat(Math.max(0, level - 1) * 4);

                // 🔹 Arrow only if level > 0
                let arrow = level > 0
                    ? "&nbsp; "
                    : "";

                // 🔹 Build content
                let content = spaces + arrow + row["Particular"];

                // 🔹 Apply color only for LEDGER
                let style = row["RowType"] === "LEDGER" ? "color:blue;" : "";
                if (row["Account_Id"] != null && row["Account_Id"] > 0) {
                    return `<a href="javascript:void(0);" onclick="OpenLedger(${row["Account_Id"]}, '${row["Particular"]}')">${content}</a>`;
                }
                else {
                    return `<span style="${style}">${content}</span>`;
                }
            }
        });
        dynamicColumns.push({title: "Opening Debit", data: "Op_Debit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) {
                        return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>";
                    }
                    else {
                        return "<span class='text-danger'></span>";
                    }
                }
                else {
                    return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>";
                }
            },
        });
        dynamicColumns.push({title: "Opening Credit", data: "Op_Credit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
                    else { return "<span class='text-success'></span>"; }
                }
                else { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
            },
        });
        dynamicColumns.push({
            title: "Debit", data: "Tr_Debit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) { return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
                    else { return "<span class='text-danger'></span>"; }
                }
                else { return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
            },
        });
        dynamicColumns.push({
            title: "Credit", data: "Tr_Credit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
                    else { return "<span class='text-success'></span>"; }
                }
                else { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
            },
        });
        dynamicColumns.push({
            title: "Closing Debit", data: "Cl_Debit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) { return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
                    else { return "<span class='text-danger'></span>"; }
                }
                else { return "<span class='text-danger'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
            },
        });
        dynamicColumns.push({
            title: "Closing Credit", data: "Cl_Credit", class: "text-right",
            render: function (data, type, row, meta) {
                let debitAmt = parseFloat(data) || 0;
                if (row["Particular"] == "Closing Balance") {
                    if (debitAmt > 0) { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
                    else { return "<span class='text-success'></span>"; }
                }
                else { return "<span class='text-success'>₹" + debitAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + "</span>"; }
            },
        });
        // do something
        if ($('#tblDataReportView tfoot').length === 0) {
            let footer = '<tfoot><tr>';
            dynamicColumns.forEach(() => footer += '<th></th>');
            footer += '</tr></tfoot>';
            $('#tblDataReportView').append(footer);
        }
        let focusedColumnIndex = null;
        let caretPos = 0;
        $("#btnExportCsv").addClass("disabled");
        // collect filter data
        var requestModel = {
            FromDate: $("#dtFromDate").val(),
            ToDate: $("#dtToDate").val(),
            ReportType: $("#ddlReportType").val()
        };
        // destroy old instance if any
        if ($.fn.DataTable.isDataTable('#tblDataReportView')) {
            $('#tblDataReportView').DataTable().destroy();
            $('#tblDataReportView thead').empty(); // IMPORTANT
        }

        // re-init
        let table = $("#tblDataReportView").DataTable({
            destroy: true,
            deferLoading: 0,
            columns: dynamicColumns,
            scrollY: "70vh",
            scrollX: true,
            scrollCollapse: true,
            searching: true,
            ordering: false,
            serverSide: true,
            paging: false,
            processing: true,
            fixedHeader: false,
            orderCellsTop: true,
            lengthMenu: [10, 25, 100, 200, 500, 10000],
            pageLength: 10000,
            scroller: {
                loadingIndicator: true,
                displayBuffer: 10   // pre-load rows
            },
            language: {
                emptyTable: "Data not available",
                infoEmpty: "No records available - Got it?",
                processing: ""
            },
            createdRow: function (row, data, dataIndex) {
                if (dataIndex === 0) {
                    $(row).addClass('opening-balance-row');
                }
                if (data.AccountName === 'Closing Balance') {
                    $(row).addClass('opening-balance-row fw-bold');
                }
                if (data.AccountName === 'Grand Total') {
                    $(row).addClass('table-light fw-bold even');
                }
            },
            columnDefs: [{
                targets: "_all",
                render: function (data) {
                    if (data === null || data === undefined || data === "NULL" || data === "01/01/1900") {
                        return "";
                    }
                    return data;
                }
            }],
            ajax: {
                url: "@Url.Action("GetTrialBalanceReport", "Reports")",
                type: "POST",
                skipLoading: true,
                data: function (d) {
                    d.search = d.search.value;
                    d.model = requestModel;
                },
                dataSrc: function (json) {
                    if (!json || !json.data || json.data.length === 0) {
                        $("#btnExportCsv").addClass("disabled");
                        return [];
                    }
                    return json.data;
                }
            },
            footerCallback: function (row, data, start, end, display) {
                let api = this.api();
                // ✅ Safe numeric conversion
                let num = function (val) {
                    if (val === null || val === undefined || val === '') return 0;
                    if (typeof val === 'string') {
                        val = val.replace(/[^0-9.-]+/g, ''); // handles ₹, commas etc
                    }
                    val = parseFloat(val);
                    return isNaN(val) ? 0 : val;
                };

                // ✅ Label
                $(api.column(0).footer()).html('<b>Summary</b>');
                $(api.column(1).footer()).html('');
                api.columns().every(function (idx) {
                    // 🔹 Skip first two columns (index 0 and 1)
                    if (idx < 1) return;
                    let column = this;
                    // 🔹 Get column data key (VERY IMPORTANT)
                    let colName = column.dataSrc();
                    if (!colName) return;
                    // 🔹 Find config by FieldName
                    try {
                        // 🔹 Get all rows data
                        let rowsData = api.rows().data().toArray();

                        // 🔹 Filter rows where RowType === "LEDGER"
                        let filtered = rowsData.filter(row => row.RowType === "LEDGER");

                        if (!filtered.length) {
                            $(column.footer()).html('');
                            return;
                        }

                        // 🔹 Sum only this column's values from filtered rows
                        let total = filtered.reduce((sum, row) => {
                            let val = row[colName]; // access value by column key
                            return sum + num(val);
                        }, 0);

                        $(column.footer()).html("₹"+total.toLocaleString('en-IN', { minimumFractionDigits: 2 }));

                    } catch (e) {
                        $(column.footer()).html('0');
                    }
                });
            }
            //initComplete: function () {
            //    addTopFilterRow(this.api());
            //},
        });
        setTimeout(() => {
            table.ajax.reload();
        }, 0);
        table.on('processing.dt', function (e, settings, processing) {
            if (processing) {
                // show spinner
                $('.dataTables_processing').html(
                    '<i class="fa fa-spinner fa-spin fa-3x fa-fw" style="color:#27a9d7;"></i> Loading...'
                ).show();
            } else {
                // hide spinner
                $('.dataTables_processing').hide();
                $("#btnExportCsv").removeClass("disabled");
            }
        });
    } catch (e) {
        ShowToastNotification("error", e.message);
        $("#btnExportCsv").addClass("disabled");
    }
}
</script>


