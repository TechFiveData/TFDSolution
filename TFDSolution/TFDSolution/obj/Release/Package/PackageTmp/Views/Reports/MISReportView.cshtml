    function addTopFilterRow(api) {
        let thead = $('.dataTables_scrollHead thead');

        // Prevent duplicate filter rows
        if (thead.find('tr.filters').length) return;

        let filterRow = $('<tr class="filters"></tr>');

        thead.find('tr:eq(0) th').each(function (i) {

            let headerText = $(this).text().trim();  // ✅ Get header name

            let th = $('<th></th>');

            $('<input>', {
                type: 'text',
                class: 'form-control',
                placeholder: 'Search ' + headerText,   // ✅ placeholder
                style: 'width:100%'
            })
                .appendTo(th)// Ignore Tab key
                .on('keydown', function (e) {
                    if (e.key === 'Tab') return;
                })
                .on('keyup change', function (e) {
                    if (e.key === 'Tab') return;
                    api.column(i).search(this.value).draw();
                });

            filterRow.append(th);
        });

        // 🔥 INSERT BEFORE HEADER ROW
        thead.prepend(filterRow);
    }

    async function SendEmail() {
         try
         {
            $("#btnEmailSend").attr("disabled", true);
            $("#pageLoader").fadeIn();
            ShowToastNotification("info", "Email is sending..Please wait.");
             if (!validateEmailForm()) {
                 $("#btnEmailSend").attr("disabled", false);
                 return;
             }
            const bodyContent = CKEDITOR.instances["emailMessage"].getData().trim();
            const reportModel = {
                FieldData: getReportFilters(),
                ReportId: '@Model.ReportId',
                ReportTitle: '@Model.ReportName'
            };
            const reportType = $("input[name='myOptions']:checked").val();
            $("#btnDownloadCsv")
                .text("Preparing...")
                .prop("disabled", true);

            const downloadUrl = await generateReport(reportModel, reportType);
            await sendReportEmail(downloadUrl, bodyContent);
        }
        catch (ex) {
             console.error(ex);
             $("#btnEmailSend").attr("disabled", false);
            ShowToastNotification("error", ex.message || "Something went wrong.");
        }
        finally {
            $("#btnDownloadCsv")
                .text("Download")
                .prop("disabled", false);
        }
    }
    function validateEmailForm() {
        $(".validation").remove();
        $(".input-validation-error").removeClass("input-validation-error");
        let isValid = true;
        function validate(selector, message) {
            const control = $(selector);
            if (!control.val().trim()) {
                control
                    .addClass("input-validation-error")
                    .after(`<div class="validation text-danger">${message}</div>`);
                isValid = false;
            }
        }

        validate("#emailTo", "Enter email");
        validate("#emailSubject", "Enter subject");
        const body = CKEDITOR.instances["emailMessage"].getData().trim();
        if (!body) {
            $("#emailMessage")
                .addClass("input-validation-error")
                .after("<div class='validation text-danger'>Enter message</div>");

            isValid = false;
        }
        return isValid;
     }
    function getReportFilters() {
         const filters = [];
         $(".reportfilter")
             .find("input,select")
             .each(function () {
                 const el = $(this);
                 const fieldName = el.data("bind");
                 if (!fieldName)
                     return;
                 let value = "";
                 let text = "";

                 if (el.is("select")) {

                     if (el.prop("multiple")) {

                         value = el.val() ? el.val().join(",") : "";

                         text = el.find("option:selected")
                             .map(function () {
                                 return $(this).text();
                             }).get().join(", ");

                     } else {

                         value = el.val() || "";
                         text = el.find("option:selected").text();
                     }

                 } else {

                     value = el.val();

                     text = el.attr("type") === "date"
                         ? formatDateToDDMMYYYY(value)
                         : value;
                 }

                 filters.push({
                     FieldName: fieldName,
                     FieldValue: value,
                     FieldText: text
                 });

             });

         return filters;
     }
    function generateReport(reportModel, reportType) {
        return new Promise(function (resolve, reject) {
            $.ajax({
                url: '@Url.Action("ExportReport","Reports")?type=' + encodeURIComponent(reportType),
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(reportModel),
                success: function (response) {
                    if (!response.IsSuccess) {
                        reject(new Error(response.Response));
                        return;
                    }
                    waitForReport(response.Action)
                        .then(resolve)
                        .catch(reject);
                },
                error: function () {
                    $("#btnEmailSend").attr("disabled", false);
                    reject(new Error("Report generation failed."));
                }
            });
        });
    }
    function waitForReport(fileName) {
        return new Promise(function (resolve) {
            const timer = setInterval(function () {
                $.get('@Url.Action("CheckExportStatus","Reports")',
                    { fileName: fileName },
                    function (res) {
                        if (res.IsReady) {
                            clearInterval(timer);
                            resolve(
                                '@Url.Content("~/TempDownload/")' +
                                encodeURIComponent(res.FileName)
                            );
                        }
                    });
            }, 5000);
        });
    }
    function sendReportEmail(downloadUrl, bodyContent) {
        const emailModel = {
            CCEmail: $("#emailCc").val(),
            BCCEmail: $("#emailBcc").val(),
            ToEmail: $("#emailTo").val(),
            Subject: $("#emailSubject").val(),
            MessageBody: bodyContent,
            ReportId: '@Model.ReportId',
            ReportFileName: '@Model.ReportName',
            FullFilePath: downloadUrl
        };
        return new Promise(function (resolve, reject) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SendTransactionEmail","Reports")',
                contentType: "application/json",
                data: JSON.stringify(emailModel),
                beforeSend: function () {
                    $("#pageLoader").fadeIn();
                },
                success: function (res) {
                    $("#btnEmailSend").attr("disabled", false);
                    if (res.IsSuccess) {
                        ShowToastNotification("success", res.Response);
                        $("#btnEmailCancel").click();
                        resolve();
                    } else {
                        reject(new Error(res.Response));
                    }
                },
                error: function () {
                    $("#btnEmailSend").attr("disabled", false);
                    reject(new Error("Email sending failed"));
                },
                complete: function () {
                    $("#btnEmailSend").attr("disabled", false);
                    $("#btnEmailCancel").click();
                    $("#pageLoader").fadeOut();
                }
            });
        });
    }
</script>