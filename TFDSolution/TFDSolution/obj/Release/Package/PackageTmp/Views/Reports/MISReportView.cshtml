    function LoadSelections() {
        $('.select2').each(function () {
            const $select = $(this);
            const selectId = $select.attr('id');
            if (!selectId) return;
            try {
                const $parentWrapper = $select.parent();
                const controlId = $select.data('parent');
                const selectOption = $select.data('content');
                $("#" + selectId).select2({
                    dropdownParent: $parentWrapper,
                    placeholder: 'Select ' + selectOption,
                    allowClear: true,
                    skipLoading: true, // Custom flag
                    delay: 250,
                    minimumInputLength: 0, // Set to 0 to allow dropdown without typing
                    ajax: {
                        url: '@Url.Action("FillReportSelction", "Common")',
                        dataType: 'json',
                        skipLoading: true, // <-- Custom flag
                        delay: 250,
                        cache: true,
                        data: function (params) {
                            return {
                                _Id: controlId,
                                searchTerm: params.term || '',
                                page: params.page || 1,
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: data.results,
                                pagination: {
                                    more: data.pagination.more
                                }
                            };
                        },
                        error: function (xhr, status, error) {
                            console.error("Select2 AJAX Error:", error);
                            console.error("Status:", status);
                            console.error("Response:", xhr.responseText);
                        },
                        cache: true
                    }
                });

            } catch (e) {
                console.error("Select2 Initialization Error:", e);
            }
        });
    }
    
    function rebuildThead(keys) {
        const headerHtml = keys.map(k => `<th>${k}</th>`).join("");
        $("#tblMISReportView thead").html(`<tr>${headerHtml}</tr>`);
    }

    function ReportLoadPagination() {
        try {
            let focusedColumnIndex = null;
            let caretPos = 0;
            $("#btnExportCsv").addClass("disabled");
            // collect filter data
            const filterData = $(".reportfilter")
                .find("input, select")
                .map(function () {
                    const $el = $(this);
                    const fieldId = $el.attr("data-bind");

                    if (!fieldId) return null;

                    if ($el.is("select")) {
                        const selectedTexts = $el.find("option:selected")
                            .map(function () { return $(this).val(); })
                            .get()
                            .join(",");

                        return { FieldName: fieldId, FieldValue: selectedTexts };
                    }

                    return { FieldName: fieldId, FieldValue: $el.val() };
                }).get();
            // destroy old instance if any
            if ($.fn.DataTable.isDataTable('#tblMISReportView')) {
                $('#tblMISReportView').DataTable().destroy();
                $('#tblMISReportView thead').empty(); // IMPORTANT
            }
            $.ajax({
                url: "@Url.Action("getReportDataLargeColumns", "Reports")",
                type: "POST",
                skipLoading: true,
                data: { draw: 0, start: 1, length: 1, search: "",  FieldData: filterData, ReportId: "@Model.ReportId" },
                success: function (json) {
                    if (!json.columns || json.columns.length === 0) {
                        ShowToastNotification("info", "No data found");
                        return;
                    }
                    const dynamicColumns = json.columns;
                    // Get secondColumns safely
                    let summaryColumns = json.secondColumns;
                    // re-init
                    if ($('#tblMISReportView tfoot').length === 0) {
                        let footer = '<tfoot><tr>';
                        dynamicColumns.forEach(() => footer += '<th></th>');
                        footer += '</tr></tfoot>';
                        $('#tblMISReportView').append(footer);
                    }
                    let table = $("#tblMISReportView").DataTable({
                        destroy: true,
                        deferLoading: 0,
                        columns: dynamicColumns,
                        scrollY: "60vh",
                        scrollX: true,
                        scrollCollapse: true,
                        searching: true,
                        ordering: false,
                        serverSide: true,
                        paging: true,
                        processing: true,
                        fixedHeader: false,
                        orderCellsTop: true,
                        lengthMenu: [10, 25, 100, 200, 500],
                        pageLength: 100,
                        language: {
                            emptyTable: "Data not available",
                            infoEmpty: "No records available - Got it?",
                            processing: ""
                        },
                        columnDefs: [{
                            targets: "_all",
                            render: function (data) {
                                if (data === null || data === undefined || data === "NULL" || data === "01/01/1900") {
                                    return "";
                                }
                                return data;
                            }
                        }],
                        ajax: {
                            url: "@Url.Action("getReportDataLarge2","Reports")",
                            type: "POST",
                            skipLoading: true,
                            data: function (d) {
                                d.search = d.search.value;
                                d.FieldData = filterData;
                                d.ReportId = "@Model.ReportId";
                            },
                            dataSrc: function (json) {
                                if (!json || !json.data || json.data.length === 0) {
                                    $("#btnExportCsv").addClass("disabled");
                                    return [];
                                }
                                return json.data;
                            }
                        },
                        initComplete: function () {
                            addTopFilterRow(this.api());
                        },
                        footerCallback: function (row, data, start, end, display) {
                            let api = this.api();
                            // 🔄 Clear footer first
                            $(api.table().footer()).find('th').html('');

                            // 🔢 Safe numeric conversion
                            let num = function (val) {

                                if (val === null || val === undefined || val === '') {
                                    return null;
                                }

                                if (typeof val === 'string') {
                                    val = val.replace(/,/g, '').replace(/[^0-9.-]+/g, '');
                                }

                                let parsed = parseFloat(val);

                                return isNaN(parsed) ? null : parsed;
                            };

                            $(api.column(0).footer()).html('<b>Summary</b>');

                            // Check if secondColumns actually exists and has values
                            let hasSecondColumns =
                                Array.isArray(summaryColumns) &&
                                summaryColumns.length > 0;
                            
                            console.log("secondColumns:", summaryColumns);
                            console.log("hasSecondColumns:", hasSecondColumns);
                            if (hasSecondColumns == false)
                                return;
                            api.columns().every(function () {
                                let column = this;
                                let colName = column.dataSrc();
                                if (!colName) return;
                                try {
                                    // Get column data
                                    let colData = column
                                        .data({ search: 'applied' })
                                        .toArray();

                                    if (!colData.length) {
                                        $(column.footer()).html('');
                                        return;
                                    }
                                    // --------------------------------------------------
                                    // Check if current column exists in secondColumns
                                    // --------------------------------------------------
                                    let isSummaryColumn = false;
                                    if (hasSecondColumns) {
                                        isSummaryColumn = summaryColumns.some(function (x) {
                                            return x != null &&
                                                x.toString().trim().toLowerCase() ===
                                                colName.toString().trim().toLowerCase();
                                        });
                                    }
                                    // --------------------------------------------------
                                    // Get numeric values
                                    // --------------------------------------------------
                                    let numericValues = colData
                                        .map(num)
                                        .filter(function (v) {
                                            return v !== null;
                                        });
                                    // --------------------------------------------------
                                    // Decide whether to calculate summary
                                    // --------------------------------------------------
                                    let shouldCalculate = false;
                                    if (hasSecondColumns) {
                                        // secondColumns exists
                                        // Only calculate specified columns
                                        shouldCalculate = isSummaryColumn;
                                    } else {
                                        // secondColumns doesn't exist
                                        // Automatically calculate numeric columns
                                        shouldCalculate = numericValues.length > 0;
                                    }
                                    // --------------------------------------------------
                                    // Calculate total
                                    // --------------------------------------------------
                                    if (shouldCalculate) {

                                        let total = numericValues.reduce(function (sum, value) {
                                            return sum + value;
                                        }, 0);

                                        $(column.footer()).html(
                                            total.toLocaleString('en-IN', {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            })
                                        );

                                    } else {

                                        // Text / Date / non-summary column
                                        $(column.footer()).html('');
                                    }
                                    $(api.column(0).footer()).html('<b>Summary</b>');

                                } catch (e) {

                                    console.error(
                                        'Footer calculation error:',
                                        colName,
                                        e
                                    );
                                    $(api.column(0).footer()).html('<b>Summary</b>');
                                    //$(column.footer()).html('');
                                }
                            });
                        }
