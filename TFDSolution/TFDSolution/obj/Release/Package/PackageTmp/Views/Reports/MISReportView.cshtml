<style>
    .select2 {
        min-width: 600px !important;
    }

    .reportfilter label {
        min-width: 100px;
        text-align: right;
    }

    #tblMISReportView_wrapper .dataTables_scrollBody {
        min-height: 250px;
        border: 1px solid #ccc;
    }

    #tblMISReportView tbody tr:last-child td {
        border-bottom: 1px solid #ccc;
    }

    #tblMISReportView_filter {
        display: none;
    }

    .filters th {
        background: transparent;
        border: none !important;
    }

    .filters input {
        border: 1px solid #ccc;
        border-radius: 0;
        height: 30px;
    }

        .filters input:focus {
            outline: none;
