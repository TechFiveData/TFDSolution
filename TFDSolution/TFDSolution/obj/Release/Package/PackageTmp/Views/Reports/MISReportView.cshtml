<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>MIS Reports - @Model.ReportTitle</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li><a href="@Url.Action("MISReport","Reports")">MIS Report</a></li>
                    <li class="active">@Model.ReportTitle</li>
                </ol>
            </div>
        </div>
    </div>
</div>
@{
    var ImagesBase = Url.Content("~/TempDownload");
}
<input type="hidden" id="hdnReportId" />
<div class="animated fadeIn">
    <div class="row m-0">
        <div class="col-md-12 p-0">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-12 text-right">
                        <label id="lblExportNotification" style="padding-top: 6px;color: crimson;display:none;float:left;">Report export in progress. Please wait...</label>
                        <a class="btn btn-sm" onclick="ReportLoadPagination();" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                        <a class="btn btn-sm" id="btnExportCsv" href="javascript:void(0);"><i class="fa fa-file-excel-o"></i>&nbsp; Excel</a>
                        <a class="btn btn-sm" id="btnExportPDF" href="javascript:void(0);"><i class="fa fa-file-pdf-o"></i>&nbsp; PDF</a>
                        <a class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#emailModal" href="javascript:void(0);"><i class="fa fa-envelope"></i>&nbsp; e-Mail</a>
                        <a class="btn btn-sm" href="@Url.Action("MISReport","Reports")"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row form-group">
                        <div class="col-md-12 form-group reportfilter">
                            @if (Model.Header != null & Model.Header.Count > 0)
                            {
                                foreach (var item in Model.Header)
                                {
                                    if (item.FieldType == "Dropdown")
                                    {
                                        var ctrId = "ctrl_" + item.Id;
                                        <div class="d-inline-block pr-3 pb-2">
                                            <label class="form-control-label">@item.FieldCaption</label>
                                            <div class="d-inline-block">
                                                <select id="@ctrId" style="width:250px !important;" multiple class="form-select d-inline-block w-auto select2" data-content="@item.FieldCaption" data-parent="@item.Id" data-bind="@item.FieldName">
                                                    <option>Select @item.FieldCaption</option>
                                                </select>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-12 form-group reportfilter">
                            @if (Model.Header != null & Model.Header.Count > 0)
                            {
                                foreach (var item in Model.Header)
                                {
                                    var ctrId = "ctrl_" + item.Id;
                                    if (item.FieldType == "Text")
                                    {
                                        <div class="d-inline-block pr-3 pb-2">
                                            <label class="form-control-label">@item.FieldCaption</label>
                                            <input id="@ctrId" type="text" class="form-control d-inline-block w-auto myDate" data-bind="@item.FieldName" />
                                        </div>
                                    }
                                    else if (item.FieldType == "Date")
                                    {
                                        <div class="d-inline-block pr-3 pb-2">
                                            <label class="form-control-label">@item.FieldCaption</label>
                                            <input id="@ctrId" type="date" class="form-control d-inline-block w-auto myDate" data-bind="@item.FieldName" />
                                        </div>
                                    }
                                }
                                <button onclick="ReportLoadPagination();" class="btn btn-primary btn-Generate">Generate</button>
                            }
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <table id="tblMISReportView" class="display cell-border nowrap" cellspacing="0" width="100%"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Email Modal -->
<div class="modal fade" id="emailModal" tabindex="-1" aria-labelledby="emailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered float-none model-center-style" style="height:auto;">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="emailModalLabel">Send Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <form id="emailForm">
                    <div class="mb-3 row">
                        <label for="emailTo" class="col-sm-2 col-form-label">To:</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control" id="emailTo" placeholder="Enter recipient email" required>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label for="emailCc" class="col-sm-2 col-form-label">CC:</label>
                        <div class="col-sm-10">
                            <input type="email" class="form-control" id="emailCc" placeholder="Enter CC email">
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label for="emailSubject" class="col-sm-2 col-form-label">Subject:</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="emailSubject" placeholder="Enter subject" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="emailMessage" class="form-label">Message:</label>
                        <textarea class="form-control" id="emailMessage" rows="4" placeholder="Enter your message" required></textarea>
                    </div>

                    <div class="d-flex align-items-center">
                        <label class="mb-0 mr-2" style="margin-top: 6px; padding-right: 6px;"><b>Report Type: </b></label>
                        <div class="form-check form-check-inline me-2 mb-0">
                            <input class="form-check-input" type="radio" name="myOptions" id="optionCSV" value="csv" checked>
                            <label class="form-check-label" for="optionCSV">CSV</label>
                        </div>
                        <div class="form-check form-check-inline me-2 mb-0">
                            <input class="form-check-input" type="radio" name="myOptions" id="optionPDF" value="pdf">
                            <label class="form-check-label" for="optionPDF">PDF</label>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button" id="btnEmailCancel" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Close">Close</button>
                @*<button type="submit" form="emailForm" class="btn btn-primary" >Send Email</button>*@
                <button type="button" id="btnEmailSend" class="btn btn-primary" onclick="SendEmail()">Send Email</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function formatDateToDDMMYYYY(dateStr) {
        if (!dateStr) return "";
        var parts = dateStr.split("-");
        if (parts.length !== 3) return dateStr;
        return parts[2] + "/" + parts[1] + "/" + parts[0];
    }
    $(document).ready(function () {
        let today = new Date();

        // First day of current month
        let firstDayOfMonth = new Date(
            today.getFullYear(),
            today.getMonth(),
            1
        );

        // Format Date as yyyy-MM-dd
        function formatDate(date) {
            let year = date.getFullYear();
            let month = String(date.getMonth() + 1).padStart(2, '0');
            let day = String(date.getDate()).padStart(2, '0');

            return `${year}-${month}-${day}`;
        }

        if ($('[data-bind="FromDate"]').length) {
            $('[data-bind="FromDate"]').val(formatDate(firstDayOfMonth));
        }

        if ($('[data-bind="ToDate"]').length) {
            $('[data-bind="ToDate"]').val(formatDate(today));
        }
        $("#btnExportCsv").addClass("disabled");
        $(".myDate").val(new Date().toISOString().split("T")[0]);
        //LoadColumns();
        $('.tblMISReportView').html(
            '<i class="fa fa-spinner fa-spin fa-3x fa-fw" style="color:#27a9d7;"></i> Loading...'
        ).show();
        ReportLoadPagination();
        $('#tblMISReportView tfoot th').each(function () {
            const title = $(this).text();
            $(this).html('<input type="text" placeholder="Search ' + title + '" />');
        });
        if (!CKEDITOR.instances['emailMessage']) {
            CKEDITOR.replace('emailMessage');
            /*CKEDITOR.instances['emailMessage'].setData(emailmsg);*/
        }
        LoadSelections();
    });
    $('#btnExportCsv').on('click', function () {
        try {
            var filterData = [];
            $(".reportfilter").find("input, select").each(function () {
                var $el = $(this);
                var fieldId = $el.attr("data-bind");
                var type = $el.attr("type");
                if (fieldId && fieldId.length > 0) {
                    if ($el.is("select")) {
                        if ($el.prop("multiple") == false) {
                            const selectedVal = $(this).val();
                            const selectedTexts = $(this).text();
                            filterData.push({
                                FieldName: fieldId,
                                FieldValue: selectedVal.join(','),
                                FieldText: selectedTexts.join(', ')
                            });
                        }
                        else {
                            const selectedVal = $el.find("option:selected").map(function () {
                                return $(this).val();
                            }).get();

                            const selectedTexts = $el.find("option:selected").map(function () {
                                return $(this).text();
                            }).get();

                            filterData.push({
                                FieldName: fieldId,
                                FieldValue: selectedVal.join(','),
                                FieldText: selectedTexts.join(', ')
                            });
                        }

                    } else {
                        // input type (text, date, hidden, etc.)
                        if (type == "date") {
                            filterData.push({
                                FieldName: fieldId,
                                FieldValue: $el.val(),
                                FieldText: formatDateToDDMMYYYY($el.val())
                            });
                        }
                        else {
                            filterData.push({
                                FieldName: fieldId,
                                FieldValue: $el.val(),
                                FieldText: $el.val()
                            });
                        }
                    }
                }
            });
            var model = {
                FieldData: filterData,
                ReportId: '@Model.ReportId',
                ReportTitle : '@Model.ReportName'
            }
            $("#btnExportCsv").addClass("disabled");
            $("#lblExportNotification").show();
            $("#btnExportCsv").attr("title", "Report is exporting. Please wait..")
            ShowToastNotification("info", "Report is downloading... Please wait.");
            $.ajax({
                url: "@Url.Action("ExportReport", "Reports", new { type = "csv" })",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(model),
                skipLoading: true,
                beforeSend: function () {
                    $('#btnDownloadCsv').text('Preparing...').prop('disabled', true);
                },
                success: function (response) {
                    if (response != null && response != null && response.IsSuccess) {
                        //ShowToastNotification("success", response.Response);
                        // Poll every 5 seconds to check export completion
                        let pollInterval = setInterval(function () {
                            $.ajax({
                                url: '@Url.Action("CheckExportStatus", "Reports")',
                                type: 'GET',
                                async: true,
                                skipLoading: true,
                                data: { fileName: response.Action },
                                success: function (res) {
                                    if (res.IsReady) {
                                        $("#lblExportNotification").hide();
                                        $("#btnExportCsv").removeClass("disabled");
                                        $("#btnExportCsv").attr("title", "Export");
                                        clearInterval(pollInterval);
                                        const downloadBaseUrl = '@Url.Content("~/TempDownload/")';
                                        const url = downloadBaseUrl + encodeURIComponent(res.FileName);
                                        // Construct download URL
                                        //const downloadUrl = '@Url.Content("~/TempDownload/")' + res.FileName;

                                        ShowToastNotification("success", "Report is ready. Downloading...");
                                        window.open(url, '_blank');
                                    }
                                }
                            });
                        }, 5000);

                        //const url = downloadBaseUrl + encodeURIComponent(response.Response);
                        // Open download link in a new tab
                        //window.open(url, '_blank');
                        //ShowToastNotification("success", "Report downloaded successfully.");
                    }
                    else {
                        $("#btnExportCsv").removeClass("disabled");
                        $("#lblExportNotification").hide();
                        $("#btnExportCsv").attr("title", "Export");
                        ShowToastNotification("error", response.Response);
                    }
                },
                complete: function () {
                    /*$('#btnDownloadCsv').text('Preparing...').prop('disabled', true);*/
                    //ShowToastNotification("success", "Report downloaded success.");
                },
                error: function () {
                    $("#btnExportCsv").removeClass("disabled");
                    $("#lblExportNotification").hide();
                    $("#btnExportCsv").attr("title", "Export");
                    ShowToastNotification("error", "Report downloaded failed. Please try again..");
                }
            });
        } catch (e) {
            $("#btnExportCsv").attr("title", "Export");
            $("#lblExportNotification").hide();
            $("#btnExportCsv").removeClass("disabled");
            ShowToastNotification("error", "Report downloaded failed. Please try again..");
        }
    });
