            if ($("#hdnSelectedSectionText").val() == "Detail") {
                spTableName = $("#hdnSelectedTabSQLTableName").val();
            }
            $.ajax({
                url: "@Url.Action("GetSourceColumns", "FormSetting")",
                type: "GET",
                data: { sourceType: _OptionSource, tableName: tableName, fieldId: $("#hdnFieldId").val(), pageTableName: spTableName },
                success: function (reponse) {
                    let columnDropdown1 = $("#ddlSelectText");
                    let columnDropdown2 = $("#ddlSelectValue");
                    columnDropdown1.empty();
                    columnDropdown2.empty();
                    columnDropdown1.append('<option value="">Select TextField</option>');
                    columnDropdown2.append('<option value="">Select ValueField</option>');
                    if (reponse.Columns != null && reponse.Columns.length > 0) {
                        reponse.Columns.forEach(column => {
                            if (selectedText != undefined && selectedText != null && selectedText != "" && selectedText == column) {
                                columnDropdown1.append(`<option selected value="${column}">${column}</option>`);
                            }
                            else {
                                columnDropdown1.append(`<option value="${column}">${column}</option>`);
                            }
                            if (selectedValu != undefined && selectedValu != null && selectedValu != "" && selectedValu == column) {
                                columnDropdown2.append(`<option selected value="${column}">${column}</option>`);
                            }
                            else {
                                columnDropdown2.append(`<option value="${column}">${column}</option>`);
                            }
                        });
                    }
                    if (reponse != null && reponse.Request != null && reponse.Request.length > 0) {
                        $("#divSPRequest").removeClass("d-none");

                        var ddlField = "<select class='form-control form-select'><option value='0'>Select Field</option>";
                        reponse.SPColumns.forEach(spCol => {
                            ddlField = ddlField + `<option value="${spCol}">${spCol}</option>`;
                        });
                        ddlField = ddlField + `</select>`;

                        reponse.Request.forEach(item => {
                            const newRow = `<tr><td>${item.ORDINAL_POSITION}</td><td class="text-left paramName" data-bind="${item.PARAMETER_NAME}">${item.PARAMETER_NAME}</td><td class="text-left">${item.DATA_TYPE}</td><td class="paramField" data-bind="${item.PARAMETER_Value}">${ddlField}</td></tr>`;
                            // Append it to the tbody
                            $('#tblRequest tbody').append(newRow);
                        });

                        $('#tblRequest tbody>tr').each(function () {
                            if ($(this) != null) {
                                var _paramMapField = "";
                                $('td', this).each(function () {
                                    if ($(this).hasClass('paramField')) {
                                        _paramMapField = $(this).attr("data-bind");
                                        $(this).find('select').val(_paramMapField);
                                    }
                                });
                            }
                        });
                    }
                }
            });
        } catch (e) {
        }
    }

