// StockEffects toggle - delegated so works after AJAX rows loaded
$(document).on("change", "#tblSettings select", function () {
    var divConfig = "div" + $(this).attr("data-content");
    if ($("#" + divConfig).length > 0) {
        $(this).val() === "Y"
            ? $("#" + divConfig).removeClass("d-none")
            : $("#" + divConfig).addClass("d-none");
    }
});

// Save Form Settings - delegated
function SaveFormSettingTabId(primaryId) {
    try {
        var formSettings = [];
        var tabId = primaryId;
        $('#tblSettings tbody tr').each(function () {
            var keyName    = $(this).data('content');
            var formId     = $(this).data('bind');
            var keyValue   = $.trim($(this).find("select").val() || "");
            var otherValue = keyValue;

            if (keyName === "AllowSubDetailsView" && keyValue === "Y") {
                otherValue = $('input[name="DetailView"]:checked').val();
            }
            formSettings.push({
                KeyName    : keyName,
                FormId     : formId,
                KeyValue   : otherValue,
                KeyCaption : otherValue,
                FormTabId  : tabId
            });
        });

        $.ajax({
            url: '@Url.Action("SaveFormSettings", "FormSetting")',
            type: 'POST',
            data: JSON.stringify(formSettings),
            contentType : 'application/json; charset=utf-8',
            success: function (response) {
            },
            error: function () {
                ShowToastNotification("error",
                    "An error occurred while saving form settings.");
            }
        });
    } catch (e) { }
}
// ── Called by AddNewTab() and EditTab() ───────────────────────────────
function LoadFormSettingsRows() {
    var formId = $("#hdnSelectedFormId").val();
    var type = $("#hdnSelectedSectionText").val();
    var tabId = $("#hdnSelectedTab").val();

    // ✅ Always destroy DataTable safely before clearing tbody
    try {
        if ($.fn.DataTable.isDataTable("#tblSettings")) {
            $("#tblSettings").DataTable().destroy();
        }
        $('#tblSettings').DataTable({
            destroy: true,
            paging: false,
            info: false,
            searching: false,
            ordering: true,
            columnDefs: [
                { orderable: false, targets: [0, 3] }
            ]
        });
    } catch (e) { }

    // ✅ Clear tbody AFTER destroy
    $("#tblSettingsTbody").empty();
    $("#divFormSettingsLoader").show();
    $.ajax({
        url:'@Url.Action("GetFormSettingsRows", "FormSetting")',
        type: "GET",
        data: { formId: formId, type: type, TabId: tabId },
        success : function (response) {
            $("#divFormSettingsLoader").hide();
            if (response != null && response.length > 0) {
                $.each(response, function (i, item) {
                    var selectedVal = (item.KeyValue === "Y") ? "selected" : "";
                    var controlHtml = BuildControlCell(item, selectedVal);
                    var actionHtml  = BuildActionCell(item);
                    var row = '<tr data-content="' + item.KeyName + '" ' +
                                  'data-bind="'    + item.FormId  + '">' +
                              '<td>' + item.SrNo       + '</td>' +
                              '<td>' + item.KeyCaption + '</td>' +
                              '<td>' + controlHtml     + '</td>' +
                              '<td>' + actionHtml      + '</td>' +
                              '</tr>';
                    $("#tblSettingsTbody").append(row);
                });

                // Bind SP dropdowns
                var spFields = [
                    "HeaderValidationScript",
                    "DetailValidationScript",
                    "PageListScript",
                    "AllowFinanceEffect"
                ];
                $.each(spFields, function (i, fieldId) {
                    if ($("#" + fieldId).length > 0) {
                        BindFormSettingDropdown("StoredProcedure", fieldId);
                    }
                });

                // Init select2
                $('#tblSettings .select2').each(function () {
                    if (!$(this).hasClass("select2-hidden-accessible")) {
                        $(this).select2({ dropdownParent: $('#tabModal') });
                    }
                });
            } else {
                $("#tblSettingsTbody").html(
                    '<tr><td colspan="4" class="text-center text-muted">' +
                    'No settings found.</td></tr>'
                );
            }

           if ($.fn.DataTable.isDataTable('#tblSettings')) {
                $('#tblSettings').DataTable().destroy();
            }
            $('#tblSettings').DataTable({
                destroy: true,
                paging: false,
                info: false,
                searching: false,
                ordering: true,
                columnDefs: [
                    { orderable: false, targets: [0, 3] }
                ]
            });
        },
        error: function () {
            $("#divFormSettingsLoader").hide();
            ShowToastNotification("error", "Error loading form settings.");
        }
    });
}

function BuildControlCell(item, selectedVal) {
    if (item.KeyName === "DetailPopupStyle") {
        return '<select class="form-select" data-content="' + item.KeyName + '" ' +
               'style="min-width:100px !important;max-width:100px !important">' +
               '<option value="N">Default</option>' +
               '<option value="Y" ' + selectedVal + '>Center</option></select>';

    } else if (item.KeyName === "HeaderValidationScript" ||
               item.KeyName === "DetailValidationScript"  ||
               item.KeyName === "PageListScript"          ||
               item.KeyName === "AllowFinanceEffect") {
        return '<select id="' + item.KeyName + '" ' +
               'class="form-control form-select select2" ' +
               'data-bind="' + (item.KeyValue || '') + '" ' +
               'data-content="' + item.KeyName + '">' +
               '<option value="">Select</option></select>';

    } else if (item.KeyName === "AllowSubDetailsView") {
        var isSel    = (item.KeyValue === "Detail" ||
                        item.KeyValue === "Header" ||
                        item.KeyValue === "Y") ? "selected" : "";
        var detChk   = (item.KeyValue === "Detail") ? "checked" : "";
        var hdrChk   = (item.KeyValue === "Header") ? "checked" : "";
        var subClass = (isSel === "selected") ? "" : "d-none";
        return '<div class="radio-line">' +
               '<select class="form-select" onchange="onAllowSubDetailsViewChange(this)" ' +
               'data-content="' + item.KeyName + '" ' +
               'style="min-width:100px !important;max-width:100px !important;display:inline-block">' +
               '<option value="N">No</option>' +
               '<option value="Y" ' + isSel + '>Yes</option></select>' +
               '<div id="divAllowSubDetailsView" style="display:inline-block;" ' +
               'class="' + subClass + '">' +
               '<label>Enable for?</label>' +
               '<label><input type="radio" name="DetailView" ' + detChk +
               ' class="radio mr-1" value="Detail">Detail</label>' +
               '<label><input type="radio" name="DetailView" ' + hdrChk +
               ' value="Header" class="radio mr-1">Header</label>' +
               '</div></div>';
    } else {
        return '<select class="form-select" data-content="' + item.KeyName + '" ' +
               'style="min-width:100px !important;max-width:100px !important">' +
               '<option value="N">No</option>' +
               '<option value="Y" ' + selectedVal + '>Yes</option></select>';
    }
}

function BuildActionCell(item) {
    if (item.KeyName === "StockEffects") {
        var cls = (item.KeyValue === "Y") ? "d-none" : "";
        return '<div id="div' + item.KeyName + '" class="' + cls + '">' +
               '<a href="javascript:void(0);" data-toggle="modal" ' +
               'data-target="#stockEffectModal"><i class="fa fa-cog"></i></a></div>';
    }
    return '';
}
