    function BindFormSettingDropdown(_OptionSource, ctrolId)
    {
        try {
            var defaultValue = $("#" + ctrolId).attr("data-bind");
            $.ajax({
                url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
                type: "GET",
                data: { sourceType: _OptionSource },
                success: function (tables) {
                    let tableDropdown = $("#" + ctrolId);
                    tableDropdown.empty();
                    tableDropdown.append('<option value="">Select ' + _OptionSource +'</option>');
                    tables.forEach(table => {
                        if (defaultValue != undefined && defaultValue != "" && defaultValue == table) {
                            tableDropdown.append(`<option selected value="${table}">${table}</option>`);
                        }
                        else {
                            tableDropdown.append(`<option value="${table}">${table}</option>`);
                        }
                    });
                    tableDropdown.val(defaultValue).trigger("change");
                 }
            });
        } catch (e) {

        }
    }
