    //#region  Next Button Code
    function bindStoredProcedureNextButton(defaultValue) {

        let tableDropdown = $("#ddlNextTabDataScript");

        // Destroy Select2 if already initialized
        if (tableDropdown.hasClass("select2-hidden-accessible")) {
            tableDropdown.select2("destroy");
        }

        tableDropdown.empty();

        $.ajax({
            url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
            type: "GET",
            skipLoading: true,
            data: { sourceType: "StoredProcedure" },
            success: function (tables) {

                tableDropdown.append('<option value="">Select Stored Procedure</option>');

                tables.forEach(function (table) {
                    tableDropdown.append(
                        `<option value="${table}">${table}</option>`
                    );
                });

                // Apply Select2
                tableDropdown.select2({
                    placeholder: "Select Stored Procedure",
                    allowClear: true,
                    width: "100%"
                    // If inside a Bootstrap modal, uncomment:
                    // dropdownParent: $("#yourModalId")
                });

                // Set default value
                if (defaultValue) {
                    tableDropdown.val(defaultValue).trigger("change");
                }
            },
            error: function (xhr, status, error) {
                console.error(error);
            }
        });
    }
