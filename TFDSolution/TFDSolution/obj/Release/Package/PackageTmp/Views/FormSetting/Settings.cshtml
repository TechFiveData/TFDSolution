    function loadDropdownTables(_OptionSource, defaultValue)
{
    let columnDropdown1 = $("#ddlSelectText");
    let columnDropdown2 = $("#ddlSelectValue");
    $("#divSPRequest").addClass("d-none");
    columnDropdown1.empty();
    columnDropdown2.empty();
    $('#tblRequest tbody tr').remove();
    return $.ajax({
        url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
        type: "GET",
        skipLoading: true,
        data: { sourceType: _OptionSource },
        success: function (tables) {
            let tableDropdown = $("#ddlTables");
            tableDropdown.empty();
            tableDropdown.append('<option value="">Select ' + _OptionSource +'</option>');
            tables.forEach(table => {
                if (defaultValue != undefined && defaultValue != "" && defaultValue == table) {
                    tableDropdown.append(`<option selected value="${table}">${table}</option>`);
                }
                else {
                    tableDropdown.append(`<option value="${table}">${table}</option>`);
                }
            });
            if (defaultValue != undefined && defaultValue != "") {
                tableDropdown.val(defaultValue);
            }
         }
    });
}
    function loadTableColumns(_OptionSource, tableName, selectedText, selectedValu) {
