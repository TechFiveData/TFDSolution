    function SaveTab()
    {
        var isFormValid = true;
        $("#tabModal input").each(function () {
            if ($.trim($(this).val()).length == 0 && ($(this).attr("id") != "txtFormTabSQLTable") && $(this).attr("id") != "hdnFormTabId") {
                //if ($("#hdnSelectedSectionText").val() != "Header") {
                //    $("#txtFormTabSQLTable").parent().parent().hide();
                //}
                $(this).addClass("input-validation-error");
                if (isFormValid == true) {
                    $(this).focus();
                }
                isFormValid = false;
            }
            else {
                $(this).removeClass("input-validation-error");
            }
        });

        if (!isFormValid) {
            ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
        }
        else {
            try {
                var sectionId = $("#hdnSelectedSection").val();
                var tabId = $("#hdnFormTabId").val();
                var modal = {
                    TabName: $("#txtFormTab").val(),
                    IsActive: true,
                    FormId: $("#hdnSelectedFormId").val(),
                    TabSQLTableName: $("#txtFormTabSQLTable").val(),
                    TabTitle: $("#txtFormTabTitle").val(),
                    FormTabId: tabId,
                    SectionId: sectionId,
                    SortOrder: $("#hdnTabSortOrderSelectedFormId").val(),
                    NextTabDataScript: $("#ddlNextTabDataScript").val()
                };

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveTab", "FormSetting")',
                    contentType: "application/json;",
                    data: JSON.stringify(modal),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            ShowToastNotification("success", "Record saved successfully.");
                            SaveFormSettingTabId(response.PrimaryId);
                            AddNewTab();
                            $('#btnCancelTab').click();
                            BindTab();
                        }
                        else {
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            } catch (e) {
            }
        }
    }
