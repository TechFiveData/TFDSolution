    function BindTab() {
        var formId = $("#hdnSelectedFormId").val();
        var sectionId = $("#hdnSelectedSection").val();
        $.ajax({
            type: "GET",
            url: "@Url.Action("getSectionTab", "FormSetting")",
            contentType: "application/json; charset=utf-8",
            data: { FormId: formId, sectionId: sectionId },
            dataType: "json",
            success: function (response) {
                $("#div" + $("#hdnSelectedSectionText").val() +"Tabs").empty();
                if (response != null && response.length > 0) {
                    $("#btnAddNewField").show();
                    var selectedSection = $("#hdnSelectedSectionText").val(); // e.g., "Header" or "Detail"
                    var dynamicTabId = selectedSection + "Tab"; // So: "HeaderTab" or "DetailTab"
                    var tabHtml = '<ul class="nav nav-tabs" id="' + dynamicTabId + '" role="tablist">';
                    //var tabHtml = '<ul class="nav nav-tabs" id="HeaderTab" role="tablist">';
                    var tabDetHtml = '<div class="tab-content pl-3 p-1 tab-inner-content" id="' + dynamicTabId + 'Content">';
                    //var tabDetHtml = '<div class="tab-content pl-3 p-1 tab-inner-content" id="HeaderTabContent">';
                    var defaultTabtbl = "";
                    for (var iRow = 0; iRow < response.length; iRow++)
                    {
                        var tanbname = response[iRow].TabName.replace(" ", "");
                        var tanbtitle = response[iRow].TabTitle;
                        if (iRow == 0) {
                            defaultTabtbl = "tblFormFields" + response[iRow].FormTabId;
                            tabHtml = tabHtml + "<li class='nav-item'><a style='cursor:move' onclick='selectTab(\"" + response[iRow].FormTabId + "\",\"" + tanbname + "\",\"" + response[iRow].TabSQLTableName + "\");' class='nav-link active' id=" + tanbname + "-tab' data-toggle='tab' href='#" + tanbname + "' title='Press and move the tab' role='tab' aria-controls=\"" + tanbname + "\" aria-selected='true'>" + tanbtitle + "";
                            tabHtml = tabHtml + "<label title='Edit Tab' onclick='EditTab(\"" + response[iRow].FormTabId + "\");' data-toggle='modal' data-target='#tabModal' style='padding-left:8px;'><i class='fa fa-pencil' style='font-size:14px;'></i></label>";
                            tabHtml = tabHtml + '<label title="Delete Tab" onclick="DeleteTab(\'' + response[iRow].FormTabId + '\');" style="padding-left:8px;"><i class="fa fa-trash" style="font-size:14px;"></i></label>';
                            tabHtml = tabHtml + '</a></li>';
                            $("#hdnSelectedTab").val(response[iRow].FormTabId);
                            $("#hdnSelectedTabName").val(tanbname);
                            $("#hdnTabSorOrder").val(response[iRow].SortOrder);
                            $("#hdnSelectedTabSQLTableName").val(response[iRow].TabSQLTableName);
                        }
                        else {
                            tabHtml = tabHtml + "<li class='nav-item'><a  title='Press and move the tab' style='cursor:move' onclick='selectTab(\"" + response[iRow].FormTabId + "\",\"" + tanbname + "\",\"" + response[iRow].TabSQLTableName + "\");' class='nav-link' id=" + tanbname + "-tab' data-toggle='tab' href='#" + tanbname + "' role='tab' aria-controls=\"" + tanbname + "\" aria-selected='true'>" + tanbtitle + "";
                            tabHtml = tabHtml + "<label title='Edit Tab' onclick='EditTab(\"" + response[iRow].FormTabId + "\");' data-toggle='modal' data-target='#tabModal' style='padding-left:8px;'><i class='fa fa-pencil' style='font-size:14px;'></i></label>";
                            tabHtml = tabHtml + '<label title="Delete Tab" onclick="DeleteTab(\'' + response[iRow].FormTabId + '\');" style="padding-left:8px;"><i class="fa fa-trash" style="font-size:14px;"></i></label>';
                            tabHtml = tabHtml + '</a></li>';
                            tabHtml = tabHtml + '</li>';
                        }

                        if (iRow == 0) {
                            tabDetHtml = tabDetHtml + '<div class="tab-pane fade show active" id="' + tanbname + '" role="tabpanel" aria-labelledby="' + tanbname + '-tab">';
                        }
                        else {
                            tabDetHtml = tabDetHtml + '<div class="tab-pane fade show" id="' + tanbname + '" role="tabpanel" aria-labelledby="' + tanbname + '-tab">';
                        }
                        /*tabHtml = tabHtml + '<div class="tab-pane fade show active" id="' + tanbname + '" role="tabpanel" aria-labelledby="' + tanbname + '-tab">';*/
                        tabDetHtml = tabDetHtml + '<div class="row form-group">';
                        tabDetHtml = tabDetHtml + '<table id="tblFormFields' + response[iRow].FormTabId +'" class="row-reorder display table-bordered table-striped dataTable dtr-inline" cellspacing="0" width="100%"></table>';
                        tabDetHtml = tabDetHtml + '</div></div>';
                    }
                    tabHtml = tabHtml + '<a class="btn btn-sm tab-add-btn" style="padding-top:13px;" id="btnAddNewTab" onclick="AddNewTab();" href="javascript:void(0);" title="Add New Field" data-toggle="modal" data-target="#tabModal" style=""><i class="fa fa-plus"></i></a>';
                    tabHtml = tabHtml + '</ul>';
                    tabDetHtml = tabDetHtml + '</div>';
                    $("#div" + $("#hdnSelectedSectionText").val() + "Tabs").append(tabHtml + tabDetHtml);

                    // Make the tabs sortable
                    $("#" + dynamicTabId).sortable({
                        axis: "x",
                        containment: "parent",
                        items: "> li.nav-item",
                        stop: function (event, ui) {
                            let sortedTabs = [];
                            $("#" + dynamicTabId).children("li.nav-item").each(function (index) {
                                const onclickAttr = $(this).find("a").attr("onclick");
                                const matches = onclickAttr?.match(/selectTab\("(.+?)",\s*"(.+?)",\s*"(.+?)"\)/);
                                if (matches) {
                                    sortedTabs.push({ FormId: matches[1], FormName: matches[2], SortOrder: index + 1 });
                                }
                            });
                            var parentId = formId;//no use
                            // Save new sort order via AJAX
                             $.ajax({
                                type: "POST",
                                url: '@Url.Action("UpdateTabSortOrder", "FormSetting")',
                                contentType: "application/json; charset=utf-8",
                                data: JSON.stringify({ ParentFormId: formId, Rows: sortedTabs }),
                                success: function () {
                                    ShowToastNotification("success", "Tab order updated.");
                                },
                                error: function () {
                                    ShowToastNotification("error", "Failed to update tab order.");
                                }
                            });
                        }
                    });
                    $("#hdnSelectedTabGrid").val(defaultTabtbl);

                    GetFormFieldList();
                }
                else {
                    $("#btnAddNewField").hide();
                    AddNewTab();
                    $("#div" + $("#hdnSelectedSectionText").val() + "Tabs").html('<div class="alert alert-info" role="alert">No tabs have been added yet. Click <a href="#" data-toggle="modal" data-target="#tabModal" class="alert-link">Add New Tab</a> here to add a new tab.</div >');
                }
             },
             failure: function (response) {
                 ShowToastNotification("error", response.d);
             },
             error: function (response) {
                 ShowToastNotification("error", "Error fetching data!");
             }
         });
    }
    function DeleteTab(_tabId) {
        var tabName = $("#hdnSelectedTabName").val();
        var isValid = true;
        if ($("#tblFormFields" + _tabId).length > 0 && $("#tblFormFields" + _tabId + " tbody tr").length > 0) {
            if ($("#tblFormFields" + _tabId + " tbody tr td").length > 1) {
                isValid = false;
                ShowToastNotification("warning", "Fields are exists in " + tabName + " tab.");
            }
        }
        if (isValid) {
            if (confirm("Do you want to delete " + tabName + " tab?")) {
                try {
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("DeleteTab", "FormSetting")",
                        contentType: "application/json; charset=utf-8",
                        data: { tabId: _tabId },
                        dataType: "json",
                        success: function (response) {
                            if (response != null && response.IsSuccess) {
                                ShowToastNotification("success", "" + tabName + " Tab has been successfully deleted.");
                                BindTab();
                            }
                            else {
                                ShowToastNotification("error", response.Response);
                            }
                        },
                        failure: function (response) { },
                        error: function (response) { }
                     });
                } catch (e) {
                }
            }
        }
    }
