    function SaveFieldInfo() {
        try {

            var IsValidated = true;
            if ($.trim($("#txtFieldInfoTabName").val()).length == 0) {
                IsValidated = false;
                $("#txtFieldInfoTabName").addClass("input-validation-error");
                $("#txtFieldInfoTabName").focus();
            }
            else {
                $("#txtFieldInfoTabName").removeClass("input-validation-error");
            }
            var IsValidated = true;
            if ($.trim($("#ddlFieldInfoScript").val()).length == 0) {
                IsValidated = false;
                $("#ddlFieldInfoScript").addClass("input-validation-error");
                $("#ddlFieldInfoScript").focus();
            }
            else {
                $("#ddlFieldInfoScript").removeClass("input-validation-error");
            }
            if (IsValidated) {
                var modal = {
                    InformationId: $("#hdnInformationId").val(),
                    FieldId: $("#hdnFieldId").val(),
                    TabName: $("#txtFieldInfoTabName").val(),
                    SQLScriptName: $("#ddlFieldInfoScript").val(),
                };
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveFieldInformation", "FormSetting")',
                    contentType: "application/json;",
                    data: JSON.stringify(modal),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            $("#txtFieldInfoTabName").val('');
                            $("#hdnInformationId").val(0);
                            bindStoredProcedure("ddlFieldInfoScript", "");
                            BindFieldInformation();
                            ShowToastNotification("success", "Record saved successfully.");
                        }
                        else {
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            }
            else {
                ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
            }

        } catch (e) {

        }
    }
    function EditFieldInfo(InformationId, TabName, SQLScriptName) {
        $("#hdnInformationId").val(InformationId);
        $("#txtFieldInfoTabName").val(TabName);
        bindStoredProcedure("ddlFieldInfoScript", SQLScriptName);
