@model TFDSolution.Transport.Master.FormMast
@{
        ViewBag.Title = "Settings";
        Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
        var formSettingsList = ViewBag.FormSettings as
                               IEnumerable<TFDSolution.Transport.Master.FormSettings>;
}
<script src="~/Scripts/dataTables.rowReorder.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
    /* Style the tab */
    .modal-content {
        font-size: 13px;
    }

        .modal-content .modal-title {
            font-size: 13px;
        }

    .tab-add-btn {
        padding-top: 13px;
        width: 50px;
        /* border: 1px solid #ccc;
        border-width: 1px 1px 0 0;
        border-radius: 0 5px 0 0;*/
    }

        .tab-add-btn:hover {
            color: #27a9d7;
            /*border: 1px solid #ccc;
            border-width: 1px 1px 0 0;
            border-radius: 0 5px 0 0;*/
        }

    .panel-left {
        float: left;
        border: 1px solid #ccc;
        background-color: #fdfdfd;
        width: 300px;
        height: 100%;
    }

    .panel-right {
        float: left;
        padding: 0px 12px;
        /*border: 1px solid #ccc;*/
        width: calc(100% - 300px);
        border-left: none;
        height: 100%;
        background-color: #fff;
        min-height: calc(100vh - 120px);
    }

    .tab {
        float: left;
        /*border: 1px solid #ccc;*/
        background-color: #fdfdfd;
        width: 185px;
        height: 100%;
    }

        /* Style the buttons inside the tab */
        .tab button {
            display: block;
            background-color: inherit;
            color: black;
            padding: 12px 16px;
            width: 100%;
            border: none;
            outline: none;
            text-align: left;
            cursor: pointer;
            transition: 0.3s;
            font-size: 17px;
            /*border: 1px solid #ccc;*/
            border-width: 1px 0 1px 0;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #dedede;
            }

            /* Create an active/current "tab button" class */
            .tab button.active {
                background-color: #dedede;
                color: #000;
            }

    /* Style the tab content */
    .tabcontent {
        float: left;
        padding: 0px 12px;
        border: 1px solid #ccc;
        width: calc(100% - 300px);
        border-left: none;
        height: 100%;
        background-color: #fff;
    }

    #tblForms thead {
        display: none;
    }

    .nav-link {
        color: #000;
        height: 40px !important;
        /*background-color: #ccc;*/
        font-size: 14px !important;
        margin-bottom: 3px;
    }

    #HeaderTabName .nav-item.show .nav-link, #HeaderTabName.nav-tabs .nav-link.active,
    #nav-tab .nav-item.show .nav-link, #nav-tab.nav-tabs .nav-link.active {
        color: #fff !important;
        background-color: #27a9d7 !important;
    }

    /*.nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        color: #fff !important;
        background-color: #27a9d7 !important;
    }*/

    #HeaderTabName .nav-link:hover, #nav-tab .nav-link:hover {
        color: #fff;
        background-color: #27a9d7;
    }

    .tab-content {
        border: none;
        border-top-width: 0 !important;
    }

        .tab-content > .tab-pane {
            padding-right: 10px;
        }

    .tab-inner-content {
        border: 1px solid #ccc;
    }

    .card-header {
        padding: .25rem 0.35rem !important;
    }

    .btn-sm {
        font-size: 14px;
    }

    label {
        font-size: 14px;
    }

    .nav-item a {
        font-size: 13px;
    }

    table thead th {
        font-size: 13px !important;
        padding: 5px 10px !important;
    }

    table td, table tr {
        font-size: 13px;
        padding: 5px 10px !important;
    }
</style>
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Form Settings</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="active">Form Settings</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdnSelectedFormId" value="" />
<input type="hidden" id="hdnSelectedSection" value="" />
<input type="hidden" id="hdnSelectedSectionText" value="" />
<input type="hidden" id="hdnSelectedTab" value="" />
<input type="hidden" id="hdnTabSortOrder" value="" />
<input type="hidden" id="hdnSelectedTabName" value="" />
<input type="hidden" id="hdnSelectedTabGrid" value="" />
<input type="hidden" id="hdnParentForm" value="0" />
<input type="hidden" id="hdnSelectedFormSQLTableName" value="" />
<input type="hidden" id="hdnSelectedTabSQLTableName" value="" />
<input type="hidden" id="hdnSelectedFormSQLTemplateId" value="" />
<div class="animated fadeIn">
    <div class="row m-0">
        <div class="col-md-12 p-0">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-9">
                        <div class="d-flex align-items-center gap-4">
                            <!-- Parent Form -->
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div>
                                    <select id="ddlSelect" class="form-control" style="width:200px;">
                                        @if (Model != null && Model.ChildForm != null)
                                        {
                                            foreach (var item in Model.ChildForm)
                                            {
                                                <option data-bind="@item.Prefix" value="@item.FormId">
                                                    @item.FormTitle
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div style="display:flex; align-items:center;">
                                    <a class="btn btn-default btn-sm"
                                       id="btnAddNewFrom"
                                       href="javascript:void(0);"
                                       title="Add New Menu"
                                       data-toggle="modal"
                                       data-target="#formModal">
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <!-- Child Form -->
                            <div class="d-flex align-items-center">
                                <select id="ddlSubForm" class="form-control form-select" style="width:220px;"></select>

                                <a class="btn btn-sm ms-2"
                                   id="btnAddNewChildForm"
                                   href="javascript:void(0);"
                                   title="Add New Form"
                                   data-toggle="modal"
                                   data-target="#formModal">
                                    <i class="fa fa-plus"></i>
                                </a>

                                <a class="btn btn-sm ms-2"
                                   id="btnEditChildForm"
                                   href="javascript:void(0);"
                                   title="Edit Form"
                                   data-toggle="modal"
                                   data-target="#formModal">
                                    <i class="fa fa-pencil"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                    <div class="col-lg-3 text-right">
                        @*<a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>*@
                        <a class="btn btn-sm" href="@Url.Action("Index","Home")"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                        @*<a class="btn btn-sm" id="btnAddNewChildForm" href="javascript:void(0);" title="Add New Form" data-toggle="modal" data-target="#formModal"><i class="fa fa-plus"></i>&nbsp; Add New Form</a>*@
                        @*<a class="btn btn-sm" href="@Url.Action("ItemAction","Master")"><i class="fa fa-save"></i>&nbsp; Save</a>*@
                    </div>
                </div>
                <div class="card-body">
                    @*<div class="panel-left">
                        <table id="tblForms" class="display" cellspacing="0" width="100%"></table>
                    </div>*@
                    <div>
                        <div class="card" id="btnFormData">
                            <div class="card-header">
                                <div class="col-lg-6 pt-1">
                                    <strong class="card-title">Form: </strong>
                                    <label id="lblFormname"></label>
                                </div>
                                <div class="col-lg-6 text-right">
                                    <a class="btn btn-sm" id="btnTabRefresh" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                                    <a class="btn btn-sm" id="btnAddNewField" href="javascript:void(0);" title="Add New Field" data-toggle="modal" data-target="#formfieldModal"><i class="fa fa-plus"></i>&nbsp;Add New Field</a>
                                </div>
                            </div>
                            <div class="card-body">
                                <nav>
                                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                        @if (Model.FormSection != null && Model.FormSection.Count > 0)
                                        {
                                            foreach (var item in Model.FormSection)
                                            {
                                                if (item.SectionName == "Header")
                                                {
                                                    <button onclick="btnSection('@item.FormSectionId','@item.SectionName')" class="nav-link active" id="nav-Header-tab" data-bs-toggle="tab" data-bs-target="#nav-Header" type="button" role="tab" aria-controls="nav-Header" aria-selected="true">
                                                        <i class="fa fa-h-square"></i>&nbsp;@item.SectionName
                                                    </button>
                                                }
                                                else if (item.SectionName == "Detail")
                                                {
                                                    <button onclick="btnSection('@item.FormSectionId','@item.SectionName')" class="nav-link" id="nav-Detail-tab" data-bs-toggle="tab" data-bs-target="#nav-Detail" type="button" role="tab" aria-controls="nav-Detail" aria-selected="true">
                                                        <i class="fa fa-list"></i>&nbsp;@item.SectionName
                                                    </button>
                                                }
                                            }
                                        }
                                        <button class="nav-link" id="nav-report-tab" data-bs-toggle="tab" data-bs-target="#nav-report" type="button" role="tab" aria-controls="nav-report" aria-selected="true">
                                            <i class="fa fa-table"></i>&nbsp;Report
                                        </button>
                                        <button class="nav-link" onclick="DocSection()" id="nav-doc-tab" data-bs-toggle="tab" data-bs-target="#nav-doc" type="button" role="tab" aria-controls="nav-doc" aria-selected="true">
                                            <i class="fa fa-sort-numeric-asc"></i> &nbsp;Doc Number
                                        </button>
                                        <button class="nav-link" onclick="FormPendingSection()" id="nav-pending-tab" data-bs-toggle="tab" data-bs-target="#nav-pending" type="button" role="tab" aria-controls="nav-pending" aria-selected="true">
                                            <i class="fa fa-code-fork"></i> &nbsp;Pending
                                        </button>
                                        <button class="nav-link" id="nav-settings-tab" data-bs-toggle="tab" data-bs-target="#nav-settings" type="button" role="tab" aria-controls="nav-settings" aria-selected="true">
                                            <i class="fa fa-cog"></i> &nbsp;Settings
                                        </button>
                                    </div>
                                </nav>
                                <div class="tab-content" id="nav-tabContent" style="border:1px solid #ccc;">
                                    <div class="tab-pane fade active show" id="nav-Header" role="tabpanel" aria-labelledby="nav-Header-tab">
                                        <div class="p-3">
                                            <div class="row form-group">
                                                <div id="divHeaderTabs"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-Detail" role="tabpanel" aria-labelledby="nav-Detail-tab">
                                        <div class="p-3">
                                            <div class="row form-group">
                                                <div id="divDetailTabs"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-report" role="tabpanel" aria-labelledby="nav-report-tab">
                                        <div class="p-3">
                                            @Html.Action("ReportTab", "FormSetting", new { @formId = Model.FormId })
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-doc" role="tabpanel" aria-labelledby="nav-doc-tab">
                                        <div class="p-3">
                                            <div class="row">
                                                <div class="col-md-12 form-group">
                                                    <a class="btn btn-sm" id="btnAddNewDoc" href="javascript:void(0);" title="Add New Field" data-toggle="modal" data-target="#docNumberingModal">
                                                        <i class="fa fa-plus"></i>&nbsp;Add New Doc Numbering
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 form-group">
                                                    <table id="tblDocNumber" class="display cell-border" cellspacing="0" width="100%"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-pending" role="tabpanel" aria-labelledby="nav-pending-tab">
                                        <div class="p-3">
                                            <div class="row">
                                                <div class="col-md-12 form-group">
                                                    <a class="btn btn-sm" id="btnAddNewpending" href="javascript:void(0);" title="Add New Pending" data-toggle="modal" data-target="#formPendingModal">
                                                        <i class="fa fa-plus"></i>&nbsp;Add New Form Pending
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 form-group">
                                                    <table id="tblpending" class="display cell-border" cellspacing="0" width="100%"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-settings" role="tabpanel" aria-labelledby="nav-pending-tab">
                                        <div id="divFormSettings" class="p-3">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="tabModal" tabindex="-1" role="dialog" aria-labelledby="tabModal" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tabModellLabel">Add New Tab</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnTabSortOrderSelectedFormId" value="0" />
                <div class="row form-group">
                    <input type="hidden" id="hdnFormTabId" value="" />
                    <div class="col col-md-12">
                        <label for="text-input" class=" form-control-label">Tab Name<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <input type="text" id="txtFormTab" name="text-input" placeholder="Tab Name" maxlength="50" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="text-input" class=" form-control-label">Tab Title<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <input type="text" id="txtFormTabTitle" name="text-input" placeholder="Tab Title" maxlength="50" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="text-input" class=" form-control-label">Next Button Configuration</label>
                    </div>
                    <div class="col col-md-12">
                        <select class="form-control form-select" name="dropdown" id="ddlNextTabDataScript"></select>
                    </div>
                </div>

                @*<div class="row form-group">
                        <div class="col col-md-12">
                            <input type="checkbox" id="enableInlineForm" name="InlineForm" value="yes" style="margin: 5px;float: inline-start">
                            <label for="enableInlineForm">Enable Inline Form</label>
                        </div>
                    </div>*@
                <div class="row form-group" style="display:none;">
                    <div class="col col-md-12">
                        <label for="text-input" class=" form-control-label">SQL Table Name<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <input type="text" id="txtFormTabSQLTable" name="text-input" placeholder="SQL Table Name" maxlength="50" class="form-control">
                    </div>
                </div>
                <hr />

                <div id="divFormSettingsLoader" class="text-center p-2" style="display:none;">
                    <i class="fa fa-spinner fa-spin"></i> Loading settings...
                </div>
                <div class="row">
                    <div clasclass="col-md-12">
                        <label for="text-input" class=" form-control-label">Tab Configuration</label>
                    </div>
                    <div class="col-md-12 form-group">
                        <table id="tblSettings" class="display cell-border" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th>Action</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tblSettingsTbody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelTab" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="SaveTab();">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="formPendingModal" tabindex="-1" role="dialog" aria-labelledby="formPendingModal" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="PendingModelLabel">Add New Pending Setting</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group" style="display:none;">
                    <div class="col col-md-6">
                        <div class="col col-md-3">
                            <label for="text-input" class=" form-control-label">DocId</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <input type="text" id="txtFormPendingId" name="text-input" placeholder="Doc" maxlength="50" class="form-control" />
                        </div>
                    </div>
                </div>
                <fieldset class="custom-fieldset">
                    <legend class="custom-legend">Base Form</legend>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class=" form-control-label">Parent<span class="text-danger p-1">(*)</span></label>
                        </div>
                        <div class="col-12 col-md-12">
                            <select id="ddlfrmPending" class="form-control form-select">
                                @if (Model!= null && Model.ChildForm!= null)
                                                                {
                                                                    foreach (var item in Model.ChildForm)
                                                                    {
                                <option data-bind="@item.Prefix" value="@item.FormId.ToString().ToUpper()">@item.FormTitle</option>
                                                                    }
                                                                }
                            </select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class="form-control-label">From Form <span class="text-danger p-1">(*)</span></label>
                        </div>
                        <div class="col-12 col-md-12">
                            <select id="ddlfrmSubPending" class="form-control form-select"></select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class="form-control-label">From Tab</label>
                        </div>
                        <div class="col-12 col-md-12">
                            <select id="ddlfrmTabPending" class="form-control form-select"></select>
                        </div>
                    </div>
                </fieldset>
                <br />
                <fieldset class="custom-fieldset">
                    <legend class="custom-legend">To Form</legend>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class=" form-control-label">Tab Name<span class="text-danger p-1">(*)</span></label>
                        </div>
                        <div class="col-12 col-md-12">
                            <input type="text" id="txtFormTabName" name="text-input" placeholder="Pending Tab Name" maxlength="50" class="form-control" />
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class=" form-control-label">Source<span class="text-danger p-1">(*)</span></label>
                        </div>
                        <div class="col-12 col-md-12">
                            <select id="ddlfrmPendingSource" class="form-select select2"></select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-12">
                            <label for="text-input" class=" form-control-label">Current Form Tab</label>
                        </div>
                        <div class="col-12 col-md-12">
                            <select id="ddlfrmTab" class="form-control form-select"></select>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelPending" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="SaveFormPending();">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="docNumberingModal" tabindex="-1" role="dialog" aria-labelledby="docNumberingModal" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docModelLabel">Add New Document Numbering</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group" style="display:none;">
                    <div class="col col-md-6">
                        <div class="col col-md-3">
                            <label for="text-input" class=" form-control-label">DocId</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <input type="text" id="txtDocId" name="text-input" placeholder="Doc" maxlength="50" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Doc Name<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtDocName" name="text-input" placeholder="Document Name" maxlength="50" class="form-control" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Alias<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtDocAlias" name="text-input" placeholder="Alias" maxlength="50" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Start No<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtStartNo" name="text-input" placeholder="Start Number" maxlength="50" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Is Default </label>
                    </div>
                    <div class="col-12 col-md-9">
                        <label class="switch switch-3d switch-success mr-3">
                            <input type="checkbox" id="chkIsDefault" class="switch-input" checked="checked"> <span class="switch-label"></span>
