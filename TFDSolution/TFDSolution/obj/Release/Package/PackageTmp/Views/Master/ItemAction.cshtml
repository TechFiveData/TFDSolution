@model TFDSolution.Transport.Master.ItemMast

@{
    ViewBag.Title = "ItemAction";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- /header -->
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                @if (string.IsNullOrEmpty(Model.ItemDescription))
                {
                    <h1>Add New Item </h1>
                }
                else
                {
                    <h1>Edit Item: @Model.ItemCode </h1>
                }
            </div>
        </div>
    </div>

    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li><a href="@Url.Action("Item","Master")">Item Master</a></li>
                    @if (!string.IsNullOrEmpty(Model.ItemDescription))
                    {
                        <li class="active">Edit Item</li>
                    }
                    else
                    {
                        <li class="active">Add New Item</li>
                    }
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    @using (Html.BeginForm("ItemAction", "Master", FormMethod.Post))
    {
        if (ViewBag.ErrorMessages != null)
        {
            <div id="divError">
                <div class="alert alert-danger">
                    <strong>Danger!</strong>  @ViewBag.ErrorMessages
                </div>
            </div>
        }
        if (ViewBag.SuccessMessage != null)
        {
            <script type="text/javascript">
                ShowToastNotification("success", "Record saved successfully.");
                setTimeout(function () {
                    var backURL = "@Url.Action("Item","Master")"
                    location.href = backURL;
                }, 6000);
            </script>
        }
        @Html.HiddenFor(m => m.ItemId)
        @Html.HiddenFor(m => m.ItemCode)
        <div class="row m-0">

            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-lg-6">
                            <strong class="card-title"></strong>
                        </div>
                        <div class="col-lg-6 text-right">
                            <a class="btn btn-sm" id="btnrefresh" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                            <a class="btn btn-sm" id="btnBack" href="@Url.Action("Item","Master")"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                            <button class="btn btn-sm" type="submit"><i class="fa fa-save"></i>&nbsp; Save</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="general">
                            <div class="form-horizontal page-head">
                                <div class="section-left">
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label class=" form-control-label">Item Code</label></div>
                                        <div class="col-12 col-md-9 text-left">
                                            @Html.TextBoxFor(m => m.ItemCode, new { @placeholder = "Item Code", @class = "form-control", @disabled = "disabled" })
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label for="select" class=" form-control-label">Item Status<span class="text-danger p-1">(*)</span></label></div>
                                        <div class="col-12 col-md-9 pt-2">
                                            <label class="switch switch-3d switch-success mr-3">
                                                @Html.CheckBoxFor(m => m.ItemStatus, new { @class = "switch-input" })
                                                @*<input type="checkbox" class="switch-input" checked="true">*@
                                                <span class="switch-label"></span> <span class="switch-handle"></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3">
                                            <label for="text-input" class=" form-control-label">Item Description<span class="text-danger p-1">(*)</span></label>
                                        </div>
                                        <div class="col-12 col-md-9 form-group">
                                            @Html.TextBoxFor(m => m.ItemDescription, new { @placeholder = "Item Description", @class = "form-control", @required = "required" })
                                            @Html.ValidationMessageFor(m => m.ItemDescription, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3">
