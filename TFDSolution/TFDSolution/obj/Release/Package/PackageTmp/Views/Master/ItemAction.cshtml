<div class="modal fade" id="mediumModal" tabindex="-1" role="dialog" aria-labelledby="mediumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mediumModalLabel">Medium Modal</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>
                    Msg Body
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function SetDefaultSelection(did, ddlValue) {
        if (ddlValue != "" && ddlValue.length > 0 && ddlValue != "0")
        {
            $("#" + did).val(ddlValue).attr('selected', true);
        }
    }
    $(document).ready(function () {
        $('#btnrefresh').click(function () {
            location.reload();
        });
        loadDropdownMaster("ddlTaxSlab", "TaxSlab");

        SetDefaultSelection("ddlItemGroup", '@Model.ItemGroup');
        SetDefaultSelection("ddlItemUOM", '@Model.ItemUOM');
        SetDefaultSelection("ddlItemCategory", '@Model.ItemCategory');
        SetDefaultSelection("ddlItemType", '@Model.ItemType');
        SetDefaultSelection("ddlPackingType", '@Model.PackingType');
        SetDefaultSelection("ddlPurchaseTaxPercentage", '@Model.PurchaseTaxPercentage');
        SetDefaultSelection("ddlSalesTaxPercentage", '@Model.SalesTaxPercentage');
        SetDefaultSelection("ddlPurchaseHSNCode", '@Model.PurchaseHSNCode');
        SetDefaultSelection("ddlSalesHSNCode", '@Model.SalesHSNCode');
        SetDefaultSelection("ddlValuationMethod", '@Model.ValuationMethod');
        $("#pageLoader").hide();
    });
     function loadDropdownMaster(dropdownId, entryType) {
      $.ajax({
          url: '@Url.Action("getSelection", "Master")',
          type: 'GET',
          data: {
              _type: entryType,
              _whareClause: "",
              _orderType: "",
              _entryType: ""
          },
          success: function (data) {
              var dropdown = $('#' + dropdownId);
              dropdown.empty().append('<option value="">Select ' + entryType + '</option>');
              $.each(data, function (i, item) {
                  dropdown.append($('<option></option>').val(item.Value).text(item.Text));
              });
              $("#pageLoader").hide();
              if (entryType == "TaxSlab") {
                  SetDefaultSelection("ddlTaxSlab", '@Model.TaxSlabId');
              }
          },
          error: function () {
              $("#pageLoader").hide();
              console.log("Error loading dropdown: " + entryType);
          }
      });
 }
    function loadDropdown(dropdownId, entryType) {
        $.ajax({
            url: '@Url.Action("getSelection", "Master")',
            type: 'GET',
            data: {
                _type: "Parameter",
                _whareClause: "",
                _orderType: "",
                _entryType: entryType
            },
            success: function (data) {
                var dropdown = $('#' + dropdownId);
                dropdown.empty().append('<option value="">Select ' + entryType + '</option>');
                $.each(data, function (i, item) {
                    dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                });
                $("#pageLoader").hide();
            },
            error: function () {
                $("#pageLoader").hide();
                console.log("Error loading dropdown: " + entryType);
            }
        });
    }

