@model TFDSolution.Models.RegisterModel
@{
    ViewBag.Title = "Index";
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    @{
        var ImagesBase = Url.Content("~/Images");
        var ContentBase = Url.Content("~/Content");
    }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TFD | Registration</title>
    <link rel="stylesheet" href="@ContentBase/theme//theme1/login.css">
    <link href="@ContentBase/main/assets/css/style.css" rel="stylesheet" />
    <link href="@ContentBase/main/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@ContentBase/bootstrap.min.css" rel="stylesheet" />
    <link href="@ContentBase/main/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="@ContentBase/main/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>


        /* =========================================
           PAGE
        ========================================= */
        .register-page {
            min-height: 100vh;
            position: relative;
            overflow: hidden;
             background-image: url('@Url.Content(ImagesBase + "/theme1.jpg")');
 background-size: cover;
 background-position: center;
 background-repeat: no-repeat;
        }
        /* =========================================
           MAIN
        ========================================= */

        .main-container {
            min-height: calc(100vh - 105px);
            display: flex;
            align-items: center;
            padding: 40px 20px;
            position: relative;
            z-index: 2;
        }

        .register-container {
            max-width: 1180px;
            width: 100%;
            margin: auto;
        }


        /* =========================================
           LEFT PANEL
        ========================================= */

        .intro-panel {
            padding: 35px 50px;
            position: relative;
        }

        .intro-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(39,169,215,.10);
            color: #1689b7;
            border-radius: 30px;
            padding: 7px 14px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 20px;
        }

            .intro-badge i {
                margin-right: 7px;
            }

        .intro-title {
            font-size: 44px;
            line-height: 1.12;
            font-weight: 700;
            color: #253746;
            margin-bottom: 18px;
        }

            .intro-title span {
                color: #27a9d7;
            }

        .intro-description {
            max-width: 500px;
            font-size: 16px;
            line-height: 1.7;
            color: #64748b;
            margin-bottom: 30px;
        }


        /* =========================================
           FEATURE ITEMS
        ========================================= */

        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 35px;
        }

        .feature {
            background: white;
            border: 1px solid #e7edf2;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            color: #536273;
            box-shadow: 0 4px 12px rgba(20,50,70,.04);
        }

            .feature i {
                color: #27a9d7;
                margin-right: 6px;
            }


        /* =========================================
           ERP VISUAL
        ========================================= */

        .erp-visual {
            width: 100%;
            max-width: 480px;
            height: 210px;
            position: relative;
            margin-top: 15px;
        }

        .visual-card {
            position: absolute;
            background: white;
            border-radius: 14px;
            box-shadow: 0 15px 35px rgba(30,70,90,.10);
            border: 1px solid rgba(0,0,0,.05);
        }

        .visual-main {
            width: 330px;
            height: 180px;
            left: 50px;
            top: 15px;
            padding: 18px;
        }

        .visual-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .visual-header-title {
            font-size: 12px;
            font-weight: 600;
            color: #526170;
        }

        .visual-dots span {
            width: 6px;
            height: 6px;
            display: inline-block;
            border-radius: 50%;
            background: #d8e1e7;
            margin-left: 3px;
        }

        .chart {
            height: 85px;
            display: flex;
            align-items: flex-end;
            gap: 9px;
            padding: 0 5px;
            border-bottom: 1px solid #e9eef2;
        }

        .bar {
            width: 24px;
            border-radius: 5px 5px 0 0;
            background: #bfe9f7;
        }

            .bar:nth-child(1) {
                height: 38%;
            }

            .bar:nth-child(2) {
                height: 58%;
            }

            .bar:nth-child(3) {
                height: 45%;
            }

            .bar:nth-child(4) {
                height: 78%;
                background: #27a9d7;
            }

            .bar:nth-child(5) {
                height: 64%;
            }

            .bar:nth-child(6) {
                height: 88%;
                background: #168fb9;
            }

        .visual-small {
            width: 135px;
            height: 95px;
            right: 0;
            bottom: -5px;
            padding: 14px;
        }

        .small-title {
            font-size: 10px;
            color: #8795a1;
        }

        .small-value {
            font-size: 20px;
            font-weight: 700;
            color: #263746;
            margin-top: 7px;
        }

        .small-growth {
            font-size: 9px;
            color: #27a9d7;
            margin-top: 5px;
        }


        /* =========================================
           REGISTER CARD
        ========================================= */

        .register-card {
            background: white;
            border-radius: 18px;
            padding: 30px 32px 25px;
            box-shadow: 0 20px 55px rgba(30,60,80,.12), 0 3px 10px rgba(30,60,80,.04);
            border: 1px solid rgba(0,0,0,.04);
            max-width: 475px;
            margin-left: auto;
        }

        .register-heading {
            text-align: center;
            margin-bottom: 25px;
        }

        .register-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(39,169,215,.10);
            color: #27a9d7;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
        }

            .register-icon i {
                font-size: 19px;
            }

        .register-heading h2 {
            font-size: 25px;
            font-weight: 650;
            color: #273746;
            margin: 0 0 5px;
        }

        .register-heading p {
            margin: 0;
            color: #8a97a4;
            font-size: 13px;
        }


        /* =========================================
           FORM
        ========================================= */

        .form-row-custom {
            display: flex;
            gap: 12px;
        }

            .form-row-custom .form-group {
                flex: 1;
            }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 600;
            color: #526170;
            margin-bottom: 6px;
        }

        .required {
            color: #e05252;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0acb7;
            font-size: 13px;
            z-index: 2;
        }

        .password-toggle {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ba7b1;
            cursor: pointer;
        }

            .password-toggle:hover {
                color: #27a9d7;
            }


        /* =========================================
           PASSWORD STRENGTH
        ========================================= */

        .password-strength {
            display: flex;
            gap: 4px;
            margin-top: 7px;
        }

        .strength-line {
            height: 3px;
            flex: 1;
            border-radius: 3px;
            background: #e7edf1;
        }

        .strength-text {
            font-size: 10px;
            color: #9aa5af;
            margin-top: 4px;
        }


        /* =========================================
           BUTTON
        ========================================= */

        .btn-create {
            width: 100%;
            height: 45px;
            border: 0;
            border-radius: 8px;
            background: linear-gradient(135deg,#27a9d7,#168fb9);
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(39,169,215,.22);
            transition: all .25s ease;
            margin-top: 3px;
        }

            .btn-create:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(39,169,215,.30);
            }

            .btn-create i {
                margin-left: 7px;
            }


        /* =========================================
           LOGIN
        ========================================= */

        .login-text {
            text-align: center;
            color: #8a96a1;
            font-size: 12px;
            margin-top: 18px;
        }

            .login-text a {
                color: #168fb9;
                font-weight: 600;
                text-decoration: none;
            }

                .login-text a:hover {
                    text-decoration: underline;
                }


      

        /* =========================================
           DECORATIVE CIRCLES
        ========================================= */

        .circle-one {
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            border: 50px solid rgba(39,169,215,.035);
            left: -180px;
            bottom: -150px;
        }

        .circle-two {
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(39,169,215,.025);
            right: -80px;
            top: 100px;
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media(max-width: 991px) {

            .intro-panel {
                padding: 20px;
            }

            .intro-title {
                font-size: 36px;
            }

            .erp-visual {
                display: none;
            }

            .register-card {
                margin: auto;
            }
        }

        @@media(max-width: 767px) {

            .topbar {
                padding: 0 18px;
            }

            .help-link {
                display: none;
            }

            .main-container {
                padding: 25px 15px;
                align-items: flex-start;
            }

            .intro-panel {
                text-align: center;
                padding: 10px 10px 30px;
            }

            .intro-title {
                font-size: 31px;
            }

            .intro-description {
                font-size: 14px;
                margin-left: auto;
                margin-right: auto;
            }

            .features {
                justify-content: center;
            }

            .register-card {
                width: 100%;
                padding: 25px 20px;
                border-radius: 15px;
            }
        }

        @@media(max-width: 480px) {

            .brand-name {
                font-size: 16px;
            }

            .form-row-custom {
                display: block;
            }

            .register-heading h2 {
                font-size: 23px;
            }

            .footer {
                font-size: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="register-page">

        <!-- Decorative background -->
        <div class="circle-one"></div>
        <div class="circle-two"></div>
        <!-- =========================================
             TOP BAR
        ========================================== -->
        <header class="topbar">
            <a href="#" class="brand">
                <div class="brand-logo">
                    <i class="fa fa-bar-chart"></i>
                </div>
                <div class="brand-name">
                    LotusNext <span>ERP</span>
                </div>
            </a>
            <a href="#" class="help-link">
                <i class="fa fa-question-circle"></i>
                Need Help?
            </a>
        </header>
        <!-- =========================================
             MAIN
        ========================================== -->
        <main class="main-container">
            <div class="register-container">
                <div class="row align-items-center">
                    <!-- =================================
                         LEFT
                    ================================== -->
                    <div class="col-lg-6">
                        <div class="intro-panel d-none">
                            <div class="intro-badge">
                                <i class="fa fa-sparkles"></i>
                                SMART BUSINESS MANAGEMENT
                            </div>
                            <h1 class="intro-title">
                                Run your business
                                <br>
                                <span>smarter with ERP.</span>
                            </h1>
                            <p class="intro-description">

                                Bring your finance, inventory, sales,
                                purchasing and operations together with
                                one powerful ERP platform designed for
                                modern businesses.
                            </p>
                            <div class="features">
                                <div class="feature">
                                    <i class="fa fa-shield-alt"></i>
                                    Secure
                                </div>
                                <div class="feature">
                                    <i class="fa fa-bolt"></i>
                                    Powerful
                                </div>
                                <div class="feature">
                                    <i class="fa fa-cloud"></i>
                                    Cloud Ready
                                </div>
                                <div class="feature">
                                    <i class="fa fa-chart-line"></i>
                                    Business Insights
                                </div>
                            </div>
                            <!-- ERP Dashboard Illustration -->
                            <div class="erp-visual">
                                <div class="visual-card visual-main">
                                    <div class="visual-header">
                                        <div class="visual-header-title">
                                            Business Overview
                                        </div>
                                        <div class="visual-dots">
                                            <span></span>
                                            <span></span>
                                            <span></span>
                                        </div>
                                    </div>
                                    <div class="chart">
                                        <div class="bar"></div>
                                        <div class="bar"></div>
                                        <div class="bar"></div>
                                        <div class="bar"></div>
                                        <div class="bar"></div>
                                        <div class="bar"></div>
                                    </div>
                                </div>
                                <div class="visual-card visual-small">
                                    <div class="small-title">
                                        Revenue
                                    </div>
                                    <div class="small-value">
                                        ₹ 24.8L
                                    </div>
                                    <div class="small-growth">
                                        <i class="fa fa-arrow-up"></i>
                                        18.6% Growth
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- =================================
                         RIGHT FORM
                    ================================== -->
                    <div class="col-lg-6">
                        <div class="register-card">
                            <!-- Heading -->
                            <div class="register-heading">
                                @*<div class="register-icon">
                                    <i class="fa fa-user-plus"></i>
                                </div>*@
                                <h2>Create your account</h2>
                                <p>
                                    Register to start using LotusNext ERP
                                </p>
                            </div>
                            @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { autocomplete = "off" }))
                            {
                                @Html.ValidationSummary(false, null, new { @class = "validation-summary-errors-alerts" })
                                <!-- First / Last Name -->
                                <div class="form-row-custom">
                                    <div class="form-group">
                                        <label class="form-label">
                                            First Name
                                            <span class="required">*</span>
                                        </label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-user input-icon"></i>
                                            @Html.TextBoxFor(a => a.FirstName, new { @Required = "Required", @placeholder = "First name", @class = "form-control form-control-icon" })
                                            @Html.ValidationMessageFor(a => a.FirstName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">
                                            Last Name
                                            <span class="required">*</span>
                                        </label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-user input-icon"></i>
                                            @Html.TextBoxFor(a => a.LastName, new { @Required = "Required", @class="form-control form-control-icon", @placeholder="Last name" })
                                            @Html.ValidationMessageFor(a => a.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <!-- Email -->
                                <div class="form-group">
                                    <label class="form-label">
                                        Email Address
                                        <span class="required">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-envelope input-icon"></i>
                                        @Html.TextBoxFor(a => a.EmailId, new { @type = "email", @class="form-control form-control-icon", @placeholder="you@example.com", @Required = "Required" })
                                        @Html.ValidationMessageFor(a => a.EmailId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <!-- Username -->
                                <div class="form-group">
                                    <label class="form-label">
                                        Username
                                        <span class="required">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-user-circle input-icon"></i>
                                        @Html.TextBoxFor(a => a.UserName, new { @class = "form-control form-control-icon", @placeholder = "Choose a username", @Required = "Required" })
                                        @Html.ValidationMessageFor(a => a.UserName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <!-- Password -->
                                <div class="form-group">
                                    <label class="form-label">
                                        Password
                                        <span class="required">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-lock input-icon"></i>
                                        <input type="Password" id="Password" name="Password"
                                               pattern="^(?=.*\d)(?=.*[a-zA-Z])(?=.*[^a-zA-Z0-9])\S{8,}$"
                                               class="form-control form-control-icon"
                                               placeholder="Enter new passwrod"
                                               title="Password must contain at least one number, one alphabet, one symbol, and be at
least 8 characters long" required />
                                        @Html.ValidationMessageFor(a => a.Password, "", new { @class = "text-danger",})                                        
                                        <span class="password-toggle"
                                              onclick="togglePassword('Password', this)">
                                            <i class="fa fa-eye"></i>
                                        </span>
                                    </div>
                                    <div class="password-strength">
                                        <div class="strength-line"></div>
                                        <div class="strength-line"></div>
                                        <div class="strength-line"></div>
                                        <div class="strength-line"></div>
                                    </div>
                                    <div class="strength-text">
                                        Use at least 8 characters
                                    </div>
                                </div>
                                <!-- Confirm Password -->
                                <div class="form-group">
                                    <label class="form-label">
                                        Confirm Password
                                        <span class="required">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-lock input-icon"></i>
                                        <input type="password" id="ConfirmPassword" class="form-control form-control-icon" placeholder="Confirm your password" name="ConfirmPassword" required />
                                        @Html.ValidationMessageFor(a => a.ConfirmPassword, "", new { @class = "text-danger" })
                                         <span class="password-toggle"
                                              onclick="togglePassword('ConfirmPassword', this)">
                                            <i class="fa fa-eye"></i>
                                        </span>
                                    </div>
                                </div>
                                <!-- Contact -->
                                <div class="form-group">
                                    <label class="form-label">
                                        Contact Number
                                        <span class="required">*</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-phone input-icon"></i>
                                        <input type="text" id="mobile" name="mobile" maxlength="10" class="form-control form-control-icon"
                                         placeholder="Contact Number" required />
                                    </div>
                                </div>
                                <!-- Submit -->
                                <button type="submit"
                                        class="btn-create">
                                    Create Account
                                    <i class="fa fa-arrow-right"></i>
                                </button>
                                <!-- Login -->
                                <div class="login-text">
                                    Already have an account?
                                    <a href="@Url.Action("Index","Login")">
                                        Sign in
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <!-- =========================================
             FOOTER
        ========================================== -->
        <footer class="footer">
            &copy; @DateTime.Now.Year Lotus Next ERP. All rights reserved.
        </footer>
    </div>
    <script>
        function togglePassword(inputId, element) {
            const input = document.getElementById(inputId);
            const icon = element.querySelector("i");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");

            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
        // Password strength
        document.getElementById("password")
            .addEventListener("input", function () {
                const value = this.value;
                const lines =
                    document.querySelectorAll(".strength-line");
                let strength = 0;
                if (value.length >= 8)
                    strength++;
                if (/[A-Z]/.test(value))
                    strength++;
                if (/[0-9]/.test(value))
                    strength++;
                if (/[^A-Za-z0-9]/.test(value))
                    strength++;
                lines.forEach(function (line, index) {
                    line.style.background =
                        index < strength
                            ? "#27a9d7"
                            : "#e7edf1";
                });
            });
    </script>
</body>
</html>