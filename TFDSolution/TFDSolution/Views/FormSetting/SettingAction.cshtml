@model TFDSolution.Transport.Master.FormMast

@{
    ViewBag.Title = "SettingAction";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Form : @Model.FormTitle</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li><a href="@Url.Action("Settings","FormSetting")">Form Settings</a></li>
                    <li>@Model.FormTitle</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    <div class="row">
        <div class="col-md-12 p-0">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-6">
                        <strong class="card-title"></strong>
                    </div>
                    <div class="col-lg-6 text-right">
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                        <a class="btn btn-sm" href="@Url.Action("ItemAction","Master")"><i class="fa fa-save"></i>&nbsp; Save</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row form-group">
                        <div class="col col-md-3">
                            <label for="text-input" class=" form-control-label">Form Name</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <input type="text" id="txtFormName" width="200" name="text-input" value="@Model.FormName" disabled placeholder="Form Name" class="form-control" style="width:100px;">
                            <input type="text" id="txtSQLTableName" width="200" name="text-input" value="@Model.SQLTableName" disabled placeholder="Form Name" class="form-control" style="width:100px;">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-3">
                            <label for="select" class=" form-control-label">Form Status</label>&nbsp;&nbsp;
                        </div>
                        <div class="col-12 col-md-9">
                            <label class="switch switch-3d switch-success mr-3">
                                <input type="checkbox" id="chkFormStatus" class="switch-input" checked="true"> <span class="switch-label"></span> <span class="switch-handle"></span>
                            </label>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-3">
                            <label for="text-input" class=" form-control-label">Form Title</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <input type="text" id="txtFormTitle" name="text-input" value="@Model.FormTitle" maxlength="50" placeholder="Form Titile" class="form-control w-50">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-3">
                            <label for="text-input" class=" form-control-label">Form Description</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <input type="text" id="txtFormDescription" name="text-input" value="@Model.FormDescription" maxlength="500" placeholder="form Description" class="form-control">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-12 col-md-12 section-title">
                            <label>
                                Forms
                                <div style="float:right;">
                                    <a class="btn btn-sm" href="@Url.Action("ItemAction","Master")" data-toggle="modal" data-target="#formModal"
                                       title="Click here to add new form"><i class="fa fa-plus"></i>&nbsp; Add New Form</a>
                                </div>
                            </label>
                        </div>
                        <div class="col-12 col-md-12 section-body">
                            <div class="row form-group">
                                <table id="tblForm" class="display nowrap cell-border" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Form Name</th>
                                            <th>Form Title</th>
                                            <th>Form Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ChildForm)
                                        {
                                            <tr>
                                                <td>@item.FormName</td>
                                                <td>@item.FormTitle</td>
                                                <td>@item.IsActive</td>
                                                <td>
                                                    <a href="javascript:vid(0);">Edit</a>
                                                    &nbsp;|&nbsp;
                                                    <a href="javascript:vid(0);">Delete</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-12 col-md-12 section-title">
                            <label>
                                Form Fields
                                <div style="float:right;">
                                    <a class="btn btn-sm" href="@Url.Action("ItemAction","Master")" title="Click here to add new field"
                                       data-toggle="modal" data-target="#fieldModal"><i class="fa fa-plus"></i>&nbsp; Add New Field</a>
                                </div>
                            </label>
                        </div>
                        <div class="col-12 col-md-12 section-body">
                            <div class="row form-group">
                                <table id="tblFileds" class="display nowrap cell-border" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Section Name</th>
                                            <th>Tab Name</th>
                                            <th>Field Name</th>
                                            <th>Field Type</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.FormFields)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="javascript:vid(0);"><i class='fa fa-pencil'></i></a>
                                                    &nbsp;|&nbsp;
                                                    <a href="javascript:vid(0);"><i class='fa fa-trash text-danger'></i></a>
                                                </td>
                                                <td>@item.SectionName</td>
                                                <td>@item.TabName</td>
                                                <td>@item.FieldName</td>
                                                <td>@item.FieldType</td>
                                                <td>
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="fa fa-check text-success"></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fa fa-remove text-danger"></span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="formModal" tabindex="-1" role="dialog" aria-labelledby="mediumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mediumModalLabel">Add New Form</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Form Name</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtAFormName" name="text-input" placeholder="Form Name" maxlength="50" class="form-control" disabled>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">SQL Table Name</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtASQLTableName" name="text-input" placeholder="Form Name" maxlength="50" class="form-control" disabled>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Form Title</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtAFormTitle" name="text-input" placeholder="Form Title" maxlength="50" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Form Description</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtAFormDesc" name="text-input" rows="9" placeholder="Form Description" maxlength="500" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Status</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <label class="switch switch-3d switch-success mr-3">
                            <input type="checkbox" class="switch-input" checked="true"> <span class="switch-label"></span>
                            <span class="switch-handle"></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="fieldModal" tabindex="-1" role="dialog" aria-labelledby="mediumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mediumModalLabel">Add New Field</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Name
                        <span class="text-danger p-2">*</span>
                        </label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtAFieldName" name="text-input" placeholder="Field Name" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Title<span class="text-danger p-2">*</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="txtAFieldCaption" name="text-input" placeholder="Field Caption" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Section<span class="text-danger p-2">*</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        @Html.DropDownList("ddlSection", new SelectList(ViewBag.SectionList, "Value", "Text"), "Select Section", new { @class = "form-control" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Tab</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <select id="ddlTab" class="form-control">
                            <option>Select Tab</option>
                        </select>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Types<span class="text-danger p-2">*</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        @Html.DropDownList("ddlFieldType", new SelectList(ViewBag.FieldTypeList, "Value", "Text"), "Select Type", new { @class = "form-control" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Length</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="number" id="txtAFieldLength" name="text-input" maxlength="4" style="width:50px;" placeholder="Field Length" class="form-control">
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="text-input" class=" form-control-label">Field Status<span class="text-danger p-2">*</span></label>
                    </div>
                    <div class="col-12 col-md-9">
                        <div class="col-md-6">
                            <label class="switch switch-3d switch-success mr-3">
                                <input type="checkbox" class="switch-input" checked="true"> <span class="switch-label"></span> <span class="switch-handle"></span>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <div class="col col-md-7">
                                <label for="text-input" class=" form-control-label">Required Field</label>
                            </div>
                            <label class="switch switch-3d switch-success mr-3">
                                <input type="checkbox" class="switch-input" checked="true"> <span class="switch-label"></span> <span class="switch-handle"></span>
                            </label>
                        </div>                        
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        new DataTable('#tblForm');
        new DataTable('#tblFileds');
    })
</script>
