    function SaveField()
    {
        var SPParams = [];
        var isFormValid = true, isFieldLength = true;
        var isParent = $("#hdnParentForm").val();
        var fieldType = $("#v-pills-fieldstypetab").find("button.active").data("fieldtype");
        $("#formfieldModal input").each(function () {
            var fieldId = $(this).attr("id");
            if ($.trim($(this).val()).length == 0 && (fieldId != "txtFieldFormula" && fieldId != "txtFieldPlaceholder" && fieldId != "txtFieldHelptext")) {
                if (fieldId == "txtFieldLength" && (fieldType == "MultiText" || fieldType == "TextBox" || fieldType == "Selection")) {
                    $(this).addClass("input-validation-error");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                }
                else if (fieldId == "txtFieldname" || fieldId == "txtFieldcaption"){
                    $(this).addClass("input-validation-error");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                }
            }
            else if ($.trim($(this).val()).length > 0 && fieldId == "txtFieldLength" &&
                (fieldType == "MultiText" || fieldType == "TextBox" || fieldType == "Selection")) {
                var minText = parseInt($(this).attr("data-bind"));
                if (parseInt($(this).val()) < minText) {
                    $(this).addClass("input-validation-error");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFieldLength = false;
                    isFormValid = false;
                } else {
                    $(this).removeClass("input-validation-error");
                }
            }
            else {
                $(this).removeClass("input-validation-error");
            }
        });
        if (isFormValid) {
            $("#formfieldModal select").each(function () {
                var fieldId = $(this).attr("id");
                //if ((fieldType == "Selection" || fieldType == "Label")
                 if ((fieldType == "Selection")
                    && (fieldId == "ddlTables" || fieldId == "ddlSelectText" || fieldId == "ddlSelectValue")) {
                    if ($.trim($(this).val()).length == 0) {
                        $(this).addClass("input-validation-error");
                        if (isFormValid == true) {
                            $(this).focus();
                        }
                        isFormValid = false;
                    }
                    else {
                        $(this).removeClass("input-validation-error");
                    }
                }
            });
        }
        if (!isFormValid) {
            if (!isFieldLength) {
                ShowToastNotification("error", "Field length cannot be decreased");
            }
            else {
                ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
            }
        }
        else {

            if ($('input[name="inline-radios"]:checked').val() == "StoredProcedure" && $('#tblRequest tbody>tr').length > 0) {
                var spTableName = $("#hdnSelectedTabSQLTableName").val();

                $('#tblRequest tbody>tr').each(function () {
                    if (isFormValid) {
                        if ($(this) != null) {
                            var _paramName = "", _paramMapField = "";
                            $('td', this).each(function () {
                                if ($(this).hasClass('paramName')) {
                                    _paramName = $(this).text();
                                }
                                else if ($(this).hasClass('paramField')) {
                                    _paramMapField = $(this).find('select').val();
                                    if (_paramMapField == "0") {
                                        isFormValid = false;
                                    }
                                }
                            });
                            SPParams.push({
                                ParameterId: 0,
                                ParameterName: _paramName,
                                ParameterValueFieldName: _paramMapField,
                                ParameterFromTable: spTableName
                            });
                        }
                    }
                });
            }
            if (!isFormValid) {
                ShowToastNotification("error", "Please select field in Stored Procedure Request.");
            }
            else {
                try {
                    var ddlSource = $('input[type=radio][name=inline-radios]:checked').val();
                    var sectionId = $("#hdnSelectedSection").val();
                    var tabId = $("#hdnSelectedTab").val();
                    if (fieldType == "Label") {
                        $("#txtFieldLength").val("3000");
                    }
                    else if ($("#chkIsMultiSelection").prop("checked")) {
                        $("#txtFieldLength").val("3999");
                    }
                    var modal = {
                        FieldName: $("#txtFieldname").val(),
                        FieldCaption: $("#txtFieldcaption").val(),
                        FieldLength: $("#txtFieldLength").val(),
                        FieldPlaceHolder: $("#txtFieldPlaceholder").val(),
                        FieldHelpText: $("#txtFieldHelptext").val(),
                        IsRequired: $("#chkRequired").prop("checked"),
                        IsActive: $("#chkStatus").prop("checked"),
                        FormId: $("#hdnSelectedFormId").val(),
                        FieldFormula: $("#txtFieldFormula").val(),
                        FormTabId: tabId,
                        FieldTypeId: $("#hdnFieldTypeId").val(),
                        FormSectionId: sectionId,
                        FieldId: $("#hdnFieldId").val(),
                        DDLSourceType: ddlSource,
                        DDLSourceName: $("#ddlTables").val(),
                        DDLTextField: $("#ddlSelectText").val(),
                        DDLValueField: (fieldType == "Button" ? $("#ddlFieldSelectButton").val() : $("#ddlSelectValue").val()),
                        FieldSize: $("#ddlFieldSize").val(),
                        FieldDecimal: $("#ddlFieldDecimal").val(),
                        IsReadOnly: $("#chkIsReadOnly").prop("checked"),
                        IsSummary: $("#chkIsSummary").prop("checked"),
                        IsDependencyField: $("#chkIsDependencyField").prop("checked"),
                        IsVisible: $("#chkIsVisible").prop("checked"),
                        IsDisable: $("#chkIsDisabled").prop("checked"),
                        IsUnique: $("#chkIsUnique").prop("checked"),
                        IsMultiSelection: $("#chkIsMultiSelection").prop("checked"),
                        AllowMultiDocument: $("#chkMultipleDocument").prop("checked"),
                        IsVisibleInList: $("#chkIsVisibleInList").prop("checked"),
                        SortOrder: $("#hdnSortOrder").val(),
                        FieldType: fieldType,
                        TabName: $("#hdnSelectedTabName").val(),
                        SQLTableName: $("#hdnSelectedTabSQLTableName").val(),
                        SectionName: $("#hdnSelectedTabName").val(),
                        Parameters: SPParams,
                        TemplateId: $("#ddlButtonTemplate").val(),
                        ItemAdvanceId: parseInt($("#hdnSelectedTab").val())
                    };

                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("SaveFormItemAdvanceField", "FormSetting")',
                        contentType: "application/json;",
                        data: JSON.stringify(modal),
                        async: false,
                        success: function (response) {
                            if (response.IsSuccess) {
                                ShowToastNotification("success", "Record saved successfully.");
                                $("#btn_TextBox").click();
                                AddNewField();
                                $('#btnCancelField').click();
                                GetFormFieldList();
                            }
                            else {
                                ShowToastNotification("error", response.Response);
                            }
                        },
                        failure: function (response) { },
                        error: function (response) { }
                    });

                } catch (e) {
                }
            }
        }
    }
    function EditField(_fieldId, _type) {
        if (_type == "Edit") {
            $("#fieldModalLabel").html("Edit Field");
            $("#btnSaveField").removeAttr("disabled");
        }
        else{
            $("#fieldModalLabel").html("View Field");
            $("#btnSaveField").attr("disabled", "disabled");
        }
        $('#tblRequest tbody tr').remove();
        $('#tblDependencyRequest tbody tr').remove();
        ///alert("Edit Field functionality in development.");
        try {
            $.ajax({
                type: "GET",
                url: "@Url.Action("getFormItemAdvanceFieldDetail", "FormSetting")",
                contentType: "application/json; charset=utf-8",
