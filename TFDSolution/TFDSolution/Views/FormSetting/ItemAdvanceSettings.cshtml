                formTable.on('row-reorder', function (e, diff, edit) {
                    var formId = $("#hdnSelectedFormId").val();
                    var updatedRows = [];
                    // Loop through the TRs in the current DOM order
                    $table.find('tbody tr').each(function (idx) {
                        var $tr = $(this);
                        var fieldId = $tr.find('td').eq(5).find('span').attr('data-fieldid');
                        var fieldName = $tr.find('td').eq(1).text().trim(); // 2nd column is Form Name
                        updatedRows.push({
                            FormId: fieldId,
                            FormName: fieldName,
                            SortOrder: idx + 1 // 1-based index
                        });
                        // Optionally update the first cell in the row with the new sort order
                        $tr.find('td').eq(6).text(idx + 1);
