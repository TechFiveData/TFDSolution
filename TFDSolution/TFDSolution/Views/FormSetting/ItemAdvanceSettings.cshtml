    function showFieldControl(fieldTypeId, fieldType) {
        var fieldHeader = $("#ddlSelect").find(":selected").text();
        $("#fieldModalLabel").html("Add New Field : " + fieldType);

        $("#hdnFieldTypeId").val(fieldTypeId);
        var htmlPath = '<ol class="breadcrumb text-right p-0">'
        htmlPath = htmlPath + '<li>' + fieldHeader + '</li>';
        htmlPath = htmlPath + '<li>' + $("#lblFormname").html() + '</li>';
        htmlPath = htmlPath + '<li>' + $("#hdnSelectedTabName").val() + '</li>';
        htmlPath = htmlPath + '</ol>';
        $("#fieldPopupPath").html(htmlPath);
        AddNewField();
        $(".row_Text").hide();
        $("#row_LengthText").hide();
        $("#row_select").hide();
        $("#ddlFieldSelect").parent().hide();
        $("#ddlFieldDecimal").parent().hide();
        $("#MultiSelection").hide();
        $(".spnIsNumericHideMandaory").show();
        $("#divchkIsSummary").hide();
        $("#chkIsSummary").prop("checked", false);
        $("#ddlFieldSize").parent().parent().css("display", "");
        $("#chkRequired").parent().parent().css("display", "");
        $("#chkIsReadOnly").parent().parent().css("display", "");
        $("#chkIsDependencyField").parent().parent().css("display", "");
        $("#chkIsUnique").parent().parent().css("display", "");
        $(".buttonreffield").hide();
        if (fieldType === "TextBox" || fieldType === "MultiText") {
            $(".row_Text").show();
            $("#row_LengthText").show();
            $("#row_select").show();
            $(".row_size").show();
        } else if (fieldType === "Dropdown" || fieldType === "Selection") {
            var ddlSource = $('input[type=radio][name=inline-radios]:checked').val();
            $(".row_Text").hide();
            $("#row_LengthText").show();
            $("#row_select").show();
            $(".row_size").show();
            $("#MultiSelection").show();
            $("#rdbTable").prop("checked", true);
            loadDropdownTables("Table"); // Load DB table list dynamically
        }
        else if (fieldType === "Label") {
            var ddlSource = $('input[type=radio][name=inline-radios]:checked').val();
            $("#row_select").show();
            $(".spnIsNumericHideMandaory").hide();
        }
        else if (fieldType == "Numeric") {
            $("#row_select").show();
            $("#row_LengthText").show();
            $("#ddlFieldSelect").parent().show();
            $("#ddlFieldDecimal").parent().show();
            $("#divchkIsSummary").show();
            $(".spnIsNumericHideMandaory").hide();
        }
        else if (fieldType == "Button") {
            $("#ddlFieldSize").parent().parent().css("display", "none");
            $("#chkRequired").parent().parent().css("display", "none");
            $("#chkIsReadOnly").parent().parent().css("display", "none");
            $("#chkIsDependencyField").parent().parent().css("display", "none");
            $("#chkIsUnique").parent().parent().css("display", "none");
            $('#rdbSP').prop("checked", true);
            loadDropdownTables("StoredProcedure");
            $(".row_Text").show();
            $(".buttonreffield").show();
        }
        else {
            $("#row_LengthText").hide();
            $(".row_Text").hide();
            $(".row_size").show();
            $("#row_select").hide();
        }
    }
