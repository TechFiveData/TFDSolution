                        //"Header"
                        $("#txtFieldFormula").val(FormField.FieldFormula);
                        $("#txtFieldcaption").val(FormField.FieldCaption);
                        $("#txtFieldLength").val(FormField.FieldLength);
                        $("#txtFieldLength").attr("data-bind", FormField.FieldLength);
                        $("#txtFieldPlaceholder").val(FormField.FieldPlaceHolder);
                        $("#txtFieldHelptext").val(FormField.FieldHelpText);
                        $("#chkRequired").prop("checked", (FormField.IsRequired == null ? false : FormField.IsRequired));
                        $("#chkStatus").prop("checked", (FormField.IsActive == null ? false : FormField.IsActive));
                        $("#hdnFieldTypeId").val(FormField.FieldTypeId);
                        $("#hdnFieldId").val(FormField.FieldId);
                        /*DDLSourceType: ddlSource,*/
                        if (FormField.DDLSourceType != "") {
                            $("input[name=inline-radios][value='" + FormField.DDLSourceType +"']").prop("checked", true);
                            loadDropdownTables(FormField.DDLSourceType, FormField.DDLSourceName);
                            $("#ddlTables").val(FormField.DDLSourceName);
                            loadTableColumns(FormField.DDLSourceType, FormField.DDLSourceName, FormField.DDLTextField, FormField.DDLValueField);
                            $("#ddlSelectText").val(FormField.DDLTextField);
                            $("#ddlSelectValue").val(FormField.DDLValueField);
                        }
                        $("#v-pills-fieldstypecontent select").attr("disabled", true);
                        $("#ddlFieldSize").val(FormField.FieldSize);

                        if (FormField.FieldType == "Button") {
                            $("#ddlFieldSelectButton").val(FormField.DDLValueField);
                            $("#select2-ddlFieldSelectButton-container").html(FormField.DDLValueField);
                        }

                        $("#ddlFieldDecimal").val(FormField.FieldDecimal);
                        $("#chkIsReadOnly").prop("checked", (FormField.IsReadOnly == null ? false : FormField.IsReadOnly));
                        $("#chkIsSummary").prop("checked", (FormField.IsSummary == null ? false : FormField.IsSummary));
                        $("#chkIsDependencyField").prop("checked", (FormField.IsDependencyField == null ? false : FormField.IsDependencyField));
                        $("#chkIsVisible").prop("checked", (FormField.IsVisible == null ? false : FormField.IsVisible));
                        $("#chkIsDisabled").prop("checked", (FormField.IsDisable == null ? false : FormField.IsDisable));
                        $("#chkIsUnique").prop("checked", (FormField.IsUnique == null ? false : FormField.IsUnique));
                        $("#chkIsMultiSelection").prop("checked", (FormField.IsMultiSelection == null ? false : FormField.IsMultiSelection));
                        if ((FormField.IsMultiSelection == null ? false : FormField.IsMultiSelection)) {
                            if ($("#txtFieldname").attr("data-section") == "Header") {
                                $("#MultiDocument").removeClass("d-none");
                            }
                            else { $("#MultiDocument").addClass("d-none"); }
                            $("#chkMultipleDocument").prop("checked", false);
                        }
                        else {
                            $("#MultiDocument").addClass("d-none");
                            $("#chkMultipleDocument").prop("checked", false);
                        }
                        $("#chkMultipleDocument").prop("checked", (FormField.AllowMultiDocument == null ? false : FormField.AllowMultiDocument));
                        $("#chkIsVisibleInList").prop("checked", (FormField.IsVisibleInList == null ? false : FormField.IsVisibleInList));
                        $("#selectedFieldType").html(FormField.FieldType);
                        $("#hdnFieldTypeId").val(FormField.FieldTypeId);
                        $("#hdnSortOrder").val(FormField.SortOrder);
                        $("#hdnSelectedTabName").val(FormField.TabName);
                        $("#hdnSelectedFormSQLTableName").val(FormField.SQLTableName);
                        $("#ddlButtonTemplate").val(FormField.TemplateId);
                        $("#v-pills-fieldstypetab button").addClass("disabled");
                        $("#txtFieldname").addClass("disabled");
                        if (_type == "Edit") {
                            $("#fieldModalLabel").html("Edit Field : " + FormField.FieldType);
                            $("#txtFieldcaption").attr("disabled", false);
                            $("#txtFieldLength").attr("disabled", false);
                            $("#ddlFieldSelectButton").attr("disabled", false);
                            $("#txtFieldFormula").attr("disabled", false);
                            $("#txtFieldPlaceholder").attr("disabled", false);
                            $("#chkIsUnique").attr("disabled", false);
                            $("#txtFieldHelptext").attr("disabled", false);
                            $("#ddlFieldSelect").attr("disabled", false);
                            $("#chkStatus").attr("disabled", false);
                            $("#chkRequired").attr("disabled", false);
                            //$("#chkIsMultiSelection").attr("disabled", false);
                            $("#chkMultipleDocument").attr("disabled", false);
                            $("#chkIsReadOnly").attr("disabled", false);
                            $("#chkIsSummary").attr("disabled", false);
                            $("#chkIsDependencyField").attr("disabled", false);
                            $("#chkIsVisible").attr("disabled", false);
                            $("#chkIsVisibleInList").attr("disabled", false);
                            $("#ddlButtonTemplate").attr("disabled", false);
                            $("#ddlFieldSize").attr("disabled", false);
                            $("#ddlFieldDecimal").attr("disabled", false);
                            $("#ddlSelectText").attr("disabled", false);
                            $("#rdbTable").attr("disabled", false);
                            $("#rdbSP").attr("disabled", false);
                            $("#ddlTables").attr("disabled", false);
                            $("#ddlSelectValue").attr("disabled", false);
                        }
                        else {
                            $("#fieldModalLabel").html("View Field : " + FormField.FieldType);
                        }
                    }
                    else {

                    }
                },
                failure: function (response) { },
                error: function (response) { }
            });
        } catch (e) {

        }
    }
    function DeleteRecord(primaryId, source, caption) {
        if (confirm("Are you sure you want to delete " + caption + "?")){
            try {
                var spTableName = $("#hdnSelectedTabSQLTableName").val();
                var modal = { PrimaryId: primaryId, Source: spTableName };

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteFormItemAdvanceSetting", "FormSetting")',
                    contentType: "application/json;",
                    data: JSON.stringify(modal),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            ShowToastNotification("success", "Record has been deleted.");
                            if (source == "m_FormField") {
                                GetFormFieldList();
                            }
                            else if (source == "m_FormTab") {
                                BindTab();
                            }
                        }
                        else {
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            } catch (e) {
            }
        }
    }
