                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding: 0 15px;">
                <button type="button" id="btnCancelField" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveField" class="btn btn-primary" onclick="SaveField();">Submit</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('.select2').each(function () {
        const $select = $(this);
        if ("ddlButtonTemplate" != $(this).attr("id")) {
            const parentWrapper = $select.closest('.modal'); // or any appropriate container

            $select.select2({
                dropdownParent: parentWrapper.length ? parentWrapper : $('body')
            });
        }
    });
    $(document).ready(function () {
        BindTab();
        loadFormFields();
        $('input[type=radio][name=inline-radios]').change(function () {
            loadDropdownTables(this.value);
        });
        $('#txtAFormTitle').on('input', function () {
            $("#txtAFormDesc").val($(this).val());
        });
        $('#txtFieldcaption').on('input', function () {
            $("#txtFieldPlaceholder").val($(this).val());
        });
        $("#btnAddNewField").click(function () {
            $("#fieldModalLabel").html("Add New Field");
            $("#btn_TextBox").click();
        })
        $("#btnTabRefresh").click(function () {
            $("#v-pills-tab button.active").click();
        });
        $("#ddlSelect").change(function () {
            var formId = $(this).val();
            localStorage.setItem("FormSettings_FormId", formId);
            $("#txtTblPrefix").html($(this).children('option:selected').data('bind'));
            $("#txtAParentId").val(formId);
            GetFormList(formId);
        });
        $('#txtAFormName').change(function (e) {
            if (e.which === 32) {
                return false;
            }
            else {
                $("#txtATableName").val($(this).val());
            }
        });
        $('#txtAFormName').change(function () {
            $(this).val($(this).val().replace(/\s/g, ""));
        });
        $('#txtFieldname').on('input', function () {
            $(this).val(function (i, val) {
                return val.replace(/[^a-z\s]/gi, '');
            });
        });
        $('#txtFieldname').change(function () {
            $(this).val($(this).val().replace(/\s/g, ""));
        });

        $('#txtATableName').on('input', function () {
            $(this).val(function (i, val) {
