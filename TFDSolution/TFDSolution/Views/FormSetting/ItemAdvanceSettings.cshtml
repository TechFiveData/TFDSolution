    function FieldSelectChangeEvent(ctrl) {
        if (ctrl != undefined && $(ctrl).val() != null && $(ctrl).val() != "") {
            var currentVal = $('#txtFieldFormula').val();         // Get current input value
            var newVal = currentVal + "{" + $(ctrl).val() + "}";           // Append text
            $('#txtFieldFormula').val(newVal);
        }
    }
    function FieldSourceChangeEvent(ctrl) {
        let selectedTable = $(ctrl).val();
        var _OptionSource = $('input[type=radio][name=inline-radios]:checked').val();
        $('#tblRequest tbody tr').remove();
        $("#divSPRequest").addClass("d-none");
        if (selectedTable) {
            loadTableColumns(_OptionSource, selectedTable);
        }
    }
    function bindStoredProcedure(dropdownId, defaultValue)
    {
        let tableDropdown = $("#" + dropdownId);
        tableDropdown.empty();
        $.ajax({
            url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
            type: "GET",
            skipLoading: true,
            data: { sourceType: "StoredProcedure" },
            success: function (tables) {
                tableDropdown.append('<option value="0">Select Stored Procedure</option>')
                tables.forEach(table => {
                    if (defaultValue != undefined && defaultValue != "" && defaultValue == table) {
                        tableDropdown.append(`<option selected value="${table}">${table}</option>`);
                    }
                    else {
                        tableDropdown.append(`<option value="${table}">${table}</option>`);
                    }
                });
             }
        });
    }
    function SaveTab() {
        var isFormValid = true;
        $("#tabModal input").each(function () {
            if ($.trim($(this).val()).length == 0 && ($(this).attr("id") != "txtFormTabSQLTable") && $(this).attr("id") != "hdnItemAdvanceId") {
                $(this).addClass("input-validation-error");
                if (isFormValid == true) {
                    $(this).focus();
                }
                isFormValid = false;
            }
            else {
                $(this).removeClass("input-validation-error");
            }
        });

        if (!isFormValid) {
            ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
        }
        else {
            try {
                
                var tabId = parseInt($("#hdnItemAdvanceId").val());
                var modal = {
                    GridName: $("#txtFormTab").val(),
                    IsActive: true,                    
                    ItemAdvanceId: tabId,
                    SQLTableName: $("#txtFormTabSQLTable").val(),
                    GridTitle: $("#txtFormTabTitle").val(),
                    GetDataScript: $("#ddlGetDataScript").val(),
                    SetDataScript: $("#ddlSetDataScript").val(),
                    ValidDataScript: $("#ddlValidDataScript").val()
                };

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveFormItemAdvance", "FormSetting")',
                    contentType: "application/json;",
                    data: JSON.stringify(modal),
                    async: false,
                    success: function (response) {
                        if (response.IsSuccess) {
                            ShowToastNotification("success", "Record saved successfully.");
                            AddNewTab();
                            $('#btnCancelTab').click();
                            BindTab();
                        }
                        else {
                            ShowToastNotification("error", response.Response);
                        }
                    },
                    failure: function (response) { },
                    error: function (response) { }
                });
            } catch (e) {
            }
        }
    }
</script>