                dataType: "json",
                success: function (response) {
                    if (response != null) {
                        var FormField = response;
                        $("#v-pills-fieldstypetab #btn_" + FormField.FieldType).click();
                        showFieldControl(FormField.FieldTypeId, FormField.FieldType);
                        $("#v-pills-fieldstypecontent input").attr("disabled", true);
