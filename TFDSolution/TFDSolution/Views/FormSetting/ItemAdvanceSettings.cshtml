                                tabHtml = tabHtml + "<label title='Edit Tab' onclick='EditTab(\"" + response[iRow].ItemAdvanceId + "\");' data-toggle='modal' data-target='#tabModal' style='padding-left:8px;'><i class='fa fa-pencil' style='font-size:14px;'></i></label>";
                                //tabHtml = tabHtml + '<label title="Delete Tab" onclick="DeleteTab(\'' + response[iRow].ItemAdvanceId + '\');" style="padding-left:8px;"><i class="fa fa-trash" style="font-size:14px;"></i></label>';
                                tabHtml = tabHtml + '</a></li>';
                                tabHtml = tabHtml + '</li>';
