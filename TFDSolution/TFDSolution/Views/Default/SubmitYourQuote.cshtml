                    var fieldId = $(this).attr("data-bind");
                    var fieldtype = $(this).attr("data-content");
                    var fieldcap = $(this).attr("data-html");

                    if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: $(this).val(),
                            FieldType: $(this).attr("type"),
                        });
                    }
                    $(this).next(".validation").remove();
                    if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                        $(this).addClass("input-validation-error");
                        $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");
                        if (isFormValid == true) {
                            $(this).focus();
                        }
                        isFormValid = false;
                    } else {
                        $(this).removeClass("input-validation-error");
                    }
                }
            });
            $("#HeaderTabs label").each(function () {
                if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                    var fieldId = $(this).attr("data-bind");
                    if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                        PageFieldData.push({
                            FieldName: fieldId,
                            FieldValue: $(this).text()
                        });
                    }
                }
            });
            if (!isFormValid) {
                ShowToastNotification("error","Please fill in all the required fields (indicated by *)");
                return;
            }
            else {
                try {
                    var tablename = $("#hdnTableName").val();
                    var recordId = $("#hdnRecordId").val(); // Get the hidden ID field
                    var model = {
                        PageTablename: tablename,
                        FieldData: PageFieldData,
                        Id: recordId,  // Pass record ID for update
                        PageType: "Header",
                        FormId: '@Model.Design.FormId',
                        DocId: $("#hdnDocId").val(),
                        AllowMultipleDocument: isAllowMultipleDoc,
                        MultipleDocFieldName: multipleDocFieldName,
                        CompanyId: '@Model.Design.CompanyId',
                        UserId: '@Model.Design.UserId',
                        FiancialYearId: '@Model.Design.FinancialYearId',
                        PendingId: '@Model.PendingId',
                        ItemSrNos: '@Model.ItemSrNos'
                    }

                     $.ajax({
                         type: "POST", url: '@Url.Action("SavePageData", "Default")',
                         contentType: "application/json;",
                         data: JSON.stringify(model),
                         async: false,
                         success: function (response) {
                             if (response.IsSuccess) {
                                 ShowToastNotification("success", response.Response)
                                 var url = '@Url.Action("QuoteSubmitted", "Default")';
                                 window.location.href = url + '?uRNNo=' + encodeURIComponent(response.URNNo) +
                                    '&Id=' + encodeURIComponent(response.Id) +
                                    '&PendingId=' + encodeURIComponent('@Model.PendingId') +
                                    '&ItemSrNos=' + encodeURIComponent('@Model.ItemSrNos');
                             }
                             else {
                                 ShowToastNotification("error",response.Response);
                             }
                         },
                         failure: function (response) { },
                         error: function (response) { }
                     });
                } catch (e) {
                }
            }
        }

        function InlineSaveRecord(rowData, tablename, detailId) {
            var isFormValid = true;
            try {
                var PageFieldData = [];
                var rownumber = "1";
                rowData.find("input").each(function () {
                    var $input = $(this);
                    var ctrlId = $input.attr("id");
                    if (!ctrlId) return;
                    var fieldId = $input.attr("data-bind");
                    var fieldcap = $input.attr("data-html");
                    var fieldValue = $input.val();
                    var type = $input.prop("type");

                    if (ctrlId == "ItemSrNo") {
                        rownumber = fieldValue;
                    }

                    // ✅ Fix datetime-local
                    if (type === "datetime-local" && fieldValue && fieldValue.length === 16) {
                        fieldValue += ":00";
                    }
                    if (fieldId) { PageFieldData.push({FieldName: fieldId,FieldValue: fieldValue,FieldType: type}); }

                    $input.next(".validation").remove();

                    if ($input.prop('required') && $.trim(fieldValue).length == 0) {
                        $input.addClass("input-validation-error");
                        $input.after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");

                        if (isFormValid) {
                            $input.focus();
                        }
                        isFormValid = false;
                    } else {
                        $input.removeClass("input-validation-error");
                    }
                });
                rowData.find("textarea").each(function () {
                    if ($(this).attr("id")) {
                        var fieldId = $(this).attr("data-bind");
                        var fieldcap = $(this).attr("data-html");
                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $(this).val()
                            });
                        }
                        $(this).next(".validation").remove();
                        if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                            $(this).addClass("input-validation-error");
                            $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");
                            if (isFormValid == true) {
                                $(this).focus();
                            }
                            isFormValid = false;
                        } else {
                            $(this).removeClass("input-validation-error");
                        }
                    }
                });
                rowData.find("select").each(function () {
                    if ($(this).attr("id")) {
                        const fieldId = $(this).attr("data-bind");
                        const fieldcap = $(this).attr("data-html");
                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            var val = $(this).val();
                            if (val && val !== "0" && val !== "" && val.length > 0) {
                                PageFieldData.push({
                                    FieldName: fieldId,
                                    FieldValue: rowData.find("#" + $(this).attr("id") + "  option:selected").text()
                                });
                            }
                            PageFieldData.push({
                                FieldName: fieldId + "_Id",
                                FieldValue: $(this).val()
                            });
                        }
                        $(this).next(".validation").remove();
                        if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                            $(this).addClass("input-validation-error");
                            $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please select " + fieldcap + "</div>");
                            if (isFormValid == true) {
                                $(this).focus();
                            }
                            isFormValid = false;
                        } else {
                            $(this).removeClass("input-validation-error");
                        }
                    }
                });
                rowData.find("label").each(function () {
                    if ($(this).attr("id")) {
                        var fieldId = $(this).attr("data-bind");
                        if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                            PageFieldData.push({
                                FieldName: fieldId,
                                FieldValue: $(this).text()
                            });
                        }
                    }
                });

                if (!isFormValid) {
                    ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
                    return;
                }
                else {
                    var recordId = $("#hdnDetailId").val(); // Get the hidden ID field
                    var model = {
                        PageTablename: tablename,
                        FieldData: PageFieldData,
                        Id: detailId,
                        ParentId: parseInt($("#hdnRecordId").val()),
                        PageType: "Detail",
                        FormId: '@Model.Design.FormId',
                        SectionId: '2629A112-68DF-4660-A528-6B5D9041B5EB',
                        UserId: $("#hdnUserId").val(),
                        CompanyId: $("#hdnCompanyId").val(),
                        FiancialYearId: $("#hdnFiancialId").val(),
                        PendingId: '@Model.PendingId',
                        ItemSrNos: '@Model.ItemSrNos'
                    }
                    $.ajax({
                        type: "POST", url: '@Url.Action("SavePageData", "Default")',
                        contentType: "application/json;",
                        data: JSON.stringify(model),
                        async: false,
                        success: function (response) {
                            if (response.IsSuccess) {
                                ShowToastNotification("success", "Row Number " + rownumber + " record has been saved successfully!");
                                rowData.attr('data-id', response.Id);
                                rowData.find('a.btn-delete').removeClass('d-none');
                                rowData.find('a.btn-save').attr('data-content',response.Id);
                                rowData.find('a.btn-delete').attr('data-content', response.Id);
                            }
                            else {
                                ShowToastNotification("error", response.Response);
                            }
                        },
                        failure: function (response) { },
                        error: function (response) { }
                    });
                }
            } catch (e) {

            }
        }
    </script>
