                                                                                                else
                                                                                                {
                                                                                                    @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_decimal = field.FieldDecimal, data_path = field.FieldFormula, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number" })
                                                                                                }
