                                            <p>Page could not be rendered.</p>
                                            <p>We'll try again shortly.</p>
                                            <button onclick="location.reload()">Try Again</button>
                                        </div>
                                    }
                                    @if (Model.Design.SqlTemplateId == 2) // && AllowOtherCharges == "y"
                                    {
                                        <div id="DivTotal" style="padding-top: 10px !important;"></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div id="divpageDetail" class="animated fadeIn mypage">
                    <div class="error-box">
                        <h1>Oops!</h1>
                        <p>Page could not be rendered.</p>
                        <p>We'll try again shortly.</p>
                        <button onclick="location.reload()">Try Again</button>
                    </div>
                </div>
            }
        </div>
    </div>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#HeaderTabs .select2').each(function () {
            let selectId = $(this).attr('id');

            let isDependency = $(this).attr("data-dependency");
            if (selectId && isDependency != "True") {
                try {
                    let parentWrapper = $(this).parent();
                    var sourceType = $(this).attr("data-sourcetype");
                    var _fieldId = $(this).attr("data-container");
                    let selectedValues = $(this).attr("data-interval");
                    let selectedText = $(this).attr("data-display");
                    let caption = $(this).attr("data-html");
                    let firstFive = selectedText ? selectedText.substring(0, 40) : "";
                    if (sourceType != "StoredProcedure") {
                        const $selectElement = $('#HeaderTabs #' + selectId);
                        $('#HeaderTabs #' + selectId).select2({
                            dropdownParent: parentWrapper,
                            placeholder: 'Select ' + caption,
                            allowClear: true,
                            delay: 250,
                            minimumInputLength: 0, // change to 0 if you want scrolling without typing
                            ajax: {
                                url: '@Url.Action("FillSelctionPagingDefault", "Common")',
                                dataType: 'json',
                                skipLoading: true, // <-- Custom flag
                                delay: 250,
                                data: function (params) {
                                    return {
                                        FieldId: _fieldId,
                                        CompanyId: $("#hdnCompanyId").val(),
                                        searchTerm: params.term || '', // search term
                                        page: params.page || 1,
                                        fieldValue: selectedValues
                                    };
                                },
                                processResults: function (data) {
                                    return {
                                        results: data.results,
                                        pagination: {
                                            more: data.pagination.more
                                        }
                                    };
                                },
                                error: function (xhr, status, error) {
                                    console.error("Select2 AJAX Error:", error);
                                    console.error("Status:", status);
                                    console.error("Response:", xhr.responseText);
                                },
                                cache: true
                            }
                        });
                        /// Pre-load selected values (important when editing)
                        if (selectedValues.length) {
                            $.ajax({
                                url: '@Url.Action("FillSelctionPagingDefault", "Common")',
                                type: 'GET',
                                data: { FieldId: _fieldId, CompanyId: $("#hdnCompanyId").val(), searchTerm: firstFive, page: 1, fieldValue: '' },
                                success: function (data) {
                                    var isMultiSelection = $selectElement.attr("data-multiselection");
                                    if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                        const multiVal = selectedValues.split(',');
                                        $selectElement.val([]).trigger('change');
                                        multiVal.forEach(function (val) {
                                            let item = data.results.find(x => x.id.trim().toLowerCase() == val.trim().toLowerCase());
                                            if (item) {
                                                let option = new Option(item.text, item.id, true, true);
                                                $selectElement.append(option);
                                                $selectElement.trigger('change');
                                            }
                                        });
                                    }
                                    else {
                                        if (data != null && data.results != null) {
                                            let item = data.results.find(x => x.id == selectedValues);
                                            if (item) {
                                                let option = new Option(item.text, item.id, true, true);
                                                $('#HeaderTabs #' + selectId).append(option).trigger('change');
                                            }
                                        }
                                    }
                                    $('#HeaderTabs #' + selectId).trigger('change');
                                }
                            });
                        }
                        //$('#' + selectId).select2()
                    }
                    else {
                            //$('#HeaderTabs #' + selectId).select2({
