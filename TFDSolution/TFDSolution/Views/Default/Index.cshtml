@model TFDSolution.Models.LicenseModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>TFD | License</title>
    @{
        var ImagesBase = Url.Content("~/Images");
        var ContentBase = Url.Content("~/Content");
    }
    <link rel="stylesheet" href="@ContentBase/Site.css">
    <link rel="stylesheet" href="@ContentBase/theme//theme1/login.css">
    <link href="@ContentBase/bootstrap.min.css" rel="stylesheet" />
    <link href="@ContentBase/main/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.7.1.js"></script>
</head>
<body class="loginbody" style="background-image: Url('@ImagesBase/theme1.jpg')">
    <div class="header-block" style="text-align:center;">
        <span>Product Activattion Process</span>
    </div>    
    @if (@ViewBag.RegistrationMsg != null)
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @ViewBag.RegistrationMsg
        </div>
    }
    <div class="section1"></div>
    <!--SECTION 2-->
    <div class="section2">
        <div class="main">
            <h4 style="border-bottom: 1px double #f39b3b; padding-bottom: 15px;">Activate Your Product</h4>
            @using (Html.BeginForm("Index", "Default", FormMethod.Post))
            {
                <div class="row">
                    <div class="col-md-12 form-group">
                        <label for="UserName">🔐 Enter Your License Key</label>
                        @Html.TextBoxFor(a => a.LicenseKey, new { @Required = "Required", @placeholder = "Enter your Product License Key" })
                        @Html.ValidationMessageFor(a => a.LicenseKey)
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 form-group">
                        <div class="wrap">
                            <button type="submit">Activate</button>
                        </div>
                    </div>
                </div>
                if (Model.Status == 1) //Fist Time Access
                {
                    <div id="divError">
                        <div class="alert alert-info">
                            @Model.Message
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div id="divError">
                        <div class="alert alert-danger">
                            @Model.ErrorMessage
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div id="divError">
                        <div class="alert alert-danger">
                            @Model.Message
                        </div>
                    </div>
                }
            }
            <p>
                <div class="hint">
                    Can't find your key? Check your email receipt or Request to <a href="mailto:support@techfivedata.com">LotusNext ERP Support</a>.
                </div>
            </p>
        </div>
    </div>
</body>
</html>
