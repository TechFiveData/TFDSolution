@model TFDSolution.Transport.ReportTemplateModel
<script src="~/Scripts/select2.min.js"></script>
<div class="row form-group">
    <input type="hidden" id="hgnTemplateId" value="@Model.ReportId" />
    <div class="col-md-6">
        @Html.LabelFor(m => m.ReportTitle, "Caption", new { @class = "form-control-label" })
        <span class="text-danger p-1">(*)</span>

        @Html.TextBoxFor(m => m.ReportTitle, new
        {
            @class = "form-control",
            id = "txtReportCaption",
            maxlength = "50",
            data_content = "0"
        })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.ReportName, "Report Name", new { @class = "form-control-label" })
        <span class="text-danger p-1">(*)</span>
        @Html.TextBoxFor(m => m.ReportName, new
        {
            @class = "form-control",
            id = "txtReportName",
            maxlength = "100",
            data_content = "0",
            onkeydown = "return blockSpaces(event)"
        })
    </div>
</div>
<div class="row form-group">
    <div class="col-md-6">
        @Html.LabelFor(m => m.AssignedUsers, "Assigned User", new { @class = "form-control-label" })
        <select id="ddlUser" data-display="" data-interval="@Model.AssignedUsers" multiple class="form-select"></select>
    </div>
    <div class="col-md-6">
        <div class="form-check">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "chkIsActive" })
            <label class="form-check-label" for="chkIsActive">
                Is Active
            </label>
        </div>
    </div>
    <div class="col-md-12"></div>
</div>
<div class="row form-group">
    <div id="divSPRequestPeraFilter" class="col-md-12 form-group ">
        <label class="form-label label-header">
            Perameter/Filter
            <a id="btnAddFilter" href="javascript:void(0);" class="float-right pr-2" title="Add New Filter"><i class="fa fa-plus"></i></a>
        </label>
        <table id="tblRequestPeraFilter" class="table table-striped table-bordered table-default">
            <thead>
                <tr>
                    <th class="text-center"></th>
                    <th class="text-center">#</th>
                    <th>Field name</th>
                    <th>Field Caption</th>
                    <th>FieldType</th>
                    <th>Default</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Header != null && Model.Header.Count > 0)
                {
                    foreach (var item in Model.Header)
                    {
                        string ddlId = "ddlSource" + @item.SrNo;
                        <tr>
                            <td><a href="javascript:void(0);" class="btnDelete" title="Delete Record"><i class="fa fa-trash text-danger"></i></a></td>
                            <td class="text-center RTSrNofield">@item.SrNo</td>
                            <td><input type="text" class="form-control form-control-sm RTFieldName text-left" value="@item.FieldName" /></td>
                            <td><input type="text" class="form-control form-control-sm RTFieldCaption text-left" value="@item.FieldCaption" /></td>
                            <td class="RTFieldType">
                                <select id="test" onchange="onFieldTypeChange(this);" data-interval="@item.FieldType" class="form-select form-control form-select-sm">
                                    <option value="Text" @(item.FieldType == "Text" ? "selected" : "")>Text</option>
                                    <option value="Date" @(item.FieldType == "Date" ? "selected" : "")>Date</option>
                                    <option value="Dropdown" @(item.FieldType == "Dropdown" ? "selected" : "")>Dropdown</option>
                                </select>
                            </td>
                            <td style="width:40%">
                                @if (item.FieldType == "Dropdown")
                                {
                                    <input type="text" class="form-control d-none form-control-sm RTFieldDefaultVal text-left" value="@item.FieldDefaultValue" />
                                    <select id="@ddlId" class="form-select dropdownsource RTFieldDefaultVal select2" data-interval="@item.FieldDefaultValue">
                                        <option></option>
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm RTFieldDefaultVal text-left textfield" value="@item.FieldDefaultValue" />
                                    <select id="@ddlId" class="form-select d-none dropdownsource RTFieldDefaultVal select2" data-interval="@item.FieldDefaultValue">
                                        <option></option>
                                    </select>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="row form-group">
    <div class="col-md-12">
        <label for="ddlStoreprocedure" class="form-control-label">Store Procedure</label>
        <select id="ddlStoreprocedure" class="form-select select2" data-interval="@Model.SQLQueryName" onchange="handleCategoryChange(this.value)"> </select>
    </div>
</div>
<div class="row form-group">
    <div id="divSPRequest" class="col-md-12 form-group">
        <label class="form-label label-header">Stored Procedure Request</label>
        <table id="tblRequest" class="table table-striped table-bordered table-default">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Parameter</th>
                    <th>Data Type</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProcedureMappings != null && Model.ProcedureMappings.Count > 0)
                {
                    foreach (var item in Model.ProcedureMappings)
                    {
                        <tr>
                            <td class="text-center RTRSrNofield">@item.SrNo</td>
                            <td class="text-left RTRParaNamefield">@item.ParameterName</td>
                            <td class="text-left RTRParaDataTypefield">@item.ParamDataType</td>
                            <td>
                                <select class='form-control form-select RTRParaValufield' data-bind="@item.ParamValueName">
                                    <option value='0'>Select Field</option>
                                    @if (item.ParamValueName == "CompanyId")
                                    {
                                        <option value='CompanyId' selected>CompanyId</option>
                                    }
                                    else
                                    {
                                        <option value='CompanyId'>CompanyId</option>
                                    }
                                    @if (Model != null && Model.Header != null && Model.Header.Count > 0)
                                    {
                                        foreach (var Iitem in Model.Header)
                                        {
                                            if (item.ParamValueName == Iitem.FieldName)
                                            {
                                                <option value="@Iitem.FieldName" selected>@Iitem.FieldCaption</option>
                                            }
                                            else
                                            {
                                                <option value="@Iitem.FieldName">@Iitem.FieldCaption</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<script>
    $(document).on("click", ".btnDelete", function () {
        $(this).closest("tr").remove();
    });
    function onFieldTypeChange(ctrl) {
        try {
            const $row = $(ctrl).closest("tr");
            if ($(ctrl).length && $(ctrl).val().length) {
                if ($(ctrl).val() == "Dropdown") {
                    $row.find(".textfield").addClass("d-none");
                    $row.find(".dropdownsource").removeClass("d-none");
                    $row.find(".select2").removeClass("d-none");
                }
                else {
                    $row.find(".textfield").removeClass("d-none");
                    $row.find(".select2").addClass("d-none");
                    $row.find(".dropdownsource").addClass("d-none");
                }
            }
        } catch (e) { }
    }
    function UpdateRequestFieldValueSelection() {
        try {

            const NewFilterfields = [];
            NewFilterfields.push({ Name: "CompanyId", Value: "CompanyId" });
            // Collect field names from first table
            $("#tblRequestPeraFilter tbody tr").each(function () {
                let fieldName = $(this).find(".RTFieldCaption").text().length
                    ? $(this).find(".RTFieldCaption").text()
                    : $(this).find(".RTFieldCaption").val();
                let fieldVal = $(this).find(".RTFieldName").text().length
                    ? $(this).find(".RTFieldName").text()
                    : $(this).find(".RTFieldName").val();

                if (fieldName) {
                    NewFilterfields.push({ Name: fieldName, Value: fieldVal });
                }
            });
            // Loop through rows of second table
            $("#tblRequest tbody tr").each(function () {
                const $select = $(this).find(".RTRParaValufield");
                if ($select.length) {
                    NewFilterfields.forEach(field => {
                        // check if option already exists
                        const exists = $select.find("option").filter(function () {
                            return $(this).val().trim() === field.Value;
                        }).length > 0;

                        if (!exists) {
                            // add new option
                            $select.append(new Option(field.Name, field.Value));
                        }
                    });
                }
            });
        } catch (e) {

        }
    }
    $(document).ready(function () {
        bindStoredProcedure();
        /*BindFilterRequest();*/
        BindFilterRequest();
        bindSQLTable();
        setInterval(UpdateRequestFieldValueSelection, 3000);
        //let parentWrapper = $('#ddlStoreprocedure').parent();
        //$('#ddlStoreprocedure').select2({
        //    dropdownParent: parentWrapper,
        //});
        BindUserDropdown();
        $("#btnAddFilter").on("click", function () {
            try {
                const sp = $("#ddlStoreprocedure").val();
                if (sp === "0") {
                    alert("Please enter Store Procedure.");
                    return;
                }
                const tbody = $("#tblRequestPeraFilter tbody")[0];
                const totalRows = dynamicFilterRows.length;
                if (totalRows > 0) {
                    const lastRow = tbody.rows[staticFilterData.length + totalRows - 1];

                    const fieldName = lastRow.cells[1]?.querySelector("input")?.value.trim();
                    const fieldCaption = lastRow.cells[2]?.querySelector("input")?.value.trim();

                    if (!fieldName || !fieldCaption) {
                        alert("Please fill in 'Field Name' and 'Field Caption' before adding a new filter.");
                        return;
                    }

                    // Save last row values
                    Object.assign(dynamicFilterRows[totalRows - 1], {
                        FIELD_NAME: fieldName,
                        FIELD_CAPTION: fieldCaption,
                        FIELD_TYPE: lastRow.cells[3]?.querySelector("select")?.value || "Text",
                        DEFAULT_VALUE: lastRow.cells[4]?.querySelector("input")?.value.trim() || ""
                    });
                }
                // Add new row with defaults
                //dynamicFilterRows.push({
                //    FIELD_NAME: "",
                //    FIELD_CAPTION: "",
                //    FIELD_TYPE: "Text",
                //    DEFAULT_VALUE: ""
                //});
                renderDynamicRows();
            } catch (err) {
                console.error("Error in Add Filter:", err);
            }
        });
        $('.select2').each(function () {
            let selectId = $(this).attr('id');
            if (selectId) {
                let parentWrapper = $(this).parent();
                $('#' + selectId).select2({ dropdownParent: parentWrapper });
            }
        });
        const Filterfields = [];
        $("#tblRequestPeraFilter tbody tr").each(function () {
            var fieldName = $(this).find(".RTFieldName").text();
            Filterfields.push({ Name: fieldName })
            let fieldType = $(this).find(".RTFieldType select").val();
            if (fieldType.length) {
                if (fieldType == "Dropdown") {
                    $(this).find(".textfield").addClass("d-none");
                    $(this).find(".dropdownsource").removeClass("d-none");
                    $(this).find(".select2").removeClass("d-none");
                }
                else {
                    $(this).find(".textfield").removeClass("d-none");
                    $(this).find(".select2").addClass("d-none");
                    $(this).find(".dropdownsource").addClass("d-none");
                }
            }
        });
        $("#tblRequest tbody tr").each(function () {
            let $select = $(this).find(".RTRParaValufield");
            let defaultValue = $(this).find(".RTRParaValufield").attr("data-bind");
            if ($select.find("option").length == 1) {
                Filterfields.forEach(table => {
                    if (defaultValue != undefined && defaultValue != "" && defaultValue == table.Name) {
                        $select.append(`<option selected value="${table.Name}">${table.Name}</option>`);
                    }
                    else {
                        $select.append(`<option value="${table.Name}">${table.Name}</option>`);
                    }
                });
            }
        });
    });
    function handleCategoryChange(value) {
        $("#divSPRequest").removeClass("d-none");
        if (value) {  // If a SP is selected
            if (value == "0") {``
                $("#divSPRequest").addClass("d-none");
            }
            else {
                document.getElementById("divSPRequest").classList.remove("d-none");
                bindTableData(value);
            }

        } else {
            document.getElementById("divSPRequest").classList.add("d-none");
            document.querySelector("#tblRequest tbody").innerHTML = "";
        }
    }
    //  4/8/25
    function blockSpaces(event) {
        if (event.key === ' ' || event.keyCode === 32) {
            event.preventDefault(); // block spacebar
            return false;
        }
        return true; // allow other keys
    }
    function bindTableData(value) {
        try {
            const tbody = document.querySelector("#tblRequest tbody");
            tbody.innerHTML = ""; // Clear previous rows
            $.ajax({
                url: "@Url.Action("GetSourceColumns", "DynamicReport")",
                type: "GET",
                async: true,
                skipLoading: true,
                data: { tableName: value },
                success: function (response) {
                    if (response != null && response.Request != null && response.Request.length > 0) {
                        var ddlField = "<select class='form-control RTRParaValufield form-select'><option value='0'>Select Field</option>";
                        if (response.SPColumns && response.SPColumns.length > 0) {
                            response.SPColumns.forEach(spCol => {
                                ddlField += `<option value="${spCol}">${spCol}</option>`;
                            });
                        }
                        // Add all fields from staticFilterData and dynamicFilterRows
                        [...staticFilterData, ...dynamicFilterRows].forEach(item => {
                            if (item.DEFAULT_VALUE) {
                                ddlField += `<option value="${item.FIELD_NAME}">${item.FIELD_NAME} (${item.DEFAULT_VALUE})</option>`;
                            } else {
                                ddlField += `<option value="${item.FIELD_NAME}">${item.FIELD_NAME}</option>`;
                            }
                        });
                        ddlField += `</select>`;

                        response.Request.forEach(row => {
                            const tr = document.createElement("tr");
                            tr.innerHTML = `
                                <td class="RTRSrNofield">${row.ORDINAL_POSITION}</td>
                                <td class="text-left paramName RTRParaNamefield" data-bind="${row.PARAMETER_NAME}">${row.PARAMETER_NAME}</td>
                                <td class="text-left RTRParaDataTypefield">${row.DATA_TYPE}</td>
                                <td class="paramField" data-bind="${row.PARAMETER_Value}"> ${ddlField} </td>`;
                            tbody.appendChild(tr);
                        });
                    }
                }
            });

        } catch (e) {

        }
    }
    function bindStoredProcedure()
    {
        let tableDropdown = $("#ddlStoreprocedure");
        var defaultValue = tableDropdown.attr("data-interval");
        try {
            tableDropdown.empty();
            $.ajax({
                url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
                type: "GET",
                skipLoading: true,
                data: { sourceType: "StoredProcedure" },
                success: function (tables) {
                    tableDropdown.append('<option value="0">Select Stored Procedure</option>')
                    tables.forEach(table => {
                        if (defaultValue != undefined && defaultValue != "" && defaultValue == table) {
                            tableDropdown.append(`<option selected value="${table}">${table}</option>`);
                        }
                        else {
                            tableDropdown.append(`<option value="${table}">${table}</option>`);
                        }
                    });
                    if ($("#tblRequest").length > 0 && $("#tblRequest tbody tr").length == 0) {
                        tableDropdown.trigger("change");
                    }
                 }
            });
        } catch (e) {

        }
    }
    function bindSQLTable()
    {
        try {
            $.ajax({
                url: "@Url.Action("GetFieldOptionSource", "FormSetting")",
                type: "GET",
                skipLoading: true,
                data: { sourceType: "Table" },
                success: function (tables) {
                    $("#tblRequestPeraFilter tbody tr").each(function () {
                        let tableDropdown = $(this).find("select.dropdownsource");
                        tableDropdown.empty();
                        tableDropdown.append('<option value="0">Select Table</option>')
                        var defaultValue = tableDropdown.attr("data-interval");
                        tables.forEach(table => {
                            if (defaultValue != undefined && defaultValue != "" && defaultValue == table) {
                                tableDropdown.append(`<option selected value="${table}">${table}</option>`);
                            }
                            else {
                                tableDropdown.append(`<option value="${table}">${table}</option>`);
                            }
                        });
                    });

                 }
            });
        } catch (e) {
        }
    }
    function BindUserDropdown() {
        try {
            let parentWrapper = $("#ddlUser").parent();
            let selectedValues = $("#ddlUser").attr("data-interval");
            let selectedText = $("#ddlUser").attr("data-display");
            let firstFive = selectedText ? selectedText.substring(0, 20) : "";
            $("#ddlUser").select2({
                dropdownParent: parentWrapper,
                placeholder: 'Select User(s)',
                allowClear: true,
                delay: 250,
                minimumInputLength: 0, // change to 0 if you want scrolling without typing
                ajax: {
                    url: '@Url.Action("FillSelctionCommon", "Common")',
                    dataType: 'json',
                    skipLoading: true, // <-- Custom flag
                    delay: 250,
                    data: function (params) {
                        return {
                            _type: 'User',
                            _whareClause: params.term || params.q || '',
                            _orderType: '',
                            _entryType: 'User'
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results,
                            pagination: {
                                more: data.pagination.more
                            }
                        };
                    },
                    error: function (xhr, status, error) {
                        console.error("Select2 AJAX Error:", error);
                        console.error("Status:", status);
                        console.error("Response:", xhr.responseText);
                    },
                    cache: true
                }
            });
            /// Pre-load selected values (important when editing)
            if (selectedValues.length && selectedValues.length > 0) {
                $.ajax({
                    url: '@Url.Action("FillSelctionCommon", "Common")',
                    type: 'GET',
                    data: { _type: 'User', _whareClause: firstFive, _orderType: '', _entryType: 'User' },
                    success: function (data) {
                        const selectedIds = selectedValues.split(",").map(v => v.trim()).filter(Boolean);
                        selectedIds.forEach(id => {
                            const item = data.results.find(x => x.id == id);
                            if (item) {
                                $("#ddlUser").append(new Option(item.text, item.id, true, true));
                            }
                        });
                    }
                });
            }
            //$('#' + selectId).select2()
        } catch (e) {
            console.error("Select2 AJAX Error:", e);
        }
    }

    function getFieldTypeDropdown(selectedValue = "") {
        try {
            return `<select onchange="onFieldTypeChange(this);" id="test" class="form-select form-control form-select-sm">
                ${fieldTypeOptions.map(opt => `
                <option value="${opt}" ${opt === selectedValue ? "selected" : ""}>${opt}</option>
                `).join('')}
            </select>`;
        } catch (e) {
        }
    }

    // Separate function to render static rows
    function BindFilterRequest() {
        if ($("#tblRequestPeraFilter").length > 0 && $("#tblRequestPeraFilter tbody tr").length == 0) {
            const tbody = document.querySelector("#tblRequestPeraFilter tbody");
            tbody.innerHTML = ""; // Clear entire table

            staticFilterData.forEach((row, index) => {
                const tr = document.createElement("tr");
                var ddlId = "ddlSource" + (index +1);
                tr.innerHTML = `
            <td><a href="javascript:void(0);" class="btnDelete" title="Delete Record"><i class="fa fa-trash text-danger"></i></a></td>
            <td class="text-center RTSrNofield">${index + 1}</td>
            <td class="text-left RTFieldName">${row.FIELD_NAME}</td>
            <td class="text-left RTFieldCaption">${row.FIELD_CAPTION}</td>
            <td class="RTFieldType">${getFieldTypeDropdown(row.FIELD_TYPE)}</td>
            <td class="RTFieldDefaultVal"><input type="text" class="form-control form-control-sm RTFieldDefaultVal text-left textfield" value="${row.DEFAULT_VALUE}" />
                <select id="${ddlId}" class="form-select d-none dropdownsource RTFieldDefaultVal select2" data-interval="0">
                <option></option>
            </select></td>`;
                tbody.appendChild(tr);
            });
            bindSQLTable();
        }
    }

