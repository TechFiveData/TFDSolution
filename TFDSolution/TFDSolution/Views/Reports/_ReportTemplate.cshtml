    // Function to update dynamic row values in real-time
    function updateDynamicRow(index) {
        try {
            const tbody = document.querySelector("#tblRequestPeraFilter tbody");
            const row = tbody.rows[staticFilterData.length + index];
            if (row) {
                dynamicFilterRows[index].FIELD_NAME = row.cells[1].querySelector('input')?.value.trim() || "";
                dynamicFilterRows[index].FIELD_CAPTION = row.cells[2].querySelector('input')?.value.trim() || "";
                dynamicFilterRows[index].FIELD_TYPE = row.cells[3].querySelector('select')?.value || "Text";
                dynamicFilterRows[index].DEFAULT_VALUE = row.cells[4].querySelector('input')?.value.trim() || "";
                bindTableData(document.getElementById("ddlStoreprocedure").value); // Update dropdown instantly
            }
        } catch (e) {
        }
    }

