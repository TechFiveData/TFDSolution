function BindParentDropdown() {

    $.ajax({
        url: '@Url.Action("getUsersForAuditLog", "Master")',
        type: 'GET',
        success: function (response) {

            $('#ddlUserName').empty();

            if (response.RoleId == 1) {
                // Admin => Add default option
                $('#ddlUserName').append(
                    $('<option>', {
                        value: '',
                        text: '-- Select User --',
                        selected: true
                    })
                );
            }

            $.each(response.Data, function (i, item) {
                $('#ddlUserName').append(
                    $('<option>', {
                        value: item.UserId,
                        text: item.UserName
                    })
                );
            });

            if (response.RoleId == 1) {

                // Admin
                $("#hdnSelectedUserId").val('');
                $('#ddlUserName').prop('disabled', false);

            }
            else {

                // Normal User
                if (response.Data.length > 0) {

                    $('#ddlUserName').val(response.Data[0].UserId);

                    $("#hdnSelectedUserId").val(response.Data[0].UserId);

                    $('#ddlUserName').prop('disabled', true);
                }
            }

            GetUserList();
        },
        error: function () {
            console.error('Failed to load users.');
        }
    });
}

// User change event
$('#ddlUserName').on('change', function () {
    $("#hdnSelectedUserId").val($(this).val());
});
function GetUserList() {
    var userId = $("#hdnSelectedUserId").val();
    var fromDate = $("#dtFromDate").val();
    var toDate =  $("#dtToDate").val();
    $.ajax({
        type: "GET",
        url: "@Url.Action("getUsersAuditLogList", "Master")",
        data: { userId: userId, fromDate: fromDate, toDate: toDate },
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: OnSuccess,
        failure: function (response) {
            alert(response.d);
        },
        error: function (response) {
            alert("Error fetching data!");
        }
    });
}

function OnSuccess(response) {
    bindDataTable(response);
}

