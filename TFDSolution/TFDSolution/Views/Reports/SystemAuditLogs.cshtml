    function bindDataTable(dataset) {
        dataset = Array.isArray(dataset) ? dataset : [];

        // Destroy using jQuery wrapper — works with both init styles
        var table = $('#tblUserAuditLogReportView');

        if ($.fn.DataTable.isDataTable(table)) {
            table.DataTable().destroy();
            table.empty(); // ← important: clear the DOM too
        }

        // Initialize DataTable
        table.DataTable({
            layout: {
                topStart: {
                    pageLength: {
                        menu: [10, 25, 50, 100]
                    }
                },
                topEnd: {
                    search: {
                        placeholder: 'Type search here'
                    }
                },
                bottomEnd: {
                    paging: {
                        buttons: 5
                    }
                }
            },
            paging: true,
            scrollCollapse: true,
            data: dataset,
            columns: [
                { title: '#', data: 'SrNo' },
                {
                    title: 'Action Date',
                    render: function (data, type, row, meta) {
                        if (!row.LogDateTime) return "<span>N/A</span>";
                        return "<span>" + formatDate(parseMSDate(row.LogDateTime)) + "</span>";
                    }
                },
                {
                    title: 'User',
                    render: function (data, type, row, meta) {
                        return "<span>" + row.FirstName + " " + row.LastName + "</span>"
                    }
                },
                { title: 'User Name', data: 'UserName' },
                { title: 'Email', data: 'EmailId' },              
                { title: 'Page Name', data: 'PageName' },
                { title: 'Action', data: 'Action' },
                { title: 'Remark', data: 'Remark' },
                { title: 'URN #', data: 'URNNo' },
                { title: 'Page URL', data: 'PageURL' },
                { title: 'IP Address', data: 'IPAddress' },
                {
                    title: 'Last Login Date',
                    render: function (data, type, row, meta) {
                        if (!row.LastLoginDate) return "<span>N/A</span>";
                        return "<span>" + formatDate(parseMSDate(row.LastLoginDate)) + "</span>";
                    }
                },
            ],
            language: {
                emptyTable: "No records found",
                zeroRecords: "No matching records found"
            }
        });
    }
function formatDate(d) {
    if (hasTime(d)) {
        let n = d.toLocaleString([], {
            hour: "2-digit",
            minute: "2-digit",
        });
        var s = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
        s += ' ' + n;
    } else {
        var s = (d.getDate() + '/' + d.getMonth() + 1) + '/' + d.getFullYear();
    }
    return s;
}
function hasTime(d) {
    return !!(d.getUTCHours() || d.getUTCMinutes() || d.getUTCSeconds());
}

function zeroFill(n) {
    if ((n + '').length == 1)
        return '0' + n;

    return n;
}
function parseMSDate(s) {
    // Jump forward past the /Date(, parseInt handles the rest
    return new Date(parseInt(s.substr(6)));
}

