
@{
    ViewBag.Title = "MISReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/select2.min.js"></script>
<script src="https://cdn.datatables.net/rowgroup/1.4.1/js/dataTables.rowGroup.min.js"></script>
<style>
    .dtrg-group {
        background-color: aliceblue !important;
        font-weight: bold;
        padding: 5px;
        font-size: 16px;
    }

    table.dataTable tbody tr.odd{
        background-color: white !important;
    }

    table.dataTable thead {
        display: none;
    }

    table.dataTable tr:hover {
        color: #27a9d7 !important;
    }

        table.dataTable tr:hover a {
            color: #27a9d7 !important;
        }

    table.dataTable tr td a {
        color: #000 !important;
    }

        table.dataTable tr td a:hover {
            color: #27a9d7 !important;
        }
</style>
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>MIS Reports</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="active">MIS Reports</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    <div class="row m-0">
        <div class="col-md-12 p-0">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-9">
                        <label class="form-label pt-2">List of MIS Report</label>
                    </div>
                    <div class="col-lg-3 text-right">
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <table id="tblMISReport" class="display cell-border nowrap" cellspacing="0" width="100%"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        BindPendings();
    });
    function BindPendings() {
        var isValid = true;
        if (isValid) {
            $.ajax({
                type: "GET",
                url: "@Url.Action("getReportTemplates", "Reports")",
                contentType: "application/json; charset=utf-8",
                success: SuccesssBindGrid,
                failure: function (response) {
                    ShowToastNotification("error", response.d);
                },
                error: function (response) {
                    ShowToastNotification("error", "Error fetching data!");
                }
            });
        }
    }
    function SuccesssBindGrid(dataset) {
        dataset = Array.isArray(dataset) ? dataset : [];
        // Initialize DataTable
        let formTable = new DataTable("#tblMISReport", {
            "destroy": true,
            searching: true,
            ordering: false,
            paging: false,
            scrollCollapse: true,
            info: true,
            scrollY: '600px',
            data: dataset,
            fixedHeader: true,
            order: [[0, 'asc']],  // sort by name
            rowGroup: {
                dataSrc: function (row) {
                    // Group by first letter of the Name column
                    return row["ReportTitle"].charAt(0).toUpperCase();
                }
            },
            columns: [
                { title: '#', data: 'SrNo' },
                {
                    title: 'Report Title',
                    data: 'ReportTitle',
                    render: function (data, type, row, meta) {
                        var pagedetial = '@Url.Action("MISReportView", "Reports", new { ReportId = "_uId"})';
                        pagedetial = pagedetial.replace("amp;", "");
                        pagedetial = pagedetial.replace("amp;", "");
                        var viewlink = pagedetial.replace("_uId", row["ReportId"]);
                        return "<a title='View Report' href='" + viewlink +"';>" + row["ReportTitle"] + "</a>";
                    },
                },
            ],
            language: {
                emptyTable: "No records found", // Message when no data is available
                zeroRecords: "No matching records found"
            }
        });
    }
</script>