</div>
<script>
    /******************** Events ********************/
    ////Calender Popup Event
    document.addEventListener('DOMContentLoaded', function () {
        const priorityColors = {
            'High': '#ff9999',     // Red/pink
            'Medium': '#ffd966',   // Yellow
            'Low': '#b6d7a8'       // Green
        };
        var calendarEl = document.getElementById('calendar');
        var lastClick = 0;
        window.calendar  = new FullCalendar.Calendar(calendarEl, {
            headerToolbar: {
                left: 'prevYear,prev,next,nextYear today',
                center: 'title',
                right: 'dayGridMonth,dayGridWeek,dayGridDay'
            },
            initialDate: new Date().toISOString().slice(0, 10),
            navLinks: true,
            editable: true,
            dayMaxEvents: true,
            selectable: true,
            displayEventTime: false,
            // You can fetch existing events dynamically
            // events: '/Calendar/GetEvents'
            events: {
                url: "@Url.Action("GetEvents", "Calendar")",
                failure: function () {
                    alert('There was an error while fetching events!');
                },
                success: function (data) {
                    console.log("Loaded events:", data); // Confirm in browser console
                }
            },
            eventContent: function (arg) {
                return {
                    html: `<div style="color: ${getPriorityColor(arg.event.extendedProps.priority)};">${arg.event.title}</div>`
                };
            },
            eventClick: function (info) {
                // Reset everything first
                $('#FollowUpModal').find('input, select, textarea').val('');
                $('#FollowUpModal').find('input[type="checkbox"]').prop('checked', false);
                info.jsEvent.preventDefault(); // Prevent browser redirect

                $('#PopupTitle').text(info.event.extendedProps.popuptitle);
                 // First bind dropdowns with selected values from event data
                bindDropdown('@Url.Action("GetAssignedToUsers", "Calendar")', 'ddlAssignedTo', '-- Select AssignedTo --', info.event.extendedProps.assignedTo || '');
                bindDropdown('@Url.Action("GetCoAgents", "Calendar")', 'ddlCoAgent', '-- Select CoAgent --', info.event.extendedProps.coAgent || '');
                bindDropdown('@Url.Action("GetEventPriorities", "Calendar")', 'ddlPriority', '-- Select Priority --', info.event.extendedProps.priority || '');
                bindDropdown('@Url.Action("GetFollowupStatusList", "Calendar")', 'ddlStatus', '-- Select Followup Status --', info.event.extendedProps.status || '');
                bindDropdown('@Url.Action("GetCommunicationModeList", "Calendar")', 'ddlModeOfCommunication', '-- Select ModeOfCommunication --', info.event.extendedProps.modeOfCommunication || '');

                const today = new Date().toISOString().split('T')[0];
                $('#FollowUpDate_Date').attr('min', today);
                // Assuming you use Bootstrap Modal or a custom popup
                $('#FollowUpModal').modal('show'); // Show the modal
                // Populate modal fields
                $('#FollowUpDate').val(info.event.extendedProps.followUpDate);//Assign in hidden field
                const existingDateTime = $('#FollowUpDate').val();
                populateFollowUpDateTimeControls(existingDateTime, 'FollowUpDate');
                if (existingDateTime >= new Date().toISOString()) {
                    disableAllFollowupFields(true)
                }
                else {
                    disableAllFollowupFields(false)
                }
                $('#hdnCurrentFollowUpId').val(info.event.extendedProps.followUpId || '');
                $('#hdnNextFollowUpId').val(info.event.extendedProps.nextFollowUpID || '');
                $('#hdnFollowUpStatus').val(info.event.extendedProps.status || '');
                $('#nextFollowUpDate').val(info.event.extendedProps.nextFollowUpDate|| '');
                $('#URNNumber').val(info.event.extendedProps.urn || '');
                $('#Interaction').val(info.event.extendedProps.interaction || '');
                $('#Outcome').val(info.event.extendedProps.outcome || '');
                $('#ContactPerson').val(info.event.extendedProps.contactPerson || '');
                $('#ContactNumber').val(info.event.extendedProps.contactNumber || '');
                //let statusValue = info.event.extendedProps.status;
                //$('#Status').prop('checked', statusValue == "1" || statusValue === true);
                // Set all fields in modal to readonly/disabled
                //$('#FollowUpModal')
                //    .find('input, select, textarea')
                //    .not('#FollowUpDate_Date,#FollowUpDate_Time') // Exclude the input with id followupdate
                //    .each(function () {
                //        const tag = $(this).prop('tagName').toLowerCase();
                //        if (tag === 'input' || tag === 'textarea') {
                //            $(this).prop('readonly', true);
                //        } else if (tag === 'select') {
                //            $(this).prop('disabled', true);
                //        }
                //    });
                //// Disable checkboxes separately (readonly doesn't work on checkboxes)
                //$('#FollowUpModal').find('input[type="checkbox"]').prop('disabled', true);
                toggleNextFollowUpDivs();
            },
        });
        calendar.render();
    });

       ///Open Next Followup popup on button click
   $('#btnCreateNextFollowUp').on('click', function () {
       let nextFollowUpId = $('#hdnNextFollowUpId').val();
       if (nextFollowUpId && parseInt(nextFollowUpId) > 0) {
           // Load from DB using AJAX
           $.ajax({
               url: "@Url.Action("GetFollowUpById", "Calendar")",
               type: 'GET',
               data: { id: nextFollowUpId },
               success: function (data) {
                   populateNextFollowUpModal(data);
               },
               error: function () {
                   alert("Failed to load next follow-up details.");
               }
           });
       }
       else {
           // Populate from existing followUpModal
           const data = {
               followUpId: 0,
               title: $('#PopupTitle').text(),
               assignedTo: $('#ddlAssignedTo').val(),
               //contactPersonId: $('#ContactPerson').val(),
               followUpDate: $('#FollowUpDate').val(),
               priority: $('#ddlPriority').val(),
               interaction: $('#Interaction').val(),
               outcome: $('#Outcome').val(),
               coAgent: $('#ddlCoAgent').val(),
               urn: $('#URNNumber').val(),
               status: 1, // open :Assuming new follow - up is always open
               contactPerson: $('#ContactPerson').val(),
               contactNumber: $('#ContactNumber').val(),
               modeOfCommunication: $('#ddlModeOfCommunication').val(),
              // status: $('#Status').is(':checked')

           };
           populateNextFollowUpModal(data);
       }
   });

     ///Save Current followup details
    $('#btnSaveFollowUp').on('click', function () {
        try {
              var followUpId = $('#hdnCurrentFollowUpId').val();
              // Combine date and time into ISO string
              const date = $('#FollowUpDate_Date').val();
              const time = $('#FollowUpDate_Time').val();
              var fullFollowUpDate = '';
              if (date && time) {
                  fullFollowUpDate = `${date}T${time}:00`;
                  $('#FollowUpDate').val(fullFollowUpDate);
              } else {
                  ShowToastNotification("error", "Please select both Date and Time for FollowUp.");
                  return;
              }
              const today = new Date().toISOString(); // e.g., '30/07/2025 5:30 PM'
              if (today && fullFollowUpDate <= today) {
                  ShowToastNotification("error", "Follow-up date cannot be less than tomorrow date.");
                  return;
              }
               // Prepare payload
              var payload = {
                  FollowUpId: followUpId, //Always 0 for New Followup
                  Form_URNNo: $('#URNNumber').val(),
                  FollowUpDate: fullFollowUpDate,
                  EventPriority: $('#ddlPriority').val(),
                  AssignedTo: $('#ddlAssignedTo').val(),
                  Interaction: $('#Interaction').val(),
                  Response: $('#Outcome').val(),
                  CoAgent: $('#ddlCoAgent').val(),
                  // Status: $('#Next_Status').is(':checked'), // Boolean
                  Status: $('#ddlStatus').val(), // Boolean
                  ContactNumber: $('#ContactNumber').val(),
                  ContactPerson: $('#ContactPerson').val(),
                  ModeOfCommunication: $('#ddlModeOfCommunication').val()
                };
            // Send to server
            $.ajax({
                url: "@Url.Action("SaveTRNFollowUp", "Calendar")",
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.IsSuccess) {
                        ShowToastNotification("success", "Follow-Up saved successfully!");
                        //$('#nexFollowUpModal').modal('hide');
                        if (window.calendar) {
                            window.calendar.refetchEvents(); // update calendar without reload
                        }
                    } else {
                        ShowToastNotification("error", 'Failed to save Follow-Up. ' + (response.Response || ''));
                    }
                },
                error: function () {
                    ShowToastNotification("error", 'An error occurred while saving Follow-Up.');
                }
            });
        } catch (e) {

        }
});

  ///Save NExt followup details
  $('#btnSaveNextFollowUp').on('click', function () {
      // Combine date and time into ISO string
      const date = $('#Next_FollowUpDate_Date').val();
      const time = $('#Next_FollowUpDate_Time').val();
      let fullFollowUpDate = '';
      if (date && time) {
          fullFollowUpDate = `${date}T${time}:00`;
          $('#Next_FollowUpDate').val(fullFollowUpDate);
      } else {
          ShowToastNotification("error", "Please select both Date and Time for FollowUp.");
          return;
      }

      const nextFollowUpDateStr = $('#Next_NextFollowUpDate').val(); // e.g., '30/07/2025 5:30 PM'
      if (nextFollowUpDateStr) {

          const nextFollowUpDateparse = parseDateTimeFromString(nextFollowUpDateStr);
          if (nextFollowUpDateStr && fullFollowUpDate > nextFollowUpDateparse) {
              ShowToastNotification("error", "Follow-up date cannot be greater than the next follow-up date.");
              return;
          }
      }

      const FollowUpDateStr = $('#FollowUpDate').val(); // e.g., '30/07/2025 5:30 PM'
      if (FollowUpDateStr) {

          const FollowUpDateparse = parseDateTimeFromString(FollowUpDateStr);
          if (FollowUpDateStr && FollowUpDateparse > fullFollowUpDate) {
              ShowToastNotification("error", "Follow-up date cannot be Less than the Parent follow-up date.");
              return;
          }
      }
      // Prepare payload
      var payload = {
          ParentFollowUpId: $('#hdnCurrentFollowUpId').val(),
          FollowUpId: $('#Next_hdnCurrentFollowUpId').val(),
          Form_URNNo: $('#Next_URNNumber').val(),
          FollowUpDate: fullFollowUpDate,
          EventPriority: $('#Next_ddlPriority').val(),
          AssignedTo: $('#Next_ddlAssignedTo').val(),
          ContactPerson_Id: $('#Next_ContactPerson').val(),
          Interaction: $('#Next_Interaction').val(),
          Response: $('#Next_Outcome').val(),
          CoAgent: $('#Next_ddlCoAgent').val(),
          // Status: $('#Next_Status').is(':checked'), // Boolean
          Status: $('#Next_ddlStatus').val(), // Boolean
          ContactNumber: $('#Next_ContactNumber').val(),
          ContactPerson: $('#Next_ContactPerson').val(),
          ModeOfCommunication: $('#Next_ddlModeOfCommunication').val(),

         // nextFollowUpDate: $('#Next_NextFollowUpDate').val()
      };
      // Send to server
      $.ajax({
          url: "@Url.Action("SaveNextFollowUpEvent", "Calendar")",
          method: 'POST',
          contentType: 'application/json',
          data: JSON.stringify(payload),
          success: function (response) {
              if (response && response.IsSuccess) {
                  ShowToastNotification("success", "Next Follow-Up saved successfully!");
                  const updatedDate = $('#Next_FollowUpDate').val(); // new value from second popup // e.g. "2025-08-01T12:15:00"
                  const formattedDate = formatDateToDDMMYYYYHHMMTT(updatedDate); // "01/08/2025 12:15 PM"
                  $('#FollowUpModal #nextFollowUpDate').val(formattedDate);

                  $('#nextFollowUpModal').modal('hide');
                  if (window.calendar) {
                      window.calendar.refetchEvents(); // update calendar without reload
                  }
              } else {
                  ShowToastNotification("error", 'Failed to save Next Follow-Up. ' + (response.Response || ''));
              }
          },
          error: function () {
              ShowToastNotification("error", "An error occurred while saving Next Follow-Up.");
          }
      });
  });


   //btn Soft delete followup
   $('#btnDeleteFolloup').on('click', function () {
       var followUpId = $('#hdnCurrentFollowUpId').val();
       if (!followUpId || followUpId <= 0) {
           ShowToastNotification("error", "FollowUp ID is missing.");
           return;
       }
       else {
           $.ajax({
               url: "@Url.Action("DeleteFollowUp", "Calendar")",
               type: 'POST',
               data: { FollowUpId: followUpId },
               success: function (response) {
                   if (response.IsSuccess) {
                       ShowToastNotification("error", "Followup deleted successfully.");
                       if (window.calendar) {
                           window.calendar.refetchEvents(); // update calendar without reload
                       }

                   } else {
                       alert(`Failed to delete Followup: ${response.Response || ''}`);
                   }
               },
               error: function (xhr, status, error) {
                   ShowToastNotification("error", "An error occurred while deleting Followup.");
               }
           });
       }
   });

   /******************** Functions ********************/
    //Bind Dropdowns:
    function bindDropdown(url, dropdownId, defaultText, selectedValue = null) {
        $.ajax({
            url: url,
            type: 'GET',
            success: function (data) {
                var ddl = $('#' + dropdownId);
                ddl.empty(); // Clear existing options
                ddl.append($('<option>').val('').text(defaultText)); // Default option
                $.each(data, function (i, item) {
                    ddl.append($('<option>').val(item.Value).text(item.Text));
                });
                if (selectedValue !== null) {
                    ddl.val(selectedValue);
                }
            },
            error: function () {
                alert("Error loading " + dropdownId + " data.");
            }
        });
    }

    function disableAllFollowupFields(isdisable) {
        // Set all fields in modal to readonly/disabled
        $('#FollowUpModal')
            .find('input, select, textarea')
          //  .not('#FollowUpDate_Date,#FollowUpDate_Time') // Exclude the input with id followupdate
            .each(function () {
                const tag = $(this).prop('tagName').toLowerCase();
                if (tag === 'input' || tag === 'textarea') {
                    $(this).prop('readonly', isdisable);
                } else if (tag === 'select') {
                    $(this).prop('disabled', isdisable);
                }
            });
        if (isdisable) {
            $('#btnSaveFollowUp').hide();
        }
        else { $('#btnSaveFollowUp').show(); }
    }

    function toggleNextFollowUpDivs() {
        let nextFollowUpId = $('#hdnNextFollowUpId').val();
        let FollowUpStatus = $('#hdnFollowUpStatus').val();

        if (nextFollowUpId && parseInt(nextFollowUpId) > 0) {
                //$('#divNextFollowup').hide();
                $('#divNextFollowupDate').show();
                $('#btnCreateNextFollowUp').hide();
        } else {
            $('#divNextFollowupDate').hide();
            if (FollowUpStatus && (parseInt(FollowUpStatus) != 2 && parseInt(FollowUpStatus) != 3)) {
                disableAllFollowupFields(false);
                $('#btnCreateNextFollowUp').show();
            }
            else {
                disableAllFollowupFields(true);
                $('#btnCreateNextFollowUp').hide();
            }
        }
    }

    function toggleNextFollowUpDateDivs() {
        let NextFollowUpDate = $('#Next_NextFollowUpDate').val();
        if (NextFollowUpDate && NextFollowUpDate !='') {
            $('#divNext_NextFollowUpDate').show();
        } else {
            $('#divNext_NextFollowUpDate').hide();
        }
    }

    function getPriorityColor(priority) {
        switch (priority) {
            case 'High':
            case 1:
                return '#ff0000'; // Red
            case 'Medium':
            case 2:
                return '#ff9900'; // Orange
            case 'Low':
            case 3:
                return '#228B22'; // Green
            default:
                return '#555555'; // Default gray
        }
    }

    //Populate Nextfollowup Model details For update/ Insert
