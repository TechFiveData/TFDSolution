        bindDropdown('@Url.Action("GetCoAgents", "Calendar")', 'Next_ddlCoAgent', '-- Select CoAgent --', data.coAgent);
        bindDropdown('@Url.Action("GetEventPriorities", "Calendar")', 'Next_ddlPriority', '-- Select Priority --', data.priority);
        bindDropdown('@Url.Action("GetCommunicationModeList", "Calendar")', 'Next_ddlModeOfCommunication', '-- Select ModeOfCommunication --', data.modeOfCommunication);
        bindDropdown('@Url.Action("GetFollowupStatusList", "Calendar")', 'Next_ddlStatus', '-- Select Followup Status --', data.status);

