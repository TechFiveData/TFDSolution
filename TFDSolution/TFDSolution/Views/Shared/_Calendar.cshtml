    //Populate Followup date & time seperatly
    function populateFollowUpDateTimeControls(fullDateTimeStr, controlPrefix) {
        if (!fullDateTimeStr || !controlPrefix) return;
        // Expected format: dd/MM/yyyy hh:mm AM/PM
        const match = fullDateTimeStr.match(/^(\d{2})\/(\d{2})\/(\d{4}) (\d{1,2}):(\d{2}) (AM|PM)$/i);
        if (match) {
            let [_, dd, MM, yyyy, hh, mm, period] = match;
            hh = parseInt(hh, 10);
            if (period.toUpperCase() === 'PM' && hh < 12) hh += 12;
            if (period.toUpperCase() === 'AM' && hh === 12) hh = 0;

            const datePart = `${yyyy}-${MM}-${dd}`; // "yyyy-MM-dd"
            const timePart = `${hh.toString().padStart(2, '0')}:${mm}`; // "HH:mm"

            $(`#${controlPrefix}_Date`).val(datePart);
            $(`#${controlPrefix}_Time`).val(timePart);
        } else {
            console.warn('Invalid date format:', fullDateTimeStr);
        }
    }

    function isFutureDateTime(dateStr, timeStr) {
        if (!dateStr || !timeStr) return false;

        const selected = new Date(`${dateStr}T${timeStr}`);
        const now = new Date();

        return selected.getTime() >= now.getTime();
    }

    function parseDateTimeFromString(dateTimeStr) {
        // Try format: 'dd/MM/yyyy hh:mm AM/PM'
        const regex1 = /^(\d{2})\/(\d{2})\/(\d{4}) (\d{1,2}):(\d{2}) (AM|PM)$/i;
        const match1 = dateTimeStr.match(regex1);
        if (match1) {
            let [_, dd, mm, yyyy, hh, min, meridian] = match1;
            dd = parseInt(dd, 10);
            mm = parseInt(mm, 10);
            yyyy = parseInt(yyyy, 10);
            hh = parseInt(hh, 10);
            min = parseInt(min, 10);

            if (meridian.toUpperCase() === 'PM' && hh !== 12) {
                hh += 12;
            } else if (meridian.toUpperCase() === 'AM' && hh === 12) {
                hh = 0;
            }

            // Format to ISO-like string
            return `${yyyy}-${mm.toString().padStart(2, '0')}-${dd.toString().padStart(2, '0')}T${hh.toString().padStart(2, '0')}:${min.toString().padStart(2, '0')}:00`;
        }

        // Fallback: Try native Date parsing if it fails (optional)
        const parsedDate = new Date(dateTimeStr);
        if (!isNaN(parsedDate.getTime())) {
            return parsedDate.toISOString().slice(0, 19); // 'YYYY-MM-DDTHH:mm:ss'
        }

        return null; // If all parsing fails
    }

    function formatDateToDDMMYYYYHHMMTT(dateStr) {
        const date = new Date(dateStr);

        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();

        let hours = date.getHours();
        const minutes = String(date.getMinutes()).padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';

        hours = hours % 12;
        hours = hours ? hours : 12; // 0 => 12
        const strHours = String(hours).padStart(2, '0');

        return `${day}/${month}/${year} ${strHours}:${minutes} ${ampm}`;
    }

    ///Common function to save followup datetime can be used by both model
    function saveFollowUpDateTime(options) {
        const {
            dateSelector,
            timeSelector,
            hiddenFieldSelector,
            followUpId,
           // saveUrl,
            label,
            buttonSelector
        } = options;
        const date = $(dateSelector).val();
        const time = $(timeSelector).val();
        if (!date || !time) {
            alert(`Please select both date and time for ${label}.`);
            return;
        }
        if (!isFutureDateTime(date, time)) {
            alert("Date and time must not be in the past.");
            return;
        }
        if (!followUpId) {
            alert("FollowUp ID is missing.");
            return;
        }
        const combined = `${date}T${time}:00`;
        // Validate against nextFollowUpDate if present
        const nextFollowUpDateStr = $('#nextFollowUpDate').val(); // e.g., '30/07/2025 5:30 PM'
        if (nextFollowUpDateStr) {

            const nextFollowUpDateparse = parseDateTimeFromString(nextFollowUpDateStr);
            if (nextFollowUpDateStr && combined > nextFollowUpDateparse) {
                alert("Follow-up date cannot be greater than the next follow-up date.");
                return;
            }
        }


        if (hiddenFieldSelector) {
            $(hiddenFieldSelector).val(combined);
        }
        if (buttonSelector) {
            $(buttonSelector).prop('disabled', true).text('Saving...');
        }
        $.ajax({
            /*url: '/Calendar/SaveFollowUpDate',*/
            url: "@Url.Action("SaveFollowUpDate", "Calendar")",
            type: 'POST',
            data: {
                followUpId: followUpId,
                followUpDate: combined,
                type: label // Optional if you need to differentiate on server
            },
            success: function (response) {
                if (response.IsSuccess) {
                    alert(`${label} saved successfully.`);
                    if (window.calendar) {
                        window.calendar.refetchEvents(); // update calendar without reload
                    }

                } else {
                    alert(`Failed to save ${label}. ${response.Response || ''}`);
                }
            },
            error: function (xhr, status, error) {
                console.error(`Error saving ${label}:`, error);
                alert(`An error occurred while saving ${label}.`);
            },
            complete: function () {
                if (buttonSelector) {
                    $(buttonSelector).prop('disabled', false).text('Save');
                }
            }
        });
    }

</script>
