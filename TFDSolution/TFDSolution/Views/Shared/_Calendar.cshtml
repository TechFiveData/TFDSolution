                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="Next_ddlCoAgent" class="form-control-label">Co Agent<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("Next_ddlCoAgent", Enumerable.Empty<SelectListItem>(), "-- Select CoAgent --", new { @class = "form-control form-select", id = "Next_ddlCoAgent" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="Next_ddlModeOfCommunication" class="form-control-label">Mode Of Communication<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("Next_ddlModeOfCommunication", Enumerable.Empty<SelectListItem>(), "-- Select ModeOfCommunication --", new { @class = "form-control form-select", id = "Next_ddlModeOfCommunication" })
                    </div>
                </div>
                <div class="row form-group ">
                    <div class="col col-md-12">
                        <label for="Next_ddlStatus" class=" form-control-label">Status</label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("Next_ddlStatus", Enumerable.Empty<SelectListItem>(), "-- Select Followup Status --", new { @class = "form-control form-select", id = "Next_ddlStatus" })
                    </div>

                </div>
                <div class="row form-group" id="divNext_NextFollowUpDate">
                    <div class="col col-md-12">
                        <label for="text-input" class="form-control-label">Next FollowUp Date</label>
                    </div>
                    <div class="col-12 col-md-12">
                        <input id="Next_NextFollowUpDate" class="form-control disabled" placeholder="Next FollowUp Date" />
                    </div>
                </div>
                <!-- You can optionally add a hidden input for NextFollowUpId if required -->
                <input type="hidden" id="Next_hdnCurrentFollowUpId" />
