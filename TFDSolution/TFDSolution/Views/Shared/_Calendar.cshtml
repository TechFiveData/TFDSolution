<style>

    #calendar {
        /*max-width: 1100px;*/
        width: 100%;
        margin: 0 auto;
    }

    .modal-dialog {
        float: none !important;
        height: auto !important;
    }
</style>
<div id="calendar"></div>
<div class="modal fade" id="FollowUpModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><label id="PopupTitle"></label></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <input type="hidden" id="hdnCurrentFollowUpId" value="" />
            <input type="hidden" id="hdnNextFollowUpId" value="" />
            <input type="hidden" id="hdnFollowUpStatus" value="" />
            <div class="modal-body">

                <div class="row form-group d-none">
                    <div class="col col-md-12">
                        <label for="URNNumber" class="form-control-label">URN Number</label>
                    </div>
                    <div class="col col-md-12">
                        <input id="URNNumber" class="form-control" placeholder="URN Number" readonly />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="FollowUpDate" class="form-control-label">FollowUp Date<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12 p-0">
                        <div class="col col-md-7"><input type="date" id="FollowUpDate_Date" class="form-control" /></div>
                        <div class="col col-md-4 p-0"><input type="time" id="FollowUpDate_Time" class="form-control" /></div>
                        @*Hidden combined datetime value*@
                        <input type="hidden" id="FollowUpDate" name="FollowUpDate" />

                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="ddlAssignedTo" class="form-control-label">Assigned To<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("ddlAssignedTo", Enumerable.Empty<SelectListItem>(), "-- Select Assigned --", new { @class = "form-control form-select", id = "ddlAssignedTo" })
                    </div>
                </div>
                <div class="form-group">
                    <!-- Labels row -->
                    <div class="row">
                        <div class="col-md-6">
                            <label for="ContactPerson" class="form-control-label">Contact Person</label>
                        </div>
                        <div class="col-md-6">
                            <label for="ContactNumber" class="form-control-label">Contact No</label>
                        </div>
                    </div>
                    <!-- Inputs row -->
                    <div class="row">
                        <div class="col-md-6">
                            <input type="text" id="ContactPerson" maxlength="200" class="form-control" placeholder="Contact Person" />
                        </div>
                        <div class="col-md-6">
                            <input type="text" id="ContactNumber" maxlength="12" class="form-control" placeholder="Contact Number" />
                        </div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="Interaction" class="form-control-label">Interaction</label>
                    </div>
                    <div class="col col-md-12">
                        <textarea id="Interaction" class="form-control" placeholder="Interaction"></textarea>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="Outcome" class="form-control-label">Outcome</label>
                    </div>
                    <div class="col col-md-12">
                        <textarea id="Outcome" class="form-control" placeholder="Outcome"></textarea>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="ddlCoAgent" class="form-control-label">Co Agent<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("ddlCoAgent", Enumerable.Empty<SelectListItem>(), "-- Select CoAgent --", new { @class = "form-control form-select", id = "ddlCoAgent" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="ddlPriority" class="form-control-label">Priority<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("ddlPriority", Enumerable.Empty<SelectListItem>(), "-- Select Priority --", new { @class = "form-control form-select", id = "ddlPriority" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="ModeOfCommunication" class="form-control-label">Mode Of Communication<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("ddlModeOfCommunication", Enumerable.Empty<SelectListItem>(), "-- Select ModeOfCommunication --", new { @class = "form-control form-select", id = "ddlModeOfCommunication" })
                    </div>
                </div>
                <div class="row form-group ">
                    <div class="col col-md-12">
                        <label for="text-input" class=" form-control-label">Status</label>
                    </div>
                    <div class="col col-md-12">
                        @Html.DropDownList("ddlStatus", Enumerable.Empty<SelectListItem>(), "-- Select Followup Status --", new { @class = "form-control form-select", id = "ddlStatus" })
                    </div>
                </div>
                <div class="row form-group" id="divNextFollowupDate">
                    <div class="col col-md-12">
                        <label for="text-input" class="form-control-label">Next FollowUp Date</label>
                    </div>
                    <div class="col col-md-12">
                        <input id="nextFollowUpDate" class="form-control" placeholder="Next FollowUp Date" />
                    </div>
                </div>

                <div class="modal-footer">
                    @*<button type="button" title="Delete Follow-Up" class="btn btn-danger" id="btnDeleteFolloup">Delete</button>*@
                    <button type="button" title="Click here to Save" class="btn btn-primary" id="btnSaveFollowUp">Save</button>
                    <button id="btnCreateNextFollowUp" title="Click here to Create Next Follo-Up" type="button" class="btn btn-primary ">Create Next FollowUp</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
