                                 //}
                                 count = item.UnReadCount;
                                 $("#notificationCount").text(count);
                             });
                             nofticationHtml = `<p class="red">You have ${count} Notification${count > 1 ? 's' : ''}</p>` + nofticationHtml;
                             //$("#divDataNofication").html(nofticationHtml);
                             $("#notificationCount").html(count);
                             $("#divDataNofication span.badge").html(count);
                             /*$("#MyNoficationCount").html(count);                             */
                         }
                    },
                    error: function () {
                        console.log("Error loading while updating...");
                    }
                });
            } catch (e) {

            }
        }
        // ===== Tab switching =====
        $(document).on('click', '.notif-tab', function () {
            var tabName = $(this).data('tab');
            $('.notif-tab').removeClass('active');
            $(this).addClass('active');
            $('.notif-tab-content').removeClass('active');
            $('#tab-' + tabName).addClass('active');
        });

        // Prevent dropdown from closing when clicking inside
        $(document).on('click', '#divDataNofication', function (e) {
            e.stopPropagation();
        });

        // ===== TO-DO =====
        var todoItems = JSON.parse(localStorage.getItem('tfd_todo') || '[]');

        function RenderTodoList() {
            var html = '';
            var pending = 0;
            if (todoItems.length === 0) {
                html = '<div style="padding:16px;text-align:center;color:#aaa;font-size:13px;">No tasks yet. Add one above.</div>';
            } else {
                todoItems.forEach(function (item, idx) {
                    var doneClass = item.done ? 'done' : '';
                    html += '<div class="todo-item ' + doneClass + '">' +
                        '<input type="checkbox" ' + (item.done ? 'checked' : '') + ' onchange="ToggleTodo(' + idx + ')" />' +
                        '<span class="todo-text">' + escapeHtml(item.text) + '</span>' +
                        '<button class="item-delete" onclick="DeleteTodo(' + idx + ')"><i class="fa fa-times"></i></button>' +
                        '</div>';
                    if (!item.done) pending++;
                });
            }
            $('#todoList').html(html);
            $('#tabTodoCount').text(pending > 0 ? pending : '');
        }

        function SaveTodos() {
            localStorage.setItem('tfd_todo', JSON.stringify(todoItems));
        }

        function AddTodoItem() {
            var text = $('#todoInput').val().trim();
            if (!text) return;
            todoItems.unshift({ text: text, done: false });
            SaveTodos();
            RenderTodoList();
            $('#todoInput').val('').focus();
        }

        function ToggleTodo(idx) {
            todoItems[idx].done = !todoItems[idx].done;
            SaveTodos();
            RenderTodoList();
        }

        function DeleteTodo(idx) {
            todoItems.splice(idx, 1);
            SaveTodos();
            RenderTodoList();
        }

        // Allow Enter key to add todo
        $(document).on('keydown', '#todoInput', function (e) {
            if (e.key === 'Enter') AddTodoItem();
        });

        // ===== FOLLOW UP =====
        var followupItems = JSON.parse(localStorage.getItem('tfd_followup') || '[]');

        function RenderFollowupList() {
            var html = '';
            var upcoming = 0;
            var now = new Date();
            if (followupItems.length === 0) {
                html = '<div style="padding:16px;text-align:center;color:#aaa;font-size:13px;">No follow-ups yet. Add one above.</div>';
            } else {
                followupItems.sort(function (a, b) { return new Date(a.date) - new Date(b.date); });
                followupItems.forEach(function (item, idx) {
                    var itemDate = new Date(item.date);
                    var isOverdue = itemDate < now;
                    var overdueClass = isOverdue ? 'overdue' : '';
                    var dateStr = itemDate.toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    html += '<div class="followup-item ' + overdueClass + '">' +
                        '<div class="followup-info">' +
                        '<div class="followup-title">' + escapeHtml(item.title) + '</div>' +
                        '<div class="followup-time"><i class="fa fa-clock-o"></i> ' + dateStr + (isOverdue ? ' — Overdue' : '') + '</div>' +
                        '</div>' +
                        '<button class="item-delete" onclick="DeleteFollowup(' + idx + ')"><i class="fa fa-times"></i></button>' +
                        '</div>';
                    if (!isOverdue) upcoming++;
                });
            }
            $('#followupList').html(html);
            $('#tabFollowupCount').text(upcoming > 0 ? upcoming : '');
        }

        function SaveFollowups() {
            localStorage.setItem('tfd_followup', JSON.stringify(followupItems));
        }

        function AddFollowupItem() {
            var title = $('#followupTitle').val().trim();
            var date = $('#followupDate').val();
            if (!title || !date) {
                alert('Please enter both a title and a date/time.');
                return;
            }
            followupItems.push({ title: title, date: date });
            SaveFollowups();
            RenderFollowupList();
            $('#followupTitle').val('');
            $('#followupDate').val('');
        }

        function DeleteFollowup(idx) {
            followupItems.splice(idx, 1);
            SaveFollowups();
            RenderFollowupList();
        }

        function escapeHtml(text) {
            return $('<div>').text(text).html();
        }

        // Init lists on page load
        $(document).ready(function () {
            RenderTodoList();
            RenderFollowupList();
        });
    </script>
</body>
</html>
