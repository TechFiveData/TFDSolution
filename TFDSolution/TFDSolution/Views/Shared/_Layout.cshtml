    <script type="text/javascript">
        // Trigger from any tab
        function ResetNotificationTab() {
            $('.notif-tab').removeClass('active');
            $('.notif-tab-content').removeClass('active');
            $('.notif-tab[data-tab="notifications"]').addClass('active');
            $('#tab-notifications').addClass('active');
        }
        function logoutAllTabs() {
            localStorage.setItem("logout", Date.now());
        }
        function customConfirm({ message, type = "success", title = "Confirmation", okText = "OK",
            cancelText = "Cancel" }, callback) {
            const modal = $("#confirmModal");
            const box = modal.find(".confirm-box");
            // reset classes
            box.removeClass("success warning delete").addClass(type);
            // set content
            modal.find(".confirm-body").text(message);
            modal.find(".confirm-title").text(title);
            // set button text dynamically
            $(".btn-ok").text(okText);
            $(".btn-cancel").text(cancelText);
            // icons
            let iconClass = "";
            if (type === "success") iconClass = "fa fa-check-circle";
            if (type === "warning") iconClass = "fa fa-exclamation-triangle";
            if (type === "delete") iconClass = "fa fa-trash";
            modal.find(".confirm-icon").attr("class", "confirm-icon " + iconClass);
            modal.addClass("show");
            // events
            $(".btn-ok").off("click").on("click", function () {
                modal.removeClass("show");
                callback(true);
            });
            $(".btn-cancel").off("click").on("click", function () {
                modal.removeClass("show");
                callback(false);
            });
            // 🔥 Keyboard support
            $(document).on("keydown.confirm", function (e) {
                if (!modal.hasClass("show")) return;
                if (e.key === "Enter") {
                    e.preventDefault();
                    closeModal(true);   // YES
                }
                if (e.key === "Escape") {
                    e.preventDefault();
                    closeModal(false);  // CANCEL
                }
            });
            $("#confirmModal").off("click").on("click", function (e) {
                if ($(e.target).is("#confirmModal")) {
                    closeModal(false); // treat as Cancel
                }
            });
            // 🔥 common close function
            function closeModal(result) {
                modal.removeClass("show");
                $(document).off("keydown.confirm"); // cleanup
                callback(result);
            }

            // 🔥 Optional: auto focus Yes button
            setTimeout(() => {
                $(".btn-ok").focus();
            }, 100);
        }

        $(document).ready(function () {
            $("#company").click(function (e) {
                e.preventDefault();
                e.preventDefault();
                $(this).next(".company-menu").toggleClass("show");
            });
            window.addEventListener("storage", function (event) {
                if (event.key === "logout") {
                    // Another tab triggered logout
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });
            // Close when clicking outside
            $(document).click(function (e) {
                if (!$(e.target).closest('.company-area').length) {
                    $(".company-menu").removeClass("show");
                }
            });
            $('.dropdown-submenu > a').on("click", function (e) {
                e.preventDefault();
                e.stopPropagation();

                $(this).parent().toggleClass('show');
                $(this).next('.dropdown-menu').toggle();
            });
            // Show loader when page starts loading
            $("#pageLoader").fadeOut();            
            BindUserNotifications();
            setInterval(function () {
                BindUserNotifications();
            }, 50000);
        });
        // Hide loader when page is fully loaded
        $(window).on("load", function () {
            $("#pageLoader").fadeOut();
        });
        // Loop through all menu links
        $('#main-menu a').each(function () {
            var link = $(this).attr('href');
            var currentUrl = window.location.pathname + window.location.search;

            if (link && currentUrl.toLowerCase() === link.toLowerCase()) {

                // Highlight this item
                $(this).parent("li").addClass("active");

                // Open parent dropdown
                $(this).closest('.dropdown').addClass('show');

                // Open its submenu
                $(this).closest('.dropdown-menu').addClass('show');

                // Set toggle to expanded
                $(this).closest('.dropdown')
                    .children('.dropdown-toggle')
                    .attr('aria-expanded', 'true');
            }
        });
        //$(document).ajaxStart(function (event, jqXHR, options) {
        //    /*if (options.skipLoading) return;*/
        //    try {
        //        if (options ? options.skipLoading : false) {
        //            console.log("Skip loading");
        //            return;
        //        }
        //        else {
        //            $("#pageLoader").fadeIn();
        //        }
        //    } catch (e) {
        //        console.log("Error : " + e);
        //    }

        //}).ajaxStop(function (event, jqXHR, options) {
        //    $("#pageLoader").fadeOut();
        //});

        $(document).ajaxSend(function (event, jqXHR, options) {
            if (options ? options.skipLoading : false) return; // <-- Skip loader
            $("#pageLoader").fadeIn();
        });

        $(document).ajaxComplete(function (event, jqXHR, options) {
            if (options ? options.skipLoading : false) return;
            $("#pageLoader").fadeOut();
        });

