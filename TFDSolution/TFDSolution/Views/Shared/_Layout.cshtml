    function BindUserNotifications() {
        // reset UI first (prevents stale/incorrect values during first run)
        //$("#notificationCount").text(0
        $("#divDataNofication span.badge").text(0);
        $("#divDataNofication .notification-list").empty();
        $.ajax({
            url: '@Url.Action("getUserNotifications", "Master")',
            type: 'GET',
            dataType: 'json',               // ensure jQuery parses JSON — prevents string/HTML handling
            skipLoading: true,              // <-- Skip loader for this request
            success: function (response) {
                if (!response || !Array.isArray(response) || response.length === 0) {
                    // nothing to show
                    return;
                }

                const count = response.reduce((acc, it) => Math.max(acc, Number(it.UnReadCount || 0)), 0);
                if (count > 99) {
                    $("#notificationCount").text("99+");
                }
                else {
                    $("#notificationCount").text(count);
                }
                $("#divDataNofication span.badge").text(count);
                // build markup in memory for performance & avoid shadowing variables
                let itemsHtml = '';
                response.forEach(function (item) {
                    const title = item.Title || '';
                    const msgTime = typeof formatTimeAgo === 'function' ? formatTimeAgo(item.CreatedOn) : '';
                    const statusClass = (item.IsRead === true) ? "read" : "unread";

                    itemsHtml += `<a class="notification-item ${statusClass}" href="../Account/MyNofications">
                        <div class="icon"><i class="fa fa-envelope"></i></div>
                        <div class="content"><p>${title}</p></div>
                        <div class="time">${msgTime}</div>
                    </a>`;
                });

                $("#divDataNofication .notification-list").append(itemsHtml);
                if (count > 99) {
                    $("#notificationCount").text("99+");
                }
                else {
                    $("#notificationCount").text(count);
                }
                $("#divDataNofication span.badge").text(count);
                $("#btnnotification span").text(count);
                // compute unread count robustly (use max or sum depending on server semantics)
                // Using max to preserve original pattern where server supplied UnReadCount per item.

                // optionally update other UI places:
                // $("#MyNoficationCount").text(count);
            },
            error: function (jqXHR, textStatus, errorThrown) {
                // If server returned HTML (e.g. login redirect or error page), detect and handle it
                const body = (jqXHR && jqXHR.responseText) ? jqXHR.responseText.trim() : '';
                if (body && body.charAt(0) === '<') {
                    // likely a login/HTML response (session expired or server returned a View)
                    console.warn("Notification endpoint returned HTML — session may be expired. Forcing reload to sign-in.");
                    window.location.href = '@Url.Action("Index", "Home")';
                    return;
                }
                console.error("Error loading notifications:", textStatus, errorThrown);
            }
        });
    }
