<!DOCTYPE html>
<html>
<head>
    @{
        var ImagesBase = Url.Content("~/Images");
        var ContentBase = Url.Content("~/Content");
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TFD | @ViewBag.Title</title>
    <link rel="apple-touch-icon" href="apple-icon.png">
    <link rel="shortcut icon" href="favicon.ico">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/main/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/main/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/main/themify-icons/css/themify-icons.css" rel="stylesheet" />
    <link href="~/Content/main/flag-icon-css/css/flag-icon.min.css" rel="stylesheet" />
    <link href="~/Content/main/selectFX/css/cs-skin-elastic.css" rel="stylesheet" />

    <link href="~/Content/main/jqvmap/jqvmap.min.css" rel="stylesheet" />
    <link href="~/Content/main/assets/css/style.css" rel="stylesheet" />
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:400,600,700,800' rel='stylesheet' type='text/css'>
    @* For drag and drop row reordering*@
    <link href="~/Content/rowReorder.dataTables.min.css" rel="stylesheet" />
    @*For drag and drop Tab reordering*@
    <link href="~/Content/jquery-ui-1.13.2.css" rel="stylesheet" />
    <link href="~/Content/select2.min.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/dataTables.js"></script>
    <script src="~/Scripts/dataTables.scroller.js"></script>
    @*<script src="~/Scripts/dataTables.jqueryui.js"></script>*@
    <link href="~/Content/dataTables.jqueryui.css" rel="stylesheet" />
    <link href="~/Content/jquery.dataTables.css" rel="stylesheet" />
    <script src="~/Scripts/CommonFunction.js"></script>
    <script src="~/Scripts/jquery.dataTables.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/select2.min.js"></script>
    <link href="~/Content/toastr.css" rel="stylesheet" />
    @*Added for full calender event*@
    <link href="~/Content/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    @*<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />*@

    <script>
        toastr.options = {
            "closeButton": false,
            "debug": false,
            "newestOnTop": false,
            "progressBar": false,
            "positionClass": "toast-bottom-right",
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        }
    </script>
    <style>
        /* Position submenu */
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
                display: none;
            }

            /* Show on hover */
            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }
        /* Submenu position */
        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
            }

            /* Optional arrow */
            .dropdown-submenu > a:after {
                content: "▶";
                float: right;
                margin-left: 5px;
                font-size: 10px;
            }

            /* Show submenu */
            .dropdown-submenu.show > .dropdown-menu {
                display: block;
            }

        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu .dropdown-menu {
                top: 0;
                left: 100%;
                margin-top: -1px;
            }

        .c-appversion {
            background: #212529;
            color: #fff;
            text-align: center;
            text-align: center;
            align-items: center;
            padding-bottom: 5px;
            font-weight: 500;
            position: absolute;
            width: 100%;
            padding: 12px;
        }

            .c-appversion span {
                width: 100%;
                float: left;
            }

            .c-appversion a .blink {
                animation: blinker 1s linear infinite;
                color: red; /* optional */
                font-weight: bold; /* optional */
                text-decoration: none;
                width: 100%;
            }
        /* Notification Tab Styles */
        .notif-tabs {
            display: flex;
            border-bottom: 1px solid #e0e0e0;
            background: #f8f9fa;
        }

        .notif-tab {
            flex: 1;
            background: none;
            border: none;
            padding: 10px 4px;
            font-size: 11px;
            color: #666;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
        }

            .notif-tab i {
                font-size: 14px;
            }

            .notif-tab:hover {
                color: #333;
                background: #f0f0f0;
            }

            .notif-tab.active {
                color: #5a5af5;
                border-bottom: 2px solid #5a5af5;
                background: #fff;
                font-weight: 600;
            }

        .tab-badge {
            background: #dc3545;
            color: #fff;
            border-radius: 10px;
            font-size: 9px;
            padding: 1px 5px;
            min-width: 16px;
            text-align: center;
            display: inline-block;
        }

            .tab-badge:empty, .tab-badge[data-val="0"] {
                background: #aaa;
            }

        .notif-tab-content {
            display: none;
        }

            .notif-tab-content.active {
                display: block;
            }

        /* Todo & Followup items */
        .todo-item, .followup-item {
            display: flex;
            align-items: flex-start;
            padding: 8px 12px;
            border-bottom: 1px solid #f0f0f0;
            gap: 8px;
            font-size: 13px;
        }

            .todo-item.done .todo-text {
                text-decoration: line-through;
                color: #aaa;
            }

            .todo-item input[type="checkbox"] {
                margin-top: 2px;
                cursor: pointer;
            }

        .todo-text {
            flex: 1;
        }

        .followup-item .followup-info {
            flex: 1;
        }

        .followup-item .followup-title {
            font-weight: 500;
            color: #333;
        }

        .followup-item .followup-time {
            font-size: 11px;
            color: #888;
            margin-top: 2px;
        }

        .followup-item.overdue .followup-time {
            color: #ccc;
            font-weight: 600;
        }

        .item-delete {
            background: none;
            border: none;
            color: #ccc;
            cursor: pointer;
            padding: 0 4px;
            font-size: 12px;
        }

            .item-delete:hover {
                color: #ccc;
            }

        .notif-tab-content.active {
        }

        .notif-tab.active {
            border-bottom: 2px solid #5a5af5;
            color: #ccc;
            background: #fff;
            font-weight: 600;
        }

        #divDataNofication.notification-menu {
            border: 1.5px solid #ccc !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(90, 90, 245, 0.10);
        }
    </style>
</head>
<body>
    <div id="pageLoader" class="loader-overlay">
        <div class="loader"></div>
    </div>
    <!-- Left Panel -->
    <aside id="left-panel" class="left-panel">
        <nav class="navbar navbar-expand-sm navbar-default">
            <div class="navbar-header">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#main-menu" aria-controls="main-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa fa-bars"></i>
                </button>
                <a class="navbar-brand" href="@Url.Action("index","Home")"><img src="@ImagesBase/logo4.png" alt="Logo"></a>
                <a class="navbar-brand hidden" href="@Url.Action("index","Home")"><img src="@ImagesBase/logo2.png" alt="Logo"></a>
            </div>
            <div id="main-menu" class="main-menu collapse navbar-collapse">
                <ul class="nav navbar-nav">
                    @{
                        if (TFDSolution.Common.SessionPersister.LoginedUser != null)
                        {
                            var dashboards = TFDSolution.Common.SessionPersister.LoginedUser?.Dashboards;
                            if (dashboards != null && dashboards.Count > 0)
                            {
                                foreach (var item in dashboards)
                                {
                                    <li class="active">
                                        <a href="@Url.Action("Index", "Dashboard", new { @dasbharodName = item.DashboardName })" class="p-0"> <i class="menu-icon fa fa-dashboard"></i>@item.DashboardTitle </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="active">
                                    <a href="@Url.Content("~/")" class="p-0"> <i class="menu-icon fa fa-dashboard"></i>Dashboard </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="active">
                                <a href="@Url.Content("~/")" class="p-0"> <i class="menu-icon fa fa-dashboard"></i>Dashboard </a>
                            </li>
                        }
                    }
                    <li class="children">
                        <a class="p-0" href="@Url.Action("Calender", "Home")">
                            <i class="menu-icon fa fa-calendar"></i>Calendar
                        </a>
                    </li>
                    @{
                        var Parentforms = TFDSolution.Common.SessionPersister.LoginedUser?.Forms;
                        bool hasVisibleForms = Parentforms != null && Parentforms.Any(f => !f.NoAccess);
                        int RoleId = TFDSolution.Common.SessionPersister.LoginedUser.RoleID;
                    }
                    @if (hasVisibleForms)
                    {
                        <h3 class="menu-title">Main</h3><!-- /.menu-title -->
                        foreach (var item in Parentforms.Where(x => x.FormName != "Utilities" && x.FormName != "Summary").OrderBy(x => x.SortOrder))
                        {
                            if (!item.NoAccess)
                            {

                                <li class="menu-item-has-children dropdown">
                                    @{
                                        // Map FormTitle and FormName to icon filenames
                                        var iconMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        {
                                            { "CRM", "CRM.png" },
                                            { "Master", "Master.png" },
                                            { "Parameter", "Parameter.png" },
                                            { "Purchase", "Purchase.png" },
                                            { "Sales", "Sales.png" },
                                            { "Service", "Service.png" },
                                            { "Production", "Service.png" },
                                            { "Store", "Store.png" }
                                        };

                                        string iconFile = null;
                                        if (iconMap.TryGetValue(item.FormTitle, out var titleIcon))
                                        {
                                            iconFile = titleIcon;
                                        }
                                    }
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        @if (!string.IsNullOrEmpty(iconFile))
                                        {
                                            <img class="mr-2" src="~/Images/Icons/@iconFile" />
                                        }
                                        else
                                        {
                                            <i class="menu-icon fa fa-laptop"></i>
                                        }
                                        @item.FormTitle
                                    </a>
                                    <ul class="sub-menu children dropdown-menu">
                                        @foreach (var child in item.ChildForm.OrderBy(x => x.SortOrder))
                                        {
                                            if (!child.NoAccess)
                                            {
                                                if (child.FormName == "companymaster")
                                                {
                                                    <li><i class="fa fa-minus"></i><a href="@Url.Action("Company", "Master")">Company Master</a></li>
                                                }
                                                else if (child.IsHierachyForm)
                                                {
                                                    <li><i class="fa fa-minus"></i><a href="@Url.Action("HierachyPage", "Home", new { @pagename = child.FormName })">@child.FormTitle</a></li>
                                                }
                                                else
                                                {
                                                    <li><i class="fa fa-minus"></i><a href="@Url.Action("MyPage", "Home", new { @pagename = child.FormName })">@child.FormTitle</a></li>
                                                }
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    }
                    @if (RoleId == 1)
                    {
                        <h3 class="menu-title">Settings</h3><!-- /.menu-title -->
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="menu-icon fa fa-tasks"></i>Users & Roles</a>
                            <ul class="sub-menu children dropdown-menu">
                                <li><i class="menu-icon fa fa-fort-awesome"></i><a href="@Url.Action("UserMaster", "Master")">Users</a></li>
                                <li><i class="menu-icon fa fa-area-chart"></i><a href="@Url.Action("RoleMaster", "Master")">Roles & Permission</a></li>
                            </ul>
                        </li>
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="menu-icon fa fa-code"></i>Forms</a>
                            <ul class="sub-menu children dropdown-menu">
                                <li><i class="menu-icon fa fa-cogs"></i><a href="@Url.Action("Settings", "FormSetting")">Forms Settings</a></li>
                                <li><i class="menu-icon fa fa-columns"></i><a href="@Url.Action("ItemAdvanceSettings", "FormSetting")">Item Advance Settings</a></li>
                                @*<li><i class="menu-icon fa fa-certificate"></i><a href="@Url.Action("FormPermission", "FormSetting")">Forms Permission</a></li>*@
                                <li><i class="menu-icon fa fa-sitemap"></i><a href="@Url.Action("FormFlowSetting", "Master")">Flow Settings</a></li>
                            </ul>
                        </li>
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="menu-icon fa fa-cogs"></i>Configuration</a>
                            <ul class="sub-menu children dropdown-menu">
                                <li><i class="menu-icon fa fa-line-chart"></i><a href="@Url.Action("OtherCharges", "Configuration")">Other Charges</a></li>
                                <li><i class="menu-icon fa fa-id-card-o"></i><a href="@Url.Action("License", "Configuration")">Your License</a></li>
                                <li><i class="menu-icon fa fa-area-chart"></i><a href="@Url.Action("DynamicReport", "Setting")">Reports</a></li>
                                @*<li><i class="menu-icon fa fa-thumbs-up"></i><a href="@Url.Action("Approvals", "Setting")">Approvals</a></li>*@
                                <li><i class="menu-icon ti-email"></i><a href="@Url.Action("EmailTemplate", "Configuration")">Email Templates</a></li>
                                <li><i class="menu-icon ti-email"></i><a href="@Url.Action("DashboardSetting", "Configuration")">Dashboard</a></li>
                                <li><i class="menu-icon ti-settings"></i><a href="@Url.Action("UserApprovalSettings", "Configuration")">User Approval</a></li>
                                <li><i class="menu-icon ti-settings"></i><a href="@Url.Action("FormSystemReportSettings", "Configuration")">System Report Settings</a></li>
                            </ul>
                        </li>
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="menu-icon fa fa-th-list"></i>Utilities</a>
                            <ul class="sub-menu children dropdown-menu">
                                <li><i class="menu-icon fa fa-thumbs-o-up"></i><a href="@Url.Action("MultiApproval", "Configuration")">Multi Approval</a></li>
                                <li><i class="menu-icon fa fa-th"></i><a href="@Url.Action("AccountLedger", "Reports")">Account Ledger</a></li>
                                <li><i class="menu-icon fa fa-th"></i><a href="@Url.Action("SystemAuditLogs", "Reports")">User Audit Log</a></li>
                            </ul>
                        </li>
                        <h3 class="menu-title">Reports</h3>
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="menu-icon fa fa-glass"></i>Summary
                            </a>
                            <ul class="sub-menu children dropdown-menu">
                                <li><i class="menu-icon fa fa-list-ol"></i><a href="@Url.Action("MISReport", "Reports")">MIS Report</a></li>
                                <li><i class="menu-icon fa fa-list-ol"></i><a href="@Url.Action("SystemAuditLogs", "Reports")">Audit Logs</a></li>
                            </ul>
                        </li>
                        <li class="menu-item-has-children dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <i class="menu-icon fa fa-bar-chart"></i> Statutory Reports
                            </a>
                            <ul class="sub-menu children dropdown-menu">
                                <li class="dropdown-submenu">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        <i class="menu-icon fa fa-minus" style="top:3px;"></i> Accounts
                                    </a>
                                    <ul class="dropdown-menu" style="display: none; left: 22px; top: 0px; position: relative; border: 0px; padding: 0; ">
                                        <li><a href="@Url.Action("AccountLedger","Reports")"><i class="fa fa-minus"></i> Account Ledger</a></li>
                                        <li><a href="@Url.Action("TrialBalance","Reports")"><i class="fa fa-minus"></i> Trial Balance</a></li>
                                        <li><a href="@Url.Action("ProfitLoss","Reports")"><i class="fa fa-minus"></i> Profit & Loss</a></li>
                                        <li><a href="@Url.Action("BalanceSheet","Reports")"><i class="fa fa-minus"></i> Balance Sheet</a></li>
                                    </ul>
                                </li>
                                <li class="dropdown-submenu">
                                    <a href="#" class="dropdown-toggle">
                                        <i class="menu-icon fa fa-minus" style="top:3px;"></i> Tax
                                    </a>
                                    <ul class="dropdown-menu" style="display: none; left: 22px; top: 0px; position: relative; border: 0px; padding: 0; ">
                                        <li><a href="@Url.Action("GSTR1Report","Reports")"><i class="fa fa-minus"></i> GSTR-1</a></li>
                                        <li><a href="@Url.Action("GSTR2Report","Reports")"><i class="fa fa-minus"></i> GSTR-2</a></li>
                                        <li><a href="@Url.Action("GSTR3BReport","Reports")"><i class="fa fa-minus"></i> GSTR-3B</a></li>
                                    </ul>
                                </li>

                            </ul>
                        </li>
                    }
                    else
                    {
                        if (Parentforms.Where(x => x.FormName == "Utilities").FirstOrDefault() != null)
                        {
                            <h3 class="menu-title">Settings</h3>
                            foreach (var item in Parentforms.Where(x => x.FormName == "Utilities" && x.NoAccess == false).OrderBy(x => x.SortOrder))
                            {
                                <li class="menu-item-has-children dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="menu-icon fa fa-th-list"></i>Utilities</a>
                                    @if (!item.NoAccess)
                                    {
                                        <ul class="sub-menu children dropdown-menu">
                                            @foreach (var child in item.ChildForm.Where(x => x.NoAccess == false).OrderBy(x => x.SortOrder))
                                            {
                                                if (child.FormName == "MultiApproval")
                                                {
                                                    <li><i class="menu-icon fa fa-thumbs-o-up"></i><a href="@Url.Action("MultiApproval", "Configuration")">Multi Approval</a></li>
                                                }
                                                else if (child.FormName == "AccountLedger")
                                                {
                                                    <li><i class="menu-icon fa fa fa-th"></i><a href="@Url.Action("AccountLedger", "Reports")">Account Ledger</a></li>
                                                }
                                                else if (child.FormName == "SystemAuditLogs")
                                                {
                                                    <li><i class="menu-icon fa fa fa-th"></i><a href="@Url.Action("SystemAuditLogs", "Reports")">User Audit Log</a></li>
                                                }
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        }
                        if (Parentforms.Where(x => x.FormName == "Summary").FirstOrDefault() != null)
                        {
                            <h3 class="menu-title">Reports</h3>
                            foreach (var item in Parentforms.Where(x => x.FormName == "Summary" && x.NoAccess == false).OrderBy(x => x.SortOrder))
                            {
                                <li class="menu-item-has-children dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="menu-icon fa fa-glass"></i>Summary
                                    </a>
                                    @if (!item.NoAccess)
                                    {
                                        <ul class="sub-menu children dropdown-menu">
                                            @foreach (var child in item.ChildForm.Where(x => x.NoAccess == false).OrderBy(x => x.SortOrder))
                                            {
                                                if (child.FormName == "MISReport")
                                                {
                                                    <li><i class="menu-icon fa fa-list-ol"></i><a href="@Url.Action("MISReport", "Reports")">MIS Report</a></li>
                                                }
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        }
                        if (Parentforms.Where(x => x.FormName == "Statutory").FirstOrDefault() != null)
                        {
                            <h3 class="menu-title">Reports</h3>
                            foreach (var item in Parentforms.Where(x => x.FormName == "Statutory" && x.NoAccess == false).OrderBy(x => x.SortOrder))
                            {
                                <li class="menu-item-has-children dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="menu-icon fa fa-glass"></i>Statutory Reports
                                    </a>
                                    @if (!item.NoAccess)
                                    {
                                        <ul class="sub-menu children dropdown-menu">
                                            @{
                                                if (item.ChildForm.Where(x => x.NoAccess == false && (x.FormName == "AccountLedger" || x.FormName == "TrialBalance" || x.FormName == "ProfitLoss" || x.FormName == "BalanceSheet")).FirstOrDefault() != null)
                                                {
                                                    <li class="dropdown-submenu">
                                                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                                            <i class="menu-icon fa fa-minus" style="top:3px;"></i> Accounts
                                                        </a>
                                                        <ul class="dropdown-menu" style="display: none; left: 22px; top: 0px; position: relative; border: 0px; padding: 0; ">
                                                            @{
                                                                foreach (var child in item.ChildForm.Where(x => x.NoAccess == false && (x.FormName == "AccountLedger" || x.FormName == "TrialBalance" || x.FormName == "ProfitLoss" || x.FormName == "BalanceSheet")).OrderBy(x => x.SortOrder))
                                                                {
                                                                    if (child.FormName == "AccountLedger")
                                                                    {
                                                                        <li><a href="@Url.Action("AccountLedger","Reports")"><i class="fa fa-minus"></i> Account Ledger</a></li>
                                                                    }
                                                                    else if (child.FormName == "TrialBalance")
                                                                    {
                                                                        <li><a href="@Url.Action("TrialBalance","Reports")"><i class="fa fa-minus"></i> Trial Balance</a></li>
                                                                    }
                                                                    else if (child.FormName == "ProfitLoss")
                                                                    {
                                                                        <li><a href="@Url.Action("ProfitLoss","Reports")"><i class="fa fa-minus"></i> Profit & Loss</a></li>
                                                                    }
                                                                    else if (child.FormName == "BalanceSheet")
                                                                    {
                                                                        <li><a href="@Url.Action("BalanceSheet","Reports")"><i class="fa fa-minus"></i> Balance Sheet</a></li>
                                                                    }
                                                                }
                                                            }
                                                        </ul>
                                                    </li>
                                                }
                                                if (item.ChildForm.Where(x => x.NoAccess == false && (x.FormName == "GSTR1Report" || x.FormName == "GSTR2Report" || x.FormName == "GSTR3BReport")).FirstOrDefault() != null)
                                                {
                                                    <li class="dropdown-submenu">
                                                        <a href="#" class="dropdown-toggle">
                                                            <i class="menu-icon fa fa-minus" style="top:3px;"></i> Tax
