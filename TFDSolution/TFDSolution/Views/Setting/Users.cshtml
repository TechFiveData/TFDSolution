
@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>User Master</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="active">User Master</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-6">
                        <strong class="card-title"></strong>
                    </div>
                    <div class="col-lg-6 text-right">
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                        <a class="btn btn-sm" href="javascript:void(0);" title="Export"><i class="fa fa-download"></i>&nbsp; Export</a>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted m-b-15">
                        List Of User
                    </p>
                    <div class="row form-group">
                        <table id="tblUser" class="display cell-border row-border nowrap" cellspacing="0" width="100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div><!-- .animated -->    
<script type="text/javascript">
    $(document).ready(function () {
        GetUserList();        
    });
    function GetUserList() {
        $.ajax({
            type: "GET",
            url: "@Url.Action("getUserList", "Master")",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: OnSuccess,
            failure: function (response) {
                alert(response.d);
            },
            error: function (response) {
                alert(response);
            }
        });
    }
    function OnSuccess(response) {
        bindDataTable(response);
    };
    function bindDataTable(dataset) {
        // Initialize DataTable
        new DataTable('#tblUser', {
            layout: {
                topStart: {
                    pageLength: {
                        menu: [10, 25, 50, 100]
                    },
                    buttons: ['excelHtml5', 'csvHtml5', 'pdfHtml5']
                },
                topEnd: {
                    search: {
                        placeholder: 'Type search here'
                    }
                },
                bottomEnd: {
                    paging: {
                        buttons: 5
                    }
                },
            },
            paging: true,
            scrollCollapse: true,
            scrollY: '500px',
            data: dataset,
            columns: [
                {
                    title: '',
                    className: "grid-action-item",
                    render: function (data, type, row, meta) {
                        var editlink = "/Master/CompanyAction?uId=" + row.CompanyId;
                        var deletelink = "/Master/CompanyAction?uId=" + row.CompanyId;
                        return "<a title='Edit Record' href=" + editlink + "><i class='fa fa-pencil'></i></a> &nbsp;|&nbsp; <a title='Delete Record' href='javascript:DeleteCompany('/'" + row.CompanyId + "/'')';><i class='fa fa-trash text-danger'></i></a>";
                    },
                },
                { title: 'Company Code', data: 'CompanyCode' },
                {
                    title: 'Company Name',
                    data: 'CompanyName'
                },
                { title: 'Created By', data: 'CreatedBy' },
                {
                    title: 'Created On',
                    render: function (data, type, row, meta) {
                        var editlink = formatDate(parseMSDate(row.CreatedOn));
                        return "<span>" + editlink + "</span>";
                    },
                },
                {
                    title: 'Updated On',
                    render: function (data, type, row, meta) {
                        if (row.UpdatedOn != null) {
                            var editlink = formatDate(parseMSDate(row.UpdatedOn));
                            return "<span>" + editlink + "</span>";
                        }
                        else {
                            return "<span></span>";
                        }
                    },
                },

            ]
        });
    }
    function formatDate(d) {
        if (hasTime(d)) {
            var s = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
            s += ' ' + d.getHours() + ':' + zeroFill(d.getMinutes());
        } else {
            var s = (d.getDate() + '/' + d.getMonth() + 1) + '/' + d.getFullYear();
        }
        return s;
    }
    function hasTime(d) {
        return !!(d.getUTCHours() || d.getUTCMinutes() || d.getUTCSeconds());
    }

    function zeroFill(n) {
        if ((n + '').length == 1)
            return '0' + n;

        return n;
    }
    function parseMSDate(s) {
        // Jump forward past the /Date(, parseInt handles the rest
        return new Date(parseInt(s.substr(6)));
    }
</script>