@model TFDSolution.Transport.Integration.EWayBillRequest
@{
    if (Model != null && Model.IsSuccess == false)
    {
        if (Model.Response.Contains("Missing"))
        {
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    E-Way Bill Configuration
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-times-circle text-danger fa-2x me-3"></i>
                        <div>

                            <strong>Configuration Missing!</strong><br />
                            Please contact the <strong>Administrator</strong> to configure the E-Way Bill integration before proceeding.
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-warning shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <i class="fa fa-exclamation-circle me-2"></i>
                    E-Way Bill
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle text-warning fa-2x me-3"></i>
                        <div>
                            <strong>No Data Found!</strong><br />
                            No data is available for E-Way Bill generation. Please verify that the required invoice and item details have been entered correctly before proceeding.
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}
@if (Model != null && Model.IsSuccess)
{
    <div id="ewayAccordion">
        <!-- Document Details -->
        <div class="card">
            <div class="card-header p-0" id="headingDocument">
                <h6 class="mb-0">
                    <button class="btn btn-link btn-block text-left" data-toggle="collapse"
                            data-target="#collapseDocument" aria-expanded="true" aria-controls="collapseDocument">
                        <i class="fa fa-file-text"></i> Document Details
                    </button>
                </h6>
            </div>
            <div id="collapseDocument" class="collapse show" aria-labelledby="headingDocument" data-parent="#ewayAccordion">
                <div class="card-body">
                    <div class="row eway-summary">
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Supply Type</span>
                                <span class="info-value">@Model.Header.supplyType</span>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Sub Supply Type</span>
                                <span class="info-value">@Model.Header.subSupplyType</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Sub Supply Description</span>
                                <span class="info-value">@Model.Header.subSupplyDesc</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Document Type</span>
                                <span class="info-value">@Model.Header.docType</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Document No.</span>
                                <span class="info-value">@Model.Header.docNo</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Document Date</span>
                                <span class="info-value">@Model.Header.docDate</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="info-item">
                                <span class="info-label">Transaction Type</span>
                                <span class="info-value">@Model.Header.transactionType</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Details -->
        <div class="card">
            <div class="card-header p-0" id="headingSupplier">
                <h6 class="mb-0">
                    <button class="btn btn-link btn-block text-left collapsed"
                            data-toggle="collapse"
                            data-target="#collapseSupplier">
                        <i class="fa fa-user"></i> Company Details
                    </button>
                </h6>
            </div>
            <div id="collapseSupplier" class="collapse" data-parent="#ewayAccordion">
                <div class="card-body">
                    <!-- Supplier Fields -->
                    <div class="row eway-summary">

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">GSTIN</span>
                                <span class="info-value">@Model.Header.fromGstin</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Trade Name</span>
                                <span class="info-value">@Model.Header.fromTrdName</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">State Code</span>
                                <span class="info-value">@Model.Header.fromStateCode</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Address 1</span>
                                <span class="info-value">@Model.Header.fromAddr1</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Address 2</span>
                                <span class="info-value">@Model.Header.fromAddr2</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Place</span>
                                <span class="info-value">@Model.Header.fromPlace</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Pincode</span>
                                <span class="info-value">@Model.Header.fromPincode</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Actual State Code</span>
                                <span class="info-value">@Model.Header.actFromStateCode</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Customer Details -->
        <div class="card">
            <div class="card-header p-0">
                <h6 class="mb-0">
                    <button class="btn btn-link btn-block text-left collapsed" data-toggle="collapse" data-target="#collapseCustomer">
                        <i class="fa fa-user"></i> Shipping Details
                    </button>
                </h6>
            </div>
            <div id="collapseCustomer" class="collapse" data-parent="#ewayAccordion">
                <div class="card-body">
                    <!-- Customer Fields -->
                    <div class="row eway-summary">
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">GSTIN</span>
                                <span class="info-value">@Model.Header.toGstin</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Trade Name</span>
                                <span class="info-value">@Model.Header.shipToTradeName</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">State Code</span>
                                <span class="info-value">@Model.Header.toStateCode</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Address 1</span>
                                <span class="info-value">@Model.Header.toAddr1</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Address 2</span>
                                <span class="info-value">@Model.Header.toAddr2</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Place</span>
                                <span class="info-value">@Model.Header.toPlace</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Pincode</span>
                                <span class="info-value">@Model.Header.toPincode</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Ship To GSTIN</span>
                                <span class="info-value">@Model.Header.shipToGSTIN</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Ship To Name</span>
                                <span class="info-value">@Model.Header.shipToTradeName</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Details -->
        <div class="card">
            <div class="card-header p-0">
                <h6 class="mb-0">
                    <button class="btn btn-link btn-block text-left collapsed"
                            data-toggle="collapse"
                            data-target="#collapseInvoice">
                        <i class="fa fa-money"></i> Invoice Details
                    </button>
                </h6>
            </div>
            <div id="collapseInvoice" class="collapse" data-parent="#ewayAccordion">
                <div class="card-body">
                    <!-- Invoice Fields -->
                    <div class="row eway-summary">

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Basic Amount</span>
                                <span class="info-value text-right">@Model.Header.totalValue</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Other Charges</span>
                                <span class="info-value text-right">@Model.Header.otherValue</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">CGST</span>
                                <span class="info-value text-right">@Model.Header.cgstValue</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">SGST</span>
                                <span class="info-value text-right">@Model.Header.sgstValue</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">IGST</span>
                                <span class="info-value text-right">@Model.Header.igstValue</span>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">CESS</span>
                                <span class="info-value text-right">@Model.Header.cessValue</span>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">CESS Non Advol</span>
                                <span class="info-value text-right">@Model.Header.cessNonAdvolValue</span>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item total-item">
                                <span class="info-label">Total Amount</span>
                                <span class="info-value text-right">@Model.Header.totInvValue</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Transpor Details -->
        <div class="card">
            <div class="card-header p-0">
                <h6 class="mb-0">
                    <button class="btn btn-link btn-block text-left collapsed" data-toggle="collapse" data-target="#collapseTransport">
                        <i class="fa fa-truck"></i> Transport Details
                    </button>
                </h6>
            </div>
            <div id="collapseTransport" class="collapse" data-parent="#ewayAccordion">
                <div class="card-body">
                    <!-- Transport Fields -->
                    @{
                        string transportModeText = Model.Header.transMode == 1 ? "Road" :
                                                   Model.Header.transMode == 2 ? "Rail" :
                                                   Model.Header.transMode == 3 ? "Air" :
                                                   Model.Header.transMode == 4 ? "Ship" : "";

                        string vehicleTypeText = Model.Header.vehicleType == "R"
                                                    ? "Regular"
                                                    : Model.Header.vehicleType == "O"
                                                        ? "Over Dimensional Cargo"
                                                        : "";
                    }
                    <div class="row eway-summary">
                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transporter GSTIN</span>
                                <span class="info-value">@Model.Header.transporterId</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transporter Name</span>
                                <span class="info-value">@Model.Header.transporterName</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transport Mode</span>
                                <span class="info-value">@transportModeText</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transport Distance</span>
                                <span class="info-value">@Model.Header.transDistance KM</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transport Doc No.</span>
                                <span class="info-value">@Model.Header.transDocNo</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Transport Doc Date</span>
                                <span class="info-value">@Model.Header.transDocDate</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Vehicle No.</span>
                                <span class="info-value">@Model.Header.vehicleNo</span>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 mb-1">
                            <div class="info-item">
                                <span class="info-label">Vehicle Type</span>
                                <span class="info-value">@vehicleTypeText</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <!-- Items Section -->
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="fa fa-list"></i> Item Details
                </h6>
                <span class="font-weight-bold" id="lblTotalItems">
                    Total Items : @Convert.ToString(Model.Items != null ? Model.Items.Count : 0)
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="tbleWayItems"
                           class="table table-bordered table-striped table-hover mb-0 dataTable">
                        <thead>
                            <tr>
                                <th width="50">Sr.</th>
                                <th>Product</th>
                                <th>HSN</th>
                                <th>Qty</th>
                                <th>Unit</th>
                                <th>Taxable Value</th>
                                <th>GST %</th>
                                <th>CGST</th>
                                <th>SGST</th>
                                <th>IGST</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.Items != null && Model.Items.Count > 0)
                                {
                                    int srnot = 0;
                                    foreach (var itm in Model.Items)
                                    {
                                        srnot = srnot + 1;
                                        <tr>
                                            <td>@srnot</td>
                                            <td>@itm.productName</td>
                                            <td>@itm.hsnCode</td>
                                            <td>@itm.quantity</td>
                                            <td>@itm.qtyUnit</td>
                                            <td>@itm.taxableAmount</td>
                                            <td>@itm.cgstRate</td>
                                            <td>@itm.cgstRate</td>
                                            <td>@itm.sgstRate</td>
                                            <td>@itm.igstRate</td>
                                            <td>@itm.taxableAmount</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            new DataTable('#tbleWayItems', {
                searching: false,
                paging: false,
                ordering: false,
                info: false,
                scrollY: '400px',
                scrollX: true,
                scrollCollapse: true,
                fixedHeader: true
            });
        })
    </script>
}