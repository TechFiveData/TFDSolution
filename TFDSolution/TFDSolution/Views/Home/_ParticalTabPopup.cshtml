    function SavePageDetail(isSubmited) {
        var $btn = $("#btnSave");
        // Save original text
        $btn.data("original-text", $btn.html());
        // Replace with loader
        $btn.html('<span class="loader"></span> Please wait...');
        $btn.prop("disabled", true);
        var isFormValid = true;
        var PageFieldData = [];
        $("#DataTabPopup input").each(function () {
             if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                 var fieldId = $(this).attr("data-bind");
                 if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                     if ($(this).attr("type") == "checkbox") {
                         var checkVal = ($(this).is(":checked") == true ? "true" : "false");
                         PageFieldData.push({
                             FieldName: fieldId,
                             FieldValue: checkVal,
                             FieldType: $(this).attr("type"),
                         });
                     }
                     else if ($(this).attr("type") == "radio") {
                         var checkVal = ($(this).is(":checked") == true ? "true" : "false");
                         PageFieldData.push({
                             FieldName: fieldId,
                             FieldValue: checkVal,
                             FieldType: $(this).attr("type"),
                         });
                     }
                     else {
                         PageFieldData.push({ FieldName: fieldId, FieldValue: $(this).val()});
                     }
                 }
                 $(this).next(".validation").remove();
                 if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                     var fieldcap = $(this).attr("data-html");
                     $(this).addClass("input-validation-error");
                     $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap +"</div>");
                     if (isFormValid == true) {
                         $(this).focus();
                     }
                     isFormValid = false;
                 } else {
                     $(this).removeClass("input-validation-error");
                 }
             }
        });

        $("#DataTabPopup textarea").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val()
                    });
                }
                $(this).next(".validation").remove();
                if ($(this).prop('required') && $.trim($(this).val()).length == 0) {
                    var fieldcap = $(this).attr("data-html");
                    $(this).addClass("input-validation-error");
                    $(this).after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter " + fieldcap + "</div>");
                    if (isFormValid == true) {
                        $(this).focus();
                    }
                    isFormValid = false;
                } else {
                    $(this).removeClass("input-validation-error");
                }
            }
        });
        $("#DataTabPopup select").each(function () {
            const $select = $(this);
            const ctrlId = $select.attr("id");
            const fieldId = $select.attr("data-bind");
            const isMultiSelection = $select.attr("data-multiselection") === "True";
            const selectedValues = $select.val();
            const selectedTexts = $select.find("option:selected").map(function () {
                return $(this).text();
            }).get();

            if (ctrlId && fieldId) {
                if (isMultiSelection) {
                    PageFieldData.push({ FieldName: fieldId, FieldValue: selectedTexts.join(',') });
                    PageFieldData.push({ FieldName: fieldId + "_Id", FieldValue: Array.isArray(selectedValues) ? selectedValues.join(',') : '' });
                } else {
                    const selectedValue = selectedValues;
                    const selectedText = selectedTexts[0] || '';
                    if (selectedValue && selectedValue !== "0" && selectedValue !== "") {
                        PageFieldData.push({ FieldName: fieldId, FieldValue: selectedText });
                    }
                    else {
                        PageFieldData.push({ FieldName: fieldId, FieldValue: '' });
                    }
                    PageFieldData.push({ FieldName: fieldId + "_Id", FieldValue: selectedValue || '' });
                }
                // Validation
                $select.next(".validation").remove();
                const isRequired = $select.prop('required');
                const hasValue = selectedValues && (Array.isArray(selectedValues) ? selectedValues.length > 0 : selectedValues.trim().length > 0);
                if (isRequired && !hasValue) {
                    const fieldCap = $select.attr("data-html");
                    $select.addClass("input-validation-error");
                    $select.after(`<div class='validation' style='color:red;margin-bottom: 2px;'>Please select ${fieldCap}</div>`);
                    if (isFormValid) {
                        $select.focus();
                    }
                    isFormValid = false;
                } else {
                    $select.removeClass("input-validation-error");
                }
            }
