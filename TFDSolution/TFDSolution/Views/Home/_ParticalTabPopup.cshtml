    function loadPopupDropdown(_fieldId, dropdownId, fieldcap) {
        try {
            if (dropdownId != "ChargesId") {
                var sourceType = $("#DataTabPopup #" + dropdownId).attr("data-sourcetype");
                if (sourceType == "StoredProcedure") {
                    var fieldname = $("#DataTabPopup #" + dropdownId).attr('id') + "_Id";
                    /*console.log("Load Stored Procedure Bind for " + fieldname);*/
                    BindDependencyData(fieldname, true);
                }
                else {
                    $.ajax({
                        url: '@Url.Action("getFieldSelection", "Common")',
                        type: 'GET',
                        data: { fieldId: _fieldId },
                        success: function (data) {
                            $('#' + dropdownId + '_select-loader').hide();
                            var dropdown = $('#DataTabPopup #' + dropdownId);
                            var fieldvalue = $('#DataTabPopup #' + dropdownId).attr("data-interval");
                            dropdown.append('<option value="">Select ' + fieldcap + '</option>');
                            var isData = false;
                            $.each(data, function (i, item) {
                                isData = true;
                                if (fieldvalue != null && fieldvalue != "" && fieldvalue == item.Value) {
                                    dropdown.append($('<option selected></option>').val(item.Value).text(item.Text));
                                }
                                else {
                                    dropdown.append($('<option></option>').val(item.Value).text(item.Text));
                                }
                            });
                            dropdown.off("change").on("change", function () {
                            });
                            if ($("#hdnPageActionDetail").val() == "V" || $("#hdnPageActionDetail").val() == "E") {
                                BindDependencyData(dropdownId + "_Id", false);
                            }
                            $('#DataTabPopup #' + dropdownId + '_select-loader').hide();
                            $("#pageLoader").hide();
                        },
                        error: function () {
                            $('#DataTabPopup #' + dropdownId + '_select-loader').hide();
                            $("#pageLoader").hide();
                            console.log("Error loading dropdown: " + fieldcap);
                        }
                    });
                }
            }
        } catch (e) {

        }
    }
