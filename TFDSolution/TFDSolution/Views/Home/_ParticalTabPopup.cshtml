                }
                else if (isDependency != "True") {
                    $('#DataTabPopup #' + selectId).select2({
                        dropdownParent: parentWrapper,
                        placeholder: 'Select ' + caption,
                        allowClear: true,
                        skipLoading: true, // <-- Custom flag
