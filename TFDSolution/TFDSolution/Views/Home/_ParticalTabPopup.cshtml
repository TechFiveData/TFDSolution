    function BindLanguageConversation(fieldId, fieldName) {
        try {
            $.ajax({
                url: '@Url.Action("getLanguageConversation", "Transaction")',
                type: 'GET',
                data: { fieldId: fieldId, fieldValue: $('#DataTabPopup #' + fieldName).val() },
                success: function (response) {
                    if (response && response.length > 0) {
                        $.each(response, function (index, item) {
                            var $element = $('#DataTabPopup #' + item.FieldName);
                            // Check if element exists
                            if ($element.length > 0) {
                                $element.val(item.FieldValue);
                            }
                        });
                    }
                },
                error: function (err) {
                    console.log("Error:", err);
                }
            });

        } catch (e) {
            console.log("Exception:", e);
        }
    }
