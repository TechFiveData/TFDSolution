@model TFDSolution.Transport.Master.PageTabModel
@*<link href="~/Content/select2.min.css" rel="stylesheet" />*@
@{
    string AllowOtherCharges = TFDSolution.Business.CommonBusiness.getFormKeySetting(Model.Design.FormId, "AllowOtherCharges");
    string AllowSpecifications = TFDSolution.Business.CommonBusiness.getFormKeySetting(Model.Design.FormId, "AllowSpecification");
    string AllowDetailPopupStyle = TFDSolution.Business.CommonBusiness.getFormKeySetting(Model.Design.FormId, "DetailPopupStyle");
    string AllowDeliverySchedule = TFDSolution.Business.CommonBusiness.getFormKeySetting(Model.Design.FormId, "DeliverySchedule");
    string AllowStocWithkSerialNo = TFDSolution.Business.CommonBusiness.getFormKeySetting(Model.Design.FormId, "StockEffects");
    string AllowLockPendingQuantity = TFDSolution.Business.CommonBusiness.getFormKeySetting(Convert.ToString(Model.Design.FormId), "LockPendingQuantity");
    bool IsOtherCharges = false, IsSpecification = false, IsCenterStyle = false, IsStocWithkSerialNo = false, IsDeliverySchedule = false, IsLockedPendingQty = false;
    string popStyle = "";
    if (!string.IsNullOrEmpty(AllowOtherCharges) && AllowOtherCharges == "y")
    {
        IsOtherCharges = true;
    }
    if (!string.IsNullOrEmpty(AllowDeliverySchedule) && AllowDeliverySchedule == "y")
    {
        IsDeliverySchedule = true;
    }
    if (!string.IsNullOrEmpty(AllowLockPendingQuantity) && AllowLockPendingQuantity == "y")
    {
        IsLockedPendingQty = true;
    }
    if (!string.IsNullOrEmpty(AllowStocWithkSerialNo) && AllowStocWithkSerialNo == "y")
    {
        IsStocWithkSerialNo = TFDSolution.Business.CommonBusiness.getFormStockSetting(Convert.ToString(Model.Design.FormId), Convert.ToString(Model.Design.FormTabId));
    }
    if (!string.IsNullOrEmpty(AllowDetailPopupStyle) && AllowDetailPopupStyle == "y")
    {
        IsCenterStyle = true;
    }
    if (!string.IsNullOrEmpty(AllowSpecifications) && AllowSpecifications == "y")
    {
        IsSpecification = true;
    }
}

<script src="~/Scripts/select2.min.js"></script>
<input id="hdnTabSQLTableName" type="hidden" value="@Model.Design.TabSQLTableName" />
<input id="hdnPageActionDetail" type="hidden" value="@Model.PageAction" />
<input id="hdnFormTabId" type="hidden" value="@Model.FormTabId" />
<input id="hdnItemId" type="hidden" value="0" />
<input id="hdnPopupTabId" type="hidden" value="@Model.Design.FormTabId.ToString()" />
<style>
    .selectloader {
        position: absolute;
        right: 26px;
        top: 55%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        border: 2px solid #ccc;
        border-top: 2px solid #000;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        margin-top: 1px;
        background: white;
    }
</style>

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title" id="mediumModalLabel">@Model.Design.TabTitle</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    @{
        bool IsFromPending = (Model != null && Model.From_Item_SRNO > 0);
    }
    <input type="hidden" value="@((Model != null && Model.From_Item_SRNO > 0) ? "1": "0")" id="IsFromPending" />
    <div class="modal-body">
        <input type="hidden" id="hdnDetailId" value="@Model.Id" />
        <div class="accordion" id="accordionExample">
            @if (Model.FormFields != null && Model.FormFields.Count() > 0)
            {
                var chargesField = Model.FormFields.Where(x => x.FieldName == "ChargesId").FirstOrDefault();
                var ChargesFieldValue = "0";
                if (chargesField != null)
                {
                    ChargesFieldValue = Convert.ToString(chargesField.FieldValue);
                }
                <input type="hidden" id="hdnChargesId" value="@ChargesFieldValue" />
                <div>
                    @*<h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#itemCollapse" aria-expanded="true" aria-controls="itemCollapse">
                                General
                            </button>
                        </h2>*@
                    <div id="itemCollapse">
                        <div>
                            <div id="DataTabPopup" class="row">
                                @{
                                    int ItemSrNo = 0, RowIndex = 0;
                                    if (Model.FormFields.Where(x => x.FieldName == "ItemSrNo").FirstOrDefault() != null)
                                    {
                                        var SrField = Model.FormFields.Where(x => x.FieldName == "ItemSrNo").FirstOrDefault();
                                        ItemSrNo = Convert.ToInt32(@SrField.FieldValue);
                                        <div class="col col-md-12 d-none">
                                            <label for="ItemSrNo" class="form-control-label"><strong id="lblItemSrNo">Item# @SrField.FieldValue</strong></label>
                                            <input style="display:none" value="@SrField.FieldValue" id="ItemSrNo" data-bind="ItemSrNo" data_content="TextBox" disabled class="form-control w-25" />
                                        </div>
                                        var indexField = Model.FormFields.Where(x => x.FieldName == "RowIndex").FirstOrDefault();
                                        if (indexField != null && !string.IsNullOrEmpty(@indexField.FieldValue) && @indexField.FieldValue.Length > 0)
                                        {
                                            RowIndex = Convert.ToInt32(@indexField.FieldValue);
                                        }
                                        else
                                        {
                                            RowIndex = ItemSrNo;
                                        }
                                        <div class="col col-md-12">
                                            <label for="RowIndex" class="form-control-label"><strong id="lblRowIndex">Item#: @RowIndex</strong></label>
                                            <input value="@RowIndex" style="display:none" id="RowIndex" data-bind="RowIndex" data_content="TextBox" disabled class="form-control w-25" />
                                        </div>
                                    }
                                    else
                                    {
                                        ItemSrNo = Convert.ToInt32(@ViewBag.ItemSrNo);
                                        RowIndex = Convert.ToInt32(@ViewBag.RowIndex);
                                        <div class="col col-md-12">
                                            <label for="RowIndex" class="form-control-label"><strong id="lblRowIndex">Item#: @ViewBag.RowIndex</strong></label>
                                            <input value="@ViewBag.RowIndex" style="display:none" id="RowIndex" data-bind="RowIndex" data_content="TextBox" disabled class="form-control w-25" />
                                        </div>
                                        <div class="col col-md-12 d-none">
                                            <label for="ItemSrNo" class="form-control-label"><strong id="lblItemSrNo">Item#: @ViewBag.ItemSrNo</strong></label>
                                            <input value="@ViewBag.ItemSrNo" style="display:none" id="ItemSrNo" data-bind="ItemSrNo" data_content="TextBox" disabled class="form-control w-25" />
                                        </div>
                                    }
                                    var objfields = Model.FormFields;
                                }
                                @{
                                    if (@ViewBag.ProcessId != null && @ViewBag.ProcessId != 0)
                                    {
                                        if (Model.FormFields.Where(x => x.FieldName == "ProcessId").FirstOrDefault() != null)
                                        {
                                            var SrField = Model.FormFields.Where(x => x.FieldName == "ProcessId").FirstOrDefault();
                                            <input style="display:none" value="@SrField.FieldValue" id="BOMProcessId" data-bind="ProcessId" data_content="TextBox" disabled class="form-control w-25" />
                                        }
                                        else
                                        {
                                            <input value="@ViewBag.ProcessId" style="display:none" id="BOMProcessId" data-bind="ProcessId" data_content="TextBox" disabled class="form-control w-25" />
                                        }
                                    }
                                }
                                @{
                                    if (@ViewBag.DetailParentId != null && @ViewBag.DetailParentId != 0)
                                    {
                                        if (Model.FormFields.Where(x => x.FieldName == "DetailParentId").FirstOrDefault() != null)
                                        {
                                            var SrField = Model.FormFields.Where(x => x.FieldName == "DetailParentId").FirstOrDefault();
                                            <input style="display:none" value="@SrField.FieldValue" id="SubDetailParentId" data-bind="DetailParentId" data_content="TextBox" disabled class="form-control w-25" />
                                        }
                                        else
                                        {
                                            <input value="@ViewBag.DetailParentId" style="display:none" id="SubDetailParentId" data-bind="DetailParentId" data_content="TextBox" disabled class="form-control w-25" />
                                        }
                                    }
                                }
                                @foreach (var field in Model.FormFields)
                                {
                                    bool IsDisabled = false;
                                    string fieldName = Convert.ToString(field.FieldName).ToUpper();
                                    if (field.FieldName != "ChargesId" && field.FieldName != "ItemSrNo" && field.FieldName != "RowIndex")
                                    {
                                        if (fieldName == "ITCODE" || fieldName == "IT_CODE" || fieldName == "ITEMNAME" || fieldName == "ITEM_NAME")
                                        {
                                            IsDisabled = IsFromPending;
                                        }
                                        string cls = "col-md-6";
                                        if (IsCenterStyle)
                                        {
                                            cls = "col-md-4";
                                        }
                                        if (field.FieldSize == "Medium")
                                        {
                                            cls = " col-md-6 ";
                                        }
                                        else if (field.FieldSize == "Large")
                                        {
                                            cls = " col-md-12 ";
                                        }
                                        if (field.IsVisible == false)
                                        {

                                        }
                                        else
                                        {
                                            string alignClass = field.FieldType == "CheckBox" ? "checkbox-align" : "";
                                            string buttnCss = "";
                                            if (field.FieldType == "Button")
                                            {
                                                buttnCss = "style='width:100%; display:flow; justify-content:end;align-content:center'";
                                            }
                                            <div class="col @cls form-group @alignClass" @Html.Raw(buttnCss)>
                                                @if (field.FieldType != "CheckBox" && field.FieldType != "Button")
                                                {
                                                    <label for="@field.FieldName" class="form-control-label">@field.FieldCaption</label>
                                                }
                                                @if (field.IsRequired)
                                                {
                                                    <span class="text-danger p-1">(*)</span>
                                                }
                                                @if (field.InfoTabCount > 0 && field.FieldType == "Selection")
                                                {
                                                    <a href="javascript:Void(0);"
                                                       onclick="FieldInformationModel('@field.FieldId','@field.FieldName.Trim()'); return false;"
                                                       title="View @field.FieldCaption Information"><i class="fa fa-eye text-black"></i></a>
                                                }
                                                @if (field.FieldType == "Selection")
                                                {
                                                    @*<a href="javascript:void(0);" onclick="CopySelectedOptionItem('@field.FieldName.Trim()')" title="Click to copy" class="text-black"><i class="fa fa-copy"></i></a>*@
                                                    <button type="button" onclick="CopySelectedOption('@field.FieldName.Trim()')" title="Click to copy" class="text-black" style="border:none;background:none;">
                                                        <i class="fa fa-copy"></i>
                                                    </button>
                                                }
                                                @if (field.FieldType == "Attachment")
                                                {
                                                    <a href="javascript:void(0);" data-toggle="modal" onclick="OpenDetailAttachment(@Model.Id, '@field.FieldCaption', '@field.FieldId',@ItemSrNo);" data-target="#attachModal" title="Attachments" class="text-black">
                                                        <i class="fa fa-paperclip"></i>
                                                    </a>
                                                }
                                                @switch (field.FieldType)
                                                {
                                                    case "Label":
                                                        <label class="form-control text-danger" data-html="@field.FieldCaption" data-bind="@field.FieldName" style="padding: 0; border: none; display: block; white-space: normal; word-break: break-word; height: auto;" id="@field.FieldName">N/A</label>
                                                        break;
                                                    case "TextBox":
                                                        if (field.IsRequired)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { data_container = @field.FieldId, data_language = field.IsLanguage, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength, @required = field.IsRequired == true ? "required" : null })
                                                        }
                                                        else if (field.IsReadOnly == true)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { data_container = @field.FieldId, data_language = field.IsLanguage, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength, @readonly = "readonly" })
                                                        }
                                                        else
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { data_container = @field.FieldId, data_language = field.IsLanguage, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength })
                                                        }
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "MultiText":
                                                        if (field.IsRequired)
                                                        {
                                                            @Html.TextArea(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @rows = "2", @required = field.IsRequired == true ? "required" : null })
                                                        }
                                                        else if (field.IsReadOnly == true)
                                                        {
                                                            @Html.TextArea(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @rows = "2", @readonly = "readonly" })
                                                        }
                                                        else
                                                        {
                                                            @Html.TextArea(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @rows = "2" })
                                                        }
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "Numeric":
                                                        if (!string.IsNullOrWhiteSpace(field.FieldValue) && !field.FieldValue.Equals("NULL", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            if (decimal.TryParse(field.FieldValue, out decimal parsedValue))
                                                            {
                                                                decimal rounded = Math.Round(parsedValue, field.FieldDecimal);
                                                                field.FieldValue = rounded.ToString();
                                                            }
                                                        }
                                                        int decimalPlaces = (field.FieldDecimal < 0 ? 2 : field.FieldDecimal);
                                                        string step = decimalPlaces == 0
                                                            ? "1"
                                                            : (1 / Math.Pow(10, decimalPlaces)).ToString("F" + decimalPlaces);
                                                        if (field.IsRequired)
                                                        {
                                                            if (field.IsReadOnly == true)
                                                            {
                                                                @Html.TextBox(field.FieldName, field.FieldValue, new { max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", @step = step, data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number", @required = field.IsRequired == true ? "required" : null, @readonly = "readonly" })
                                                            }
                                                            else
                                                            {
                                                                @Html.TextBox(field.FieldName, field.FieldValue, new { max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", @step = step, data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number", @required = field.IsRequired == true ? "required" : null })
                                                            }
                                                        }
                                                        else if (field.IsReadOnly == true)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", @step = step, data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number", @readonly = "readonly" })
                                                        }
                                                        else
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", @step = step, data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number" })
                                                        }
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "Selection":
                                                        var _fieldValue = Convert.ToString(field.FieldValue);
                                                        var _fieldText = Convert.ToString(field.FieldValue);
                                                        if (!string.IsNullOrEmpty(field.FieldValue))
                                                        {
                                                            _fieldValue = Convert.ToString(field.FieldValue).Trim();
                                                            _fieldText = Convert.ToString(field.FieldValue).Trim();
                                                        }

                                                        if (Model.Data != null && Model.Data != null)
                                                        {
                                                            foreach (var _it in Model.Data)
                                                            {
                                                                object value;
                                                                if (_it.TryGetValue((field.FieldName + "_Id").ToUpper(), out value))
                                                                {
                                                                    _fieldValue = Convert.ToString(value).Trim();
                                                                }
                                                            }
                                                        }

                                                        if (field.IsRequired)
                                                        {
                                                            if (IsDisabled || field.IsReadOnly == true)
                                                            {
                                                                <select class="form-select select2 form-control selectpicker" data-disabled="True" multiple="@((field.IsMultiSelection.HasValue ? field.IsMultiSelection.Value : false) ? "multiple" : null)" data-multiselection="@field.IsMultiSelection" onchange="dropdownChange(this)" data-display="@_fieldText" data-dependency="@field.IsDependencyField" data-live-search="true" data-sourcetype="@field.DDLSourceType" data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue" required id="@field.FieldName.Trim()" data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName" data-content="@field.FieldType"></select>
                                                            }
                                                            else
                                                            {
                                                                <select class="form-select select2 form-control selectpicker" multiple="@((field.IsMultiSelection.HasValue ? field.IsMultiSelection.Value : false) ? "multiple" : null)" data-multiselection="@field.IsMultiSelection" onchange="dropdownChange(this)" data-display="@_fieldText" data-dependency="@field.IsDependencyField" data-live-search="true" data-sourcetype="@field.DDLSourceType" data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue" required id="@field.FieldName.Trim()" data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName" data-content="@field.FieldType"></select>
                                                            }
                                                        }
                                                        else if (field.IsReadOnly == true)
                                                        {
                                                            <select class="form-select select2 form-control selectpicker" multiple="@((field.IsMultiSelection.HasValue ? field.IsMultiSelection.Value : false) ? "multiple" : null)" data-multiselection="@field.IsMultiSelection" onchange="dropdownChange(this)" data-display="@_fieldText" data-dependency="@field.IsDependencyField" data-sourcetype="@field.DDLSourceType" data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@field.FieldName.Trim()" data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName" data-content="@field.FieldType" data-disabled="@field.IsReadOnly"></select>
                                                        }
                                                        else
                                                        {
                                                            if (IsDisabled)
                                                            {
                                                                <select class="form-select select2 form-control selectpicker" data-disabled="True" multiple="@((field.IsMultiSelection.HasValue ? field.IsMultiSelection.Value : false) ? "multiple" : null)" data-multiselection="@field.IsMultiSelection" onchange="dropdownChange(this)" data-display="@_fieldText" data-dependency="@field.IsDependencyField" data-sourcetype="@field.DDLSourceType" data-live-search="true" data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@field.FieldName.Trim()" data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName" data-content="@field.FieldType"></select>
                                                            }
                                                            else
                                                            {
                                                                <select class="form-select select2 form-control selectpicker" multiple="@((field.IsMultiSelection.HasValue ? field.IsMultiSelection.Value : false) ? "multiple" : null)" data-multiselection="@field.IsMultiSelection" onchange="dropdownChange(this)" data-display="@_fieldText" data-dependency="@field.IsDependencyField" data-sourcetype="@field.DDLSourceType" data-live-search="true" data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@field.FieldName.Trim()" data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName" data-content="@field.FieldType"></select>
                                                            }
                                                        }
                                                        string selectloder = field.FieldName.Trim() + "_select-loader";
                                                        <div class="selectloader" id="@selectloder" style="display: none;"></div>
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "CheckBox":
                                                        <div class="form-check">
                                                            @if (field.IsRequired)
                                                            {
                                                                if (field.FieldValue == "True")
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @checked = (field.FieldValue == "True" ? "checked" : ""), @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @required = field.IsRequired == true ? "required" : null })
                                                                }
                                                                else
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @required = field.IsRequired == true ? "required" : null })
                                                                }
                                                            }
                                                            else if (field.IsReadOnly == true)
                                                            {
                                                                if (field.FieldValue == "True")
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @checked = (field.FieldValue == "True" ? "checked" : ""), @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @readonly = "readonly" })
                                                                }
                                                                else
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @readonly = "readonly" })
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (field.FieldValue == "True")
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @checked = (field.FieldValue == "True" ? "checked" : ""), @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName })
                                                                }
                                                                else
                                                                {
                                                                    @Html.CheckBox(field.FieldName, new { @class = "form-check-input", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName })
                                                                }
                                                            }
                                                            <label class="form-check-label" for="@field.FieldName">@field.FieldCaption</label>
                                                        </div>
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "RadioButton":
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "DateTimeField":
                                                        string datefieldType = (field.IsTimeField == true ? "datetime-local" : "date");
                                                        if (!string.IsNullOrEmpty(field.FieldValue))
                                                        {
                                                            try
                                                            {
                                                                DateTime _dt = DateTime.Parse(field.FieldValue);
                                                                field.FieldValue = _dt.ToString("yyyy-MM-dd");
                                                            }
                                                            catch (Exception)
                                                            {
                                                            }
                                                        }
                                                        if (field.IsRequired)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @required = field.IsRequired == true ? "required" : null })
                                                        }
                                                        else if (field.IsReadOnly == true)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @readonly = "readonly" })
                                                        }
                                                        else
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date" })
                                                        }
                                                        @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                        break;
                                                    case "Hidden":
                                                        @Html.Hidden(field.FieldName)
                                                        break;
                                                    case "TimeField":
                                                        if (!string.IsNullOrEmpty(field.FieldValue))
                                                        {
