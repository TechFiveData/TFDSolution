                                                        break;
                                                    default:
                                                        if (field.IsRequired)
                                                        {
                                                            @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_path = @field.FieldFormula, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength, @required = field.IsRequired == true ? "required" : null })
