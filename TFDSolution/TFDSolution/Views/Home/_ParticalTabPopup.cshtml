    function LoadOtherCharges(ctrl) {
        try {
            let tableDropdown = $("#ChargesId");
            $("#divChargeFields").empty();
            var fieldId = $(ctrl).attr("data-container");
            var itemId = $(ctrl).val();
            var _accountId = 0;
            var $accountElement = $("#HeaderTabs").find('[data-delay="m_MastAccountMaster"]');
            var accountVal = $accountElement.val();
            if ($accountElement.length > 0 && accountVal && accountVal !== "0") {
                _accountId = parseInt(accountVal);
            }
            else if ($accountElement.length == 0) {
                $accountElement = $("#DataTabPopup").find('[data-delay="m_MastAccountMaster"]');
                accountVal = $accountElement.val();
                if ($accountElement.length > 0 && accountVal && accountVal !== "0") {
                    _accountId = parseInt(accountVal);
                }
            }
            if (itemId > 0 || _accountId > 0) {
                var headerFieldData = getPageHeaderFieldData();
                var fieldData = getPageFieldData();
                var model = {
                    FieldId: fieldId,
                    ItemId: itemId,
                    AccId: _accountId,
                    FormId: '@Model.Design.FormId',
                    HeaderFieldData: headerFieldData,
                    DetailFieldData: fieldData
                };
                tableDropdown.empty();
                tableDropdown.append('<option value="">Other Charge Template</option>')
                $.ajax({
                    type: "POST", url: '@Url.Action("GetItemFieldOtherCharges", "Common")',
                    contentType: "application/json;",
                    data: JSON.stringify(model),
                    dataType: "json",
                    skipLoading: true, // <-- Custom flag
                    async: true,
                    success: function (tables) {
                        tableDropdown.empty();
                        tableDropdown.append('<option value="">Other Charge Template</option>')
                        if (tables != null && tables.length > 0) {
                            tables.forEach(table => {
                                if (table.Value != "-1" && table.Value != null) {
                                    if ($("#hdnChargesId").val() == "" || $("#hdnChargesId").val() == "0") {
                                        tableDropdown.append(`<option selected value="${table.Value}">${table.Text}</option>`);
                                    }
                                    else {
                                        tableDropdown.append(`<option value="${table.Value}">${table.Text}</option>`);
                                    }
                                }
                            });
                            if ($("#hdnChargesId").val() != "" && $("#hdnChargesId").val() != "0") {
                                $('#ChargesId').val($("#hdnChargesId").val()).change();
                            }
                            else if ($("#ChargesId").val() != "" && $("#ChargesId").val() != "0") {
                                $('#ChargesId').val($("#ChargesId").val()).change();
                            }
                            //else {
                            //    $('#ChargesId').prop('selectedIndex', 1);
                            //    $('#ChargesId').val($("#ChargesId").val()).change();
                            //}
                            if ($('#ChargesId option').length > 1) {
                                var sel = $('#ChargesId')[0];
                                if (sel.selectedIndex < 0 || sel.selectedIndex === 0) {
                                    sel.selectedIndex = 1;
                                    $('#ChargesId').val($("#ChargesId").val()).change();
                                }
                            }
                        }
                    },
                    failure: function (response) { },
                    error: function (xhr, status, error) {

                        console.log("Status:", status);
                        console.log("Error:", error);
                        console.log("Response:", xhr.responseText);

                    }
                });
            }
        } catch (e) {
        }
    }

