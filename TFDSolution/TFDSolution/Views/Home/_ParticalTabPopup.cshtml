                            skipLoading: true, // <-- Custom flag
                            delay: 250,
                            data: function (params) {
                                return {
                                    FieldId: _fieldId,
                                    searchTerm: params.term || '', // search term
                                    page: params.page || 1,
                                    fieldValue: ''
                                };
                            },
                            processResults: function (data) {
