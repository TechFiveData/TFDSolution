    function CalculateTotal() {
        var total = 0;
        try {
            if ($("#tblOtherCharges").length > 0 && $("#hdnPageActionDetail").val() != "V") {
                $("#txtBasic").val($("#Amount").val());
                $("#tblOtherCharges tbody tr").each(function () {
                    var BasedOnfield = $(this).find('td').attr("data-content");
                    var Alias = $(this).find('td').attr("data-bind");
                    if (Alias != undefined && Alias.length > 0) {
                        Alias = Alias.toLowerCase();
                    }
                    var fieldformula = $(this).find('td').attr("data-container");
                    var fielddecimal = $(this).find('td').attr("data-decimal");
                    if (fielddecimal != null && fielddecimal != "") {
                        fielddecimal = parseInt(fielddecimal);
                    }
                    else {
                        fielddecimal = parseInt("0");
                    }
                    if (fieldformula != undefined && fieldformula.indexOf("=") != -1) {
                        fieldformula = fieldformula.replaceAll("=", "").toLowerCase();
                    }
                    if (Alias != undefined && Alias.length > 0 & fieldformula != undefined && fieldformula.length > 0) {
                        var basedOn = parseFloat(0);
                        if ($("#" + BasedOnfield).length > 0) {
                            basedOn = parseFloat($("#" + BasedOnfield).val())
                        }
                        if (Alias == fieldformula) {
                        }
                        else {
                            let inputVal = $(this).find('input').val();
                            if (fieldformula != null && fieldformula != undefined && fieldformula != "") {

                                fieldformula = fieldformula.replaceAll("a", basedOn);
                                fieldformula = fieldformula.replaceAll("A", basedOn);
                                $("#tblOtherCharges tr").each(function () {
                                    var _innerAlias = $(this).find('td').attr("data-bind");
                                    var _PerAmount = $(this).find('td').attr("data-find");
                                    if (_innerAlias != undefined && _innerAlias.length > 0) {
                                        _innerAlias = _innerAlias.toLowerCase();
                                    }
                                    var _defaultValue = 0;
                                    if ($(this).find('td').find("input.default-value") != null && $(this).find('td').find("input.default-value").length > 0) {
                                        _defaultValue = parseFloat(convertNumber($(this).find('td').find("input.default-value").val()));
                                    }
                                    if (_defaultValue > 0 && $(this).find('td').find("input.charges-value").length > 0) {

                                    }
                                    if ($(this).find('td').find("input.charges-value").length > 0) {
                                        var dataValue = 0
                                        if (_PerAmount == "Amount") {
                                            //$(this).find('td').find("input.charges-value").val(parseFloat(eval(_defaultValue)).toFixed(2));
                                            //dataValue = parseFloat(convertNumber($(this).find('td').find("input.charges-value").val()));
                                            fieldformula = fieldformula.replaceAll(_innerAlias, convertNumber($(this).find('td').find("input.charges-value").val()));
                                        }
                                        else {
                                            //dataValue = parseFloat(convertNumber(_defaultValue));
                                            //$(this).find('td').find("input.charges-value").val(parseFloat(eval((_defaultValue * basedOn)/100)).toFixed(2));
                                            fieldformula = fieldformula.replaceAll(_innerAlias, convertNumber(_defaultValue));
                                        }
                                    }
                                })
                                try {
                                    //console.log(Alias + " - Field Formula With Value -2 : " + fieldformula);
                                    var calFieldValue = parseFloat(eval(fieldformula)).toFixed(fielddecimal);
                                    $(this).find('td').find("input.charges-value").val(calFieldValue);
                                    /*console.log(Alias + " - Field Formula With Value Final : " + fieldformula);*/
                                } catch (e) {
                                    $(this).find('td').find("input.charges-value").val(0);
                                }
                            }
                        }
                    }
                });
                $("#tblOtherCharges tr").each(function () {
                    if ($(this).find('td').find("input.charges-value") != undefined && $(this).find('td').find("input.charges-value").length > 0) {
                        if ($(this).find('td').find("input.charges-value").attr("id") != "txtBasic") {
                            if ($(this).find('td').find("input.charges-value").attr("data-content") == "Deduction") {
                                total = total - parseFloat(convertNumber($(this).find('td').find("input.charges-value").val()));
                            }
                            else if ($(this).find('td').find("input.charges-value").attr("data-content") == "Addition") {
                                total = total + parseFloat(convertNumber($(this).find('td').find("input.charges-value").val()));
                            }
                        }
                    }
                });

                $("#txtTotalOtherCharges").val(total.toFixed(2));
            }
        } catch (e) {
            debugger;
        }
    }
