    function bindDataTabledata(dataset, tableName) {
        //var formname = $("#hdnFormName").val();
        var columns = [];
        columns.push(
            {
                title: '',
                className: "grid-action-item",
                render: function (data, type, row, meta) {
                    var editlink = '';
                    /*"<a title='Edit Record' href='" + editlink + "';><i class='fa fa-pencil'></i></a> &nbsp;|&nbsp; " +*/
                    return "<a title='Delete Record' href='javascript:deleteTabRecord(" + row.Id + ")';><i class='fa fa-trash text-danger'></i></a>&nbsp;|&nbsp;" +
                        "<a title='View Record' href='javascript:editTabRecord(" + row.Id + ",0)';> <i class='fa fa-eye'></i></a >";
                },
            });
        columns.push({
            title: 'Created On',
            render: function (data, type, row, meta) {
                var editlink = formatDate(parseMSDate(row.CreatedOn));
                return "<span>" + editlink + "</span>";
            },
        });
        columns.push({
            title: 'Updated On',
            render: function (data, type, row, meta) {
                if (row.UpdatedOn != null) {
                    var editlink = formatDate(parseMSDate(row.UpdatedOn));
                    return "<span>" + editlink + "</span>";
                }
                else {
                    return "<span></span>";
                }
            },
        });
        var tableData = JSON.parse(JSON.stringify(dataset.Data));    // Cannot read property '0' of undefined
        if (tableData.length > 0) {
            columnNames = Object.keys(tableData[0]);
            for (var i in columnNames) {
                var dataVal = columnNames[i];
                if (columnNames[i] != "Id" && columnNames[i] != "CompanyId" && columnNames[i] != "CreatedBy" && columnNames[i] != "UpdatedBy" && columnNames[i] != "CreatedOn" && columnNames[i] != "UpdatedOn"
                    && columnNames[i].indexOf("PODate") < 0) {
                    if (columnNames[i].toLowerCase() == "amount") {
                        columns.push({
                            title: columnNames[i],
                            render: function (data, type, row, meta) {
                                var subtotal = $("#txtSubTotal").val();
                                var cleaned = subtotal.replace(/[^0-9.-]+/g, "");
                                var amount = parseFloat(cleaned);
                                amount = amount + convertNumber(row["Amount"]);
                                $("#txtSubTotal").val(formatAmount(amount));
                                CalculateTotal();
                                return row["Amount"];
                            },
                        });
                    }
                    else {
                        columns.push({
                            data: columnNames[i],
                            title: columnNames[i]
                        });
                    }
                }
                else if (columnNames[i].indexOf("PODate") >= 0) {
                    columns.push({
                        title: dataVal,
                        render: function (data, type, row, meta) {
                            //console.log("date" + columnNames[i]);
                            if (columnNames[i].indexOf("PODate") >= 0) {
                                if (row[columnNames[i]] != null) {
                                    var editlink = formatDate(parseMSDate(row[columnNames[i]]));
                                    return "<span>" + editlink + "</span>";
                                }
                                else {
                                    return "<span></span>";
                                }
                            }
                            else {
                                return "<span></span>";
                            }
                        },
                    });
                }
            }
            // Assuming data is an array of objects
            // Initialize DataTable
        }
        try {

            new DataTable('#' + tableName, {
                "destroy": true,
                layout: {
                    topStart: {
                        pageLength: {
                            menu: [10, 25, 50, 100]
                        },
                        ///buttons: ['excelHtml5', 'csvHtml5', 'pdfHtml5']
                    },
                    topEnd: {
                        search: {
                            placeholder: 'Type search here'
                        }
                    },
                    bottomEnd: {
                        paging: {
                            buttons: 5
                        }
                    },
                },
                "destroy": true,
                searching: true,
                paging: true,
                scrollCollapse: true,
                info: true,
                select: true,
                scrollY: '500px',
                data: dataset.Data,
                rowId: 'Id',
                columns: columns
            });
        } catch (e) {

        }
    }
