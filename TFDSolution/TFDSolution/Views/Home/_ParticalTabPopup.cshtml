            else {
                ShowToastNotification("error", fieldName.replaceAll('_', ' ') + " field does not exists.");
                return;
            }
            var model = {
                FieldId: fieldId,
                FieldName: fieldName,
                FieldValue: $("#" + fieldName).val(),
