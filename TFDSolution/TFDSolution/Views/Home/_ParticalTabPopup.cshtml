                        if (isChecked) {
                            const stockEffect = $row.find(".ISQTYfield").attr("data-interval");
                            var val = parseFloat(parseFloat($row.find(".ISQTYfield").val()).toFixed(3) || 0); // default to 0 if empty or invalid

                            if (stockEffect.toLowerCase() == "out") {
                                const stock = parseFloat(parseFloat($row.find(".ISQTYfield").attr("data-bind")).toFixed(3));
                                if (stock < val) {
                                    isFormValid = false;
                                    $btn.html($btn.data("original-text"));
                                    $btn.prop("disabled", false);
                                    ShowToastNotification("error", "You entered larger quantity of stock in Item Serial Stock. Please review them.");
                                    $row.find(".ISQTYfield").focus();
                                    return;
                                }
                            }
                            total += parseFloat(val);
                        }
                    });

                    if (isFormValid && parseFloat(TotalQTY.toFixed(3)) != parseFloat(total.toFixed(3))) {
                        isFormValid = false;
                        $btn.html($btn.data("original-text"));
                        $btn.prop("disabled", false);
                        ShowToastNotification("error", "The stock serial and item quantity don't match. Please review them.");
                        return;
                    }
                }
            }
            else if ($("#tblItem_StockSerial tbody tr").length > 0 && $("#tblItem_StockSerial tbody tr td").length == 1) {
                isFormValid = false;
                $btn.html($btn.data("original-text"));
                $btn.prop("disabled", false);
                ShowToastNotification("error", "Stock Serial Number is mandatory. Kindly review the Serial Stock Numbers.");
                return;
            }
        }
        if (!isFormValid) {
            $btn.html($btn.data("original-text"));
            $btn.prop("disabled", false);
             ShowToastNotification("error", "Please fill in all the required fields (indicated by *)");
             return;
         }
         else {
             try {
                 var tablename = $("#hdnTabSQLTableName").val();
