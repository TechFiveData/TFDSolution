                var myModal = new bootstrap.Modal(document.getElementById('FieldButtonModel'));
                myModal.show();
            }
        } catch (e) {

        }
    }
    function FieldInformationModel(fieldId, fieldName) {
        try {

            if ($("#" + fieldName).length > 0) {
                if ($("#" + fieldName).val() == null || $("#" + fieldName).val() == undefined || $("#" + fieldName).val() == "") {
                    ShowToastNotification("error", "Please select " + fieldName.replaceAll('_', ' ') + " to view details.");
