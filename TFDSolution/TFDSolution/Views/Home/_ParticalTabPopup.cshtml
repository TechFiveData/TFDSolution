    function showCopiedLabel(ctrl) {
        $('#DataTabPopup #' + ctrl).before('<span class="my-label">Copied</span>');
        // Remove the span after 5 seconds (5000 milliseconds)
        setTimeout(function () {
            $('#DataTabPopup #' + ctrl).prev('span.my-label').fadeOut(1000, function () {
                $(this).remove(); // Remove after fade out
            });
        }, 5000);
    }
    function CopySelectedOptionItem(ctrl) {
        const $select = $('#DataTabPopup #' + ctrl);
        $('#DataTabPopup #' + ctrl).prev('span.my-label').remove();

        let selectedValues = "";
        const isMultiSelection = $select.attr("data-multiselection");

        if (isMultiSelection === "True") {
            selectedValues = $select.find('option:selected')
                .map(function () { return $(this).text(); })
                .get()
                .join(',');
        } else {
            selectedValues = $select.find('option:selected').text();
        }

        if (!selectedValues) return;

        copyText(selectedValues, ctrl);
    }

    function copyText(text, ctrl) {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text)
                .then(() => showCopiedLabel(ctrl))
                .catch(() => legacyCopy(text, ctrl));
        } else {
            legacyCopy(text, ctrl);
        }
    }

    function legacyCopy(text, ctrl) {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();

        try {
            document.execCommand("copy");
            showCopiedLabel(ctrl);
        } catch (err) {
            console.error("Copy failed", err);
        }

        document.body.removeChild(textarea);
    }

    function CopySelectedOptionItem1(ctrl) {
        try {

        var $select = $('#DataTabPopup #' + ctrl);
        $('#DataTabPopup #' + ctrl).prev('span.my-label').remove();
        // Make sure Select2 is initialized
        if (!$select.hasClass('select2-hidden-accessible') && $("#hdnPageActionDetail").val() != "V") {
            //alert('Select2 not initialized!');
            return;
        }
        var selectedValues = "";
        var isMultiSelection = $select.attr("data-multiselection");
        if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
            var multiText = $select.find('option:selected').map(function () {
                return $(this).text(); // Use .val() if you want IDs
            }).get().join(',');
            selectedValues = multiText;
        }
        else {
            selectedValues = $('#DataTabPopup #' + ctrl + ' option:selected').text();
        }

        if (selectedValues.length === 0) {
            selectedValues = $('#DataTabPopup #' + ctrl + ' option:selected').text();
            return;
        }
        var textToCopy = selectedValues;
        // Use a fallback method if navigator.clipboard is not supported
            if (navigator.clipboard && window.isSecureContext && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(textToCopy).then(function () {
                console.log('Copied: ' + textToCopy);
                $('#DataTabPopup #' + ctrl).before('<span class="my-label">Copied</span>');
                // Remove the span after 5 seconds (5000 milliseconds)
                setTimeout(function () {
                    $('#DataTabPopup #' + ctrl).prev('span.my-label').fadeOut(1000, function () {
                        $(this).remove(); // Remove after fade out
                    });
                }, 5000);
            }).catch(function (err) {
                console.error('Clipboard failed:', err);
            });
        } else {
            // Fallback for insecure context
            var textArea = document.createElement("textarea");
            textArea.value = textToCopy;
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                console.log('Copied: ' + textToCopy);
                $('#DataTabPopup #' + ctrl).before('<span class="my-label">Copied</span>');
                // Remove the span after 5 seconds (5000 milliseconds)
                setTimeout(function () {
                    $('#DataTabPopup #' + ctrl).prev('span.my-label').fadeOut(1000, function () {
                        $(this).remove(); // Remove after fade out
                    });
                }, 5000);
            } catch (err) {
                console.error('Fallback: Unable to copy', err);
            }
            document.body.removeChild(textArea);
            // Fallback using temporary input element
            //alert('Copied: ' + textToCopy);
            }
        } catch (e) {

        }
    }
    $(document).on('focusout', '#DataTabPopup input[type="number"]', function () {
        // your code here
        let fieldname = $(this).attr('id');
        BindDependencyData(fieldname, false);
        $("#DataTabPopup #" + fieldname).trigger('change');
    });
    $(document).on('focusout', '#DataTabPopup input[type="text"]', function () {
        // your code here
        if ($(this).attr("data-language") == "True") {
            let fieldname = $(this).attr('id');
            var fieldId = $('#DataTabPopup #' + fieldname).attr("data-container");
            BindLanguageConversation(fieldId, fieldname);
        }
    });
    $(document).on("focusout", "#DataTabPopup #Quantity", function () {
        var isLockedPendingQty = '@IsLockedPendingQty.ToString()';
        if (isLockedPendingQty == 'True' && $("#IsFromPending").val() == '1') {
            let max = Number($(this).attr('max'));
            if (Number(this.value) > max) {
              this.value = max;
            }
        }
        if ($("#tblItem_StockSerial").length > 0 && $("#tblItem_StockSerial tbody tr").length > 0 && $("#tblItem_StockSerial tbody tr td").length > 1) {
            var qty = $("#DataTabPopup #Quantity").val();
            if (qty && qty !== "0") {
                var TotalQTY = parseFloat(parseFloat(qty).toFixed(3));
                var total = 0;
                $("#tblItem_StockSerial tbody tr").each(function () {
                    const $row = $(this);
                    $row.find(".ISCheckfield").prop("checked", false);
                    $row.find(".ISQTYfield").val(0);
                    const $stockCtrl = $row.find(".ISStockfield");
                    const stock = parseFloat(parseFloat($stockCtrl.val()).toFixed(3) || 0);
                    $row.find(".ISBalancefield").val(stock - 0);
                    if (parseFloat(total) < parseFloat(TotalQTY)) {
                        if ($stockCtrl.length) {
                            if (stock > 0) {
                                const qty = Math.min(stock, (TotalQTY - total)); // take smaller of stock or TotalQTY
                                $row.find(".ISQTYfield").val(parseFloat(qty.toFixed(3)));
                                $row.find(".ISCheckfield").prop("checked", true);
                                // Increase total only by qty or remaining required
                                const remain = parseFloat(parseFloat(TotalQTY).toFixed(3)) - parseFloat(parseFloat(qty).toFixed(3));
                                total += (TotalQTY - remain);
                            }
                            const fieldQTY = parseFloat(parseFloat($row.find(".ISQTYfield").val()).toFixed(3) || 0);
                            const _balance = parseFloat(stock - fieldQTY);
                            $row.find(".ISBalancefield").val(_balance.toFixed(3));
                        }
                    }
                });
                if ($("#txtISTotalQty").length > 0) {
                    $("#txtISTotalQty").text(parseFloat(total));
                    $("#txtISTotalQty").removeClass("text-danger");
                    $("#txtISTotalQty").removeClass("text-success");
                    if (parseFloat(TotalQTY) != parseFloat(total)) {
                        $("#txtISTotalQty").addClass("text-danger");
                    }
                    else if (parseFloat(TotalQTY) = parseFloat(total)) {
                        $("#txtISTotalQty").addClass("text-success");
                    }
                }
            }
        }
    });
