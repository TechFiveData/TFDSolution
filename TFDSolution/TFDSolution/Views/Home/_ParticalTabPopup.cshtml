    function getPageFieldData() {
        const PageFieldData = [];
        // Handle input fields
        $("#DataTabPopup input").each(function () {
            const $input = $(this);
            const fieldId = $input.attr("data-bind");
            if (fieldId) {
                PageFieldData.push({
                    FieldName: fieldId,
                    FieldValue: $input.val()
                });
            }
        });
        // Handle textarea fields
        $("#DataTabPopup textarea").each(function () {
            const $textarea = $(this);
            const fieldId = $textarea.attr("data-bind");
            if (fieldId) {
                PageFieldData.push({
                    FieldName: fieldId,
                    FieldValue: $textarea.val()
                });
            }
        });
        // Handle select fields
        $("#DataTabPopup select").each(function () {
            const $select = $(this);
            const fieldId = $select.attr("data-bind");
            const selectId = $select.attr("id");
            if (selectId && fieldId) {
                const selectedText = $select.find("option:selected").text();
                const selectVal = $select.val() ?? $select.attr("data-interval");

                PageFieldData.push({
                    FieldName: fieldId,
                    FieldValue: selectedText
                });

                PageFieldData.push({
                    FieldName: fieldId + "_Id",
                    FieldValue: selectVal
                });
            }
        });
        return PageFieldData;
    }
