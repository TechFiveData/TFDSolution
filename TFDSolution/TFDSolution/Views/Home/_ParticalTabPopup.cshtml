                      data: JSON.stringify(model),
                      async: false,
                      success: function (response) {
                          if (response.IsSuccess) {
                              $("#Detailtab li> a.active").click();
                              ShowToastNotification("success", "Record saved successfully!");
                              SaveOtherCharges(response.Id);
