    function editRecord(id,isEdit) {
        var tablename = $("#hdnTableName").val();
        try {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetPageRecord", "Home")",
                data: { id: id, tblName: tablename },
                success: function (response) {
                        if (response && response.PageTablename) {
                            var data = response; // Directly assign respons
                            // Set record ID
                            $("#hdnRecordId").val(data.Id);
                            // Populate input fields dynamically
                            data.FieldData.forEach(field => {
                                var $inputField = $("input[data-bind='" + field.FieldName + "']");
                                // Set the field value
                                $inputField.val(field.FieldValue);
                                 if (isEdit == 0) {
                                    $inputField.prop("readonly", true); // Make fields readonly
                                } else {
                                    $inputField.prop("readonly", false); // Enable editing
                                }
                            });
                            // Show/hide Save button based on isEdit flag
                            var modalTitle = $("#mediumModalLabel").text();
                            if (isEdit == 0) {
                                $("#btnSave").hide(); // Hide Save button
                                $("#mediumModalLabel").text(modalTitle.replace("Add New", "View").replace("Edit", "View"));
                            } else {
                                $("#btnSave").show(); // Show Save button
                                $("#mediumModalLabel").text(modalTitle.replace("Add New", "Edit").replace("View", "Edit"));
                            }
                            var myModal = new bootstrap.Modal(document.getElementById('mediumModal'));
                            myModal.show();
                        }
                },
                error: function () { ShowToastNotification("error", "Error fetching record details."); }
            });
        }
        catch (e) {
            ShowToastNotification("error", e.message);
        }
    }

    function deleteRecord(id) {
        customConfirm({
            message: "Are you sure you want to delete this record?",
            type: "delete", // success | warning | delete
            title: "Delete Record"}, function (result) {
            if (result) {
               var tablename = $("#hdnTableName").val();
                try {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("DeletePageRecord", "Home")",
                        data: { id: id, tblName: tablename, URNNo: "", ParentFormName: '@Model.Design.ParentFormName', FormName: '@Model.Design.FormName' },
                        success: function (response) {
                            if (response.IsSuccess) {
                                ShowToastNotification("success", "Record has been deleted successfully.");
                                BindGridPagination();
                            } else {
                                ShowToastNotification("error", "Error Record Status record.");
                            }
                        },
                        error: function () {
                            ShowToastNotification("error", "Error Record Status record.");
                        }
                    });
                }
                catch (e) {
                    ShowToastNotification("error", e.message);
                }
                return true;
            }
        });
    }

    function UpdateRecordStatus(fromId, paramId, paraparentId, paramStatus, cancelreason)
    {
        var tablename = $("#hdnTableName").val();
        try {
             $.ajax({
                 type: "POST",
                 url: "@Url.Action("UpdateRecordStatus", "Home")",
                 data: {
                     formId: fromId,
                     status: paramStatus,
                     ParentId: paraparentId,
                     Id: paramId,
                     CancelReason: cancelreason
                 },
                 success: function (response) {
                     if (response.IsSuccess) {
                         //alert("Record Status has been successfully.");
                         ShowToastNotification("success", "Record Status has been successfully.");
                         $("#btnCancelReasonDet").click();
                         $("#btnCancelReason").click();
                         $('#tblpage').DataTable().destroy();
                         $('#tblpage tbody').empty();
                         BindGridPagination();

                     } else {
                         ShowToastNotification("error", response.Response);
                     }
                 },
                 error: function () {
                     ShowToastNotification("error", "Error status update record.");
                 }
            });
        }
        catch (e) {
            ShowToastNotification("error", e.message);
        }
    }
