@model TFDSolution.Models.PageModel

@{
    ViewBag.Title = Model.Design.FormTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    td.actions {
        position: relative;
    }

    .export-print {
        top: 2px !important;
        left: 26px !important;
    }

        .export-print .dropdown-item {
            padding: 2px 14px !important;
        }

    .dropdown-item:hover {
        background-color: #d9d9d9 !important;
        color: #000 !important;
        /*transform: translateX(3px);*/
    }

    .dropdown-item:active {
        background-color: #d9d9d9;
        color: #000;
    }

    .report-print .dropdown-menu .dropdown-item {
        padding: 2px 14px !important;
    }

    .modal.modal-right .modal-dialog {
        position: fixed;
        margin: 0;
        top: 0;
        right: 0;
        height: 100vh;
        max-width: 400px; /* adjust width as needed */
        transform: translateX(100%);
        transition: transform 0.3s ease-out;
    }

    .modal.modal-right.show .modal-dialog {
        transform: translateX(0);
    }

    .modal-content {
        height: 100vh;
        border-radius: 0;
    }
</style>
<input value="0" type="hidden" id="LastCommentId" />
<div id="tableLoader" style="display:none;position:absolute;top:0;left:0;
    width:100%;height:100%;background:rgba(255,255,255,0.7);
    z-index:9999;text-align:center;padding-top:100px;">
    <img src="/images/loader.gif" alt="Loading..." />
</div>
@{
    var ImagesBase = Url.Content("~/");
}
<input type="hidden" value="@Model.Design.SQLTableName" id="hdnTableName" />
<input type="hidden" value="@Model.Design.FormName" id="hdnFormName" />
<input type="hidden" value="@Model.Design.FormId" id="hdnFormId" />
<input type="hidden" value="@Convert.ToString(Model.Design.CanApprove)" id="hdnCanApprove" />
<input type="hidden" value="@Convert.ToString(Model.Design.CanDelete)" id="hdnCanDelete" />
<input type="hidden" value="@Convert.ToString(Model.Design.CanEdit)" id="hdnCanEdit" />
<div class="page-main">
    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->
    <div class="page-main-header">
        <div class="page-main-title">
            <i class="fa fa-building-o"></i>
            <span>
                @Model.Design.FormTitle
            </span>
        </div>
        <nav>
            <ol class="breadcrumb page-breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index","Home")">
                        Home
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    @Model.Design.ParentFormTitle
                </li>
                <li class="breadcrumb-item active">
                    @Model.Design.FormTitle
                </li>
            </ol>
        </nav>
    </div>
    <div class="page-main-container">
        <div class="page-main-card">
            <div class="page-main-card-header">
                <div class="page-main-card-title">
                    <button class="btn btn-sm" data-toggle="modal" data-target="#showCommentsModel" onclick="ShowComments()" title="Comments" type="button">
                        <i class="fa fa-comment-o font16"></i>
                    </button>
                </div>
                <div class="page-main-card-actions">
                    <!-- REFRESH -->
                    <a class="page-main-action-btn" href="@Url.Action("MyPage","Home", new { @pagename = Model.Design.FormName })" title="Refresh">
                        <i class="fa fa-refresh"></i>
                        Refresh
                    </a>
                    @if (Model.Design.CanAdd == true)
                    {
                        <a class="page-main-action-btn primary" id="btnAddNew"
                           href="@Url.Action("PageDetail", "Home", new { @pagename = Model.Design.FormName })" title="Add New @Model.Design.FormTitle">
                            <i class="fa fa-plus"></i>&nbsp; New
                        </a>
                    }
                    <div class="dropdown" style="float:right; position:relative;">
                        <button class="btn btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-download"></i>&nbsp; Export
                        </button>
                        <div class="dropdown-menu export-print" style="margin: 2.2rem -1.285em 2rem;min-width: auto !important; width: auto;" aria-labelledby="dropdownMenuButton">
                            <a class="dropdown-item" title="Export in CSV" id="btnExportCsv" href="javascript:void(0);"><i class="fa fa-file-text-o pr-1" style="color:#555"></i>CSV</a>
                            <a class="dropdown-item" title="Export in Excel" id="btnExportExcel" href="javascript:void(0);"><i class="fa fa-file-excel-o pr-1" style="color:green"></i>Excel</a>
                            <a class="dropdown-item" id="btnExportPDF" title="Export in PDF" href="javascript:void(0);"><i class="fa fa-file-pdf-o"></i>&nbsp; PDF</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- =================================================
                 CARD BODY
            ================================================== -->
            <div class="page-main-card-body">
                <div class="page-main-list-heading d-none">
                    <div class="page-main-list-title">
                        <i class="fa fa-list"></i>
                        List Of @Model.Design.FormTitle
                    </div>
                    <div class="page-main-list-description">
                        Manage and maintain your records
                    </div>
                </div>
                <nav>
                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                        <button class="nav-link active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button" role="tab" aria-controls="nav-home" aria-selected="true">
                            List Record <span id="lblRecordCount" class="font-weight-bold">(0)</span>
                        </button>
                        @if (Model.PendingData != null && Model.PendingData.Count > 0)
                        {
                            foreach (var item in Model.PendingData)
                            {
                                string liId = "nav-pending-tab-" + item.FormPendingId.ToString();
                                string liCount = liId + "Count";
                                string contentDiv = "nav-pending-" + item.FormPendingId.ToString();
                                string tblId = "tblPending-" + item.FormPendingId.ToString();
                                <button class="nav-link" data-interval="@liCount" data-bind="@tblId" data-content="@item.SourceName" id="@liId"
                                        data-bs-toggle="tab" data-bs-target="#@contentDiv" type="button" role="tab" aria-controls="@contentDiv"
                                        aria-selected="false" onclick="adjustColumns('@tblId')">
                                    @item.FormTabName&nbsp;<span id="@liCount" class="font-weight-bold">(0)</span>
                                    <a href="javascript:void(0);" onclick="BindPendings('@tblId', '@liCount','@item.SourceName');" class="PendingRefresh" title="Refresh"><i class="fa fa-refresh"></i></a>
                                </button>
                            }
                        }
                    </div>
                </nav>
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
                        <div class="p-3">
                            <div class="row form-group">
                                <div class="col-md-12">
                                    <table id="tblpage" class="display cell-border nowrap" cellspacing="0" width="100%"></table>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.PendingData != null && Model.PendingData.Count > 0)
                    {
                        foreach (var item in Model.PendingData)
                        {
                            string liId = "nav-pending-tab-" + item.FormPendingId.ToString();
                            string contentDiv = "nav-pending-" + item.FormPendingId.ToString();
                            string tblId = "tblPending-" + item.FormPendingId.ToString();
                            string FromFormId = Convert.ToString(item.FromFormId);
                            <div class="tab-pane fade" id="@contentDiv" role="tabpanel" aria-labelledby="@liId">
                                <div class="p-3">
                                    <div class="row form-group">
                                        <div class="col-md-12" style="width:100%; overflow-x:auto;">
                                            <table id="@tblId" data-content="@FromFormId" data-bind="@item.FormPendingId.ToString()" class="display nowrap cell-border" cellspacing="0" width="100%"></table>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-md-12 text-left">
                                            <button class="btn btn-primary" onclick="CreateRecord('@tblId')">Create @Model.Design.FormTitle</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="row form-group mb-0">
                    <div class="col-12 p-0">

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cancel Reason</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="text-input" class="form-control-label">Enter Reason<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <textarea id="txtCancelReason" data-content="0" class="form-control"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelReason" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="btnSubmitCancelReason" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModalDet" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Reason</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="text-input" class="form-control-label">Enter Reason<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <textarea id="txtCancelReasonDet" data-content="0" class="form-control"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelReasonDet" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="btnSubmitCancelReasonDet" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="mediumModal" tabindex="-1" role="dialog" aria-labelledby="mediumModalLabel" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mediumModalLabel">Add New @Model.Design.FormTitle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnRecordId" />
                @if (Model.Design.Sections != null && Model.Design.Sections.Count > 0)
                {
                    foreach (var section in Model.Design.Sections)
                    {
                        <div id="@($"{section.SectionName}Tabs")">
                            @if (section.SectionName != "Header")
                            {
                                <div class="page-breaker"></div>
                            }
                            @if (section.Tabs != null && section.Tabs.Count > 0)
                            {
                                <!-- Tabs -->
                                <ul class="nav nav-tabs" id=@($"{section.SectionName}tab") role="tablist">
                                    @foreach (var tab in section.Tabs)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link @(tab == section.Tabs.First() ? "active" : "")" id=@($"{tab.TabName}-tab") data-toggle="tab" href="#@tab.TabName" aria-controls="@tab.TabName" role="tab">
                                                @tab.TabName
                                            </a>
                                        </li>
                                    }
                                </ul>

                                <!-- Tab Content -->
                                <div class="tab-content pl-3 p-1 tab-inner-content" id=@($"{section.SectionName}TabContent")>
                                    @foreach (var tab in section.Tabs)
                                    {
                                        <div class="tab-pane fade @(tab == section.Tabs.First() ? "show active" : "")" id="@tab.TabName" aria-labelledby=@($"{tab.TabName}-tab") role="tabpanel">
                                            <div class="row form-group">
                                                @if (tab.Fields != null && tab.Fields.Count > 0)
                                                {
                                                    foreach (var field in tab.Fields)
                                                    {

                                                        <div class="col col-md-3">
                                                            <label for="@field.FieldName" class="form-control-label">
                                                                @field.FieldCaption
                                                            </label> @if (field.IsRequired)
                                                            {
                                                                <span class="text-danger p-1">(*)</span>
                                                            }
                                                        </div>

                                                        <div class="col-12 col-md-9 form-group">
                                                            @switch (field.FieldType)
                                                            {
                                                                case "TextBox":
                                                                    @Html.TextBox(field.FieldName, null, new
                                                                    {
                                                                        @class = "form-control",
                                                                        @placeholder = field.FieldPlaceHolder,
                                                                        @maxlength = field.FieldLength,
                                                                        @required = field.IsRequired ? "required" : null
                                                                    })
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "MultiText":
                                                                    @Html.TextArea(field.FieldName, null, new
                                                                    {
                                                                        @class = "form-control",
                                                                        @placeholder = field.FieldPlaceHolder,
                                                                        @rows = "4",
                                                                        @required = field.IsRequired ? "required" : null
                                                                    })
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "Numeric":
                                                                    @Html.TextBox(field.FieldName, null, new
                                                                    {
                                                                        @class = "form-control",
                                                                        @type = "number",
                                                                        @required = field.IsRequired ? "required" : null
                                                                    })
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "Selection":
                                                                    @*@Html.DropDownList(field.FieldName, new SelectList(GetDropdownOptions(field), "Value", "Text"),
                                                                        "Select " + field.FieldCaption,
                                                                        new { @class = "form-control", @required = field.IsRequired ? "required" : null })*@
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "CheckBox":
                                                                    <div class="form-check">
                                                                        @Html.CheckBox(field.FieldName, new { @class = "form-check-input", @required = field.IsRequired ? "required" : null })
                                                                        <label class="form-check-label" for="@field.FieldName">@field.FieldCaption</label>
                                                                    </div>
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "RadioButton":
                                                                    @*@foreach (var option in GetDropdownOptions(field))
                                                                        {
                                                                            <div class="form-check form-check-inline">
                                                                                @Html.RadioButton(field.FieldName, option.Value, new { @class = "form-check-input", @required = field.IsRequired ? "required" : null })
                                                                                <label class="form-check-label">@option.Text</label>
                                                                            </div>
                                                                        }*@
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "DateTimeField":
                                                                    @Html.TextBox(field.FieldName, null, new
                                                                    {
                                                                        @class = "form-control",
                                                                        @type = "date",
                                                                        @required = field.IsRequired ? "required" : null
                                                                    })
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;

                                                                case "Hidden":
                                                                    @Html.Hidden(field.FieldName)
                                                                    break;

                                                                default:
                                                                    @Html.TextBox(field.FieldName, null, new
                                                                    {
                                                                        @class = "form-control",
                                                                        @placeholder = field.FieldPlaceHolder,
                                                                        @maxlength = field.FieldLength,
                                                                        @required = field.IsRequired ? "required" : null
                                                                    })
                                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                                    break;
                                                            }

                                                            @if (!string.IsNullOrEmpty(field.FieldHelpText))
                                                            {
                                                                <small class="form-text text-muted">@field.FieldHelpText</small>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <p>No fields available.</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p>No tabs available in this section.</p>
                            }
                        </div>}
                }
                else
                {
                    <p>No sections available.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancel" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnSave" class="btn btn-primary" onclick="SavePagefield();">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="statusCommentModel" tabindex="-1" role="dialog" aria-labelledby="statusCommentModel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="float:none;height: auto;">
        <div class="modal-content" style="height:300px;">
            <div class="modal-header">
                <h5 class="modal-title">Comment</h5>
                <button type="button" id="btnCancelComment1" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row form-group">
                    <div class="col col-md-12">
                        <label for="text-input" class="form-control-label">Enter your commnet<span class="text-danger p-1">(*)</span></label>
                    </div>
                    <div class="col col-md-12">
                        <textarea class="form-control" id="txtStatusComment" rows="6" placeholder="Enter your comment" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelComment" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="btnSubmitComment" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="showCommentsModel" tabindex="-1" role="dialog" aria-labelledby="showCommentsModelLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="max-width: 410px !important;">
        <div class="modal-content">
            <div class="modal-header cursor-move">
                <h5 class="modal-title" id="fieldInfoModelLabel">Comments</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body chat-modal-body">
                <div id="divChat" class="chat-container"></div>
                <div class="chat-input">
                    <textarea id="textMyComment" rows="2" class="form-control" placeholder="Type a message..."></textarea>
                    <button type="button" onclick="SubmitComments();" class="btn btn-primary ms-2">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="actions" class="dropdown" style="display:none;position:absolute;">
    <button id="btnApproved" data-bind="2" class="text-success" value="approved">Approved</button>
    <button id="btnNotApproved" data-bind="1" class="text-primary" value="notapproved">Not Approved</button>
    <button id="btnCancelled" data-bind="3" class="text-danger" value="cancelled">Cancelled</button>
    <button id="btnAddComment" onclick="AddComment();" data-bind="4" class="text-dark" value="comment">Add Comment</button>
</div>
<div id="PageAction" class="linkmenu" style="display: none; position: absolute">
    <a id="btnActionView" data-bind="3" class="text-black">View</a>
    <a id="btnActionEdit" data-bind="2" class="text-black">Edit</a>
    <a id="btnActionDelete" data-bind="1" class="text-black">Delete</a>
</div>
<div id="actionsDet" class="dropdown" style="display: none; position: absolute">
    <button id="btnCancelledDet" data-bind="3" class="text-danger" value="cancelled">Cancelled</button>
</div>
<script type="text/javascript">
    function AddComment() {
        $("#txtStatusComment").val("");
        $("#txtStatusComment").focus();
        $('#statusCommentModel').modal('show');
    }
    var PendingSelected = [];
    $(document).ready(function () {
        setInterval(function () {
            ShowComments();
        }, 5000);
        $("#btnCancelComment, #btnCancelComment1").click(function () {
            $('#statusCommentModel').modal('hide');
        });
        $("#btnSubmitComment").click(function () {
            try {
                var comment = $("#txtStatusComment").val();
                var model = {
                    FormId: '@Model.Design.FormId',
                    ParentId: parseInt($("#btnSubmitComment").attr("data-content")),
                    DetailId: 0,
                    CommentText: comment
                };

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddFormComment", "Transaction")",
                    data: JSON.stringify(model),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.IsSuccess) {
                            $("#btnCancelComment").click();
                            $("#txtStatusComment").val('');
                            ShowToastNotification("success", "Your comment has been submitted.");
                        } else {
                            ShowToastNotification("error", "Comment not added.");
                        }
                    },
                    error: function () {
                        ShowToastNotification("error", "Comment not added.");
                    }
                });
            } catch (e) {

            }
        });
        $("#btnSubmitCancelReason").click(function () {
            var txtreason = $("#txtCancelReason").val();
            $("#txtCancelReason").next(".validation").remove();
            $("#txtCancelReason").removeClass("input-validation-error");
            if (txtreason.length == 0) {
                $("#txtCancelReason").addClass("input-validation-error");
                $("#txtCancelReason").after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter cancel reason.</div>");
                $("#txtCancelReason").focus();
            }
            else {
                UpdateRecordStatus($("#hdnFormId").val(), 0, $("#txtCancelReason").attr("data-content"), 3, $("#txtCancelReason").val());
            }
        })
        $("#btnSubmitCancelReasonDet").click(function () {
            var txtreason = $("#txtCancelReasonDet").val();
            $("#txtCancelReasonDet").next(".validation").remove();
            $("#txtCancelReasonDet").removeClass("input-validation-error");
            if (txtreason.length == 0) {
                $("#txtCancelReasonDet").addClass("input-validation-error");
                $("#txtCancelReasonDet").after("<div class='validation' style='color:red;margin-bottom: 2px;'>Please enter cancel reason.</div>");
                $("#txtCancelReasonDet").focus();
            }
            else {
                UpdateRecordStatus($("#txtCancelReasonDet").attr("data-container"),$("#txtCancelReasonDet").attr("data-content"), $("#txtCancelReasonDet").attr("data-interval"), 3, $("#txtCancelReasonDet").val());
            }
        })
        $("#btnApproved").click(function () {
            UpdateRecordStatus($("#hdnFormId").val(), 0, $(this).attr("data-content"), 2, "");
        })
        $("#btnNotApproved").click(function () {
            UpdateRecordStatus($("#hdnFormId").val(), 0, $(this).attr("data-content"), 1, "");
        })
        $("#btnCancelled").click(function () {
            $("#txtCancelReason").val("");
            $("#txtCancelReason").attr("data-content", $(this).attr("data-content"));
            var myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
            myModal.show();
        })
        $("#btnCancelledDet").click(function () {
            $("#txtCancelReasonDet").val("");
            $("#txtCancelReasonDet").attr("data-content", $(this).attr("data-content"));
            $("#txtCancelReasonDet").attr("data-interval", $(this).attr("data-interval"));
            $("#txtCancelReasonDet").attr("data-container", $(this).attr("data-container"));

            var myModal = new bootstrap.Modal(document.getElementById('exampleModalDet'));
            myModal.show();
        })
        $("#nav-home-tab").click(function () {
            $("#btnAddNew").removeClass("disabled");
        });
        $("#nav-tab button").each(function () {
            if ($(this).attr("id").length > 0 && $(this).attr("data-bind") != undefined) {
                var tblId = $(this).attr("data-bind");
                var liCount = $(this).attr("data-interval");
