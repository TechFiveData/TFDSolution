    function CreateRecord(tableId) {
        let tableEntry = PendingSelected.find(entry => entry.TableName === tableId);
        if (!tableEntry) {
            ShowToastNotification("error", "Please select at least record");
        }
        else {
            var PendingSelectedRequest = [];
            if (PendingSelected.length > 0) {
                var firstFormTabId = PendingSelected[0].FormTabId;
                var isSameFormTab = PendingSelected.every(function (entry) {
                    return entry.FormTabId === firstFormTabId;
                });
                if (!isSameFormTab) {
                    ShowToastNotification("error", "You can not select mix page entry from pending.");
                    return false;
                }
                // All selected records belong to the same page
                PendingSelectedRequest = PendingSelected.filter(function (entry) {
                    return entry.TableName === tableId;
                });
            }

            var paramItem_SRNo = (tableEntry?.FieldValues || "");
            // Remove first comma if it exists at the beginning
            var _formTabId = (tableEntry?.FormTabId || "");
            paramItem_SRNo = paramItem_SRNo.replace(/^,/, '');
            console.log("paramItem_SRNo : " + paramItem_SRNo);
            // Split current values into array
            if ($("#" + tableId).attr("data-bind") != undefined && $("#" + tableId).attr("data-bind").length > 0) {
