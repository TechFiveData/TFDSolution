                    success: function (response) {
                        if (response != null) {
                            if (response.IsSuccess) {
                                var tablename = $("#hdnFormName").val();
                                var urlred = '@Url.Action("PageDetail","Home", new { pagename = "_pagename", uId= "_Id", act= "_act" })';
                                urlred = urlred.replace("amp;", "");
                                urlred = urlred.replace("amp;", "");
                                urlred = urlred.replace("_pagename", tablename);
                                if (response.Id > 0) {
                                    urlred = urlred.replace("_Id", response.Id);
                                    urlred = urlred.replace("_act", "E");
                                }
                                else {
                                    urlred = urlred.replace("_Id", "-1");
                                    urlred = urlred.replace("_act", "A");
