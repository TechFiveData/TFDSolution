                                $("#btnApproved").show();
                            }
                            $("#btnNotApproved").show();
                        }
                        else {
                            $("#btnNotApproved").show();
                        }
                        $("#btnApproved").attr("data-bind", currectStatus);
                        $("#btnApproved").attr("data-content", recordId);
                        $("#btnNotApproved").attr("data-bind", currectStatus);
                        $("#btnNotApproved").attr("data-content", recordId);
                        $("#btnCancelled").attr("data-bind", currectStatus);
                        $("#btnCancelled").attr("data-content", recordId);
                        $("#btnSubmitComment").attr("data-content", recordId);
                        $("#statusCommentModel .modal-title").html(urnNo + " : Comment")
                        if (actions != null) {
                            this.parentNode.append(actions);
                            const currentOffsetLeft = e.pageX;
                            const currentOffsetTop = e.pageX;
                            if (actions.style != null) {
                                const $actions = $(actions);
                                $actions.css({
                                    display: 'block',
                                    position: 'fixed',
                                    left: e.pageX + 'px',
                                    top: event.clientY + 'px'
                                });
                            }
                        }
                        // Remove with the next click on the document
                        document.addEventListener('click', function () {
                            if (actions != null) {
                                actions.remove();
                            }
                        });
                    });
                },
                error: function (response) {
                    ShowToastNotification("error", "Error fetching data!");
                }
            });
        } catch (e) {
            ShowToastNotification("error", e.message);
        }
    }
    function SubmitComments() {
        try {
            var comment = $("#textMyComment").val();
            var model = {
                FormId: '@Model.Design.FormId',
                ParentId: 0,
                DetailId: 0,
                CommentText: comment
            };
            $.ajax({
                type: "POST",
                url: "@Url.Action("AddFormComment", "Transaction")",
                data: JSON.stringify(model),
                skipLoading: true,
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.IsSuccess) {
                        $("#textMyComment").val('');
                        $("#textMyComment").focus();
                        ShowComments();
                    } else {
                        ShowToastNotification("error", "Comment not added.");
                    }
                },
                error: function () {
                    ShowToastNotification("error", "Comment not added.");
                }
            });
        } catch (e) {

        }
    }
    function ShowComments() {
        try {
            if ($("#showCommentsModel").hasClass("show")) {
                var model = {
                    FormId: '@Model.Design.FormId',
                    ParentId: 0,
                    DetailId: 0
                };
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetUserComments", "Transaction")",
                    data: JSON.stringify(model),
                    skipLoading: true,
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response != null && response.IsSuccess) {
                            loadComments(response.Data);
                        }
                    }
                });
            }
        } catch (e) {

        }
    }
    function loadComments(CommentData) {
        try {
            var objCommentId = parseInt($("#LastCommentId").val());
            for (var i = 0; i < CommentData.length; i++) {
                var obj = CommentData[i];
                if (objCommentId < obj.CommentId) {
                    $("#LastCommentId").val(obj.CommentId)
                    var html = "";
                    if (obj.IsYou) {
                        html = `<div class="chat-message right comment-animate">
                    <div class="chat-bubble">
                        <div class="chat-username">You</div>
                         <div class="chat-text ${obj.CommentText.startsWith('*') && obj.CommentText.endsWith('*') ? 'blue-text' : ''}">
                            ${obj.CommentText && obj.CommentText.startsWith('*') && obj.CommentText.endsWith('*')
                                ? obj.CommentText.slice(1, -1)
                                : obj.CommentText}
                        </div>
                        <div class="chat-meta"><span class="chat-date">${obj.CommentedOn}</span></div>
                    </div>
                </div>`;
                    } else {
                        html = `<div class="chat-message left comment-animate">
                    <div class="chat-avatar">
                        <div class="avatar-wrapper ${obj.IsLoggedIn ? 'online' : 'offline'}">
                            <div class="avatar-initials">${obj.ShortName}</div>
                            <span class="status-dot"></span>
                        </div>
                    </div>
                    <div class="chat-bubble">
                        <div class="chat-username">${obj.CreatedBy}</div>
                        <div class="chat-text">${obj.CommentText}</div>
                        <div class="chat-meta"><span class="chat-date">${obj.CommentedOn}</span></div>
                    </div>
                </div>`;
                    }
                    $("#divChat").append(html);
                }
            }
            // Auto scroll to bottom
            $("#divChat").scrollTop($("#divChat")[0].scrollHeight);
        } catch (e) {
            console.log(e);
        }
    }
</script>