    function addselectedPending(tblId, id, isChecked, formTabId) {
        // Find or create table entry
        id = id.toString();
        let tableEntry = PendingSelected.find(entry => entry.TableName === tblId && entry.FormTabId == formTabId );
        if (!tableEntry) {
            if (isChecked) {
                PendingSelected.push({ TableName: tblId, FieldValues: id, FormTabId: formTabId });
            }
            return;
        }
        else {
            const fieldValues = (tableEntry?.FieldValues || "");
            // Normalize existing values to array
            if (fieldValues != null && fieldValues.length> 0 && fieldValues.includes(',')) {
                let values = (tableEntry.FieldValues || "")
                    .split(',')
                    .map(v => v.trim())
                    .filter(v => v !== "");

                // Update values array
                if (isChecked) {
                    if ($.inArray(id, values) == -1) { values.push(id) };
                } else {
                    values = values.filter(val => val !== id);
                }
                if (values != null && values.length > 0) {
                    tableEntry.FieldValues = values.join(',');
                }
                else {
                    tableEntry.FieldValues = '';
                }
            }
            else {
                if (isChecked) {
                    if (tableEntry.FieldValues != id) {
                        tableEntry.FieldValues = tableEntry.FieldValues + "," + id;
                    }
                    else {
                        tableEntry.FieldValues = id;
                    }
                } else if (tableEntry.FieldValues == id) {
                    tableEntry.FieldValues = "";
                }
            }
            PendingSelected = PendingSelected.filter(
                entry => entry.FieldValues != null &&
                    entry.FieldValues.toString().trim() !== ""
            );
            // Save back to FieldValues as comma-separated string
        }
    }
