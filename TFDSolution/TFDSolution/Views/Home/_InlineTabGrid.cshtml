<script type="text/javascript">

    var columnNames = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.FormFields
        .Where(x => x.IsVisibleInList == true)
        .OrderBy(x => x.SortOrder)
        .Select(x => new {x.FieldName,x.FieldCaption,x.IsSummary}).ToList()));
    var hasSummary = $.grep(columnNames, function (item) {
        return item.IsSummary === true;
    }).length > 0;
    var tableName = '@tabGrid';
    if (hasSummary) {
        // do something
        if ($('#' + tableName + ' tfoot').length === 0) {
            let footer = '<tfoot><tr>';
            columnNames.forEach(() => footer += '<th></th>');
            footer += '</tr></tfoot>';
            $('#' + tableName).append(footer);
        }
    }
    new DataTable('#@tabGrid', {
        searching: false, paging: false, info: false,
        // 🚀 SUMMARY FOOTER
        footerCallback: function (row, data, start, end, display) {

            if (!hasSummary || !columnNames || columnNames.length === 0) return;

            let api = this.api();

            // ✅ Safe numeric conversion
            let num = function (val) {
                if (val === null || val === undefined || val === '') return 0;

                if (typeof val === 'string') {
                    val = val.replace(/[^0-9.-]+/g, ''); // handles ₹, commas etc
                }

                val = parseFloat(val);
                return isNaN(val) ? 0 : val;
            };

            // ✅ Label
            $(api.column(0).footer()).html('<b>Summary</b>');

            api.columns().every(function (idx) {
                /* 🔹 1. Always skip fixed columns */
                //if (idx === 0) return;

                let column = this;
                // 🔹 Get column data key (VERY IMPORTANT)
                let colName = column.dataSrc();
                if (!colName) return;
                // 🔹 Find config by FieldName
                let config = columnNames[idx];
                if (!config || config.IsSummary !== true) return;
                let footerCell = api.column(column.index() + 1).footer();
                try {
                    if (columnNames[idx].ColumnTitle == "Amount"
                        || columnNames[idx].ColumnName == "Amount") {
                        let colData = api.rows().data().pluck('Amount').toArray();
                        let total = colData.reduce((sum, v) => sum + num(v), 0);
                        if (footerCell) {
                            $(footerCell).html(total ? total.toFixed(2) : '0');
                        }
                    }
                    else {
                        let colData = this.data().toArray();
                        let colDatar = api.rows().data().toArray();
                        if (!colData.length) return;
                        try {
                            // get all row data
                            let rows = api.rows().data().toArray();
                            // get only current column values
                            let colDatar = rows.map(r => r[colName+1]);
                            let totalr = colDatar.reduce((sum, v) => {
                                return sum + num(v);
                            }, 0);

                            let total = colDatar.reduce((sum, v) => {
                                // convert to string safely
                                let value = $('<div>').html(v || '').text();
                                // Clean numeric value
                                value = value
                                    .replace(/,/g, '')
                                    .replace(/[^\d.-]/g, '');
                                value = parseFloat(value);
                                if (isNaN(value))
                                    value = 0;
                                return sum + value;
                            }, 0);
                            if (footerCell) {
                                $(footerCell).html(total ? total.toFixed(2) : '0');
                            }
                        } catch (e) {
                            if (footerCell) {
                                $(footerCell).html('0');
                            }
                        }
                    }
                } catch (e) {
                    if (footerCell) {
                        $(footerCell).html('0');
                    }
                }
            });
        }
    });
    function selectInlinChange(ctrl) {
        let selectId = $(ctrl).attr("id");
        var $row = $(ctrl).closest('tr');
        BindInlineDependency(selectId, true, $row);
    }
    function InitalizeSelect($select) {
        let selectId = $($select).attr('id');
        if (selectId) {
            try {
                let parentWrapper = $($select).parent();
                var sourceType = $($select).attr("data-sourcetype");
                if (sourceType != "StoredProcedure") {
                    var _fieldId = $($select).attr("data-container");
                    let selectedValues = $($select).attr("data-interval");
                    let selectedText = $($select).attr("data-display");
                    let firstFive = selectedText ? selectedText.substring(0, 20) : "";
                    $($select).select2({
                         dropdownParent: parentWrapper,
                         placeholder: 'Search...',
                         allowClear: true,
                         delay: 250,
                         dropdownParent: $('body'),
                         minimumInputLength: 0, // change to 0 if you want scrolling without typing
                         ajax: {
                             url: '@Url.Action("FillSelctionPagingDefault", "Common")',
                             dataType: 'json',
                             type: 'GET',
                             delay: 250,
                             skipLoading: true,
                             width: '100%', // 🔥 This is key to match the column width
                             data: function (params) {
                                 return {
                                     FieldId: _fieldId,
                                     CompanyId: $("#hdntabCompanyId").val(),
                                     searchTerm: params.term || '', // search term
                                     page: params.page || 1,
                                     fieldValue: ''
                                 };
                             },
                             processResults: function (data) {
                                 return {
                                     results: data.results,
                                     pagination: {
                                         more: data.pagination.more
                                     }
                                 };
                             },
                             error: function (xhr, status, error) {
                                 console.error("Select2 AJAX Error:", error);
                                 console.error("Status:", status);
                                 console.error("Response:", xhr.responseText);
                             },
                             cache: true
                         }
                    });
                    /// Pre-load selected values (important when editing)
                    if (selectedValues.length) {
                        $.ajax({
                            url: '@Url.Action("FillSelctionPagingDefault", "Common")',
                            type: 'GET',
                            skipLoading: true,
                            data: { FieldId: _fieldId, CompanyId: $("#hdntabCompanyId").val(), searchTerm: firstFive, page: 1, fieldValue: '' },
                            success: function (data) {
                                var isMultiSelection = $(this).attr("data-multiselection");
                                if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                    selectedValues.forEach(function (val) {
                                        let item = data.results.find(x => x.id == val);
                                        if (item) {
                                            let option = new Option(item.text, item.id, true, true);
                                            $($select).append(option);
                                        }
                                    });
                                }
                                else {
                                    if (data != null && data.results != null) {
                                        let item = data.results.find(x => x.id == selectedValues);
                                        if (item) {
                                            let option = new Option(item.text, item.id, true, true);
                                            $($select).append(option).trigger('change');
                                        }
                                    }
                                }
                                $($select).trigger('change');
                            }
                        });
                    }
                    const $input = $($select);
                    if ($input.hasClass("d-none")) {
                        $input.next().addClass('d-none');
                    }
                }
            } catch (e) {
             console.error("Select2 Inline Form:", e);
            }
        }
    }
    $(document).off("keydown.inlineForm").on("keydown.inlineForm", ".InlineForm input, .InlineForm select", function (e) {
        if (e.key === "Tab") {
            try {
                let $current = $(this);
                const $row = $current.closest("tr");  // current row
                let $focusable = $row.find("input:not([readonly]):not([disabled]), select:not([disabled])").filter(":visible");
                let index = $focusable.index($current);
                var input_field = $current.attr("id");
                var tableId = $row.closest('table').attr("data-bind");
                BindInlineDependency(input_field, false, $row);
                //console.log("Left last editable column in row:" + index);
                if (index > -1) {
                    e.preventDefault();
                    let next = $focusable.eq(index + 1);
                    if (next.length) {
                        next.focus();
                    }
                    else {
                        var tabSQLTable = $row.attr("data-bind");
                        if (tabSQLTable && tabSQLTable != null && tabSQLTable != "") {
                            let detailId = $row.attr("data-id");
                            //detailId = $("#@tabGrid tbody tr").eq(0).data("id");
                            InlineSaveRecord($row, tabSQLTable, detailId);
                            const nextRow = $row.next("tr");
                            if (nextRow.length > 0) {
                                let next$focusable = nextRow.find("input:not([readonly]):not([disabled]), select:not([disabled])").filter(":visible");
                                let nextfo = next$focusable.eq(0);
                                if (nextfo.length) {
                                    nextfo.focus();
                                }
                            }
                            else {
                                let isLastRow = $row.is(":last-child");
                                if (isLastRow) {
                                    console.log('Last Row');
                                   if (parseInt('@Model.IsDefault', 0) !== 1) {
                                        InlinTabData(0, 'A', tableId, '@tabGrid');
                                    }
                                }
                            }
                        }
                        console.log("Next editable column Not available:");
                        e.stopPropagation();
                        return;
                    }
                }
            } catch (e) {

            }
        }
    });
    $('#@tabGrid').on('blur', 'tr :input', function () {
        try {
            var $input = $(this);
            var fieldvalue = $input.val();
            var input_field = $input.attr("id");
            /*console.log("Left field: " + fieldName + " with value: " + value);*/
            var $row = $input.closest('tr');
            // Now get other input values in the same row
            // Loop through all inputs in the row
            $row.find('input').each(function () {
                var fieldId = $(this).attr("id");
                var fieldformula = $(this).attr("data-path");
                var fielddecimal = $(this).attr("data-decimal");
                if (fieldformula != undefined && fieldformula != null && fieldformula != "") {
                    if (input_field != fieldId) {
                        $row.find('input').each(function () {
                            if ($(this).attr("data-bind") != null && $(this).attr("data-bind").length > 0) {
                                if ($(this).val() != null && $(this).val().length == 0) {
                                    fieldformula = fieldformula.replaceAll("{" + $(this).attr("data-bind").replace("inline_", "") + "}", 0);
                                }
                                else {
                                    fieldformula = fieldformula.replaceAll("{" + $(this).attr("data-bind").replace("inline_", "") + "}", $(this).val());
                                }
                            }
                        });
                        try {
                            //console.log(fieldId + " - Field Formula With Value : " + fieldformula);
                            let decimPoint = 2;
                            if (fielddecimal != undefined && fielddecimal != null) {
                                decimPoint = parseInt(fielddecimal);
                            }
                            var calFieldValue = parseFloat(eval(fieldformula)).toFixed(decimPoint);
                            //console.log(fieldId + " - Field Formula With Value : " + calFieldValue);
                            $(this).val(calFieldValue);
                        } catch (e) {
                            console.log(fieldId + " - Field Formula With Value - Exception " + e.message);
                            $(this).val(0);
                        }
                    }
                }
            });

        } catch (e) {}
    });
    $('#@tabGrid').on('focusout', 'tr :input[type="text"]', function () {
        try {
            var $input = $(this);
            var $row = $input.closest('tr');
            if($(this).attr("data-language") == "True") {

                var fieldvalue = $input.val();
                var input_field = $input.attr("id");
