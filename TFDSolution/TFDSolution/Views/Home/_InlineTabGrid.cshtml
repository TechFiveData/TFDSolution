@model TFDSolution.Transport.Master.PageTabModel
@{
    string tabGrid = "tbl" + Model.Design.TabName;
}
<input type="hidden" value="@Convert.ToString(Model.CompanyId)" id="hdntabCompanyId" />
<input type="hidden" value="@Convert.ToString(Model.UserId)" id="hdntabUserId" />
<input type="hidden" value="@Model.FinancialYearId" id="hdntabFinancialYearId" />
<script src="~/Scripts/select2.min.js"></script>
<table id="@tabGrid" data-bind="@Model.Design.FormTabId" class="table table-bordered InlineForm" cellspacing="0" width="100%" style="border:1px solid #ccc;">
    <thead>
        <tr>
            @if (Model.PageAction != "V" && Model.IsDefault != 1)
            {
                <th style="min-width:50px !important;"></th>
            }
            <th class="grid-action-item-bg text-center">#</th>
            @foreach (var field in Model.FormFields.Where(x => x.IsVisibleInList == true).OrderBy(x => x.SortOrder).ToList())
            {
                if (field.IsRequired)
                {
                    <th style="min-width:100px;" title="This field is required.">
                        @field.FieldCaption
                        <span class="text-danger">*</span>
                    </th>
                }
                else if (field.FieldType == "Selection")
                {
                    <th style="min-width:200px !important;">@field.FieldCaption</th>
                }
                else if (field.FieldType == "Button")
                {
                    <th style="min-width:60px !important;">@field.FieldCaption</th>
                }
                else
                {
                    <th style="min-width:100px;">@field.FieldCaption</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Data != null && Model.Data.Count() > 0)
            {
                foreach (var _it in Model.Data)
                {
                    object srvalue;
                    string srNumber = "1", _Id = ""; ;
                    if (_it.TryGetValue("SrNo", out srvalue))
                    {
                        srNumber = Convert.ToString(srvalue);
                    }
                    if (_it.TryGetValue("Id", out srvalue))
                    {
                        _Id = Convert.ToString(srvalue);
                    }
                    <tr data-id="@_Id" data-bind="@Model.Design.TabSQLTableName">
                        @if (Model.PageAction != "V" && Model.IsDefault != 1)
                        {
                            <td class="text-center" style="vertical-align:middle;">
                                <a title='Save Record' data-bind="@Model.Design.TabSQLTableName" data-content="@_Id" class="text-success btn-save"
                                   href='javascript:void(0)'>
                                    <i class="fa fa-save"></i>
                                </a>&nbsp;
                                <a title='Delete Record' data-bind="@Model.Design.TabSQLTableName"
                                   data-content="@_Id" class="text-danger btn-delete" href='javascript:void(0)'>
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        }
                        <td style="background: aliceblue !important; text-align: center; vertical-align: middle">
                            <label tabindex="-1" for="ItemSrNo" class="form-control-label">@srNumber</label>
                            <input style="display:none" value="@srNumber" id="ItemSrNo" data-bind="ItemSrNo" data_content="TextBox" disabled class="form-control w-25" />
                        </td>
                        @foreach (var field in Model.FormFields.Where(x => x.IsVisibleInList == true).OrderBy(x => x.SortOrder).ToList())
                        {
                            var _fieldValue = field.FieldValue; object value;
                            if (Model.IsDefault == 1 && field.FieldType != "Numeric")
                            {
                                field.IsDisable = true;
                                field.IsReadOnly = true;
                            }
                            bool isReadOnlyOrDisabled = (field.IsReadOnly ?? false) || (field.IsDisable ?? false);
                            if (_it.TryGetValue(field.FieldName, out value))
                            {
                                field.FieldValue = Convert.ToString(value);
                            }
                            string ctrlId = tabGrid + "inline_" + Convert.ToString(field.FieldName) + "_" + srNumber;
                            string isButtonClass = field.FieldType == "Button" ? "text-center" : "";
                            string tabIndexAttr = isReadOnlyOrDisabled ? "-1" : null;
                            <td class="@isButtonClass" tabindex="@tabIndexAttr">
                                @switch (field.FieldType)
                                {
                                    case "TextBox":
                                        if (Model.PageAction != "V")
                                        {
                                            if (isReadOnlyOrDisabled)
                                            {
                                                <input type="text" id="@ctrlId" value="@field.FieldValue" readonly="readonly" tabindex="-1" data-container="@field.FieldId" data-language="@field.IsLanguage" data-path="@field.FieldFormula" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                            }
                                            else
                                            {
                                                <input type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula" data-container="@field.FieldId" data-language="@field.IsLanguage" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "Numeric":
                                        if (Model.PageAction != "V")
                                        {
                                            if (isReadOnlyOrDisabled)
                                            {
                                                <input type="number" value="@field.FieldValue" readonly="readonly" tabindex="-1" data-path="@field.FieldFormula" data-decimal=@field.FieldDecimal id="@ctrlId" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                            }
                                            else
                                            {
                                                <input type="number" value="@field.FieldValue" data-path="@field.FieldFormula" id="@ctrlId" class="form-control edit" data-decimal=@field.FieldDecimal @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "DateTimeField":
                                        bool IsTime = false;
                                        if (!string.IsNullOrEmpty(field.FieldValue))
                                        {
                                            try
                                            {
                                                DateTime _dt = Convert.ToDateTime(field.FieldValue);
                                                if (_dt == new DateTime(1900, 1, 1))
                                                {
                                                    field.FieldValue = "";
                                                }
                                                else if (_dt.TimeOfDay != TimeSpan.Zero)
                                                {
                                                    field.FieldValue = _dt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                                                    IsTime = true;
                                                }
                                                else
                                                {
                                                    field.FieldValue = _dt.ToString("yyyy-MM-dd");
                                                }
                                                //field.FieldValue = (_dt == new DateTime(1900, 1, 1, 0, 0, 0)) ? "" : _dt.ToString("yyyy-MM-dd"); ;
                                                if (Model.PageAction == "V" || Model.IsDefault == 1)
                                                {
                                                    <label tabindex="-1" class="view">@field.FieldValue</label>
                                                    @*if (!string.IsNullOrEmpty(field.FieldValue))
                            {
                                @Html.TextBox(field.FieldName, field.FieldValue, new { type = "date", @class = "form-control", @data_content = "DateTimeField", dat_html = @field.FieldCaption, data_bind = field.FieldName })
                            }
                            else
                            {
                                @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, @placeholder = "", data_content = field.FieldType, data_bind = field.FieldName, @type = "text" })
                            }*@
                                                }
                                            }
                                            catch (Exception)
                                            {
                                                @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, @placeholder = "", data_content = field.FieldType, data_bind = field.FieldName, @type = "text" })
                                            }
                                        }
                                        else if (Model.PageAction == "V")
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        if (Model.PageAction == "E" || Model.PageAction == "A")
                                        {
                                            if (field.IsRequired)
                                            {
                                                @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @required = field.IsRequired == true ? "required" : null })
                                            }
                                            else if (field.IsReadOnly == true)
                                            {
                                                @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @readonly = "readonly" })}
                                            else
                                            {
                                                if (IsTime)
                                                {
                                                    @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "datetime_local" })
                                                }
                                                else
                                                {
                                                    @Html.TextBox(field.FieldName, field.FieldValue, new { @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date" })
                                                }
                                            }
                                            @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                        }
                                        @*if (Model.PageAction != "V")
                {
                    if (isReadOnlyOrDisabled)
                    {
                        <input type="date" id="@ctrlId" value="@field.FieldValue" readonly="readonly" tabindex="-1" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                    }
                    else
                    {
                        <input type="date" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                    }
                }
                else
                {
                    <label tabindex="-1" class="view">@field.FieldValue</label>
                }*@
                                        break;
                                    case "MultiText":
                                        if (Model.PageAction != "V")
                                        {
                                            if (isReadOnlyOrDisabled)
                                            {
                                                <input type="text" id="@ctrlId" value="@field.FieldValue" readonly="readonly" tabindex="-1" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                            }
                                            else
                                            {
                                                <input type="text" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "TimeField":
                                        if (Model.PageAction != "V")
                                        {
                                            if (isReadOnlyOrDisabled)
                                            {
                                                <input type="time" id="@ctrlId" value="@field.FieldValue" readonly="readonly" tabindex="-1" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                            }
                                            else
                                            {
                                                <input type="time" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "CheckBox":
                                        if (Model.PageAction != "V")
                                        {
                                            <input type="checkbox" id="@ctrlId" value="@field.FieldValue" @(isReadOnlyOrDisabled ? "disabled='disabled' tabindex=\"-1\"" : "") class="form-check edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "Label":
                                        <label tabindex="-1" class="form-label" id="@ctrlId" data-bind="@field.FieldName">@field.FieldValue</label>
                                        break;
                                    case "Selection":
                                        if (Model.PageAction != "V")
                                        {
                                            var _fieldText = field.FieldValue;
                                            if (_it.TryGetValue(field.FieldName + "_Id", out srvalue))
                                            {
                                                _fieldValue = Convert.ToString(srvalue);
                                            }
                                            if (field.IsRequired)
                                            {
                                                <select onchange="selectInlinChange(this)" required class="form-select select2 form-control selectpicker edit"
                                                        style="width:100%; min-width:200px !important;" data-display="@_fieldText"
                                                        data-sourcetype="@field.DDLSourceType"
                                                        @(isReadOnlyOrDisabled ? "disabled='disabled' tabindex=\"-1\"" : "")
                                                        data-multiselection="@field.IsMultiSelection" data-live-search="true"
                                                        data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField"
                                                        data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@ctrlId"
                                                        data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName"
                                                        data-content="@field.FieldType">
                                                </select>
                                            }
                                            else
                                            {
                                                <select onchange="selectInlinChange(this)" class="form-select select2 form-control selectpicker edit"
                                                        style="width:100%; min-width:200px !important;" data-display="@_fieldText"
                                                        data-sourcetype="@field.DDLSourceType"
                                                        @(isReadOnlyOrDisabled ? "disabled='disabled' tabindex=\"-1\"" : "")
                                                        data-multiselection="@field.IsMultiSelection" data-live-search="true"
                                                        data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField"
                                                        data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@ctrlId"
                                                        data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName"
                                                        data-content="@field.FieldType">
                                                </select>
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                    case "Button":
                                        <a class="btn btn-primary mt-1" href="javascript:void(0)"
                                           onclick="FieldButtonViewModelInline(@_Id, '@field.FieldId','@field.FieldName.Trim()','@field.FieldCaption','@field.DDLValueField', this, '@field.TemplateId'); return false;"
                                           title="@field.FieldHelpText"><i class="fa fa-ellipsis-h"></i></a>
                                        break;
                                    default:
                                        if (Model.PageAction != "V")
                                        {
                                            if (isReadOnlyOrDisabled)
                                            {
                                                <input type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula"
                                                       class="form-control edit" @(field.IsRequired == true ? "required" : null)
                                                       readonly="readonly" tabindex="-1"
                                                       data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength"
                                                       data-bind="@field.FieldName" />
                                            }
                                            else
                                            {
                                                <input onchange="selectInlinChange(this)" type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula"
                                                       class="form-control edit" @(field.IsRequired == true ? "required" : null)
                                                       data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength"
                                                       data-bind="@field.FieldName" />
                                            }
                                        }
                                        else
                                        {
                                            <label tabindex="-1" class="view">@field.FieldValue</label>
                                        }
                                        break;
                                }
                            </td>
                        }
                    </tr>
                }
            }
            else if (Model.PageAction != "V")
            {
                <tr data-id="0" data-bind="@Model.Design.TabSQLTableName">
                    <td class="text-center" style="vertical-align:middle;">
                        <a title='Save Record' data-bind="@Model.Design.TabSQLTableName" data-content="0" class="text-success btn-save"
                           href='javascript:void(0)'>
                            <i class="fa fa-save"></i>
                        </a>&nbsp;
                        <a title='Delete Record' data-bind="@Model.Design.TabSQLTableName" data-content="0" class="text-danger btn-delete"
                           href='javascript:void(0)'>
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                    <td style="background: #fff !important; text-align: center; vertical-align: middle">
                        <label tabindex="-1" for="ItemSrNo" class="form-control-label">1</label>
                        <input style="display:none" value="1" id="ItemSrNo" data-bind="ItemSrNo" data_content="TextBox" disabled class="form-control w-25" />
                    </td>
                    @foreach (var field in Model.FormFields.Where(x => x.IsVisibleInList == true).OrderBy(x => x.SortOrder).ToList())
                    {
                        var _fieldValue = field.FieldValue;
                        bool isReadOnlyOrDisabled = (field.IsReadOnly ?? false) || (field.IsDisable ?? false);
                        string ctrlId = tabGrid + "_inline_" + Convert.ToString(field.FieldName);
                        string isButtonClass = field.FieldType == "Button" ? "text-center" : "";
                        string tabIndexAttr = isReadOnlyOrDisabled ? "-1" : null;
                        <td class="@isButtonClass" tabindex="@tabIndexAttr">
                            @switch (field.FieldType)
                            {
                                case "TextBox":
                                    if (Model.PageAction != "V")
                                    {
                                        if (isReadOnlyOrDisabled)
                                        {
                                            <input type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula" data-container="@field.FieldId" data-language="@field.IsLanguage" readonly="readonly" tabindex="-1" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <input type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula" data-container="@field.FieldId" data-language="@field.IsLanguage" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "Numeric":
                                    if (Model.PageAction != "V")
                                    {
                                        if (isReadOnlyOrDisabled)
                                        {
                                            <input type="number" value="@field.FieldValue" data-path="@field.FieldFormula" id="@ctrlId" readonly="readonly" tabindex="-1" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <input type="number" value="@field.FieldValue" data-path="@field.FieldFormula" id="@ctrlId" class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "Button":
                                    <a class="btn btn-primary mt-1" href="javascript:void(0)"
                                       onclick="FieldButtonViewModelInline(0, '@field.FieldId','@field.FieldName.Trim()','@field.FieldCaption', '@field.DDLValueField', this, '@field.TemplateId'); return false;"
                                       title="@field.FieldHelpText"><i class="fa fa-ellipsis-h"></i></a>
                                    break;
                                case "DateTimeField":
                                    if (Model.PageAction != "V")
                                    {
                                        if (isReadOnlyOrDisabled)
                                        {
                                            <input type="date" id="@ctrlId" value="@field.FieldValue" class="form-control edit" readonly="readonly" tabindex="-1" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <input type="date" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "MultiText":
                                    if (Model.PageAction != "V")
                                    {
                                        if (isReadOnlyOrDisabled)
                                        {
                                            <input type="text" id="@ctrlId" value="@field.FieldValue" class="form-control edit" readonly="readonly" tabindex="-1" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <input type="text" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "TimeField":
                                    if (Model.PageAction != "V")
                                    {
                                        if (isReadOnlyOrDisabled)
                                        {
                                            <input type="time" id="@ctrlId" value="@field.FieldValue" class="form-control edit" readonly="readonly" tabindex="-1" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                        else
                                        {
                                            <input type="time" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "CheckBox":
                                    if (Model.PageAction != "V")
                                    {
                                        <input type="checkbox" id="@ctrlId" value="@field.FieldValue" class="form-check edit" @(isReadOnlyOrDisabled ? "disabled='disabled'" : null) data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                case "Label":
                                    <label tabindex="-1" class="form-label" id="@ctrlId" data-bind="@field.FieldName">@field.FieldValue</label>
                                    break;
                                case "Selection":
                                    if (Model.PageAction != "V")
                                    {
                                        var _fieldText = field.FieldValue;
                                        if (Model.Data != null && Model.Data != null)
                                        {
                                            foreach (var _prj in Model.Data)
                                            {
                                                object fvalue;
                                                if (_prj.TryGetValue((field.FieldName + "_Id").ToUpper(), out fvalue))
                                                {
                                                    _fieldValue = Convert.ToString(fvalue);
                                                }
                                            }
                                        }
                                        if (field.IsRequired)
