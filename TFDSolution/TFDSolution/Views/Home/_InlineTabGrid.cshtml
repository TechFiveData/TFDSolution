                type: "POST",
                url: '@Url.Action("PartialDetailButton", "Home")',
                contentType: "application/json;",
                data: JSON.stringify(model),
                skipLoading: true, // <-- Custom flag
                async: false,
                success: function (response) {
                    if (response != null) {
                        $("#divDetailButtonView").html(response);
                    }
                },
                failure: function (response) { },
                error: function (response) { }
            });
            var myModal = new bootstrap.Modal(document.getElementById('FieldButtonModel'));
            myModal.show();
        } catch (e) {
            console.log(e);
        }
    }
    function BindInlineLanguageConversation(fieldId, FieldValue, row) {
        try {
            $.ajax({
                url: '@Url.Action("getLanguageConversation", "Transaction")',
                type: 'GET',
                data: { fieldId: fieldId, fieldValue: FieldValue },
                success: function (response) {
                    if (response && response.length > 0) {
                        $.each(response, function (index, item) {
                            var $element = $row.find('input[id="' + item.FieldName + '"]');
                            // Check if element exists
                            if ($element.length > 0) {
                                $element.val(item.FieldValue);
                            }
                        });
                    }
                },
                error: function (err) {
                    console.log("Error:", err);
                }
            });

        } catch (e) {
            console.log("Exception:", e);
        }
    }
</script>