                                                    data-live-search="true" data-wrap="@field.DDLTextField"
                                                    data-spy="@field.DDLValueField" data-delay="@field.DDLSourceName" data-interval="@_fieldValue"
                                                    id="@ctrlId" data-container="@field.FieldId" data-html="@field.FieldCaption"
                                                    data-bind="@field.FieldName" data-content="@field.FieldType">
                                            </select>
                                        }
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                                default:
                                    if (Model.PageAction != "V")
                                    {
                                        <input type="text" id="@ctrlId" value="@field.FieldValue" data-path="@field.FieldFormula" @(isReadOnlyOrDisabled ? "disabled='disabled'" : null) class="form-control edit" @(field.IsRequired == true ? "required" : null) data-content="@field.FieldType" data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                    }
                                    else
                                    {
                                        <label tabindex="-1" class="view">@field.FieldValue</label>
                                    }
                                    break;
                            }
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
