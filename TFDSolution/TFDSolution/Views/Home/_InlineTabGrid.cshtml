    function getInlineFieldData(row) {
        var PageFieldData = [];
        row.find("input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val()
                    });
                }
            }
        });
        row.find("textarea").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val()
                    });
                }
            }
        });
        row.find("select").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: row.find("#" + $(this).attr("id") + "  option:selected").text()
                    });
                    var selectval = $(this).val();
                    if ($(this).val() == null) {
                        selectval = row.find("#" + $(this).attr("id")).attr("data-interval");
                    }
                    PageFieldData.push({
                        FieldName: fieldId + "_Id",
                        FieldValue: selectval
                    });
                }
            }
        });
        return PageFieldData;
    }
    //Dependency
    function BindInlineDependency(_fromFieldName, IsSelect, row) {
        var loadname = _fromFieldName.replace('_Id', '');
        //$('#' + loadname + '_select-loader').show();
        /*console.log("Call Dependency = " + '#' + loadname + '_select-loader');*/
        var PageFieldData = [];
        row.find("input").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val()
                    });
                }
            }
        });
        row.find("textarea").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: $(this).val()
                    });
                }
            }
        });
        row.find("select").each(function () {
            if ($(this) != undefined && $(this) != null && $(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                var fieldId = $(this).attr("data-bind");
                if (fieldId != null && fieldId != undefined && fieldId.length > 0) {
                    PageFieldData.push({
                        FieldName: fieldId,
                        FieldValue: row.find("#"+ $(this).attr("id") + "  option:selected").text()
                    });
                    var selectval = $(this).val();
                    if ($(this).val() == null) {
                        selectval = row.find("#" + $(this).attr("id")).attr("data-interval");
                    }
                    PageFieldData.push({
                        FieldName: fieldId + "_Id",
                        FieldValue: selectval
                    });
                }
            }
        });

        try {
            var tableId = row.closest('table').attr("data-bind");
            var tablename = '@Model.Design.TabSQLTableName';
            var _FromFieldName = row.find('#' + _fromFieldName + '').attr("data-bind");
            if (IsSelect) {
                _FromFieldName = _FromFieldName + "_Id";
            }
            var recordId = row.data("id");
            var model = {
                PageTablename: tablename,
                FieldData: PageFieldData,
                FromFieldName: row.find('#' + _fromFieldName + '').attr("data-bind")+"_Id",
                Id: recordId,
                ParentId: parseInt($("#hdnRecordId").val()),
                PageType: "Detail",
                FormId: '@Model.Design.FormId',
                TabId: tableId,
                FieldId: row.find('#' + _fromFieldName + '').attr("data-container"),
                CompanyId: '@Convert.ToString(Model.CompanyId)',
                UserId: '@Convert.ToString(Model.UserId)',
                FiancialYearId: $("#hdntabFinancialYearId").val()
            }
             $.ajax({
                 type: "POST", url: '@Url.Action("getDependencyData", "Default")',
                 contentType: "application/json;",
                 skipLoading: true, // <-- Custom flag
                 data: JSON.stringify(model),
                 async: false,
                 success: function (response) {
                     if (response != null && response != undefined && response.length > 0) {
                         $.each(response, function (index, item) {
                             var element = row.find('[data-bind="' + item.FieldName + '"]');
                             if (element != undefined && element.length > 0) {
                                 var dataset = item.FieldValue;
                                 if (element[0].localName == "label") {
                                     row.find('[data-bind="' + item.FieldName + '"]').removeClass("text-success");
                                     row.find('[data-bind="' + item.FieldName + '"]').addClass("text-danger");
                                     if (dataset != null && dataset != undefined && dataset.length > 0) {
                                         $.each(dataset, function (index, Dataitem) {
                                             if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                 row.find('[data-bind="' + item.FieldName + '"]').addClass("text-success");
                                                 row.find('[data-bind="' + item.FieldName + '"]').removeClass("text-danger");
                                                 element.text(Dataitem.FieldValue);
                                             }
                                             else {
                                                 element.text('N/A');
                                             }
                                         });
                                     }
                                     else {
                                         element.text('N/A');
                                     }
                                 }
                                 else if (element[0].localName == "input") {
                                     if (dataset != null && dataset != undefined && dataset.length > 0) {
                                         //if (element[0].type == "text") {
                                         //    element.val('');
                                         //}
                                         //else if (element[0].type == "number") {
                                         //    element.val('');
                                         //}
                                         $.each(dataset, function (index, Dataitem) {
                                             if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                 if (element[0].type == "text") {
                                                     if (Dataitem.FieldValue != null && Dataitem.FieldValue != "" && Dataitem.FieldValue != "0") {
                                                         element.val(Dataitem.FieldValue);
                                                     }
                                                 }
                                                 else if (element[0].type == "number") {
                                                     if (Dataitem.FieldValue != null && Dataitem.FieldValue != "" && Dataitem.FieldValue != "0") {
                                                         element.val(Dataitem.FieldValue);
                                                     }
                                                 }
                                             }
                                         });
                                     }
                                 }
                                 else if (element[0].localName == "textarea") {
                                     if (dataset != null && dataset != undefined && dataset.length > 0) {
                                         element.val('');
                                         $.each(dataset, function (index, Dataitem) {
                                             if (Dataitem.FieldValue != null && Dataitem.FieldValue.length > 0) {
                                                 element.val(Dataitem.FieldValue);
                                             }
                                         });
                                     }
                                 }
                                 else if (element[0].localName == "select" && (loadname != row.find('[data-bind="' + item.FieldName + '"]').attr("Id"))) {
                                     if (dataset != null && dataset != undefined && dataset.length > 0) {
                                         var DDLTextField = row.find('[data-bind="' + item.FieldName + '"]').attr("data-wrap");
                                         var DDLValueField = row.find('[data-bind="' + item.FieldName + '"]').attr("data-spy");
                                         var _fieldCaption = "Option";
                                         //if (row.find('#' + item.FieldName) != null
                                         //    && row.find('#' + item.FieldName) != undefined
                                         //    && row.find('#' + item.FieldName).parent().find("label") != undefined) {
                                         //    _fieldCaption = $row.find('#' + item.FieldName).parent().find("label").text();
                                         //}
                                         var dropdown = row.find('[data-bind="' + item.FieldName + '"]');
                                         dropdown.empty();
                                         dropdown.append('<option value="">Search..</option>');

                                         var optionItem = "";
                                         var optionItemValue = "";
                                         var selectedVal = false;
                                         var addItem = false;
                                         for (var irow = 0; irow < dataset.length; irow++) {
                                             if (DDLTextField == DDLValueField) {
                                                 optionItem = dataset[irow].FieldValue;
                                                 optionItemValue = dataset[irow].FieldValue;
                                                 addItem = true;
                                             }
                                             else {
                                                 if (dataset[irow].FieldName == DDLTextField) {
                                                     optionItem = dataset[irow].FieldValue;
                                                 }
                                                 else if (dataset[irow].FieldName == DDLValueField) {
                                                     optionItemValue = dataset[irow].FieldValue;
                                                 }
                                             }
                                             if (irow % 2 || addItem) {
                                                 var fieldvalue = row.find('[data-bind="' + item.FieldName + '"]').attr("data-interval");
                                                 if (fieldvalue != null && fieldvalue != "" && fieldvalue == optionItemValue) {
                                                     selectedVal = true;
                                                     dropdown.append($('<option selected></option>').val(optionItemValue).text(optionItem));
                                                 }
                                                 else {
                                                     if (dataset.length == 2) {
                                                         selectedVal = false;
                                                         dropdown.append($('<option selected></option>').val(optionItemValue).text(optionItem));
                                                     }
                                                     else {
                                                         dropdown.append($('<option></option>').val(optionItemValue).text(optionItem));
                                                     }
                                                 }
                                             }
                                         }
                                         let $select = row.find('[data-bind="' + item.FieldName + '"]');
                                         if ($select.hasClass('select2-hidden-accessible')) {
                                             $select.select2('destroy');
                                         }

                                         if (selectedVal == false && dataset.length > 0) {
                                             $select.prop('selectedIndex', 1);
                                         }

                                         $select.select2({
                                             width: '100%',
                                             dropdownParent: $('body'),
                                             placeholder: 'Select-1'
                                         });
                                     }
                                     else {
                                         dropdown.empty();
                                     }
                                 }
                             }
                         });
                     }
                 },
                 failure: function (response) { $('#' + loadname + '_select-loader').hide(); },
                 error: function (response) { $('#' + loadname + '_select-loader').hide(); }
             });
        } catch (e) {
            $('#' + loadname + '_select-loader').hide();
        }
    }
