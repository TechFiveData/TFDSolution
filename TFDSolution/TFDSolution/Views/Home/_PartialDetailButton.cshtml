@model TFDSolution.Transport.Master.ItemDetailButtonModel
@{
    string tabGrid = "tblDetailButton";
}
<style>
    .select-all-header {
        white-space: nowrap;
        vertical-align: middle !important;
    }

        .select-all-header span {
            display: inline-block;
            margin-right: 6px;
            vertical-align: middle;
            font-weight: 600;
        }

        .select-all-header input[type="checkbox"] {
            width: 17px;
            height: 17px;
            margin: 0;
            padding: 0;
            cursor: pointer;
            vertical-align: middle;
            accent-color: #27a9d7;
        }
    .form-control:disabled, .form-control[readonly] {
        background-color: aliceblue !important;
        opacity: 1;
    }
    .form-select:disabled, .form-select[readonly] {
        background-color: aliceblue !important;
        opacity: 1;
    }
    .select2-container--default.select2-container--disabled .select2-selection--single {
        background-color: aliceblue !important;
        cursor: default;
    }
</style>
<input id="DetailButtonId" value="@Model.DetailId" type="hidden" />
<input id="DetailButtonSrNo" value="@Model.ItemSrNo" type="hidden" />
<input id="DetailButtonTemplateId" value="@Model.TemplateId" type="hidden" />
@{
    decimal totalAmount = 0;
    if (Model != null && Model.FieldData != null && Model.FieldData.Count > 0)
    {
        totalAmount = Convert.ToDecimal(Model.FieldData.Where(x => x.FieldName == "ReceivedAmount").FirstOrDefault()?.FieldValue ?? "0");
        if (totalAmount == 0)
        {
            //PaymentAmount
            totalAmount = Convert.ToDecimal(Model.FieldData.Where(x => x.FieldName == "PaymentAmount").FirstOrDefault()?.FieldValue ?? "0");
        }
    }
}
<input type="hidden" name="hdnItemAmount" value="@totalAmount" />
<div class="row">
    <div class="col-md-12 form-group">
        <table id="@tabGrid" class="table table-bordered InlineForm" cellspacing="0" width="100%" style="border:1px solid #ccc;">
            <thead>
                <tr>
                    @if (Model.PageAction != "V" && Model.TemplateId != 2)
                    {
                        <th>Action</th>
                    }
                    <th class="text-center">#</th>
                    <th class="text-center select-all-header">
                        <input type="checkbox" id="chkSelectAllButton" />
                    </th>
                    @{
                        List<string> commongcol = new List<string>();
                    }

                    @foreach (var field in Model.Data.PageData.Where(x => x.ColumnName != "SrNo" && x.ColumnName != "ItemSrNo" && x.ColumnName != "FiancialYearId" && x.ColumnName != "FinancialYearId").ToList())
                    {
                        if (field.IsRequired)
                        {
                            <th title="This field is required.">
                                @field.ColumnTitle
                                <span class="text-danger">*</span>
                            </th>
                        }
                        else if (field.ColumnType == "Selection")
                        {
                            <th>@field.ColumnTitle</th>
                        }
                        else
                        {
                            <th>@field.ColumnTitle</th>
                        }
                    }
                    @if (Model.Data.Data != null && Model.Data.Data.Any())
                    {
                        var firstRow = Model.Data.Data.First();
                        foreach (var column in firstRow.Keys)
                        {
                            if (Convert.ToString(column) != "SrNo" && Convert.ToString(column) != "ItemSrNo"
                                 && Convert.ToString(column) != "FormId" && Convert.ToString(column) != "Id"
                                 && Convert.ToString(column) != "ParentId" && Convert.ToString(column) != "DetailId"
                                 && Convert.ToString(column) != "CompanyId" && Convert.ToString(column) != "CreatedBy"
                                 && Convert.ToString(column) != "CreatedOn" && Convert.ToString(column) != "UpdatedBy"
                                 && Convert.ToString(column) != "UpdatedOn" && Convert.ToString(column) != "URNNo"
                                 && Convert.ToString(column) != "FiancialYearId" && Convert.ToString(column) != "FinancialYearId"
                                 && Convert.ToString(column) != "RowColor" && Convert.ToString(column) != "RowDisable")
                            {
                                bool fieldExists = false;
                                foreach (var field in Model.Data.PageData.Where(x => x.ColumnName != "SrNo" && x.ColumnName != "ItemSrNo").ToList())
                                {
                                    if (Convert.ToString(column) == (field.ColumnName + "_Id") || Convert.ToString(column) == field.ColumnName || Convert.ToString(column) == field.ColumnTitle)
                                    {
                                        fieldExists = true;
                                        commongcol.Add(field.ColumnName);
                                    }
                                }
                                if (!fieldExists)
                                {
                                    <th>@column</th>
                                }
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    int dyncSerNo = 0;
                    if (Model.Data != null && Model.Data.Data.Count() > 0)
                    {
                        foreach (var _it in Model.Data.Data)
                        {
                            object srvalue;
                            dyncSerNo = dyncSerNo + 1;
                            string srNumber = dyncSerNo.ToString(), _Id = "", RowColor = "";
                            bool RowDisabled = false;
                            if (_it.TryGetValue("SrNo", out srvalue))
                            {
                                srNumber = Convert.ToString(srvalue);
                            }
                            if (_it.TryGetValue("RowDisable", out srvalue))
                            {
                                RowDisabled = Convert.ToBoolean(srvalue);
                            }
                            if (_it.TryGetValue("RowColor", out srvalue))
                            {
                                RowColor = Convert.ToString(srvalue);
                                if (!string.IsNullOrEmpty(RowColor))
                                {
                                    RowColor = RowColor + " !important";
                                }
                            }
                            if (_it.TryGetValue("Id", out srvalue))
                            {
                                _Id = Convert.ToString(srvalue);
                            }
                            <tr data-id="@_Id" tabindex="@srNumber">
                                @if (Model.PageAction != "V" && Model.TemplateId != 2)
                                {
                                    <td class="text-center" style="vertical-align:middle;background:@RowColor">
                                        @*<a title='Save Record' data-content="@_Id" class="text-success btn-save"
                                               href='javascript:void(0)'>
                                                <i class="fa fa-save"></i>
                                            </a>&nbsp;*@
                                        @if (RowDisabled)
                                        {
                                            <span style="color:red;">
                                                <i class="fa fa-trash"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <a title='Delete Record'
                                               data-content="@_Id" class="text-danger btn-delete" href='javascript:void(0)'>
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        }
                                    </td>
                                }
                                <td style="background: @(string.IsNullOrWhiteSpace(RowColor) ? "aliceblue !important" : RowColor); text-align: center; vertical-align: middle;">
                                    <label tabindex="-1" for="ItemSrNo" class="form-control-label">@srNumber</label>
                                    <input style="display:none"
                                           value="@srNumber"
                                           id="ItemSrNo"
                                           data-bind="SrNo"
                                           data_content="TextBox"
                                           disabled
                                           class="form-control w-25" />
                                </td>
                                <td style="background:@RowColor">
                                    @{
                                        if (Model.PageAction != "V")
                                        {
                                            if (RowDisabled)
                                            {
                                                <input type="checkbox" disabled="disabled" checked="checked" id="chk" @srNumber class="form-check rowSelectChk" />
                                            }
                                            else
                                            {
                                                <input type="checkbox" id="chk" @srNumber class="form-check rowSelectChk" />
                                            }
                                        }
                                        else
                                        {
                                            <input type="checkbox" id="chk" @srNumber class="form-check rowSelectChk" />
                                        }
                                    }
                                </td>
                                @foreach (var field in Model.Data.PageData.Where(x => x.ColumnName != "SrNo" && x.ColumnName != "RowColor" && x.ColumnName != "RowDisabled").ToList())
                                {
                                    bool IsDisabled = false;
                                    bool isReadOnlyOrDisabled = (field.IsReadOnly ?? false) || (field.IsDisable ?? false);
                                    if (RowDisabled)
                                    { isReadOnlyOrDisabled = RowDisabled; }
                                    string fieldName = Convert.ToString(field.FieldName).ToUpper();
                                    if (_it.TryGetValue(field.ColumnName, out srvalue))
                                    {
                                        srvalue = Convert.ToString(srvalue);
                                    }
                                    if (Convert.ToString(srvalue).Length <= 0)
                                    {
                                        srvalue = "0";
                                    }
                                    if (field.ColumnType == "Numeric")
                                    {
                                        if (field.FieldDecimal <= 0)
                                        {
                                            srvalue = Math.Round(Convert.ToDecimal(srvalue), 2);
                                        }
                                        else
                                        {
                                            srvalue = Math.Round(Convert.ToDecimal(srvalue), field.FieldDecimal);
                                        }
                                    }
                                    field.FieldValue = Convert.ToString(srvalue);
                                    string ctrlId = "ctrl_" + Convert.ToString(field.ColumnName) + "_" + srNumber;
                                    string isButtonClass = field.FieldType == "Button" ? "text-center" : "";
                                    string tabIndexAttr = isReadOnlyOrDisabled ? "-1" : null;
                                    <td tabindex="0" style="background:@RowColor">
                                        @switch (field.ColumnType)
                                        {
                                            case "Label":
                                                <label style="background:@RowColor" tabindex="-1" data-bind="@field.ColumnName" class="view">@srvalue</label>
                                                break;
                                            case "nvarchar":
                                                if (Model.PageAction != "V" && field.ColumnName == "Reading")
                                                {
                                                    <input style="background:@RowColor" type="text" id="@ctrlId" value="@srvalue" data-bind="@field.ColumnName" tabindex="@srNumber" class="form-control" />
                                                }
                                                else
                                                {
                                                    <label style="background:@RowColor" tabindex="-1" data-bind="@field.ColumnName" class="view">@srvalue</label>
                                                }
                                                break;
                                            case "TimeField":
                                                string timeValue = "";
                                                if (DateTime.TryParse(field.FieldValue?.ToString(), out DateTime parsedTime))
                                                {
                                                    timeValue = parsedTime.ToString("HH:mm");
                                                }
                                                timeValue = timeValue.Replace(".", ":").Replace("AM", "").Replace("PM", "");
                                                if (Model.PageAction != "V")
                                                {
                                                    if (isReadOnlyOrDisabled)
                                                    {
                                                        <input style="background:@RowColor" type="time" id="@ctrlId" value="@timeValue" readonly="readonly" disabled="disabled" tabindex="-1" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                                    }
                                                    else
                                                    {
                                                        <input style="background:@RowColor" type="time" id="@ctrlId" value="@timeValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" data-bind="@field.FieldName" />
                                                    }
                                                }
                                                else
                                                {
                                                    if (DateTime.TryParse(field.FieldValue?.ToString(), out DateTime parsedTime1))
                                                    {
                                                        timeValue = parsedTime1.ToString("HH:mm tt");
                                                    }
                                                    <label style="background:@RowColor" tabindex="-1" class="view">@timeValue</label>
                                                }
                                                break;
                                            case "TextBox":
                                                if (Model.PageAction != "V" && field.ColumnName == "Reading")
                                                {
                                                    if (field.IsRequired)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength, @required = field.IsRequired == true ? "required" : null })
                                                    }
                                                    else if (field.IsReadOnly == true)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength, @readonly = "readonly" })
                                                    }
                                                    else
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, data_path = @field.FieldFormula, data_decimal = field.FieldDecimal, @class = "form-control", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @maxlength = field.FieldLength })
                                                    }
                                                }
                                                else
                                                {
                                                    <label tabindex="-1" data-bind="@field.FieldName" class="view">@srvalue</label>
                                                }
                                                break;
                                            case "MultiText":
                                                if (Model.PageAction != "V")
                                                {
                                                    if (isReadOnlyOrDisabled)
                                                    {
                                                        <input type="text" id="@ctrlId" value="@field.FieldValue" readonly="readonly" tabindex="-1" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                                    }
                                                    else
                                                    {
                                                        <input type="text" id="@ctrlId" value="@field.FieldValue" class="form-control edit" data-content="@field.FieldType" @(field.IsRequired == true ? "required" : null) data-html="@field.FieldCaption" maxlength="@field.FieldLength" data-bind="@field.FieldName" />
                                                    }
                                                }
                                                else
                                                {
                                                    <label tabindex="-1" class="view">@field.FieldValue</label>
                                                }
                                                break;
                                            case "CheckBox":
                                                bool isChecked = field.FieldValue == "1" || string.Equals(field.FieldValue, "true", StringComparison.OrdinalIgnoreCase);
                                                bool isDisabled = field.IsReadOnly == true;
                                                if (Model.PageAction != "V")
                                                {
                                                    <input style="background:@RowColor" type="checkbox" id="@ctrlId" data-bind="@field.FieldName" value="1" class="form-check edit" data-content="@field.FieldType" data-html="@field.FieldCaption" @(field.IsRequired == true ? "required" : null) @(isChecked ? "checked" : null) @(isDisabled ? "disabled tabindex=\"-1\"" : "") /> }
                                                else
                                                {
                                                    <label style="background:@RowColor" tabindex="-1" data-bind="@field.FieldName" class="view"> @(isChecked ? "Yes" : "No") </label>
                                                }
                                                break;
                                            case "Numeric":
                                                if (!string.IsNullOrWhiteSpace(field.FieldValue) && !field.FieldValue.Equals("NULL", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    if (decimal.TryParse(field.FieldValue, out decimal parsedValue))
                                                    {
                                                        decimal rounded = Math.Round(parsedValue, field.FieldDecimal);
                                                        if (field.FieldDecimal == 0)
                                                        {
                                                            rounded = Math.Round(parsedValue, 2);
                                                        }
                                                        field.FieldValue = rounded.ToString();
                                                    }
                                                }
                                                if (Model.PageAction != "V")
                                                {
                                                    if (field.IsRequired)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number", @required = field.IsRequired == true ? "required" : null })
                                                    }
                                                    else if (field.IsReadOnly == true || isReadOnlyOrDisabled)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number", @readonly = "readonly" })
                                                    }
                                                    else
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, max = field.FieldValue, data_dependency = @field.IsDependencyField, data_path = @field.FieldFormula, @class = "form-control", data_decimal = field.FieldDecimal, data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "number" })
                                                    }
                                                }
                                                else
                                                {
                                                    <label tabindex="-1" data-bind="@field.FieldName" class="view">@field.FieldValue</label>
                                                    @*<label tabindex="-1" data-bind="@field.FieldName" class="view">
                                                            @(decimal.TryParse(Convert.ToString(field.FieldValue), out decimal amount) ? "₹" + amount.ToString("#,##,##0.00"): field.FieldValue)
                                                        </label>*@
                                                }
                                                break;
                                            case "Selection":
                                                var _fieldValue = Convert.ToString(field.FieldValue);
                                                var _fieldText = Convert.ToString(field.FieldValue);
                                                if (!string.IsNullOrEmpty(field.FieldValue))
                                                {
                                                    _fieldValue = Convert.ToString(field.FieldValue).Trim();
                                                    _fieldText = Convert.ToString(field.FieldValue).Trim();
                                                }

                                                if (Model.Data != null && Model.Data != null)
                                                {
                                                    object value;
                                                    if (_it.TryGetValue((field.FieldName + "_Id"), out value))
                                                    {
                                                        _fieldValue = Convert.ToString(value).Trim();
                                                    }
                                                }
                                                if (Model.PageAction != "V")
                                                {
                                                    if (field.IsRequired)
                                                    {
                                                        <select onchange="selectInlinChange(this)" required class="form-select select2 form-control selectpicker edit"
                                                                style="width:100%; min-width:200px !important;" data-display="@_fieldText"
                                                                data-sourcetype="@field.DDLSourceType"
                                                                @(isReadOnlyOrDisabled ? "disabled='disabled' tabindex=\"-1\"" : "")
                                                                data-multiselection="@field.IsMultiSelection" data-live-search="true"
                                                                data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField"
                                                                data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@ctrlId"
                                                                data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName"
                                                                data-content="@field.FieldType">
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <select onchange="selectInlinChange(this)" class="form-select select2 form-control selectpicker edit"
                                                                style="width:100%; min-width:200px !important;" data-display="@_fieldText"
                                                                data-sourcetype="@field.DDLSourceType"
                                                                @(isReadOnlyOrDisabled ? "disabled='disabled' tabindex=\"-1\"" : "")
                                                                data-multiselection="@field.IsMultiSelection" data-live-search="true"
                                                                data-wrap="@field.DDLTextField" data-spy="@field.DDLValueField"
                                                                data-delay="@field.DDLSourceName" data-interval="@_fieldValue" id="@ctrlId"
                                                                data-container="@field.FieldId" data-html="@field.FieldCaption" data-bind="@field.FieldName"
                                                                data-content="@field.FieldType">
                                                        </select>
                                                    }
                                                }
                                                else
                                                {
                                                    <label tabindex="-1" data-bind="@field.FieldName" class="view">@_fieldText</label>
                                                }
                                                break;
                                            case "DateTimeField":
                                                if (!string.IsNullOrEmpty(field.FieldValue))
                                                {
                                                    try
                                                    {
                                                        DateTime _dt = DateTime.Parse(field.FieldValue);
                                                        field.FieldValue = _dt.ToString("yyyy-MM-dd");
                                                    }
                                                    catch (Exception)
                                                    {
                                                    }
                                                }
                                                if (Model.PageAction != "V")
                                                {
                                                    if (field.IsRequired)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @required = field.IsRequired == true ? "required" : null })
                                                    }
                                                    else if (field.IsReadOnly == true)
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date", @readonly = "readonly" })
                                                    }
                                                    else
                                                    {
                                                        @Html.TextBox(field.FieldName, field.FieldValue, new { @style = "background:" + @RowColor, @class = "form-control", @placeholder = "dd-MM-yyyy", data_html = @field.FieldCaption, data_content = field.FieldType, data_bind = field.FieldName, @type = "date" })
                                                    }
                                                    @Html.ValidationMessage(field.FieldName, "", new { @class = "text-danger" })
                                                }
                                                else
                                                {
                                                    <label style="background:@RowColor" tabindex="-1" data-bind="@field.FieldName" class="view">@field.FieldValue</label>
                                                }
                                                break;
                                            default:
                                                if (Model.PageAction != "V")
                                                {
                                                    <input style="background:@RowColor" type="text" id="@ctrlId" value="@srvalue" data-bind="@field.ColumnName" class="form-control" />
                                                }
                                                else
                                                {
                                                    <label style="background:@RowColor" tabindex="-1" class="view" data-bind="@field.ColumnName">@srvalue</label>
                                                }
                                                break;
                                        }
                                    </td>
                                }
                                @{
                                    foreach (var cell in _it)
                                    {
                                        if (cell.Key != "SrNo" && cell.Key != "ItemSrNo" && cell.Key != "FormId" && cell.Key != "Id" && cell.Key != "ParentId" && cell.Key != "DetailId"
                                        && cell.Key != "CompanyId" && cell.Key != "CreatedBy" && cell.Key != "CreatedOn"
                                        && cell.Key != "UpdatedBy" && cell.Key != "UpdatedOn" && cell.Key != "UpdatedBy"
                                        && cell.Key != "URNNo" && cell.Key != "FiancialYearId" && cell.Key != "FinancialYearId"
                                         && cell.Key != "RowColor" && cell.Key != "RowDisable")
                                        {
                                            bool fieldExists = false;
                                            foreach (var field in Model.Data.PageData.Where(x => x.ColumnName != "SrNo" && x.ColumnName != "ItemSrNo").ToList())
                                            {
                                                if (Convert.ToString(cell.Key) == (field.ColumnName + "_Id") ||
                                                    Convert.ToString(cell.Key) == field.ColumnName || Convert.ToString(cell.Key) == field.ColumnTitle)
                                                {
                                                    fieldExists = true;
                                                }
                                            }
                                            if (!fieldExists)
                                            {
                                                if (cell.Key != "Reading")
                                                {
                                                    <td>
                                                        <label tabindex="-1" data-bind="@cell.Key" class="view">@cell.Value</label>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <input type="text" class="form-control" value="@cell.Value" data-bind="@cell.Key" />
                                                    </td>
                                                }
                                            }
                                        }
                                    }
                                }
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@if (Model.Data.Summary != null && Model.Data.Summary.Any())
{
    <div class="row">
        <div class="col-md-12 form-group">
            <div class="summary-container d-flex justify-content-end">
                @if (Model.Data.Summary != null)
                {
                    foreach (var item in Model.Data.Summary)
                    {
                        <div class="col-md-3">
                            <div class="summary-item">
                                <div class="summary-label">
                                    @Html.Raw(item.Label)
                                </div>
                                <div class="summary-value">
                                    @Html.Raw(item.Value)
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    function InitalizeSelect($select) {
        let selectId = $($select).attr('id');
        if (selectId) {
            try {
                let parentWrapper = $($select).parent();
                var sourceType = $($select).attr("data-sourcetype");
                if (sourceType != "StoredProcedure") {
                    var _fieldId = $($select).attr("data-container");
                    let selectedValues = $($select).attr("data-interval");
                    let selectedText = $($select).attr("data-display");
                    let firstFive = selectedText ? selectedText.substring(0, 20) : "";
                    $($select).select2({
                         dropdownParent: parentWrapper,
                         placeholder: 'Search...',
                         allowClear: true,
                         delay: 250,
                         dropdownParent: $('body'),
                         minimumInputLength: 0, // change to 0 if you want scrolling without typing
                         ajax: {
                             url: '@Url.Action("FillSelctionPaging", "Common")',
                             dataType: 'json',
                             type: 'GET',
                             delay: 250,
                             skipLoading: true,
                             width: '100%', // 🔥 This is key to match the column width
                             data: function (params) {
                                 return {
                                     FieldId: _fieldId,
                                     searchTerm: params.term || '', // search term
                                     page: params.page || 1,
                                     fieldValue: ''
                                 };
                             },
                             processResults: function (data) {
                                 return {
                                     results: data.results,
                                     pagination: {
                                         more: data.pagination.more
                                     }
                                 };
                             },
                             error: function (xhr, status, error) {
                                 console.error("Select2 AJAX Error:", error);
                                 console.error("Status:", status);
                                 console.error("Response:", xhr.responseText);
                             },
                             cache: true
                         }
                    });
                    /// Pre-load selected values (important when editing)
                    if (selectedValues.length) {
                        $.ajax({
                            url: '@Url.Action("FillSelctionPaging", "Common")',
                            type: 'GET',
                            skipLoading: true,
                            data: { FieldId: _fieldId, searchTerm: firstFive, page: 1, fieldValue: '' },
                            success: function (data) {
                                var isMultiSelection = $(this).attr("data-multiselection");
                                if (isMultiSelection != undefined && isMultiSelection != "" && isMultiSelection == "True") {
                                    selectedValues.forEach(function (val) {
                                       let item = data.results.find(x => x.id == val);
                                        if (item) {
                                            let option = new Option(item.text, item.id, true, true);
                                            $($select).append(option);
                                        }
                                    });
                                }
                                else {
                                    if (data != null && data.results != null) {
                                        let item = data.results.find(x => x.id == selectedValues);
                                        if (item) {
                                            let option = new Option(item.text, item.id, true, true);
                                            $($select).append(option).trigger('change');
                                        }
                                    }
                                }
                                $($select).trigger('change');
                            }
                        });
                    }
                    const $input = $($select);
                    if ($input.hasClass("d-none")) {
                        $input.next().addClass('d-none');
                    }
                }
            } catch (e) {
             console.error("Select2 Inline Form:", e);
            }
        }
    }
