    function autoSelect() {

        let remainingAmount = parseFloat(@totalAmount) || 0;
        $("#tblDetailButton tbody tr").each(function () {
            let $row = $(this);
            let $checkbox = $row.find(".form-check");
            let $outstandingAmt = $row.find('[data-bind="OutstandingAmt"]');
            let $adjustAmt = $row.find('[data-bind="AdjustAmt"]');
            let outstandingAmt = parseFloat($outstandingAmt.val()) || 0;
            if (remainingAmount <= 0) {
                $checkbox.prop("checked", false);
                $adjustAmt.val("0.00");
                return;
            }
            $checkbox.prop("checked", true);
            if (outstandingAmt <= remainingAmount) {
                $adjustAmt.val(outstandingAmt.toFixed(2));
                remainingAmount -= outstandingAmt;
            } else {
                $adjustAmt.val(remainingAmount.toFixed(2));
                remainingAmount = 0;
            }
        });
        calculateTotalAdjustAmt();
    }
