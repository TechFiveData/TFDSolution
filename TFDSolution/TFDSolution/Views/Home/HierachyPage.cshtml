    function deleteRecord(id) {
        if (confirm("Are you sure you want to delete this record?")) {
            var tablename = $("#hdnTableName").val();
            try {
            $.ajax({
                type: "POST",
                url: "@Url.Action("DeletePageRecord", "Home")",
                data: { id: id, tblName: tablename },
                success: function (response) {
                    if (response.IsSuccess) {
                        ShowToastNotification("success", "Record has been deleted successfully.");
                        BindGridPagination();
                    } else {
                        ShowToastNotification("error", "Error Record Status record.");
                    }
                },
                error: function () {
                    ShowToastNotification("error", "Error Record Status record.");
                }
            });
            }
            catch (e) {
                ShowToastNotification("error", e.message);
            }
            return true;
        }
    }
    function ActionTabData(_Id, _action, _parentId)
    {
        try {
            var isValid = true;
            if (isValid) {
                if (_action != "A") {
                   _Id = $("#hdnSelectedRecordId").val();
                }
                $("#tabModalData").empty();
                 $.ajax({
                     type: "GET", url: '@Url.Action("ParticalMasterPopup", "Home")',
                     contentType: "application/json;",
                     cache: true,
                     data: {
                         FormId: $("#hdnFormId").val(),
                         pagename: $("#hdnFormName").val(),
                         act: _action,
                         Id: _Id,
                         ParentId: _parentId
                     },
                     async: false,
                     success: function (response) {
                         if (response != null) {
                             $("#tabModalData").html(response);
                             setTimeout(function () {
                                 $('#tabModalData div.navigation-controls a.enableButton').removeClass('disabled');
                             }, 1500); // 1000 ms = 1 second
                         }
                         else {
                             ShowToastNotification("error","Please try again...");
                         }
                     },
                     failure: function (response) { },
                     error: function (response) { }
                 });
            }
        } catch (e) {
        }
    }
