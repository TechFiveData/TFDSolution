                         }
                     },
                     failure: function (response) { },
                     error: function (response) { }
                 });
             } catch (e) {
             }
         }
    }
    function GetFinancialYears() {
        $.ajax({
            type: "GET",
            url: "@Url.Action("getFinancialYears", "Master")",
            data: { uId: $("#CompanyId").val() },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: Bindfinacinal,
            failure: function (response) {
                alert(response.d);
            },
            error: function (response) {
                alert(response);
            }
        });
    }
    function Bindfinacinal(dataset) {
        // Assuming data is an array of objects
        //if (dataset.length === 0) {
        //    return; // No data to display
        //}
        //if ($.fn.DataTable.isDataTable('#tblFinancial')) {
        //    $('#tblFinancial').DataTable().destroy();
        //}
        // Extract column names from the first object
        //const columns = Object.keys(dataset[0]).map(key => {
        //    if (key == "CompanyCode") {
        //        return { title: key, data: key };
        //    }
        //});
        // Initialize DataTable
        new DataTable('#tblFinancial', {
            "destroy": true,
            layout: {
                topStart: {
                    pageLength: {
                        menu: [10, 25, 50, 100]
                    },
                    ///buttons: ['excelHtml5', 'csvHtml5', 'pdfHtml5']
                },
                topEnd: {
                    search: {
                        placeholder: 'Type search here'
                    }
                },
                bottomEnd: {
                    paging: {
                        buttons: 5
                    }
                },
            },
            paging: true,
            scrollCollapse: true,
            /// scrollY: '500px',
            data: dataset,
            columns: [
                {
                    title: '',
                    className: "grid-action-item",
                    render: function (data, type, row, meta) {
                        var editlink = "/Master/CompanyAction?uId=" + row.FiancialYearId;
                        return "<a title='Edit Record' data-toggle='modal' data-target='#mediumModal' href=javascript:void(0);><i class='fa fa-pencil'></i></a> &nbsp;|&nbsp; <a title='Delete Record' href='javascript:DeleteCompany(\"" + row.FiancialYearId + "\")';><i class='fa fa-trash text-danger'></i></a>";
                    },
                },
                {
                    title: 'Alias',
                    render: function (data, type, row, meta) {
                        return "<a title='View Record' href=" + row.CompanyId + ">" + row.Alias +"</a>";
                    },
                },
                {
                    title: 'Status',
                    className: 'text-center',
                    render: function (data, type, row, meta) {
                        return (row.IsActive === true) ? '<span class="fa fa-check text-success"></span>' : '<span class="fa fa-remove text-danger"></span>';
                    }
                },
                {
                    title: 'Start Date',
                    render: function (data, type, row, meta) {
                        var editlink = formatDateOnly(parseMSDate(row.StartDate));
                        return "<span>" + editlink + "</span>";
                    },
                },
                {
                    title: 'End Date',
                    render: function (data, type, row, meta) {
                        var editlink = formatDateOnly(parseMSDate(row.EndDate));
                        return "<span>" + editlink + "</span>";
                    },
                },

            ]
        });
    }
    function parseMSDate(s) {
        // Jump forward past the /Date(, parseInt handles the rest
        return new Date(parseInt(s.substr(6)));
    }
    function formatDateOnly(d) {
        var s = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
        return s;
    }
    function formatDate(d) {
        if (hasTime(d)) {
            let n = d.toLocaleString([], {
                hour: "2-digit",
                minute: "2-digit",
            });
            var s = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
        } else {
            var s = (d.getDate() + '/' + d.getMonth() + 1) + '/' + d.getFullYear();
        }
        return s;
    }
    function hasTime(d) {
        return !!(d.getUTCHours() || d.getUTCMinutes() || d.getUTCSeconds());
    }

    function zeroFill(n) {
            if ((n + '').length == 1)
                return '0' + n;

            return n;
        }

