@model TFDSolution.Transport.Master.CompanyMast

@{
    ViewBag.Title = "Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- /header -->
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Update Company Information</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li><a href="@Url.Action("Company","Master")">Company List</a></li>
                    <li>Update Company</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<input type="hidden" value="@Model.PageAction" id="pageAction" />
<div id="divpageDetail" class="animated fadeIn mypage">
    @using (Html.BeginForm("CompanyAction", "Master", FormMethod.Post))
    {
        if (ViewBag.ErrorMessages != null)
        {
            <div id="divError">
                <div class="alert alert-danger">
                    <strong>Danger!</strong>  @ViewBag.ErrorMessages
                </div>
            </div>
        }
        if (ViewBag.SuccessMessage != null)
        {
            <div id="divsuccess">
                <div class="alert alert-success">
                    <strong>Success!</strong> @ViewBag.SuccessMessage
                </div>
            </div>
        }
        @Html.HiddenFor(m => m.CompanyId)
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-lg-6">
                            <strong class="card-title">

                            </strong>
                        </div>
                        <div class="col-lg-6 text-right">
                            @*@if (Model.PageAction == "A")
                                {
                                    <button class="btn btn-sm" disabled type="button"><i class="fa fa-plus"></i>&nbsp; New</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm" onclick="AddNewRecord()" type="button"><i class="fa fa-plus"></i>&nbsp; New</button>
                                }*@
                            @if (Model.PageAction == "V")
                            {
                                <button class="btn btn-sm" onclick="EditPageData()" type="button"><i class="fa fa-pencil font16"></i></button>
                            }
                            @*@if (Model.PageAction != "V")
                                {
                                    <button class="btn btn-sm" disabled type="button"><i class="fa fa-trash"></i>&nbsp; Delete</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm" onclick="DeletePageData()" type="button"><i class="fa fa-trash"></i>&nbsp; Delete</button>
                                }*@
                            @if (Model.PageAction == "V")
                            {
                                <button class="btn btn-sm" disabled type="submit"><i class="fa fa-save font16"></i></button>
                            }
                            else
                            {
                                <button class="btn btn-sm" type="submit"><i class="fa fa-save font16"></i></button>
                            }
                            <a class="btn btn-sm" href="@Url.Action("Company","Master")"><i class="fa fa-arrow-circle-left font16"></i></a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="page-head">
                            <div class="section-left">
                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <div class="col col-md-6 p-0"><label class=" form-control-label">Company Code</label></div>
                                        <div class="col-12 col-md-6 text-left">
                                            @*<p class="form-control-static">@Model.CompanyCode</p>*@
                                            @Html.HiddenFor(m => m.CompanyCode)
                                            @Html.TextBoxFor(m => m.CompanyCode, new { @placeholder = "Company Name ", @class = "form-control", @disabled = "disabled" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <div class="col col-md-6 p-0 text-right"><label for="select" class=" form-control-label">Status</label></div>
                                        <div class="col-12 col-md-6">
                                            <label class="switch switch-3d switch-success mr-3">
                                                <input type="checkbox" class="switch-input" checked="true"> <span class="switch-label"></span> <span class="switch-handle"></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="text-input" class=" form-control-label">Name<span class="text-danger p-1">(*)</span></label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.CompanyName, new { @placeholder = "Company Name ", @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="text-input" class=" form-control-label">Alias</label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.CompanyName, new { @placeholder = "Alias", @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="text-input" class=" form-control-label">Email<span class="text-danger p-1">(*)</span></label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="input-group">
                                            @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email", @class = "form-control", @name = "input2-group1" })
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="text-input" class=" form-control-label">Web Site</label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.WebStite, new { @placeholder = "Web Site", @class = "form-control" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="Phone" class="control-label mb-1">Phone<span class="text-danger p-1">(*)</span></label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.Phone, new { @placeholder = "Phone", @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="Mobile" class="control-label mb-1">Mobile<span class="text-danger p-1">(*)</span></label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="input-group">
                                            @Html.TextBoxFor(m => m.Mobile, new { @placeholder = "Mobile", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="text-input" class=" form-control-label">Fax</label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.Fax, new { @placeholder = "Fax", @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="section-right">

                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <strong for="RegisterAddress1" class="control-label mb-1">Register Address</strong>
                                            @Html.TextAreaFor(m => m.RegisterAddress1, new { @placeholder = "Address1", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.RegisterAddress1, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <strong for="FactoryAddress1" class="control-label mb-1">Factory Address</strong>
                                        <div class="input-group">
                                            @Html.TextAreaFor(m => m.FactoryAddress1, new { @placeholder = "Address1", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.FactoryAddress1, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            @Html.TextAreaFor(m => m.RegisterAddress2, new { @placeholder = "Address 2", @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            @Html.TextAreaFor(m => m.FactoryAddress2, new { @placeholder = "Address 2", @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            @Html.DropDownListFor(m => m.RegiterCityId, new SelectList(ViewBag.CityList, "Value", "Text"), "Select City", new { @class = "form-control form-select", @id = "ddlRCity" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            @Html.DropDownListFor(m => m.FactoryCityId, new SelectList(ViewBag.CityList, "Value", "Text"), "Select City", new { @class = "form-control form-select", @id = "ddlFCity" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            @Html.DropDownListFor(m => m.RegiterStateId, new SelectList(ViewBag.StateList, "Value", "Text"), "Select State", new { @class = "form-control form-select", @id = "ddlRState" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            @Html.DropDownListFor(m => m.FactoryStateId, new SelectList(ViewBag.StateList, "Value", "Text"), "Select State", new { @class = "form-control form-select", @id = "ddlFState" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            @Html.DropDownListFor(m => m.RegisterCountryId, new SelectList(ViewBag.CountryList, "Value", "Text"), "Select Country", new { @class = "form-control form-select", @id = "ddlRCountry" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            @Html.DropDownListFor(m => m.FactoryCountryId, new SelectList(ViewBag.CountryList, "Value", "Text"), "Select Country", new { @class = "form-control form-select", @id = "ddlFCountry" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            @Html.TextBoxFor(m => m.RegisterPincode, new { @placeholder = "Pincode", @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group">
                                            @Html.TextBoxFor(m => m.FactoryPincode, new { @placeholder = "Pincode", @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="page-breaker"></div>
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="profile-tab" data-toggle="tab" href="#Accountdetails" role="tab" aria-controls="Accountdetails" aria-selected="false">Account Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="financialyear-tab" data-toggle="tab" href="#FinancialYear" role="tab" aria-controls="FinancialYear" aria-selected="false">Financial Year</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="bank-tab" data-toggle="tab" href="#Bankdetails" role="tab" aria-controls="Bankdetails" aria-selected="false">Bank Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="unit-tab" data-toggle="tab" href="#Unitdetails" role="tab" aria-controls="Unitdetails" aria-selected="false">Unit Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="emailcofig-tab" data-toggle="tab" href="#emailcofig" role="tab" aria-controls="emailcofig" aria-selected="true">Email Configuration</a>
                            </li>
                        </ul>
                        <div class="tab-content pl-3 p-1" id="myTabContent">
