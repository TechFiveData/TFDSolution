                            </div>
                            <div class="tab-pane fade" id="emailcofig" role="tabpanel" aria-labelledby="emailcofig-tab">
                                <div class="form-horizontal page-head">
                                    <div class="section-left">
                                        <!-- Email Subject Field -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">From Email</label>
                                            </div>
                                            <div class="col-12 col-md-9">
                                                @Html.TextBoxFor(m => m.FromEmail, new { @class = "form-control", @placeholder = "From Email", @maxlength = "255" })
                                                @Html.ValidationMessageFor(m => m.FromEmail, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <!-- Password -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">Password</label>
                                            </div>
                                            <div class="col-12 col-md-9">
                                                @Html.TextBoxFor(m => m.FromPassword, new { @class = "form-control", @type = "password", @placeholder = "Email Password", @maxlength = "255" })
                                                @Html.ValidationMessageFor(m => m.FromPassword, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <!-- Display Name -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">Display Name</label>
                                            </div>
                                            <div class="col-12 col-md-9">
                                                @Html.TextBoxFor(m => m.DisplayName, new { @placeholder = "Recipient Email", @class = "form-control", @maxlength = "100" })
                                                @Html.ValidationMessageFor(m => m.DisplayName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="section-right">
                                        <!-- SmtpServer -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">SMTP Server</label>
                                            </div>
                                            <div class="col-12 col-md-9">
                                                @Html.TextBoxFor(m => m.SmtpServer, new { @placeholder = "SMTP Server", @class = "form-control", @maxlength = "255" })
                                                @Html.ValidationMessageFor(m => m.SmtpServer, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <!-- SmtpPort Field -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">SMTP Port</label>
                                            </div>
                                            <div class="col-12 col-md-9">
                                                @Html.TextBoxFor(m => m.SmtpPort, new { @placeholder = "SMTP Port", @class = "form-control", @maxlength = "100" })
                                                @Html.ValidationMessageFor(m => m.SmtpPort, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <!-- EnableSSL -->
                                        <div class="row form-group">
                                            <div class="col col-md-3">
                                                <label for="text-input" class="form-control-label">EnableSSL</label>
                                            </div>
