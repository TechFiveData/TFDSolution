                                    <div class="col col-md-3"><label for="GSTNo" class="form-control-label">GST No</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.GSTNo, new { @placeholder = "GST No", @class = "form-control" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3">
                                        <label for="PANNo" class="form-control-label">PAN No</label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.PANNo, new { @placeholder = "PAN No", @class = "form-control" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="CINNo" class=" form-control-label"> CIN No</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.CINNo, new { @placeholder = "CIN No", @class = "form-control" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="ECCNo" class=" form-control-label">ECC No</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.ECCNo, new { @placeholder = "ECC No", @class = "form-control", @maxlength = "50" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="RegistrationNo" class=" form-control-label">Registration No</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.RegistrationNo, new { @placeholder = "Registration No", @class = "form-control", @maxlength = "30"})
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="RegistrationDate" class=" form-control-label">Registration Date</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.RegistrationDate, "{0:yyyy-MM-dd}", new { @autocomplete = "off", @placeholder = "Registration Date", @class = "form-control datepicker", @type = "date" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="MSMENo" class=" form-control-label">MSME #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.MSMENo, new { @placeholder = "MSME Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="TANNo" class=" form-control-label">TAN Registration #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.TANNo, new { @placeholder = "TAN Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="PFNo" class=" form-control-label">PF Registration #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.PFNo, new { @placeholder = "PF Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="ESICNo" class=" form-control-label">ESIC Registration #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.ESICNo, new { @placeholder = "ESIC Registration Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="PrefessionTaxNo" class=" form-control-label">Professonal Tax #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.PrefessionTaxNo, new { @placeholder = "Professonal Tax Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="LWFPrefessionNo" class=" form-control-label">LWF Registration #</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.TextBoxFor(m => m.LWFPrefessionNo, new { @placeholder = "LWF Registration Number", @class = "form-control", @maxlength = "30" })
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col col-md-3"><label for="DefaultCurrencyId" class=" form-control-label">Default Currency</label></div>
                                    <div class="col-12 col-md-9">
                                        @Html.DropDownListFor(m => m.DefaultCurrencyId, new SelectList(ViewBag.CurrencyList, "Value", "Text"), "Select Currency", new { @class = "form-control form-select", @id = "ddlCurrency" })
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="FinancialYear" role="tabpanel" aria-labelledby="financialyear-tab">
                                <div class="row form-group">
                                    <div class="col col-md-12 text-right">
                                        <a class="btn btn-primary" href="javascript:void(0);" title="Add New Fiancial" data-toggle="modal" data-target="#mediumModal"><i class="fa fa-plus"></i></a>
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <table id="tblFinancial" class="display cell-border row-border nowrap" cellspacing="0" width="100%"></table>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="Bankdetails" role="tabpanel" aria-labelledby="Bankdetails-tab">
                                <div class="row form-group">
                                    <div class="col col-md-12 text-right">
                                        <a class="btn btn-primary" href="javascript:void(0);" title="Add New Bank" data-toggle="modal" data-target="#mediumModalBank"><i class="fa fa-plus"></i></a>
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <table id="tblBankDetails" class="display cell-border row-border nowrap" cellspacing="0" width="100%"></table>
                                </div>
