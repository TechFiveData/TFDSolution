     //Unit Save details

    function SaveUnitDetails() {
        var CompanyId = $("#CompanyId").val();
        var isFormValid = true;
        var requiredFields = [
            "#txtSiteName",
            "#txtAddress1",
            "#txtPincode",
            "#txtGSTNo",
            "#txtPhone",
            "#txtEmail"
        ];
        requiredFields.forEach(function (selector) {
            var $field = $(selector);
            if (!$field.val().trim()) {
                $field.addClass("input-validation-error");
                if (isFormValid == true) {
                    $(this).focus();
                }
                isFormValid = false;
            } else {
                $field.removeClass("input-validation-error");
            }
        });
            if (!isFormValid) {
               alert("Please fill in all the required fields (indicated by *)");
            }
            else {
                try {
                    var company = {
                        SiteName: $("#txtSiteName").val(),
                        Address1:$("#txtAddress1").val(),
                        Address2: $("#txtAddress2").val(),
                        CityId: $("#txtCity").val(),
                        StateId: $("#txtStateId").val(),
                        CountryId: $("#txtCountryId").val(),
                        Pincode: $("#txtPincode").val(),
                        GSTNo: $("#txtGSTNo").val(),
                        PANNo: $("#txtPANNo").val(),
                        Phone: $("#txtPhone").val(),
                        Email: $("#txtEmail").val(),
                        IsActive: 1,
                        CompanyId: $("#CompanyId").val(),
                        CompanyUnitId: $("#hdnUnitId").val(),
                    };
                    $.ajax({
                        type: "POST", url: '@Url.Action("SaveUnitDetails", "Master")',
                        contentType: "application/json;",
                        data: JSON.stringify(company),
                        async: false,
                        success: function (response) {
                            if (response.IsSuccess) {
                                $("#CompanyId").val(CompanyId);
                                ShowToastNotification("success","Record saved successfully");
                                $("#btncancelUnit").click();
                                GetUnitDetails();
                                ClickUnitCancel();
                            }
                            else {
                                alert(response.Response);
                                ShowToastNotification("error", response.Response);
                            }
                        },
                        failure: function (response) { },
                        error: function (response) { }
                    });
                } catch (e) {
                }
            }
     }
