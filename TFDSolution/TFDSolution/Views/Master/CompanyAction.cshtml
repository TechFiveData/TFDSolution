                                    </table>*@
                                @*</div>*@
                            </div>
                            <div class="tab-pane fade" id="Unitdetails" role="tabpanel" aria-labelledby="contact-tab">
                                <div class="row form-group">
                                    <div class="row form-group">
                                        <div class="col col-md-12 text-right">
                                            <a class="btn btn-primary" href="javascript:void(0);" title="Add New Bank" data-toggle="modal" data-target="#mediumModalUnit"><i class="fa fa-plus"></i></a>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <table id="tblUnitDetails" class="display cell-border row-border nowrap" cellspacing="0" width="100%"></table>
                                    </div>
                                    @*<div class="col-12 col-md-12">
                                            <table id="bootstrap-data-table-export" class="table table-striped table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Name</th>
                                                        <th>Position</th>
                                                        <th>Office</th>
