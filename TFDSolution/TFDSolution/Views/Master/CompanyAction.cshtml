    function EditPageData() {
        if (confirm("Are you sure you want to edit record?")) {
            var editlink1 = '@Url.Action("CompanyAction", "Master", new { uId= "_uId", act = "E" })';
            editlink1 = editlink1.replace("amp;", "");
            editlink1 = editlink1.replace("amp;", "");
            editlink1 = editlink1.replace("_uId", encodeURIComponent($("#CompanyId").val()));

            location.href = editlink1;
        }
    }
    function SaveFinancial() {
        var isFormValid = true;
        $("#mediumModal input").each(function () {
            if ($.trim($(this).val()).length == 0) {
                $(this).addClass("input-validation-error");
                if (isFormValid == true) {
                    $(this).focus();
                }
                isFormValid = false;
            }
            else {
                $(this).removeClass("input-validation-error");
            }
        });
         if (!isFormValid) {
            alert("Please fill in all the required fields (indicated by *)");
         }
         else {
             try {
                 var company = {
                     Alias: $("#txtFinancialAlias").val(),
                     StartDate: $("#fianancialStartDate").val(),
                     EndDate: $("#fianancialEndDate").val(),
                     IsActive: 1,
                     CompanyId: $("#CompanyId").val()
                 };
                 $.ajax({
                     type: "POST", url: '@Url.Action("SaveCompanyFinancial", "Master")',
                     contentType: "application/json;",
                     data: JSON.stringify(company),
                     async: false,
                     success: function (response) {
                         if (response.IsSuccess) {
                             ShowToastNotification("success","Record saved successfully");
                             $("#btncancel").click();
                             GetFinancialYears();
                         }
                         else {
                             alert(response.Response);
