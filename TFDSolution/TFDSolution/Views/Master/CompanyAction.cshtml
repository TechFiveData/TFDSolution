                    $(this).attr('disabled', 'disabled');
                }
                else if ($("#pageAction").val().length > 0 && ($("#pageAction").val() == "E" || $("#pageAction").val() == "A")) {
                    $(this).removeAttr('disabled');
                }
                else {
                    $(this).attr('disabled', 'disabled');
                }
            }
        });
        $("#divpageDetail input").each(function () {
            if ($(this).attr("id") != undefined && $(this).attr("id").length > 0) {
                if ($("#pageAction").val() == "V") {
                    $(this).attr('disabled', 'disabled');
                }
                else if ($("#pageAction").val().length > 0 && ($("#pageAction").val() == "E" || $("#pageAction").val() == "A")) {
                    if ($(this).attr("id") != "CompanyCode") {
