@model TFDSolution.Transport.Master.PartyMst

@{
    ViewBag.Title = "PartyAction";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- /header -->
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                @if (string.IsNullOrEmpty(Model.PartyName))
                {
                    <h1>Add New Party </h1>
                }
                else
                {
                    <h1>Edit Party: @Model.PartyCode </h1>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li><a href="@Url.Action("PartyMaster","Master")">Party</a></li>
                    @if (!string.IsNullOrEmpty(Model.PartyName))
                    {
                        <li class="active">Edit Party</li>
                    }
                    else
                    {
                        <li class="active">Add New Party</li>
                    }
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    @using (Html.BeginForm("PartyAction", "Master", FormMethod.Post))
    {
        if (ViewBag.ErrorMessages != null)
        {
            <div id="divError">
                <div class="alert alert-danger">
                    <strong>Danger!</strong>  @ViewBag.ErrorMessages
                </div>
            </div>
        }
        if (ViewBag.SuccessMessage != null)
        {
            <div id="divError">
                <div class="alert alert-success">
                    <strong>Success!</strong> @ViewBag.SuccessMessage
                </div>
            </div>
            <script type="text/javascript">
             setTimeout(function () {
                 var backURL = "@Url.Action("PartyMaster", "Master")"
                 location.href = backURL;
             }, 6000);
            </script>
        }
        @Html.HiddenFor(m => m.PartyId)
        @Html.HiddenFor(m => m.PartyCode)
        <div class="row m-0">

            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-lg-6">
                            <strong class="card-title"></strong>
                        </div>
                        <div class="col-lg-6 text-right">
                            <a class="btn btn-sm" id="btnrefresh" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                            <a class="btn btn-sm" id="btnBack" href="@Url.Action("PartyMaster", "Master")"><i class="fa fa-arrow-circle-left"></i>&nbsp; Back</a>
                            <button class="btn btn-sm" type="submit"><i class="fa fa-save"></i>&nbsp; Save</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="general">
                            <div class="form-horizontal page-head">
                                <div class="section-left">
                                    <div class="row form-group">
                                        <div class="col col-md-3">
                                            <label class=" form-control-label">Party Code</label>
                                        </div>
                                        <div class="col-12 col-md-9 text-left">
                                            @Html.TextBoxFor(m => m.PartyCode, new { @placeholder = "Party Code", @class = "form-control", @disabled = "disabled" })
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label class=" form-control-label">Party Status<span class="text-danger p-1">(*)</span></label></div>
                                        <div class="col-12 col-md-9 pt-2">
                                            <label class="switch switch-3d switch-success mr-3">
                                                @Html.CheckBoxFor(m => m.PartyStatus, new { @class = "switch-input" })
                                                <span class="switch-label"></span> <span class="switch-handle"></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label class=" form-control-label">Party Type<span class="text-danger p-1">(*)</span></label></div>
                                        <div class="col-12 col-md-8">
                                            @Html.DropDownListFor(m => m.PartyType, new SelectList(ViewBag.PartyType, "Value", "Text", Model.PartyType), "Select Party Type", new { @class = "form-control form-select ", @id = "ddlPartyType" })
                                            @Html.ValidationMessageFor(model => model.PartyType, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-12 col-md-1 pl-0">
                                            <div class="input-group">
                                                <a class=" btn  btn-sm" href="javascript:void(0);" title="Add Contact Person" data-toggle="modal" data-target="#mediumModal"><i class="fa fa-plus-square"></i></a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row form-group">
                                        <div class="col col-md-3">
                                            <label for="text-input" class=" form-control-label">Party Name<span class="text-danger p-1">(*)</span></label>
                                        </div>
                                        <div class="col-12 col-md-9 form-group">
                                            @Html.TextBoxFor(m => m.PartyName, new { @placeholder = "Party Name", @class = "form-control", @required = "required", @maxlength = "50" })
                                            @Html.ValidationMessageFor(m => m.PartyName, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3">
                                            <label for="text-input" class=" form-control-label">Alternate Name</label>
                                        </div>
                                        <div class="col-12 col-md-9">
                                            @Html.TextBoxFor(m => m.AlternateName, new { @class = "form-control", @rows = "3", @placeholder = "Alternate Name", @maxlength = "50" })
                                            @Html.ValidationMessageFor(m => m.AlternateName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label class=" form-control-label">Group<span class="text-danger p-1">(*)</span></label></div>
                                        <div class="col-12 col-md-8">
                                            @Html.DropDownListFor(m => m.PartyGroup, new SelectList(ViewBag.PartyGroup, "Value", "Text", Model.PartyGroup), "Select Group", new { @class = "form-control form-select", @id = "ddlPartyGroup" })
                                            @Html.ValidationMessageFor(model => model.PartyGroup, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-12 col-md-1 pl-0">
                                            <div class="input-group">
                                                <a class=" btn  btn-sm" href="javascript:void(0);" title="Add Contact Person" data-toggle="modal" data-target="#mediumModal"><i class="fa fa-plus-square"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col col-md-3"><label class=" form-control-label">Currency<span class="text-danger p-1">(*)</span></label></div>
