</div><!-- .animated -->

<script type="text/javascript">
    function SetDefaultSelection(did, ddlValue) {
        if (ddlValue != "" && ddlValue.length > 0 && ddlValue != "0") {
            $("#" + did).val(ddlValue).attr('selected', true);
        }
    }
    $(document).ready(function () {

        $('#btnrefresh').click(function () {
            location.reload();
        });

        SetDefaultSelection("ddlPartyType", '@Model.PartyType');
        SetDefaultSelection("ddlPartyGroup", '@Model.PartyGroup');
        SetDefaultSelection("ddlCurrency", '@Model.Currency');
        SetDefaultSelection("ddlIndustry", '@Model.Industry');
        SetDefaultSelection("ddlSalesPerson", '@Model.SalesPerson');
        SetDefaultSelection("ddlBillToCity", '@Model.BillToCity');
        SetDefaultSelection("ddlBillToState", '@Model.BillToState');
        SetDefaultSelection("ddlBillToCountry", '@Model.BillToCountry');
        SetDefaultSelection("ddlShipToCity", '@Model.ShipToState');
        SetDefaultSelection("ddlShipToCountry", '@Model.ShipToCountry');
         SetDefaultSelection("ddlGSTType", '@Model.GSTType');
    });
    function GetNextCode(tablename)
    {
    var code = "";
    $.ajax({
        type: "GET", url: '@Url.Action("getNextCode", "Common")',
        contentType: "application/json; charset=utf-8",
        data: { tblName: tablename },
        dataType: "json",
        async: false,
        success: function (response) {
            $("#PartyCode").val(response);
        },
        failure: function (response) {},
        error: function (response) {}
    });
    return code;
    }

</script>
