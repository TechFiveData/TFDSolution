
@{
    ViewBag.Title = "Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- /header -->
<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Item Master</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="active">Item Master</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="animated fadeIn">
    <div class="row m-0">

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-6">
                        <strong class="card-title"></strong>
                    </div>
                    <div class="col-lg-6 text-right">
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-refresh"></i>&nbsp; Refresh</a>
                        <a class="btn btn-sm" href="javascript:void(0);"><i class="fa fa-download"></i>&nbsp; Export</a>
                        <a class="btn btn-sm" href="@Url.Action("ItemAction","Master")" title="Add New Item"><i class="fa fa-plus"></i>&nbsp; New</a>

                    </div>
                </div>
                <div class="card-body">
                    @*<p class="text-muted m-b-15">
                            Item List
                        </p>*@
                    <div class="row form-group">
                        <table id="tblItem" class="display cell-border" cellspacing="0" width="100%"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div><!-- .animated -->

<script type="text/javascript">
    $(document).ready(function () {
        GetItemList();
        AddNewLocation();
        $('#mediumModal').on('shown.bs.modal', function () {
            AddNewLocation();
        })
    });
    $('#mediumModal').on('shown.bs.modal', function () {
        AddNewLocation();
    })
    function GetItemList() {
        $.ajax({
            type: "GET",
            url: "@Url.Action("getItemList", "Master")",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: OnSuccess,
            failure: function (response) {
                alert(response.d);
            },
            error: function (response) {
                alert("Error fetching data!");
            }
        });
    }

    function OnSuccess(response) {
        bindDataTable(response);
    }

    function bindDataTable(dataset) {
        dataset = Array.isArray(dataset) ? dataset : [];

        // Initialize DataTable
        new DataTable('#tblItem', {
            layout: {
                topStart: {
                    pageLength: {
                        menu: [10, 25, 50, 100]
                    }
                },
                topEnd: {
                    search: {
                        placeholder: 'Type search here'
                    }
                },
                bottomEnd: {
                    paging: {
                        buttons: 5
                    }
                }
            },
            paging: true,
            scrollCollapse: true,
           // scrollY: '500px',
            data: dataset,
            columns: [
                {
                    title: '',
                    className: "grid-action-item",
                    render: function (data, type, row, meta) {
                        var editlink = '@Url.Action("ItemAction", "Master", new { uId= "_uId"})';
                        editlink = editlink.replace("_uId", row.ItemId);

                        return "<a title='Edit Record' href=" + editlink + "><i class='fa fa-pencil'></i></a> &nbsp;|&nbsp; <a title='Delete Record' href='javascript:DeleteItem(\"" + row.ItemId + "\")';><i class='fa fa-trash text-danger'></i></a>";
                    },
                },
                {
                    title: 'Item Code',
                    render: function (data, type, row, meta) {
                        var itemcode = row.ItemCode;
                         var editlink = '@Url.Action("ItemAction", "Master", new { uId= "_uId"})';
                         editlink = editlink.replace("_uId", row.ItemId);

                        if (row.UpdatedOn != null) {
                            return "<a title='Edit Record' href=" + editlink + ">" + itemcode + "</a>";
                        }
                        else {
                            return "<a title='Edit Record' href=" + editlink + "><strong>" + itemcode + "</strong></a>";
                        }
                    },
                },
                {
                    title: 'Description', data: 'ItemDescription'
                },
                {
                    title: 'Status',
                    className: 'text-center',
                    render: function (data, type, row, meta) {
                        return (row.ItemStatus === true) ? '<span class="fa fa-check text-success"></span>' : '<span class="fa fa-remove text-danger"></span>';
                    }
                },
                { title: 'Created By', data: 'CreatedBy' },
                {
                    title: 'Created On',
                    render: function (data, type, row, meta) {
                        var editlink = formatDate(parseMSDate(row.CreatedOn));
                        return "<span>" + editlink + "</span>";
                    },
                },
                { title: 'Updated By', data: 'UpdatedBy'},
                {
                    title: 'Updated On',
                    render: function (data, type, row, meta) {
                        if (row.UpdatedOn != null) {
                            var editlink = formatDate(parseMSDate(row.UpdatedOn));
                            return "<span>" + editlink + "</span>";
                        }
                        else {
                            return "<span></span>";
                        }
                    },
                },
            ],
            language: {
                emptyTable: "No records found", // Message when no data is available
                zeroRecords: "No matching records found"
            }
        });
    }
    function formatDate(d) {
        if (hasTime(d)) {
            let n = d.toLocaleString([], {
                hour: "2-digit",
                minute: "2-digit",
            });
            var s = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
            s += ' ' + n;
        } else {
            var s = (d.getDate() + '/' + d.getMonth() + 1) + '/' + d.getFullYear();
        }
        return s;
    }
    function hasTime(d) {
        return !!(d.getUTCHours() || d.getUTCMinutes() || d.getUTCSeconds());
    }

    function zeroFill(n) {
        if ((n + '').length == 1)
            return '0' + n;

        return n;
    }
    function parseMSDate(s) {
        // Jump forward past the /Date(, parseInt handles the rest
        return new Date(parseInt(s.substr(6)));
    }

    function DeleteItem(uId) {
        if (confirm("Are you sure you want to delete record?")) {
            try
            {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteItem", "Master")',
                    data: { uId: uId },
                    async: false,
                    success: function (response) {
                        alert(response.Response);
                        location.reload(); // Refresh the table
                    },
                    error: function (response) {
                        alert(response);
                    }

                });
            }
            catch (e) {
            }
        }
    }

    function AddNewLocation() {
        $("#CompanyCode").val('');
       // GetNextCode("m_CompanyMast");
        $("#Email").val('');
        $("#Phone").val('');
        $("#Mobile").val('');
        $("#CompanyName").val('');
        $("#CompanyName").focus();
    }

    function SaveLocation()
    {
     //var cCode = $("#CompanyCode").val();
     if ($.trim($("#CompanyCode").val()).length == 0) {
        // GetNextCode("m_CompanyMast");
     }

     //var cName = $("#CompanyName").val();
     //var cEmail = $("#Email").val();
     //var cPhone = $("#Phone").val();
     //var cMobile = $("#Mobile").val();
     var isFormValid = true;
     $("#mediumModal input").each(function () {
         if ($.trim($(this).val()).length == 0) {
             $(this).addClass("input-validation-error");
             if (isFormValid == true) {
                 $(this).focus();
             }
             isFormValid = false;
         }
         else {
             $(this).removeClass("input-validation-error");
         }
     });

     if (!isFormValid) {
         alert("Please fill in all the required fields (indicated by *)");
     }
     else {
         try {
             var company = {
                 CompanyCode: $("#CompanyCode").val(),
                 CompanyName: $("#CompanyName").val(),
                 Email: $("#Email").val(),
                 Phone: $("#Phone").val(),
                 Mobile: $("#Mobile").val()
             };

             $.ajax({
                 type: "POST",
                 url: "@Url.Action("SaveLocation", "Master")",
                 contentType: "application/json;",
                 data: JSON.stringify(company),
                 async: false,
                 success: function (response) {
                     if (response.IsSuccess) {
                         alert("Record saved successfully.")
                         location.reload();
                     }
                     else {
                         alert(response.Response);
                     }
                 },
                 failure: function (response) { },
                 error: function (response) { }
             });
         } catch (e) {
         }
     }
}


</script>
