@model TFDSolution.Models.ForgotModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <style>
        footer {
            background-color: #f8f9fa;
            padding: 6px 0;
            text-align: center;
            font-size: 14px;
            border-top: 1px solid #ddd;
            width: 100%;
            bottom: 0;
            position: absolute;
        }
    </style>
    <meta name="viewport" content="width=device-width" />
    <title>TFD | Forgot Password</title>
    @{
        var ImagesBase = Url.Content("~/Images");
        var ContentBase = Url.Content("~/Content");
    }
    <link rel="stylesheet" href="@ContentBase/Site.css">
    <link rel="stylesheet" href="@ContentBase/theme//theme1/login.css">
    <link href="@ContentBase/bootstrap.min.css" rel="stylesheet" />
    <link href="@ContentBase/main/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.7.1.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#UserName").focus();
        });
    </script>
</head>
<body class="loginbody" style="background-image: Url('@ImagesBase/theme1.jpg')">
    <div class="header-block">
        <span>www.techfivedata.com</span>
    </div>
    @if (@ViewBag.RegistrationMsg != null)
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @ViewBag.RegistrationMsg
        </div>
    }
    <div class="section1"></div>
    <div class="section2">
        <div class="main">
            <h4 style="border-bottom: 1px double #f39b3b; padding-bottom: 15px;">Forgot Password</h4>
            @using (Html.BeginForm("forgotPassword", "Login", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-12 form-group">
                        <label for="UserName">User Name:</label>
                        @Html.TextBoxFor(a => a.UserName, new { @placeholder = "Enter your User Name", @autocomplete = "off" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 form-group">
                        <label for="Password">Email Address:</label>
                        @Html.TextBoxFor(a => a.EmailAddress, new { @placeholder = "Enter your Email Address", @autocomplete = "off" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 form-group">
                        <div class="wrap">
                            <button type="submit">Submit</button>
                        </div>
                    </div>
                </div>
            }
            <p>
                Not registered?
                <a href="@Url.Action("Index","Register")" style="text-decoration: none;">
                    Registration
                </a>
                <span style="padding:0 4px;">|</span>
                <a href="@Url.Action("Index","Login")" style="text-decoration: none;">
                    Login
                </a>
            </p>
        </div>
    </div>
    <footer class="footer mt-auto bg-dark text-white">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year <strong>Lotus Next ERP</strong>. All rights reserved.
            </p>
            @*<p class="small">
                    <a href="/Home/Privacy" class="text-light">Privacy Policy</a> |
                    <a href="/Home/Terms" class="text-light">Terms of Service</a>
                </p>*@
        </div>
    </footer>
</body>
</html>
