@model TFDSolution.Models.ForgotModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = "";

    var ImagesBase = Url.Content("~/Images");
    var ContentBase = Url.Content("~/Content");
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>TFD | Forgot Password</title>

    <link rel="stylesheet"
          href="@ContentBase/theme//theme1/login.css" />

    <link href="@ContentBase/main/assets/css/style.css"
          rel="stylesheet" />

    <link href="@ContentBase/main/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="@ContentBase/bootstrap.min.css"
          rel="stylesheet" />

    <link href="@ContentBase/main/font-awesome/css/font-awesome.min.css"
          rel="stylesheet" />


    <style>

    /* =========================================
       GLOBAL
    ========================================= */

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
    }

    body {
        font-family: "Segoe UI", Arial, sans-serif;
        background: #ffffff;
    }


    /* =========================================
       PAGE
    ========================================= */

    .forgot-page {
        min-height: 100vh;
        width: 100%;

        position: relative;
        overflow: hidden;

        background-image: url('@Url.Content(ImagesBase + "/theme1.jpg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }


    /* =========================================
       TOP BAR
    ========================================= */

    .topbar {
        height: 64px;
        width: 100%;

        padding: 0 38px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        background: rgba(242, 251, 254, .94);

        border-bottom: 1px solid #dfecef;

        position: relative;
        z-index: 20;
    }


    /* =========================================
       TOP BAR BRAND
       IMPORTANT:
       Only topbar logo gets this CSS
    ========================================= */

    .topbar .brand {
        display: flex;
        align-items: center;

        gap: 10px;

        text-decoration: none;

        margin: 0;
        padding: 0;
    }

    .topbar .brand-logo {
        width: 40px !important;
        height: 40px !important;

        min-width: 40px;
        max-width: 40px;

        margin: 0 !important;
        padding: 0 !important;

        display: flex !important;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #27a9d7;

        color: #ffffff;

        font-size: 18px;

        line-height: 1;

        box-shadow:
            0 5px 12px rgba(39, 169, 215, .20);
    }

    .topbar .brand-logo i {
        margin: 0;
        padding: 0;

        font-size: 18px;

        line-height: 1;
    }

    .topbar .brand-name {
        margin: 0;
        padding: 0;

        font-size: 19px;

        font-weight: 700;

        line-height: 1.2;

        white-space: nowrap;

        color: #243746;
    }

    .topbar .brand-name span {
        color: #27a9d7;
    }


    /* =========================================
       HELP
    ========================================= */

    .help-link {
        display: flex;
        align-items: center;

        gap: 7px;

        margin: 0;
        padding: 0;

        color: #6c7f8c;

        font-size: 14px;

        text-decoration: none;
    }

    .help-link i {
        color: #27a9d7;
    }

    .help-link:hover {
        color: #27a9d7;

        text-decoration: none;
    }


    /* =========================================
       MAIN
    ========================================= */

    .main-container {
        min-height: calc(100vh - 105px);

        display: flex;
        align-items: center;

        padding: 40px 20px;

        position: relative;

        z-index: 2;
    }

    .forgot-container {
        max-width: 1180px;

        width: 100%;

        margin: auto;

        display: flex;

        justify-content: flex-end;

        align-items: center;
    }


    /* =========================================
       FORGOT CARD
    ========================================= */

    .forgot-card {
        width: 475px;

        max-width: 100%;

        background: #ffffff;

        border-radius: 18px;

        padding: 35px 32px 27px;

        box-shadow:
            0 20px 55px rgba(30, 60, 80, .12),
            0 3px 10px rgba(30, 60, 80, .04);

        border: 1px solid rgba(0, 0, 0, .04);

        position: relative;

        z-index: 5;

        animation: cardShow .45s ease;
    }


    @@keyframes cardShow {

        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================
       CARD BRAND / LOCK ICON
       IMPORTANT:
       Completely separate from TOPBAR logo
    ========================================= */

    .forgot-card .brand-logo {
        width: 100% !important;

        height: auto !important;

        min-width: 0 !important;
        max-width: none !important;

        margin: 0 0 26px 0 !important;

        padding: 0 !important;

        display: block !important;

        position: relative !important;

        float: none !important;

        clear: both !important;

        text-align: center !important;

        background: transparent !important;

        border-radius: 0 !important;

        box-shadow: none !important;

        color: inherit;

        font-size: inherit;
    }


    /* Lock Icon */

    .forgot-card .brand-logo .logo-icon {
        width: 65px !important;
        height: 65px !important;

        min-width: 65px !important;
        max-width: 65px !important;

        margin: 0 auto 15px auto !important;

        padding: 0 !important;

        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        position: relative !important;

        top: auto !important;
        right: auto !important;
        bottom: auto !important;
        left: auto !important;

        float: none !important;

        border-radius: 16px !important;

        background: #27a9d7 !important;

        color: #ffffff !important;

        font-size: 28px !important;

        line-height: 1 !important;

        box-shadow:
            0 8px 20px rgba(39, 169, 215, .25) !important;

        transform: none !important;
    }

    .forgot-card .brand-logo .logo-icon i {
        display: block !important;

        width: auto !important;
        height: auto !important;

        margin: 0 !important;
        padding: 0 !important;

        position: static !important;

        color: #ffffff !important;

        font-size: 28px !important;

        line-height: 1 !important;
    }


    /* Lotus Next ERP */

    .forgot-card .brand-logo h3 {
        display: block !important;

        width: 100% !important;

        margin: 0 !important;
        padding: 0 !important;

        position: static !important;

        float: none !important;

        clear: both !important;

        text-align: center !important;

        color: #243746 !important;

        font-family: "Segoe UI", Arial, sans-serif !important;

        font-size: 23px !important;

        font-weight: 700 !important;

        line-height: 1.25 !important;

        white-space: nowrap !important;

        overflow: visible !important;
    }


    /* ERP Management System */

    .forgot-card .brand-logo span {
        display: block !important;

        width: 100% !important;

        margin: 5px 0 0 0 !important;
        padding: 0 !important;

        position: static !important;

        float: none !important;

        clear: both !important;

        text-align: center !important;

        color: #7b8794 !important;

        font-family: "Segoe UI", Arial, sans-serif !important;

        font-size: 13px !important;

        font-weight: 400 !important;

        line-height: 1.4 !important;

        white-space: nowrap !important;
    }


    /* =========================================
       FORGOT HEADING
    ========================================= */

    .forgot-heading {
        width: 100%;

        text-align: center;

        margin: 0 0 27px 0;
    }

    .forgot-heading h2 {
        margin: 0 0 7px 0;

        color: #273746;

        font-size: 25px;

        font-weight: 650;

        line-height: 1.25;
    }

    .forgot-heading p {
        max-width: 390px;

        margin: 0 auto;

        color: #8a97a4;

        font-size: 13px;

        line-height: 1.55;
    }


    /* =========================================
       SUCCESS MESSAGE
    ========================================= */

    .success-alert {
        width: 100%;

        padding: 10px 12px;

        margin: 0 0 18px 0;

        border-radius: 6px;

        font-size: 12px;

        color: #0f5132;

        background: #d1e7dd;

        border: 1px solid #badbcc;
    }

    .success-alert i {
        margin-right: 6px;
    }


    /* =========================================
       FORM
    ========================================= */

    .form-group-custom {
        width: 100%;

        margin: 0 0 17px 0;
    }

    .form-label-custom {
        display: block;

        margin: 0 0 6px 0;

        font-size: 12px;

        font-weight: 600;

        line-height: 1.4;

        color: #526170;
    }

    .required {
        color: #e05252;
    }

    .input-wrapper {
        width: 100%;

        position: relative;
    }

    .input-icon {
        position: absolute;

        left: 13px;
        top: 50%;

        transform: translateY(-50%);

        color: #a0acb7;

        font-size: 13px;

        line-height: 1;

        z-index: 2;

        pointer-events: none;

        transition: color .2s ease;
    }

    .form-control-custom {
        width: 100% !important;

        height: 46px !important;

        min-height: 46px !important;

        margin: 0 !important;

        padding: 0 13px 0 39px !important;

        border: 1px solid #d6e0e6 !important;

        border-radius: 6px !important;

        outline: none !important;

        background: #ffffff !important;

        color: #526170 !important;

        font-family: "Segoe UI", Arial, sans-serif !important;

        font-size: 13px !important;

        line-height: 46px !important;

        box-shadow: none;

        transition: all .2s ease;
    }

    .form-control-custom:focus {
        border-color: #27a9d7 !important;

        box-shadow:
            0 0 0 3px rgba(39, 169, 215, .08) !important;
    }

    .form-control-custom:focus ~ .input-icon {
        color: #27a9d7;
    }

    .form-control-custom::placeholder {
        color: #8e9ca7;

        opacity: 1;
    }


    /* =========================================
       BUTTON
    ========================================= */

    .btn-reset {
        width: 100% !important;

        height: 45px !important;

        margin: 5px 0 0 0 !important;

        padding: 0 15px !important;

        border: 0 !important;

        border-radius: 8px !important;

        background:
            linear-gradient(
                135deg,
                #27a9d7,
                #168fb9
            ) !important;

        color: #ffffff !important;

        font-family: "Segoe UI", Arial, sans-serif !important;

        font-size: 14px !important;

        font-weight: 600 !important;

        line-height: 45px !important;

        cursor: pointer;

        outline: none;

        box-shadow:
            0 8px 18px rgba(39, 169, 215, .22);

        transition: all .25s ease;
    }
    .btn-reset:hover {
        transform: translateY(-1px);
        box-shadow:
            0 10px 22px rgba(39, 169, 215, .30);
    }
    .btn-reset:active {
        transform: translateY(0);
    }
    .btn-reset i {
        margin-right: 7px;
        font-size: 13px;
    }
    /* =========================================
       ACCOUNT LINKS
    ========================================= */
    .account-links {
        width: 100%;
        margin: 20px 0 0 0;
        padding: 0;
        text-align: center;
        color: #8a96a1;
        font-size: 12px;
        line-height: 1.5;
    }
    .account-links a {
        color: #168fb9;
        font-weight: 600;
        text-decoration: none;
    }
    .account-links a:hover {
        color: #27a9d7;
        text-decoration: underline;
    }
    .separator {
        padding: 0 7px;
        color: #c5ced4;
    }
    /* =========================================
       FOOTER
    ========================================= */
        .footer {
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8995a0;
            font-size: 11px;
            position: relative;
            z-index: 5;
        }
    /* =========================================
       TABLET
    ========================================= */
    @@media (max-width: 991px) {
        .main-container {
            padding: 35px 20px;
        }
        .forgot-container {
            justify-content: center;
        }
        .forgot-card {
            width: 475px;
        }
    }
    /* =========================================
       MOBILE
    ========================================= */
    @@media (max-width: 767px) {
        .topbar {
            height: 60px;
            padding: 0 18px;
        }
        .topbar .brand-logo {
            width: 36px !important;
            height: 36px !important;
            min-width: 36px !important;
            max-width: 36px !important;
            margin: 0 !important;
            font-size: 16px !important;
        }
        .topbar .brand-logo i {
            font-size: 16px !important;
        }
        .topbar .brand-name {
            font-size: 17px !important;
            white-space: nowrap;
        }
        .help-link {
            display: none;
        }
        .main-container {
            min-height: calc(100vh - 60px);
            padding: 25px 15px;
            align-items: flex-start;
        }
        .forgot-container {
            width: 100%;
            padding-top: 20px;
        }
        .forgot-card {
            width: 100%;
            padding: 30px 22px 24px;
            border-radius: 15px;
        }
        /* Card logo MUST NOT inherit mobile header logo */
        .forgot-card .brand-logo {
            width: 100% !important;
            height: auto !important;
            margin-bottom: 25px !important;
        }
        .forgot-card .brand-logo .logo-icon {
            width: 58px !important;
            height: 58px !important;
            min-width: 58px !important;
            max-width: 58px !important;
            font-size: 25px !important;
        }
        .forgot-card .brand-logo .logo-icon i {
            font-size: 25px !important;
        }
        .forgot-card .brand-logo h3 {
            font-size: 20px !important;
        }
        .forgot-card .brand-logo span {
            font-size: 12px !important;
        }
        .forgot-heading h2 {
            font-size: 23px;
        }
    }
    /* =========================================
       SMALL MOBILE
    ========================================= */
    @@media (max-width: 480px) {
        .topbar {
            padding: 0 14px;
        }
        .topbar .brand-name {
            font-size: 16px !important;
        }
        .forgot-page {
            padding: 0;
        }
        .forgot-card {
            padding: 27px 18px 22px;
        }
        .forgot-card .brand-logo .logo-icon {
            width: 55px !important;
            height: 55px !important;
            min-width: 55px !important;
            max-width: 55px !important;
        }
        .forgot-card .brand-logo h3 {
            font-size: 20px !important;
        }
        .forgot-heading h2 {
            font-size: 22px;
        }
        .forgot-heading p {
            font-size: 12px;
        }
    }
    </style>
</head>
<body>
    <div class="forgot-page">
        <!-- =========================================
         TOP BAR
    ========================================== -->
        <header class="topbar">
            <a href="#" class="brand">
                <div class="brand-logo">
                    <i class="fa fa-bar-chart"></i>
                </div>
                <div class="brand-name">
                    LotusNext <span>ERP</span>
                </div>
            </a>
            <a href="#" class="help-link">
                <i class="fa fa-question-circle"></i>
                Need Help?
            </a>
        </header>
        <!-- =========================================
         MAIN
    ========================================== -->
        <main class="main-container">
            <div class="forgot-container">
                <!-- =================================
                 FORGOT PASSWORD CARD
            ================================== -->
                <div class="forgot-card">
                    <div class="brand-logo">
                        <div class="logo-icon">
                            <i class="fa fa-lock"></i>
                        </div>
                        @*<h3>Lotus Next ERP</h3>
                        <span>ERP Management System</span>*@
                    </div>
                    <!-- Heading -->
                    <div class="forgot-heading">
                        <h2>
                            Forgot Password?
                        </h2>
                        <p>
                            Enter your registered email address or username. We will send you instructions to reset your password.
                        </p>
                    </div>
                    <!-- Success Message -->
                    @if (ViewBag.RegistrationMsg != null)
                    {
                        <div class="success-alert">
                            <i class="fa fa-check-circle"></i>
                            <strong>Success!</strong>
                            @ViewBag.RegistrationMsg
                        </div>
                    }
                    <!-- Existing MVC Form -->
                    @using (Html.BeginForm("forgotPassword", "Login", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <!-- User Name -->
                        <div class="form-group-custom">
                            <label class="form-label-custom"
                                   for="UserName">
                                User Name
                                <span class="required">*</span>
                            </label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(
                                    a => a.UserName,
                                    new
                                    {
                                        @class = "form-control-custom",
                                        @placeholder = "Enter your User Name",
                                        @autocomplete = "off",
                                        @id = "UserName"
                                    }
                                )
                                <i class="fa fa-user input-icon"></i>
                            </div>
                        </div>
                        <!-- Email -->
                        <div class="form-group-custom">
                            <label class="form-label-custom"
                                   for="EmailAddress">
                                Email Address
                                <span class="required">*</span>
                            </label>
                            <div class="input-wrapper">
                                @Html.TextBoxFor(
                                    a => a.EmailAddress,
                                    new
                                    {
                                        @class = "form-control-custom",
                                        @placeholder = "Enter your Email Address",
                                        @autocomplete = "off",
                                        @id = "EmailAddress"
                                    }
                                )
                                <i class="fa fa-envelope input-icon"></i>
                            </div>
                        </div>
                        <!-- Submit -->
                        <button type="submit"
                                class="btn-reset">
                            Send Reset Link
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    }
                    <!-- Navigation -->
                    <div class="account-links">
                        <span>
                            Not registered?
                        </span>
                        <a href="@Url.Action("Index", "Register")">
                            Registration
                        </a>
                        <span class="separator">
                            |
                        </span>
                        <a href="@Url.Action("Index", "Login")">
                            Back to login
                            <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </main>
        <!-- Footer -->
        <div class="footer">
            © @DateTime.Now.Year
            Lotus Next ERP.
            All rights reserved.
        </div>
    </div>
    <script>
        $(document).ready(function () {
            $("#UserName").focus();
        });
    </script>
</body>
</html>